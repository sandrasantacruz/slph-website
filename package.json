{
  "name": "slph",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently -n web,pb -c blue,green \"pnpm dev:web\" \"pnpm pb:serve\"",
    "dev:web": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "pb:serve": "cd backend && go run . serve --http=127.0.0.1:8090",
    "pb:migrate": "cd backend && go run . migrate",
    "pb:build": "cd backend && go build -o ../bin/pocketbase ."
  },
  "dependencies": {
    "@astrojs/node": "^10.1.0",
    "@astrojs/react": "^5.0.4",
    "@blocknote/core": "^0.50.0",
    "@blocknote/mantine": "^0.50.0",
    "@blocknote/react": "^0.50.0",
    "@tailwindcss/vite": "^4.3.0",
    "astro": "^6.3.1",
    "pocketbase": "^0.26.8",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "tailwindcss": "^4.3.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "concurrently": "^9.2.1",
    "typescript": "^6.0.3"
  }
}