{
  "name": "slph",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently -n web,pb -c blue,green \"pnpm dev:web\" \"pnpm pb:serve\"",
    "dev:web": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "pb:serve": "cd backend && go run . serve --http=127.0.0.1:8090",
    "pb:migrate": "cd backend && go run . migrate",
    "pb:build": "cd backend && go build -o ../bin/pocketbase .",
    "import:wp": "node scripts/import-wordpress.mjs",
    "import:wp-events": "node scripts/import-wp-events.mjs"
  },
  "dependencies": {
    "@astrojs/node": "^10.1.0",
    "@astrojs/react": "^5.0.4",
    "@blocknote/core": "^0.50.0",
    "@blocknote/mantine": "^0.50.0",
    "@blocknote/react": "^0.50.0",
    "@fontsource-variable/caveat": "^5.2.8",
    "@fontsource/londrina-solid": "^5.2.7",
    "@fontsource/varela-round": "^5.2.8",
    "@iconify-json/game-icons": "^1.2.4",
    "@iconify-json/simple-icons": "^1.2.81",
    "@mantine/core": "^9.1.1",
    "@mantine/dates": "^9.1.1",
    "@mantine/hooks": "^9.1.1",
    "@tailwindcss/vite": "^4.3.0",
    "astro": "^6.3.1",
    "astro-icon": "^1.1.5",
    "dayjs": "^1.11.20",
    "heic-to": "^1.4.2",
    "page-flip": "^2.0.7",
    "pocketbase": "^0.26.8",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "tailwindcss": "^4.3.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@playwright/test": "^1.59.1",
    "@types/node": "^25.6.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "cheerio": "^1.2.0",
    "concurrently": "^9.2.1",
    "dotenv": "^17.4.2",
    "sharp": "^0.34.5",
    "typescript": "^6.0.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}