PUBLIC_POCKETBASE_URL=http://127.0.0.1:8090

# Superuser bootstrap (read by backend/main.go on serve start).
# If both are set, the user is created on first boot. To overwrite the password
# of an existing user on subsequent boots, also set PB_SUPERUSER_UPDATE=1.
PB_SUPERUSER_EMAIL=
PB_SUPERUSER_PASSWORD=
PB_SUPERUSER_UPDATE=

# Default user bootstrap (regular "users" auth collection, used for /admin login).
# Same semantics as PB_SUPERUSER_*: both must be set; PB_USER_UPDATE=1 overwrites
# the password on subsequent boots. Created users are marked as verified.
PB_USER_EMAIL=
PB_USER_PASSWORD=
PB_USER_UPDATE=

# Application settings (admin > Settings > Application). Leer = Admin-Wert
# bleibt unangetastet. Wird bei jedem serve gegen den DB-Wert abgeglichen.
#
# PB_APP_URL ist außerdem die Browser-facing URL für PocketBase-File-Links
# (`<img src>` und Admin-Uploads). Wird zur Laufzeit von Astro SSR gelesen,
# d.h. ein generisches GHCR-Image kann pro Environment unterschiedlich
# konfiguriert werden. In Prod auf die öffentliche URL setzen (z.B.
# https://slph.pulpo.cloud); in `pnpm dev` reicht PUBLIC_POCKETBASE_URL.
PB_APP_URL=
PB_APP_NAME=

# ── Migration in das neue System (scripts/migrate-to-pulpo.mjs) ──────────────
# Quelle: PocketBase dieser Seite. Login nur nötig, wenn auch Entwürfe
# migriert werden sollen (öffentliche Artikel sind ohne Auth lesbar).
SRC_URL=https://slph.pulpo.cloud
SRC_EMAIL=
SRC_PASSWORD=

# Ziel: pulpo-PocketBase. PULPO_EMAIL/_PASSWORD ist ein Login der
# `users`-Collection MIT `website`-Berechtigung; daraus leitet das Skript das
# Restaurant ab. Alternativ PULPO_SUPERUSER=1 plus PULPO_RESTAURANT.
#
# Für die *Seite* sind diese Variablen optional: CMS-URL, Tenant und Sprache
# stehen in `src/config.ts`. Gesetzt überschreiben sie den dortigen Wert, was
# für lokale Arbeit gegen eine eigene pulpo-Instanz gedacht ist. Das
# Migrationsskript dagegen braucht sie.
PULPO_URL=
PULPO_EMAIL=
PULPO_PASSWORD=
PULPO_SUPERUSER=
PULPO_RESTAURANT=
# Sprachcode der Artikel; leer = site_settings.defaultLang des Tenants
# (im Content-Loader: leer = es).
PULPO_LANG=
# Optionaler Autor-Freitext für alle migrierten Artikel.
PULPO_AUTHOR=
# Nur für den Content-Loader: Basis der Bild-URLs, falls der Build intern eine
# andere Adresse erreicht als der Browser. Leer = PULPO_URL.
PULPO_PUBLIC_URL=
