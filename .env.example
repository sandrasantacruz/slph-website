# Für den normalen Build wird nichts hiervon gebraucht: CMS-URL, Tenant und
# Sprache stehen in `src/config.ts`. Gesetzte Variablen überschreiben die
# dortigen Werte, gedacht für lokale Arbeit gegen eine eigene pulpo-Instanz:
#
#   PULPO_URL=http://localhost:8081
#   PULPO_RESTAURANT=<lokale Tenant-ID>
PULPO_URL=
PULPO_RESTAURANT=
# Sprachcode der lokalisierten CMS-Felder. Leer = es.
PULPO_LANG=
# Basis der Bild-URLs, falls der Build das CMS unter einer anderen Adresse
# erreicht als der Browser. Leer = PULPO_URL.
PULPO_PUBLIC_URL=

# ── Migration (scripts/migrate-to-pulpo.mjs) ────────────────────────────────
# Einmalig gelaufen. Die damalige Quelle existiert nicht mehr; der Block steht
# hier, falls das Skript für eine andere Quelle wiederverwendet wird.
#
# PULPO_EMAIL/_PASSWORD ist ein Login der `users`-Collection MIT
# `website`-Berechtigung; daraus leitet das Skript den Tenant ab. Alternativ
# PULPO_SUPERUSER=1 plus PULPO_RESTAURANT.
SRC_URL=
SRC_EMAIL=
SRC_PASSWORD=
PULPO_EMAIL=
PULPO_PASSWORD=
PULPO_SUPERUSER=
# Optionaler Autor-Freitext für alle migrierten Artikel.
PULPO_AUTHOR=
