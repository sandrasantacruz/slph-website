PUBLIC_POCKETBASE_URL=http://127.0.0.1:8090

# Superuser bootstrap (read by backend/main.go on serve start).
# If both are set, the user is created on first boot. To overwrite the password
# of an existing user on subsequent boots, also set PB_SUPERUSER_UPDATE=1.
PB_SUPERUSER_EMAIL=
PB_SUPERUSER_PASSWORD=
PB_SUPERUSER_UPDATE=

# Application settings (admin > Settings > Application). Leer = Admin-Wert
# bleibt unangetastet. Wird bei jedem serve gegen den DB-Wert abgeglichen.
PB_APP_URL=
PB_APP_NAME=
