---
import {
  SITE_NAME,
  SITE_URL,
  SITE_LOCALE,
  DEFAULT_OG_IMAGE,
  DEFAULT_OG_IMAGE_ALT,
  DEFAULT_OG_IMAGE_WIDTH,
  DEFAULT_OG_IMAGE_HEIGHT,
  absoluteUrl,
  type JsonLd,
} from '../lib/seo';

interface Props {
  title: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  /**
   * Maße des über `image` gesetzten Bildes. Nur angeben, wenn sie wirklich
   * bekannt sind — Scraper reservieren damit das Vorschau-Layout, falsche
   * Werte erzeugen eine verzerrte Vorschau. Ohne `image` gelten automatisch
   * die Maße von DEFAULT_OG_IMAGE.
   */
  imageWidth?: number;
  imageHeight?: number;
  /** Open-Graph `og:type`. Default 'website'; für News/Detail-Seiten 'article'. */
  type?: 'website' | 'article' | 'book' | 'profile';
  /** Wenn true, wird `<meta name="robots" content="noindex,nofollow">` ausgespielt. */
  noindex?: boolean;
  /** Optionaler Canonical-Override. Default ist die aktuelle URL inkl. SITE_URL. */
  canonical?: string;
  /** Pro Seite zusätzliche schema.org-Knoten. */
  jsonLd?: JsonLd[];
  /** Article-Metadaten — nur wenn type='article'. */
  publishedTime?: string;
  modifiedTime?: string;
}

const {
  title,
  description,
  image,
  imageAlt,
  imageWidth,
  imageHeight,
  type = 'website',
  noindex = false,
  canonical,
  jsonLd = [],
  publishedTime,
  modifiedTime,
} = Astro.props as Props;

const fullTitle = title.includes(SITE_NAME)
  ? title
  : `${title} · ${SITE_NAME}`;

const canonicalUrl =
  canonical ?? new URL(Astro.url.pathname, SITE_URL).toString();

const ogImage = image ? absoluteUrl(image) : DEFAULT_OG_IMAGE;
const ogImageAlt = imageAlt ?? DEFAULT_OG_IMAGE_ALT;

// Maße nur ausspielen, wenn sie stimmen. Beim Default-Bild wissen wir sie,
// bei PB-Covern nicht (PocketBase speichert keine Bilddimensionen).
const ogImageWidth = image ? imageWidth : DEFAULT_OG_IMAGE_WIDTH;
const ogImageHeight = image ? imageHeight : DEFAULT_OG_IMAGE_HEIGHT;
---

<title>{fullTitle}</title>
{description && <meta name="description" content={description} />}
<link rel="canonical" href={canonicalUrl} />

{noindex
  ? <meta name="robots" content="noindex, nofollow" />
  : <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
}

<meta property="og:site_name" content={SITE_NAME} />
<meta property="og:title" content={fullTitle} />
{description && <meta property="og:description" content={description} />}
<meta property="og:type" content={type} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:locale" content={SITE_LOCALE} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:alt" content={ogImageAlt} />
{ogImageWidth && <meta property="og:image:width" content={String(ogImageWidth)} />}
{ogImageHeight && <meta property="og:image:height" content={String(ogImageHeight)} />}

{type === 'article' && publishedTime && (
  <meta property="article:published_time" content={publishedTime} />
)}
{type === 'article' && modifiedTime && (
  <meta property="article:modified_time" content={modifiedTime} />
)}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
{description && <meta name="twitter:description" content={description} />}
<meta name="twitter:image" content={ogImage} />
<meta name="twitter:image:alt" content={ogImageAlt} />

{jsonLd.map((node) => (
  <script type="application/ld+json" set:html={JSON.stringify(node)} />
))}
