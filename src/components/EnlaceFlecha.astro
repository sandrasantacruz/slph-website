---
/**
 * EnlaceFlecha — Querverweis zwischen Seiten als Pille mit Rand (wie
 * «Visitar tienda» auf /comprar). Sichtbarer als ein reiner Textlink, aber
 * ohne Füllung, damit gefüllte Buttons («Comprar libro») vorne bleiben.
 *
 *   <EnlaceFlecha href="/galeria#cuento">Ver la presentación del cuento</EnlaceFlecha>
 */
interface Props {
  href: string;
  /** Textfarbe: arena auf dunklem Grund (Default), azul auf hellen Karten */
  tono?: 'arena' | 'azul';
  class?: string;
}

const { href, tono = 'arena', class: className } = Astro.props;
---

<a
  href={href}
  class:list={[
    'group inline-flex items-center gap-2 rounded-full border px-5 py-2.5 font-display text-base tracking-[0.18em] uppercase transition',
    tono === 'arena'
      ? 'border-arena/60 text-arena hover:border-arena hover:bg-arena hover:text-azul'
      : 'border-azul/40 text-azul hover:border-azul hover:bg-azul hover:text-caparol',
    className,
  ]}
>
  <slot />
  <svg
    viewBox="0 0 24 24"
    class="h-4 w-4 transition-transform group-hover:translate-x-1"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M5 12h14M13 6l6 6-6 6"></path>
  </svg>
</a>
