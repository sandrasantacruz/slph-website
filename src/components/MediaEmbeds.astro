---
// Verdrahtet die Video-Embeds im Artikelkörper (Instagram, YouTube).
//
// Das Markup dazu kommt aus dem Loader (`resolveEmbeds` in
// `lib/pulpo-loader.ts`): ein `<figure data-embed>` mit dem Link darin. Ohne
// JavaScript bleibt genau dieser Link stehen, mit JavaScript wird daraus die
// Consent-Karte und nach Zustimmung der iframe.
//
// Gleiche Mechanik und derselbe `slph:consent-changed`-Kanal wie `MapEmbed`,
// aber je Anbieter ein eigener Schlüssel: wer Google Maps erlaubt, hat damit
// noch lange nicht Meta erlaubt.
//
// Die Consent-Karte bietet bewusst keinen "abrir en …"-Ausstieg zum Anbieter:
// das Video soll hier laufen, nicht drüben. Ohne JavaScript bleibt der Link
// aus dem Loader-Markup als einziger Weg zum Inhalt stehen.
---

<script>
  type Provider = {
    key: string;
    brand: string;
    /** Wer die Daten bekommt. Bei YouTube ist das nicht YouTube, sondern Google. */
    processor: string;
    title: string;
  };

  const PROVIDERS: Record<string, Provider> = {
    instagram: {
      key: 'slph:consent:instagram',
      brand: 'Instagram',
      processor: 'Meta',
      title: 'Publicación de Instagram',
    },
    youtube: {
      key: 'slph:consent:youtube',
      brand: 'YouTube',
      processor: 'Google',
      title: 'Vídeo de YouTube',
    },
  };

  function providerOf(fig: HTMLElement): Provider | null {
    return PROVIDERS[fig.dataset.embedProvider ?? ''] ?? null;
  }

  function granted(key: string): boolean {
    try {
      return localStorage.getItem(key) === 'granted';
    } catch {
      // Privates Fenster oder blockierte Site-Daten: dann eben kein Embed.
      return false;
    }
  }

  function activate(fig: HTMLElement) {
    const provider = providerOf(fig);
    const src = fig.dataset.embedSrc;
    if (!provider || !src) return;
    if (fig.querySelector('iframe')) return;

    const iframe = document.createElement('iframe');
    iframe.src = src;
    iframe.title = provider.title;
    iframe.loading = 'lazy';
    iframe.allowFullscreen = true;
    // Kein `scrolling="no"`: das sperrt im iframe auch die Wischgeste, mit der
    // sich ein Instagram-Karussell am Touchscreen weiterblättern lässt. Eine
    // Scrollleiste droht ohnehin nicht, die Höhe sitzt auf der gemeldeten.
    if (fig.dataset.embedProvider === 'instagram') {
      // Instagram legt über die Medienfläche einen Link auf den Beitrag: ein
      // Klick aufs Bild führt aus der Seite heraus in den Feed. Unterbinden
      // lässt sich das nur von außen, denn der iframe gehört uns nicht.
      //
      // `sandbox` entzieht dem Rahmen dafür genau zwei Rechte, die es ohne das
      // Attribut automatisch hätte: die Elternseite umzuleiten
      // (`allow-top-navigation`) und ein neues Fenster zu öffnen
      // (`allow-popups`). Skripte und der eigene Origin bleiben erlaubt, sonst
      // liefe das Karussell nicht mehr. Die Kombination ist hier unbedenklich:
      // gefährlich wäre sie nur bei Inhalten vom eigenen Origin, die sich die
      // Beschränkung dann selbst wieder abnehmen könnten.
      iframe.setAttribute('sandbox', 'allow-scripts allow-same-origin');
    }
    if (fig.dataset.embedProvider === 'youtube') {
      iframe.setAttribute(
        'allow',
        'accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share',
      );
      iframe.referrerPolicy = 'strict-origin-when-cross-origin';
    }
    fig.replaceChildren(iframe);
  }

  function renderCard(fig: HTMLElement) {
    const provider = providerOf(fig);
    if (!provider) return;

    fig.style.removeProperty('--ig-ratio');

    const card = document.createElement('div');
    card.className = 'embed-consent';

    const note = document.createElement('p');
    note.className = 'embed-consent-note';
    note.append('Para mostrar este vídeo cargamos contenido de ');
    const brand = document.createElement('strong');
    brand.textContent = provider.brand;
    note.append(brand);
    note.append(
      `. Al activarlo, ${provider.processor} podrá recibir datos sobre tu visita ` +
        'y podría instalar cookies en tu navegador.',
    );

    const actions = document.createElement('div');
    actions.className = 'embed-consent-actions';

    const btn = document.createElement('button');
    btn.type = 'button';
    btn.className = 'embed-consent-button';
    btn.textContent = 'Activar el vídeo';
    btn.addEventListener('click', () => {
      try {
        localStorage.setItem(provider.key, 'granted');
      } catch {
        // Kein Speicher, kein Merken: dieses eine Video trotzdem zeigen.
      }
      wire();
    });

    actions.append(btn);

    const hint = document.createElement('p');
    hint.className = 'embed-consent-hint';
    hint.append('Puedes cambiar tu decisión en ');
    const prefs = document.createElement('a');
    prefs.href = '/politica-de-cookies#preferencias';
    prefs.textContent = 'Preferencias de privacidad';
    hint.append(prefs, '.');

    card.append(note, actions, hint);
    fig.replaceChildren(card);
  }

  // Der Instagram-iframe meldet seine Gesamthöhe an die Elternseite
  // (`{"type":"MEASURE","details":{"height":883}}`). Die braucht der Zuschnitt
  // in `global.css`: Kopf- und Fußzeile sind fest, die Medienfläche dazwischen
  // hat das Seitenverhältnis des Beitrags und ist damit nur so zu erfahren.
  //
  // Zuordnung über `event.source`, nicht über "der erste iframe": auf einer
  // Seite können mehrere Beiträge stehen, und sie melden sich in beliebiger
  // Reihenfolge.
  // Feste Maße des Instagram-Embeds, unabhängig von der Breite nachgemessen.
  // Dieselben Werte stehen als `--ig-head` / `--ig-foot` in `global.css`.
  const HEAD = 54;
  const FOOT = 154;

  window.addEventListener('message', (ev: MessageEvent) => {
    if (ev.origin !== 'https://www.instagram.com') return;
    let payload: { type?: string; details?: { height?: number } };
    try {
      payload = JSON.parse(String(ev.data));
    } catch {
      return;
    }
    const height = payload?.details?.height;
    if (payload?.type !== 'MEASURE' || typeof height !== 'number' || height <= 0) return;

    for (const fig of document.querySelectorAll<HTMLElement>('.ig-embed')) {
      if (fig.querySelector('iframe')?.contentWindow !== ev.source) continue;

      // Gemerkt wird das Seitenverhältnis der Medienfläche, nicht ihre Höhe:
      // Instagram meldet nur einmal, beim Laden. Nach einer Drehung des Geräts
      // wäre eine gespeicherte Pixelhöhe falsch, das Verhältnis bleibt richtig.
      const width = fig.clientWidth;
      const media = height - HEAD - FOOT;
      if (width > 0 && media > 0) {
        fig.style.setProperty('--ig-ratio', String(media / width));
      }
      return;
    }
  });

  function wire() {
    document.querySelectorAll<HTMLElement>('[data-embed]').forEach((fig) => {
      const provider = providerOf(fig);
      if (!provider) return;
      if (granted(provider.key)) activate(fig);
      else renderCard(fig);
    });
  }

  wire();
  // Widerruf in den Präferenzen baut die Karte wieder auf.
  window.addEventListener('slph:consent-changed', wire);
</script>
