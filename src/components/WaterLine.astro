---
// Decorative water surface. Sits between the navbar and the page body
// so the eye reads the navbar as the boat above and the rest of the
// site as the ocean below. Hand-drawn-ish wave with arena highlights,
// celeste caustics shimmering down into the dark.
---

<div class="waterline" aria-hidden="true">
  <!-- Surface wave with crest highlight + light sparks -->
  <svg
    class="waterline__wave"
    viewBox="0 0 1440 90"
    preserveAspectRatio="none"
    role="presentation"
  >
    <defs>
      <linearGradient id="wl-body" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%"   stop-color="#64aad2" stop-opacity="0"/>
        <stop offset="35%"  stop-color="#64aad2" stop-opacity="0.32"/>
        <stop offset="100%" stop-color="#0b2056" stop-opacity="0"/>
      </linearGradient>
      <linearGradient id="wl-crest" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%"   stop-color="#fadeaa" stop-opacity="0"/>
        <stop offset="55%"  stop-color="#fadeaa" stop-opacity="0.95"/>
        <stop offset="100%" stop-color="#fadeaa" stop-opacity="0"/>
      </linearGradient>
      <filter id="wl-glow" x="-10%" y="-50%" width="120%" height="200%">
        <feGaussianBlur stdDeviation="1.4" />
      </filter>
    </defs>

    <!-- Back wave — softer, deeper -->
    <path
      class="wl-back"
      d="M0,50 C 180,66 320,32 500,50 C 680,68 820,36 1000,52 C 1180,68 1320,38 1440,50 L1440,90 L0,90 Z"
      fill="url(#wl-body)"
      opacity="0.55"
    />
    <!-- Front wave — sharper -->
    <path
      class="wl-front"
      d="M0,32 C 160,18 300,48 480,32 C 660,16 800,46 980,32 C 1160,18 1300,42 1440,32 L1440,90 L0,90 Z"
      fill="url(#wl-body)"
      opacity="0.85"
    />

    <!-- Crest highlight: soft glow underneath -->
    <path
      class="wl-crest wl-crest--glow"
      d="M0,24 C 160,10 300,40 480,24 C 660,8 800,38 980,24 C 1160,10 1300,36 1440,24"
      fill="none"
      stroke="#fadeaa"
      stroke-opacity="0.45"
      stroke-width="4"
      stroke-linecap="round"
      filter="url(#wl-glow)"
    />
    <!-- Crest highlight: crisp top line -->
    <path
      class="wl-crest"
      d="M0,24 C 160,10 300,40 480,24 C 660,8 800,38 980,24 C 1160,10 1300,36 1440,24"
      fill="none"
      stroke="url(#wl-crest)"
      stroke-width="1.4"
      stroke-linecap="round"
    />

    <!-- Light sparks dancing on the crest -->
    <g class="wl-sparks">
      <circle cx="140"  cy="22" r="1.4"/>
      <circle cx="380"  cy="28" r="1"/>
      <circle cx="640"  cy="20" r="1.3"/>
      <circle cx="920"  cy="28" r="1.1"/>
      <circle cx="1190" cy="22" r="1.5"/>
    </g>
  </svg>

  <!-- Caustic shimmer fading into the deep -->
  <svg
    class="waterline__caustics"
    viewBox="0 0 1440 160"
    preserveAspectRatio="none"
    role="presentation"
  >
    <defs>
      <linearGradient id="wl-caustic" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%"   stop-color="#fadeaa" stop-opacity="0.32"/>
        <stop offset="30%"  stop-color="#64aad2" stop-opacity="0.45"/>
        <stop offset="100%" stop-color="#64aad2" stop-opacity="0"/>
      </linearGradient>
    </defs>
    <g
      stroke="url(#wl-caustic)"
      stroke-width="1.1"
      stroke-linecap="round"
      fill="none"
    >
      <path d="M-40,14 Q 90,4 200,18 T 420,18 T 640,18 T 860,18 T 1080,18 T 1300,18 T 1480,18"/>
      <path d="M-40,46 Q 110,36 220,52 T 460,52 T 700,52 T 940,52 T 1180,52 T 1480,52"/>
      <path d="M-40,86 Q 120,72 240,92 T 480,92 T 720,92 T 960,92 T 1200,92 T 1480,92"/>
      <path d="M-40,128 Q 140,112 260,134 T 520,134 T 780,134 T 1040,134 T 1300,134 T 1480,134"/>
    </g>
  </svg>
</div>

<style>
  .waterline {
    position: absolute;
    inset: 5.5rem 0 auto 0;   /* sit just below the navbar logo area */
    height: 11rem;
    pointer-events: none;
    overflow: hidden;
    z-index: 5;
    isolation: isolate;
  }

  .waterline__wave {
    position: absolute;
    left: -2%;
    right: -2%;
    top: 0;
    width: 104%;
    height: 3.75rem;
    animation: wl-drift 16s ease-in-out infinite alternate;
  }

  .waterline__caustics {
    position: absolute;
    left: -2%;
    right: -2%;
    top: 3rem;                /* overlap slightly under the crest */
    width: 104%;
    height: 8rem;
    opacity: 0.55;
    mix-blend-mode: screen;
    animation: wl-drift-slow 26s ease-in-out infinite alternate;
  }

  .wl-back  { animation: wl-bob 9s ease-in-out infinite; }
  .wl-front { animation: wl-bob 7s ease-in-out -1.2s infinite; }
  .wl-crest { animation: wl-bob 6.5s ease-in-out -0.6s infinite; }

  .wl-sparks circle {
    fill: #fadeaa;
    transform-box: fill-box;
    transform-origin: center;
    animation: wl-spark 3.6s ease-in-out infinite;
  }
  .wl-sparks circle:nth-child(1) { animation-delay: 0s;   }
  .wl-sparks circle:nth-child(2) { animation-delay: 0.7s; }
  .wl-sparks circle:nth-child(3) { animation-delay: 1.4s; }
  .wl-sparks circle:nth-child(4) { animation-delay: 2.1s; }
  .wl-sparks circle:nth-child(5) { animation-delay: 2.8s; }

  @keyframes wl-drift {
    0%   { transform: translate3d(-0.6%, 0, 0); }
    100% { transform: translate3d(0.6%, 0, 0); }
  }
  @keyframes wl-drift-slow {
    0%   { transform: translate3d(-1.6%, 0, 0); }
    100% { transform: translate3d(1.6%, 0, 0); }
  }
  @keyframes wl-bob {
    0%, 100% { transform: translateY(0); }
    50%      { transform: translateY(-1.5px); }
  }
  @keyframes wl-spark {
    0%, 100% { opacity: 0.2; transform: scale(0.55); }
    50%      { opacity: 1;   transform: scale(1.35); }
  }

  @media (prefers-reduced-motion: reduce) {
    .waterline__wave,
    .waterline__caustics,
    .wl-back, .wl-front, .wl-crest,
    .wl-sparks circle {
      animation: none !important;
    }
  }
</style>
