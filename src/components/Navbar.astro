---
const cuentoPaths = ['/sobre-el-cuento', '/lee-un-fragmento', '/cuadernillo', '/autor', '/ilustrador', '/realidad-aumentada'];
const programaPaths = ['/programa', '/galeria', '/repercusion'];

type NavLink = {
  href: string;
  label: string;
  match?: string[];
  /** Unterpunkte: Desktop als Dropdown (Hover/Fokus), mobil eingerückt darunter. */
  children?: { href: string; label: string }[];
};

const links: NavLink[] = [
  { href: '/', label: 'Inicio' },
  { href: '/sobre-el-cuento', label: 'El cuento', match: cuentoPaths },
  {
    href: '/programa',
    label: 'Programa',
    match: programaPaths,
    // Galería und Repercusión hängen hier statt als eigene Menüpunkte: auf dem
    // Tablet passt die Leiste sonst nicht mehr in eine Zeile.
    children: [
      { href: '/programa', label: 'El programa' },
      { href: '/galeria', label: 'Galería' },
      { href: '/repercusion', label: 'Repercusión' },
    ],
  },
  { href: '/noticias', label: 'Noticias' },
  { href: '/colabora', label: 'Colabora' },
  { href: '/contacto', label: 'Contacto' },
];

const currentPath = Astro.url.pathname;
---

<header class="relative">
  <div
    class="pointer-events-none absolute inset-x-0 top-0 h-40 backdrop-blur-md [mask-image:linear-gradient(to_bottom,black_45%,transparent)] [-webkit-mask-image:linear-gradient(to_bottom,black_45%,transparent)]"
    aria-hidden="true"
  ></div>
  <div
    class="pointer-events-none absolute inset-x-0 top-0 h-40 bg-gradient-to-b from-azul/85 via-azul/45 to-transparent"
    aria-hidden="true"
  ></div>

  <div class="relative mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-2">
    <a href="/" class="flex items-center gap-3" aria-label="Si los peces hablaran — Inicio">
      <img src="/assets/logo.png" alt="Si los peces hablaran" width="2072" height="1492" class="h-20 w-auto" />
    </a>

    <nav class="hidden items-center gap-4 md:flex lg:gap-6" aria-label="Principal">
      {
        links.map(({ href, label, match, children }) => {
          const active =
            href === '/'
              ? currentPath === '/'
              : match
                ? match.some((p) => currentPath.startsWith(p))
                : currentPath.startsWith(href);
          const linkClass = [
            'text-base whitespace-nowrap text-caparol/90 transition-colors hover:text-caparol',
            active && 'text-caparol underline underline-offset-4 decoration-arena',
          ];
          if (!children) {
            return <a href={href} class:list={linkClass}>{label}</a>;
          }
          return (
            <div class="group relative">
              <a href={href} class:list={[linkClass, 'inline-flex items-center gap-1']} aria-haspopup="true">
                {label}
                <svg viewBox="0 0 24 24" class="h-3 w-3 opacity-70 transition-transform group-hover:rotate-180 group-focus-within:rotate-180" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
              </a>
              <!-- pt-3 überbrückt die Lücke, damit das Menü beim Hinüberfahren offen bleibt -->
              <div class="invisible absolute top-full left-1/2 z-50 -translate-x-1/2 pt-3 opacity-0 transition group-focus-within:visible group-focus-within:opacity-100 group-hover:visible group-hover:opacity-100">
                <ul class="min-w-44 rounded-xl border border-caparol/15 bg-azul/95 p-2 shadow-xl ring-1 ring-caparol/10 backdrop-blur">
                  {children.map((c) => (
                    <li>
                      <a
                        href={c.href}
                        class:list={[
                          'block rounded-lg px-4 py-2 text-base whitespace-nowrap transition hover:bg-caparol/10 hover:text-arena',
                          currentPath.startsWith(c.href) ? 'text-arena' : 'text-caparol/90',
                        ]}
                      >
                        {c.label}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          );
        })
      }
    </nav>

    <div class="flex items-center gap-2">
      <a
        href="/comprar"
        class="rounded-lg bg-arena px-4 py-2 font-display text-lg text-negro transition hover:brightness-95 md:px-5 md:text-2xl"
      >
        Comprar libro
      </a>

      <button
        type="button"
        class="md:hidden rounded p-2 text-caparol"
        aria-label="Abrir menú"
        aria-controls="mobile-nav"
        aria-expanded="false"
        data-nav-toggle
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
      </button>
    </div>
  </div>

  <div
    id="mobile-nav"
    class="fixed inset-0 z-50 hidden bg-azul md:hidden"
    role="dialog"
    aria-modal="true"
    aria-label="Menú principal"
    data-nav-mobile
  >
    <div class="flex items-center justify-between border-b border-white/10 px-4 py-3">
      <a href="/" class="flex items-center gap-3" aria-label="Si los peces hablaran — Inicio">
        <img src="/assets/logo.png" alt="Si los peces hablaran" width="2072" height="1492" class="h-20 w-auto" />
      </a>
      <button
        type="button"
        class="rounded p-2 text-caparol"
        aria-label="Cerrar menú"
        data-nav-close
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="6" y1="6" x2="18" y2="18"/><line x1="6" y1="18" x2="18" y2="6"/></svg>
      </button>
    </div>

    <nav class="flex flex-col items-center gap-6 px-6 pt-16" aria-label="Principal móvil">
      {
        links.map(({ href, label, children }) => (
          <div class="flex flex-col items-center gap-3">
            <a href={href} class="font-display text-4xl text-caparol hover:text-arena">
              {label}
            </a>
            {children && (
              <ul class="flex flex-col items-center gap-2">
                {children.slice(1).map((c) => (
                  <li>
                    <a href={c.href} class="font-display text-2xl text-celeste hover:text-arena">{c.label}</a>
                  </li>
                ))}
              </ul>
            )}
          </div>
        ))
      }
      <a
        href="/comprar"
        class="mt-6 rounded-lg bg-arena px-6 py-3 font-display text-3xl text-negro transition hover:brightness-95"
      >
        Comprar libro
      </a>
    </nav>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');
  const close = document.querySelector<HTMLButtonElement>('[data-nav-close]');
  const mobile = document.querySelector<HTMLElement>('[data-nav-mobile]');

  const setOpen = (open: boolean) => {
    if (!mobile || !toggle) return;
    mobile.classList.toggle('hidden', !open);
    toggle.setAttribute('aria-expanded', String(open));
    document.body.classList.toggle('overflow-hidden', open);
  };

  toggle?.addEventListener('click', () => setOpen(mobile?.classList.contains('hidden') ?? false));
  close?.addEventListener('click', () => setOpen(false));
  mobile?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') setOpen(false);
  });
</script>
