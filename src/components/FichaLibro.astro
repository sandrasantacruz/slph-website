---
/**
 * FichaLibro — Eckdaten der aktuellen Ausgabe des Buchs.
 * Genutzt auf /sobre-el-cuento und /comprar; bei einer neuen Auflage nur
 * hier (und in `bookSchema()` in lib/seo.ts) anpassen.
 *
 *   <FichaLibro />                  // mit Verkaufs-Hinweis
 *   <FichaLibro venta={false} />    // ohne, z.B. auf /comprar
 */
import { Icon } from 'astro-icon/components';

interface Props {
  /** Zeile «A la venta en Entintadas Editorial y librerías de Gran Canaria» */
  venta?: boolean;
  class?: string;
}

const { venta = true, class: className } = Astro.props;

// `arriba` / `abajo`: kleine Zeile über bzw. unter dem Hauptwert.
const datos: { icon: string; valor: string; arriba?: string; abajo?: string; href?: string }[] = [
  // Zwei Reihen à drei, spaltenweise gedacht: Spalte 1 das Buch selbst
  // (Seiten, Format), Spalte 2 App und Papier, Spalte 3 die Menschen dahinter
  // (Ilustrador, Save the Children). Wichtigeres in der oberen Reihe.
  { icon: 'game-icons:open-book', valor: '146 páginas', abajo: 'a todo color' },
  { icon: 'game-icons:vibrating-smartphone', arriba: 'Realidad aumentada', valor: 'App AR-SLPH', abajo: 'para las tres ediciones', href: '/realidad-aumentada' },
  { icon: 'game-icons:paint-brush', arriba: 'Ilustraciones de', valor: 'Pablo Tribiño' },
  { icon: 'game-icons:resize', valor: '210 × 210 mm' },
  { icon: 'game-icons:pine-tree', valor: 'Papel FSC' },
  { icon: 'game-icons:shaking-hands', arriba: 'Colabora con', valor: 'Save the Children' },
];
---

<div
  class:list={[
    'rounded-2xl border border-celeste/25 bg-azul-deep/40 p-6 ring-1 ring-caparol/10 backdrop-blur-sm sm:p-7',
    className,
  ]}
>
  <p class="font-hand text-2xl text-arena sm:text-3xl">
    Ya va por su 3.ª edición, ahora en tapa blanda
  </p>
  <ul class="mt-4 grid grid-cols-2 gap-x-6 gap-y-4 sm:grid-cols-3 sm:gap-x-8">
    {datos.map((d) => (
      <li class="flex items-center gap-3">
        <Icon name={d.icon} class="h-6 w-6 shrink-0 text-celeste" aria-hidden="true" />
        <span class="leading-tight">
          {d.arriba && <span class="block text-sm text-caparol/70">{d.arriba}</span>}
          <strong class:list={['block font-display text-lg', d.href ? 'text-arena' : 'text-caparol']}>
            {/* Londrina Solid hat kein «×» — das Zeichen aus der Body-Schrift nehmen */}
            {d.href ? (
              <a href={d.href} class="underline decoration-arena/40 underline-offset-4 hover:decoration-arena">{d.valor}</a>
            ) : (
              d.valor.split('×').map((parte, i) => (i ? <><span class="font-sans">×</span>{parte}</> : parte))
            )}
          </strong>
          {d.abajo && <span class="block text-sm text-caparol/70">{d.abajo}</span>}
        </span>
      </li>
    ))}
  </ul>
  {venta && (
    <p class="mt-5 text-base text-caparol/75">
      A la venta en
      <a href="/comprar" class="text-arena underline decoration-arena/40 underline-offset-4 hover:decoration-arena">Entintadas Editorial y librerías de Gran Canaria</a>.
    </p>
  )}
</div>
