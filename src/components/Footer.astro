---
import { Icon } from 'astro-icon/components';
import { socials } from '../lib/social';
import { APP_LINKS } from '../lib/app-links';

const sections = [
  {
    title: 'Sobre el cuento',
    links: [
      { href: '/sobre-el-cuento', label: 'Sobre el cuento' },
      { href: '/lee-un-fragmento', label: 'Lee el capítulo I' },
      { href: '/realidad-aumentada', label: 'Realidad aumentada' },
      { href: '/autor', label: 'La autora' },
      { href: '/ilustrador', label: 'El ilustrador' },
      { href: '/cuadernillo', label: 'Cuadernillo' },
      { href: '/comprar', label: 'Dónde comprar' },
    ],
  },
  {
    title: 'Menú',
    links: [
      { href: '/', label: 'Inicio' },
      { href: '/programa', label: 'Programa' },
      { href: '/galeria', label: 'Galería' },
      { href: '/repercusion', label: 'Repercusión' },
      { href: '/noticias', label: 'Noticias' },
      { href: '/colabora', label: 'Colabora' },
      { href: '/contacto', label: 'Contacto' },
    ],
  },
];

const legal = [
  { href: '/aviso-legal', label: 'Aviso legal' },
  { href: '/politica-de-privacidad', label: 'Política de privacidad' },
  { href: '/politica-de-cookies', label: 'Política de cookies' },
];

const stores = [
  { href: APP_LINKS.android, icon: 'simple-icons:googleplay', kicker: 'disponible en', label: 'Google Play' },
  { href: APP_LINKS.iosBeta, icon: 'simple-icons:apple', kicker: 'con TestFlight', label: 'iPhone y iPad' },
];

const year = new Date().getFullYear();
---

<footer class="relative isolate mt-16 min-h-[36rem] overflow-hidden sm:mt-32">
  <div
    class="absolute inset-0 -z-10 bg-[url('/assets/background-end-960.webp')] md:bg-[url('/assets/background-end.webp')] bg-[position:50%_100%] bg-cover bg-no-repeat [mask-image:linear-gradient(to_bottom,transparent_0%,black_40%)] [-webkit-mask-image:linear-gradient(to_bottom,transparent_0%,black_40%)]"
    aria-hidden="true"
  ></div>

  <div class="mx-auto max-w-6xl px-4 pt-36 pb-12 sm:pt-48">
    <!-- Todas las pantallas (también el ordenador, 26 nov 2026): el buscador va arriba, en su propia línea, y las tres
         columnas empiezan a la misma altura (idea de Sandra, 26 nov 2026) -->
        <form action="/buscar" method="get" role="search" class="mb-12 flex max-w-sm items-center gap-2 rounded-full border border-caparol/40 bg-azul py-1.5 pr-1.5 pl-5 shadow-lg transition focus-within:border-arena">
          <label for="footer-q-ipad" class="sr-only">Buscar en la web</label>
          <input
            id="footer-q-ipad"
            name="q"
            type="search"
            placeholder="¿Qué quieres encontrar?"
            class="min-w-0 flex-1 bg-transparent text-base text-caparol placeholder:text-caparol/85 focus:outline-none"
          />
          <button type="submit" aria-label="Buscar" class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-arena text-azul transition hover:brightness-95">
            <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m15.5 15.5 5 5"/></svg>
          </button>
        </form>

    <div class="grid gap-10 md:grid-cols-3">
      {
        sections.map(({ title, links }) => (
          <nav aria-label={title} class="flex flex-col gap-3">
            <h2 class="font-display text-2xl text-caparol">{title}</h2>
            <ul class="flex flex-col gap-2">
              {links.map(({ href, label }) => (
                <li>
                  <a href={href} class="text-caparol/90 hover:text-arena">
                    {label}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }

      <div class="flex flex-col gap-4 md:gap-3">
        <!-- Buscador: envía a /buscar?q=…, que filtra al cargar -->
        <h2 class="font-display text-2xl text-caparol">¡Síguenos!</h2>
        <ul class="flex gap-3">
          {
            socials.map(({ label, href, icon }) => (
              <li>
                <a
                  href={href}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={label}
                  class="flex h-14 w-14 items-center justify-center rounded-full bg-caparol/10 md:h-12 md:w-12 text-caparol transition hover:bg-arena hover:text-negro"
                >
                  <Icon name={icon} class="h-7 w-7" />
                </a>
              </li>
            ))
          }
        </ul>

        <h2 class="mt-6 font-display text-2xl text-caparol md:mt-2">Descarga la app</h2>
        <!-- En el iPad (vertical y horizontal) la columna es estrecha y los botones van uno debajo
             del otro: ahí ocupan el mismo ancho que el buscador, para que queden alineados -->
        <ul class="flex flex-wrap gap-3 md:max-w-sm md:flex-col">
          {
            stores.map(({ href, icon, kicker, label }) => (
              <li>
                <a
                  href={href}
                  target="_blank"
                  rel="noopener"
                  class="flex items-center gap-2.5 rounded-xl bg-caparol/10 px-4 py-2 text-caparol transition hover:bg-arena hover:text-negro md:w-full"
                >
                  <Icon name={icon} class="h-6 w-6" aria-hidden="true" />
                  <span class="flex flex-col leading-tight">
                    <span class="text-[0.65rem] tracking-wider uppercase opacity-70">{kicker}</span>
                    <span class="font-display text-base">{label}</span>
                  </span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <div class="mt-12 flex flex-col gap-4 border-t border-white/10 pt-6 pr-16 text-sm text-caparol/70 md:flex-row md:items-center md:justify-between md:pr-20">
      <p>© Si los peces hablaran, 2016 - {year}.</p>
      <ul class="flex flex-wrap gap-x-4 gap-y-2">
        {
          legal.map(({ href, label }) => (
            <li>
              <a href={href} class="hover:text-caparol">
                {label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</footer>
