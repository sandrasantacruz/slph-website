---
import SubNav from './SubNav.astro';

interface Props {
  current: 'fragmento' | 'cuadernillo' | 'autor' | 'ilustrador' | 'realidad-aumentada';
}

const items = [
  { id: 'fragmento', href: '/lee-un-fragmento', label: 'Lee un fragmento' },
  { id: 'cuadernillo', href: '/cuadernillo', label: 'Cuadernillo' },
  { id: 'autor', href: '/autor', label: 'La autora' },
  { id: 'ilustrador', href: '/ilustrador', label: 'Ilustrador' },
  { id: 'realidad-aumentada', href: '/realidad-aumentada', label: 'Realidad aumentada' },
] as const;
---

<SubNav hub={{ href: '/sobre-el-cuento', label: 'Sobre el cuento' }} items={items} current={Astro.props.current} />
