---
const bubbles = Array.from({ length: 10 }, (_, i) => i + 1);
---

<!-- Nuestra burbuja (Material SLPH, “burbujas 3”), en lugar de esferas hechas con código -->
<div class="bubbles" aria-hidden="true">
  {bubbles.map((n) => <img class={`bubble bubble-${n}`} src="/assets/burbuja.webp" alt="" width="240" height="237" decoding="async" />)}
</div>

<style is:global>
  .bubbles {
    position: fixed;
    inset: 0;
    z-index: -1;
    opacity: 0.35;
    pointer-events: none;
    overflow: hidden;
  }
  /* Cada burbuja con su propio ritmo y un retraso distinto: antes había parejas
     con el mismo tamaño y la misma velocidad, que subían juntas y parecían duplicadas. */
  .bubble {
    position: absolute;
    width: 200px;
    height: auto;
  }

  .bubble-1  { left: -5%; top: 5%; transform: scale(0.6); animation: bubble-up 25s linear -3s infinite, bubble-side 2s ease-in-out infinite alternate; }
  .bubble-2  { left: 5%; top: 80%; transform: scale(0.4); animation: bubble-up 19s linear -11s infinite, bubble-side 4s ease-in-out infinite alternate; }
  .bubble-3  { left: 10%; top: 40%; transform: scale(0.7); animation: bubble-up 28s linear -17s infinite, bubble-side 2.5s ease-in-out infinite alternate; }
  .bubble-4  { left: 20%; top: 0; transform: scale(0.3); animation: bubble-up 23s linear -6s infinite, bubble-side 3s ease-in-out infinite alternate; }
  .bubble-5  { left: 30%; top: 50%; transform: scale(0.5); animation: bubble-up 31s linear -21s infinite, bubble-side 3.5s ease-in-out infinite alternate; }
  .bubble-6  { left: 50%; top: 0; transform: scale(0.8); animation: bubble-up 21s linear -9s infinite, bubble-side 2s ease-in-out infinite alternate; }
  .bubble-7  { left: 65%; top: 70%; transform: scale(0.35); animation: bubble-up 24s linear -2s infinite, bubble-side 2.8s ease-in-out infinite alternate; }
  .bubble-8  { left: 80%; top: 10%; transform: scale(0.25); animation: bubble-up 27s linear -14s infinite, bubble-side 3.6s ease-in-out infinite alternate; }
  .bubble-9  { left: 90%; top: 50%; transform: scale(0.6); animation: bubble-up 33s linear -25s infinite, bubble-side 4.2s ease-in-out infinite alternate; }
  .bubble-10 { left: 78%; top: 80%; transform: scale(0.3); animation: bubble-up 17s linear -8s infinite, bubble-side 2.2s ease-in-out infinite alternate; }

  @keyframes bubble-up {
    0%   { margin-top: 1000px; }
    100% { margin-top: -100%; }
  }
  @keyframes bubble-side {
    0%   { margin-left: 0; }
    100% { margin-left: 50px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .bubble { animation: none !important; }
  }
</style>
