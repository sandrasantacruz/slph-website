---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import Bubbles from '../components/Bubbles.astro';
import WaterLine from '../components/WaterLine.astro';
import BackToTop from '../components/BackToTop.astro';
import Seo from '../components/Seo.astro';
import {
  SITE_NAME,
  SITE_LANG,
  organizationSchema,
  websiteSchema,
  siteNavigationSchema,
  type JsonLd,
} from '../lib/seo';

interface Props {
  title?: string;
  description?: string;
  hideWaterLine?: boolean;
  image?: string;
  imageAlt?: string;
  imageWidth?: number;
  imageHeight?: number;
  type?: 'website' | 'article' | 'book' | 'profile';
  noindex?: boolean;
  canonical?: string;
  jsonLd?: JsonLd[];
  publishedTime?: string;
  modifiedTime?: string;
}

const {
  title,
  description,
  hideWaterLine = false,
  image,
  imageAlt,
  imageWidth,
  imageHeight,
  type = 'website',
  noindex = false,
  canonical,
  jsonLd = [],
  publishedTime,
  modifiedTime,
} = Astro.props;

// Organization und WebSite werden auf jeder Seite mitgeliefert. So findet
// jeder Crawler/LLM unabhängig vom Einstiegspunkt das Marken-Stammdaten-Paar.
const allJsonLd: JsonLd[] = [
  organizationSchema(),
  websiteSchema(),
  siteNavigationSchema(),
  ...jsonLd,
];

const seoTitle = title ?? SITE_NAME;
---

<html lang={SITE_LANG}>
  <head>
    <meta charset="utf-8" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="viewport" content="width=device-width" />
    <Seo
      title={seoTitle}
      description={description}
      image={image}
      imageAlt={imageAlt}
      imageWidth={imageWidth}
      imageHeight={imageHeight}
      type={type}
      noindex={noindex}
      canonical={canonical}
      jsonLd={allJsonLd}
      publishedTime={publishedTime}
      modifiedTime={modifiedTime}
    />
    {
      import.meta.env.PROD && (
        <script
          is:inline
          defer
          src="https://analytics.pulpo.cloud/script.js"
          data-website-id="5f08da51-f10e-4bf9-bacd-43e78bc882e5"
        />
      )
    }
  </head>
  <body class="relative flex min-h-screen flex-col">
    <Bubbles />
    <Navbar />
    {!hideWaterLine && <WaterLine />}
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
    <BackToTop />
  </body>
</html>
