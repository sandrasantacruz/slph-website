---
import "../styles/global.css";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import Bubbles from "../components/Bubbles.astro";
import WaterLine from "../components/WaterLine.astro";
import BackToTop from "../components/BackToTop.astro";
import Seo from "../components/Seo.astro";
import {
  SITE_NAME,
  SITE_LANG,
  organizationSchema,
  websiteSchema,
  siteNavigationSchema,
  type JsonLd,
} from "../lib/seo";

interface Props {
  title?: string;
  description?: string;
  hideWaterLine?: boolean;
  image?: string;
  imageAlt?: string;
  imageWidth?: number;
  imageHeight?: number;
  type?: "website" | "article" | "book" | "profile";
  noindex?: boolean;
  canonical?: string;
  jsonLd?: JsonLd[];
  publishedTime?: string;
  modifiedTime?: string;
}

const {
  title,
  description,
  hideWaterLine = false,
  image,
  imageAlt,
  imageWidth,
  imageHeight,
  type = "website",
  noindex = false,
  canonical,
  jsonLd = [],
  publishedTime,
  modifiedTime,
} = Astro.props;

// Organization und WebSite werden auf jeder Seite mitgeliefert. So findet
// jeder Crawler/LLM unabhängig vom Einstiegspunkt das Marken-Stammdaten-Paar.
const allJsonLd: JsonLd[] = [
  organizationSchema(),
  websiteSchema(),
  siteNavigationSchema(),
  ...jsonLd,
];

const seoTitle = title ?? SITE_NAME;
---

<html lang={SITE_LANG}>
  <head>
    <meta charset="utf-8" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="viewport" content="width=device-width" />
    <Seo
      title={seoTitle}
      description={description}
      image={image}
      imageAlt={imageAlt}
      imageWidth={imageWidth}
      imageHeight={imageHeight}
      type={type}
      noindex={noindex}
      canonical={canonical}
      jsonLd={allJsonLd}
      publishedTime={publishedTime}
      modifiedTime={modifiedTime}
    />
    {
      import.meta.env.PROD && (
        <script
          is:inline
          async
          src="https://analytics.pulpo.cloud/script.js"
          data-website-id="5f08da51-f10e-4bf9-bacd-43e78bc882e5"
        />
      )
    }
  </head>
  <body class="relative flex min-h-screen flex-col">
    <Bubbles />
    <Navbar />
    {!hideWaterLine && <WaterLine />}
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
    <BackToTop />
      <script>
      // Ventanas (vídeos, galería): al abrir una se añade un paso al historial,
      // así el botón “atrás” del móvil la cierra en lugar de salir de la página.
      type ConHistorial = HTMLDialogElement & { porAtras?: boolean };
      const abrirOriginal = HTMLDialogElement.prototype.showModal;
      HTMLDialogElement.prototype.showModal = function (this: ConHistorial) {
        abrirOriginal.call(this);
        if (!this.dataset.historial) {
          this.dataset.historial = '1';
          this.addEventListener('close', () => {
            if (this.porAtras) { this.porAtras = false; return; }
            if (history.state?.ventana) history.back();
          });
        }
        history.pushState({ ventana: true }, '');
      };
      window.addEventListener('popstate', () => {
        document.querySelectorAll<ConHistorial>('dialog[open]').forEach((d) => {
          d.porAtras = true;
          d.close();
        });
      });

      // Un solo vídeo con sonido a la vez: al reproducir uno, se pausan los demás.
      // Los vídeos de fondo (silenciados, en bucle) no se tocan.
      document.addEventListener(
        'play',
        (e) => {
          const actual = e.target;
          if (!(actual instanceof HTMLMediaElement) || actual.muted) return;
          document.querySelectorAll<HTMLMediaElement>('video, audio').forEach((m) => {
            if (m !== actual && !m.muted && !m.paused) m.pause();
          });
        },
        true,
      );

      // Sin “viudas” (28 nov 2026): une la última palabra de cada párrafo con la anterior
      // mediante un espacio que no se parte, si las dos son cortas. Completa a
      // `text-wrap: pretty` (global.css) y funciona también donde no se admite.
      document.querySelectorAll<HTMLElement>('main p, main li, main figcaption, main blockquote, main dd').forEach((el) => {
        const textos: Text[] = [];
        const w = document.createTreeWalker(el, NodeFilter.SHOW_TEXT);
        for (let n = w.nextNode(); n; n = w.nextNode()) if (n.textContent?.trim()) textos.push(n as Text);
        const ultimo = textos.at(-1);
        if (!ultimo || textos.length === 0) return;
        const t = ultimo.textContent ?? '';
        const m = t.match(/(\S+)\s+(\S+)\s*$/);
        if (!m || m[1].length + m[2].length > 20) return;
        const i = t.lastIndexOf(m[0]) + m[1].length;
        ultimo.textContent = t.slice(0, i) + '\u00A0' + t.slice(i).replace(/^\s+/, '');
      });
    </script>
</body>
</html>
