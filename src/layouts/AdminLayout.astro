---
import '../styles/global.css';

interface Props {
  title: string;
}

const { title } = Astro.props;
const user = Astro.locals.user;
const currentPath = Astro.url.pathname;
const navLinks = [
  { href: '/admin/novedades', label: 'Novedades' },
  { href: '/admin/ajustes', label: 'Ajustes' },
];
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex" />
    <title>{title} · Administración</title>
  </head>
  <body class="min-h-screen bg-neutral-50 text-neutral-900 antialiased">
    {
      user && (
        <header class="border-b border-neutral-200 bg-white">
          <div class="mx-auto flex max-w-5xl items-center justify-between px-4 py-3">
            <div class="flex items-center gap-6">
              <a href="/admin/novedades" class="font-semibold">Administración</a>
              <nav class="flex items-center gap-4 text-sm">
                {navLinks.map(({ href, label }) => {
                  const active = currentPath.startsWith(href);
                  return (
                    <a
                      href={href}
                      class:list={[
                        'transition-colors',
                        active ? 'font-medium text-neutral-900' : 'text-neutral-500 hover:text-neutral-900',
                      ]}
                    >
                      {label}
                    </a>
                  );
                })}
              </nav>
            </div>
            <div class="flex items-center gap-4 text-sm">
              <span class="text-neutral-500">{user.email}</span>
              <form method="post" action="/admin/logout">
                <button type="submit" class="rounded border border-neutral-300 px-3 py-1 hover:bg-neutral-100">
                  Cerrar sesión
                </button>
              </form>
            </div>
          </div>
        </header>
      )
    }
    <main class="mx-auto max-w-5xl px-4 py-8">
      <slot />
    </main>
  </body>
</html>
