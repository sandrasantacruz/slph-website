---
export const prerender = false;

import AdminLayout from '../../../../layouts/AdminLayout.astro';
import BlogEditor from '../../../../components/BlogEditor';
import { PB_PUBLIC_URL } from '../../../../lib/pb';

const { id } = Astro.params;
if (!id) return Astro.redirect('/admin/news');

let post;
try {
  post = await Astro.locals.pb.collection('news').getOne(id);
} catch {
  return Astro.redirect('/admin/news');
}
---

<AdminLayout title={post.title || 'Nueva noticia'}>
  <div class="mb-4 flex items-center gap-4">
    <a href="/admin/news" class="text-sm text-neutral-500 hover:text-neutral-900">← Todas las noticias</a>
  </div>

  <BlogEditor
    client:only="react"
    postId={post.id}
    collection="news"
    collectionId={post.collectionId}
    pbUrl={PB_PUBLIC_URL}
    initial={{
      title: post.title ?? '',
      slug: post.slug ?? '',
      excerpt: post.excerpt ?? '',
      status: post.status ?? 'draft',
      published_at: post.published_at ?? '',
      content: post.content ?? null,
      cover: Array.isArray(post.cover) ? post.cover : post.cover ? [post.cover] : [],
      images: Array.isArray(post.images) ? post.images : [],
    }}
  >
    <p class="text-neutral-500">Cargando editor …</p>
  </BlogEditor>
</AdminLayout>
