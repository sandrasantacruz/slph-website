---
export const prerender = false;

import AdminLayout from '../../../../layouts/AdminLayout.astro';
import BlogEditor from '../../../../components/BlogEditor';
import { PB_PUBLIC_URL } from '../../../../lib/pb';

const { id } = Astro.params;
if (!id) return Astro.redirect('/admin/events');

let event;
try {
  event = await Astro.locals.pb.collection('events').getOne(id);
} catch {
  return Astro.redirect('/admin/events');
}
---

<AdminLayout title={event.title || 'Nuevo evento'}>
  <div class="mb-4 flex items-center gap-4">
    <a href="/admin/events" class="text-sm text-neutral-500 hover:text-neutral-900">← Todos los eventos</a>
  </div>

  <BlogEditor
    client:only="react"
    postId={event.id}
    collection="events"
    collectionId={event.collectionId}
    pbUrl={PB_PUBLIC_URL}
    initial={{
      title: event.title ?? '',
      slug: event.slug ?? '',
      excerpt: event.excerpt ?? '',
      status: event.status ?? 'draft',
      published_at: event.published_at ?? '',
      content: event.content ?? null,
      cover: Array.isArray(event.cover) ? event.cover : event.cover ? [event.cover] : [],
      images: Array.isArray(event.images) ? event.images : [],
      event_date: event.event_date ?? '',
      event_end: event.event_end ?? '',
      location: event.location ?? '',
      address_url: event.address_url ?? '',
    }}
  >
    <p class="text-neutral-500">Cargando editor …</p>
  </BlogEditor>
</AdminLayout>
