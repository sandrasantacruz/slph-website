---
export const prerender = false;

import AdminLayout from '../../../../layouts/AdminLayout.astro';
import BlogEditor from '../../../../components/BlogEditor';
import { PB_PUBLIC_URL } from '../../../../lib/pb';

const { id } = Astro.params;
if (!id) return Astro.redirect('/admin/novedades');

let post;
try {
  post = await Astro.locals.pb.collection('posts').getOne(id);
} catch {
  return Astro.redirect('/admin/novedades');
}

const typ: 'event' | 'news' = post.typ === 'event' ? 'event' : 'news';
---

<AdminLayout title={post.title || 'Nueva entrada'}>
  <div class="mb-4 flex items-center gap-4">
    <a href="/admin/novedades" class="text-sm text-neutral-500 hover:text-neutral-900">← Todas las novedades</a>
  </div>

  <BlogEditor
    client:only="react"
    postId={post.id}
    typ={typ}
    collectionId={post.collectionId}
    pbUrl={PB_PUBLIC_URL}
    initial={{
      title: post.title ?? '',
      slug: post.slug ?? '',
      excerpt: post.excerpt ?? '',
      status: post.status ?? 'draft',
      published_at: post.published_at ?? '',
      content: post.content ?? null,
      cover: Array.isArray(post.cover) ? post.cover : post.cover ? [post.cover] : [],
      images: Array.isArray(post.images) ? post.images : [],
      event_date: post.event_date ?? '',
      event_end: post.event_end ?? '',
      location: post.location ?? '',
      address_url: post.address_url ?? '',
    }}
  >
    <p class="text-neutral-500">Cargando editor …</p>
  </BlogEditor>
</AdminLayout>
