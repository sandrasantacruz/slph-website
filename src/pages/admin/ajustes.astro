---
export const prerender = false;

import AdminLayout from '../../layouts/AdminLayout.astro';
import type { RecordModel } from 'pocketbase';

const pb = Astro.locals.pb;

let rec: RecordModel | null = null;
let loadError: string | null = null;
let saved = false;
let saveError: string | null = null;

try {
  rec = await pb.collection('settings').getFirstListItem('');
} catch {
  loadError =
    'No se encontró el registro de ajustes. Asegúrate de que la migración de PocketBase se haya ejecutado.';
}

if (Astro.request.method === 'POST' && rec) {
  const form = await Astro.request.formData();
  const data = {
    whatsapp: String(form.get('whatsapp') ?? '').trim(),
    phone: String(form.get('phone') ?? '').trim(),
    email: String(form.get('email') ?? '').trim(),
  };
  try {
    rec = await pb.collection('settings').update(rec.id, data);
    saved = true;
  } catch (err) {
    saveError = err instanceof Error ? err.message : 'No se pudieron guardar los ajustes.';
  }
}

const values = {
  whatsapp: (rec?.whatsapp as string | undefined) ?? '',
  phone: (rec?.phone as string | undefined) ?? '',
  email: (rec?.email as string | undefined) ?? '',
};
---

<AdminLayout title="Ajustes">
  <div class="mb-6">
    <h1 class="text-2xl font-semibold">Ajustes de contacto</h1>
    <p class="mt-1 text-sm text-neutral-500">
      Estos datos aparecen en la página pública de contacto. Deja un campo vacío
      para ocultar el CTA correspondiente.
    </p>
  </div>

  {loadError && (
    <p class="mb-4 rounded border border-red-200 bg-red-50 px-3 py-2 text-sm text-red-900">
      {loadError}
    </p>
  )}
  {saved && (
    <p class="mb-4 rounded border border-emerald-200 bg-emerald-50 px-3 py-2 text-sm text-emerald-900">
      Guardado.
    </p>
  )}
  {saveError && (
    <p class="mb-4 rounded border border-red-200 bg-red-50 px-3 py-2 text-sm text-red-900">
      {saveError}
    </p>
  )}

  <form method="post" class="max-w-xl space-y-5 rounded-lg border border-neutral-200 bg-white p-6">
    <label class="block">
      <span class="mb-1 block text-sm font-medium">WhatsApp</span>
      <input
        type="text"
        name="whatsapp"
        value={values.whatsapp}
        placeholder="+34 651 80 37 99"
        autocomplete="off"
        disabled={!rec}
        class="w-full rounded border border-neutral-300 bg-white px-3 py-2 focus:border-neutral-500 focus:outline-none disabled:bg-neutral-100"
      />
      <span class="mt-1 block text-xs text-neutral-500">
        Número con o sin prefijo. Si no se indica prefijo, se asume España (+34).
      </span>
    </label>

    <label class="block">
      <span class="mb-1 block text-sm font-medium">Teléfono</span>
      <input
        type="text"
        name="phone"
        value={values.phone}
        placeholder="651 80 37 99"
        autocomplete="off"
        disabled={!rec}
        class="w-full rounded border border-neutral-300 bg-white px-3 py-2 focus:border-neutral-500 focus:outline-none disabled:bg-neutral-100"
      />
    </label>

    <label class="block">
      <span class="mb-1 block text-sm font-medium">Correo electrónico</span>
      <input
        type="email"
        name="email"
        value={values.email}
        placeholder="hola@silospeceshablaran.com"
        autocomplete="off"
        disabled={!rec}
        class="w-full rounded border border-neutral-300 bg-white px-3 py-2 focus:border-neutral-500 focus:outline-none disabled:bg-neutral-100"
      />
    </label>

    <div class="flex items-center justify-end">
      <button
        type="submit"
        disabled={!rec}
        class="rounded bg-neutral-900 px-4 py-2 text-sm font-medium text-white hover:bg-neutral-800 disabled:cursor-not-allowed disabled:bg-neutral-400"
      >
        Guardar
      </button>
    </div>
  </form>
</AdminLayout>
