---
import MainLayout from '../layouts/MainLayout.astro';
---

<MainLayout title="Eventos" description="Próximos eventos y archivo de eventos pasados del proyecto Si los peces hablaran.">
  <section class="mx-auto max-w-6xl px-4 py-20">
    <h1 class="text-5xl md:text-6xl">Eventos</h1>
    <p class="mt-6 max-w-2xl text-lg">
      Encuentros del proyecto: dónde nos verás próximamente y un archivo de los pasados.
    </p>

    <div class="mt-16 grid gap-12 md:grid-cols-2">
      <div>
        <h2 class="text-3xl">Próximos eventos</h2>
        <p class="mt-4 text-caparol/60">Pronto anunciaremos las próximas fechas.</p>
      </div>
      <div>
        <h2 class="text-3xl">Eventos anteriores</h2>
        <p class="mt-4 text-caparol/60">Estamos recopilando el archivo.</p>
      </div>
    </div>
  </section>
</MainLayout>
