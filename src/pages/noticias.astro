---
import MainLayout from '../layouts/MainLayout.astro';
---

<MainLayout title="Noticias" description="Notas de prensa y actualidad del proyecto Si los peces hablaran.">
  <section class="mx-auto max-w-6xl px-4 py-20">
    <h1 class="text-5xl md:text-6xl">Noticias</h1>
    <p class="mt-6 max-w-2xl text-lg">
      Notas de prensa, novedades y actualidad del proyecto.
    </p>
    <p class="mt-12 text-caparol/60">Pronto publicaremos las primeras noticias.</p>
  </section>
</MainLayout>
