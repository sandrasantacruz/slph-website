---
export const prerender = false;
import Detail from '../../views/noticias/Detail.astro';

const { slug } = Astro.params;
if (!slug) return Astro.redirect('/noticias');

let item;
try {
  item = await Astro.locals.pb.collection('news').getFirstListItem(
    `slug = "${slug.replace(/"/g, '\\"')}"`,
  );
} catch {
  return Astro.redirect('/noticias');
}
---
<Detail item={item} />
