  <section class="mx-auto max-w-6xl px-4 py-20">
    <h1 class="text-5xl md:text-6xl">Dónde comprar</h1>
    <p class="mt-6 max-w-2xl text-lg">
      Encuentra el cuento en librerías colaboradoras y tiendas online.
    </p>
    <p class="mt-12 text-caparol/60">Pronto añadiremos el listado de puntos de venta.</p>
  </section>
</MainLayout>
