---
export const prerender = false;
import Detail from '../../views/eventos/Detail.astro';

const { slug } = Astro.params;
if (!slug) return Astro.redirect('/eventos');

let item;
try {
  item = await Astro.locals.pb.collection('events').getFirstListItem(
    `slug = "${slug.replace(/"/g, '\\"')}"`,
  );
} catch {
  return Astro.redirect('/eventos');
}
---
<Detail item={item} />
