<MainLayout title="Videoteca" description="Vídeos del proyecto Si los peces hablaran: conciertos, talleres y entrevistas.">
  <section class="mx-auto max-w-6xl px-4 py-20">
    <h1 class="text-5xl md:text-6xl">Videoteca</h1>
    <p class="mt-6 max-w-2xl text-lg">
      Vídeos del proyecto: conciertos, talleres y entrevistas.
    </p>
    <p class="mt-12 text-caparol/60">Estamos preparando los vídeos.</p>
  </section>
</MainLayout>
