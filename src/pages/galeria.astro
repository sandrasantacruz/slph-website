---
import MainLayout from '../layouts/MainLayout.astro';
---

<MainLayout title="Galería" description="Imágenes del cuento, eventos y talleres del proyecto Si los peces hablaran.">
  <section class="mx-auto max-w-6xl px-4 py-20">
    <h1 class="text-5xl md:text-6xl">Galería</h1>
    <p class="mt-6 max-w-2xl text-lg">
      Imágenes del cuento, eventos y talleres.
    </p>
    <p class="mt-12 text-caparol/60">Estamos preparando la galería de imágenes.</p>
  </section>
</MainLayout>
