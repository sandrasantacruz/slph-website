---
import MainLayout from '../layouts/MainLayout.astro';
---

<MainLayout title="Contacto" description="Ponte en contacto con el equipo de Si los peces hablaran.">
  <section class="mx-auto max-w-6xl px-4 py-20">
    <h1 class="text-5xl md:text-6xl">Contacto</h1>
    <p class="mt-6 max-w-2xl text-lg">
      ¿Quieres saber más, traer el programa a tu colegio, organizar un evento? Escríbenos.
    </p>
    <p class="mt-12 text-caparol/60">Estamos preparando el formulario de contacto.</p>
  </section>
</MainLayout>
