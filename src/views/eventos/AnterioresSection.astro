---
import type { RecordModel } from 'pocketbase';
import EventCard from './EventCard.astro';

interface Props {
  items: RecordModel[];
}
const { items } = Astro.props;
---

{items.length > 0 && (
  <section class="mx-auto max-w-6xl px-4 pb-24">
    <h2 class="font-display text-3xl text-caparol sm:text-4xl">Eventos anteriores</h2>
    <p class="mt-2 text-sm text-caparol/60">Un archivo de las experiencias compartidas.</p>

    <ul class="mt-8 grid gap-6 md:grid-cols-2">
      {items.map((item) => <EventCard item={item} past />)}
    </ul>
  </section>
)}
