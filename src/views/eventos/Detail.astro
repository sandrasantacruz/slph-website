---
import MainLayout from '../../layouts/MainLayout.astro';
import type { RecordModel } from 'pocketbase';
import { PB_URL } from '../../lib/pb';
import { renderBlocks } from '../../lib/blocknote-render';

interface Props {
  item: RecordModel;
}

const { item } = Astro.props;

const fullFmt = new Intl.DateTimeFormat('es-ES', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});

const cover = Array.isArray(item.cover) ? item.cover[0] : item.cover;
const coverUrl = cover
  ? `${PB_URL}/api/files/${item.collectionId}/${item.id}/${cover}?thumb=1600x900`
  : null;

function parseDate(iso: string | undefined): Date | null {
  if (!iso) return null;
  const d = new Date(iso);
  return Number.isNaN(d.getTime()) ? null : d;
}

const start = parseDate(item.event_date);
const end = parseDate(item.event_end);
const dateLabel = end && start
  ? `${fullFmt.format(start)} – ${fullFmt.format(end)}`
  : start
    ? fullFmt.format(start)
    : '';

const today = new Date();
today.setHours(0, 0, 0, 0);
const past = !!(end && end < today) || !!(!end && start && start < today);

const html = renderBlocks(item.content);
---

<MainLayout title={item.title || 'Evento'} description={item.excerpt}>
  <article class="pb-24">
    <header class="mx-auto max-w-3xl px-4 pt-12 sm:pt-20">
      <a href="/eventos" class="inline-block text-sm text-arena hover:underline">
        ← Volver a eventos
      </a>
      {dateLabel && (
        <p class="mt-6 text-xs uppercase tracking-wider text-arena">
          {dateLabel}
          {past && <span class="ml-2 rounded bg-white/10 px-1.5 py-0.5 text-[10px]">Pasado</span>}
        </p>
      )}
      <h1 class="mt-3 font-display text-4xl leading-[1.05] text-caparol sm:text-6xl">
        {item.title}
      </h1>
      {item.location && (
        <p class="mt-4 flex items-center gap-2 text-base text-caparol/85">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0z"/>
            <circle cx="12" cy="10" r="3"/>
          </svg>
          {item.address_url ? (
            <a
              href={item.address_url}
              class="hover:text-arena hover:underline"
              target="_blank"
              rel="noopener noreferrer"
            >
              {item.location}
            </a>
          ) : (
            <span>{item.location}</span>
          )}
        </p>
      )}
      {item.excerpt && (
        <p class="mt-6 text-lg text-caparol/85">{item.excerpt}</p>
      )}
    </header>

    {coverUrl && (
      <div class="mx-auto mt-12 max-w-5xl px-4">
        <img
          src={coverUrl}
          alt={item.title}
          class="aspect-[16/9] w-full rounded-2xl object-cover"
        />
      </div>
    )}

    <div class="prose-slph mx-auto mt-12 max-w-3xl px-4" set:html={html} />
  </article>
</MainLayout>
