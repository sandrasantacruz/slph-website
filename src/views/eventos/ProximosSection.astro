---
import type { RecordModel } from 'pocketbase';
import EventCard from './EventCard.astro';

interface Props {
  items: RecordModel[];
}
const { items } = Astro.props;
---

<section class="mx-auto max-w-6xl px-4 pb-16">
  <h2 class="font-display text-3xl text-caparol sm:text-4xl">Próximos eventos</h2>

  {items.length === 0 ? (
    <p class="mt-6 text-caparol/60">
      Pronto anunciaremos las próximas fechas.
    </p>
  ) : (
    <ul class="mt-8 grid gap-6 md:grid-cols-2">
      {items.map((item) => <EventCard item={item} />)}
    </ul>
  )}
</section>
