---
import MainLayout from '../../layouts/MainLayout.astro';
import Hero from './Hero.astro';
import ProximosSection from './ProximosSection.astro';
import AnterioresSection from './AnterioresSection.astro';
import type { RecordModel } from 'pocketbase';

const pb = Astro.locals.pb;

let items: RecordModel[] = [];
let loadError: string | null = null;
try {
  const result = await pb.collection('events').getList(1, 200, {
    filter: 'status = "published" && published_at <= @now',
  });
  items = result.items;
} catch (err) {
  loadError = err instanceof Error ? err.message : 'No se pudieron cargar los eventos.';
}

const today = new Date();
today.setHours(0, 0, 0, 0);

function eventEnd(e: RecordModel): Date | null {
  const raw = e.event_end || e.event_date;
  if (!raw) return null;
  const d = new Date(raw);
  return Number.isNaN(d.getTime()) ? null : d;
}

function eventStart(e: RecordModel): Date | null {
  if (!e.event_date) return null;
  const d = new Date(e.event_date);
  return Number.isNaN(d.getTime()) ? null : d;
}

const datedItems = items.filter((e) => eventStart(e) !== null);

const proximos = datedItems
  .filter((e) => {
    const end = eventEnd(e)!;
    return end >= today;
  })
  .sort((a, b) => eventStart(a)!.getTime() - eventStart(b)!.getTime());

const anteriores = datedItems
  .filter((e) => {
    const end = eventEnd(e)!;
    return end < today;
  })
  .sort((a, b) => eventStart(b)!.getTime() - eventStart(a)!.getTime());
---

<MainLayout
  title="Eventos"
  description="Próximos eventos y archivo de eventos del proyecto Si los peces hablaran."
>
  <Hero />
  {loadError ? (
    <section class="mx-auto max-w-6xl px-4 pb-24">
      <p class="text-arena">{loadError}</p>
    </section>
  ) : (
    <>
      <ProximosSection items={proximos} />
      <AnterioresSection items={anteriores} />
    </>
  )}
</MainLayout>
