---
import ParaTuCentro from "./ParaTuCentro.astro";
import WaterLine from '../../components/WaterLine.astro';
import MainLayout from "../../layouts/MainLayout.astro";
import Hero from "./Hero.astro";
import Talleres from "./Talleres.astro";
import Principios from "./Principios.astro";
import Video from "./Video.astro";
import Destacan from "./Destacan.astro";
import Diferencia from "./Diferencia.astro";
import Profesorado from './Profesorado.astro';
import Ods from "./Ods.astro";
import Formatos from "./Formatos.astro";
import FormatosGrid from "./FormatosGrid.astro";
import Explora from "./Explora.astro";
import { breadcrumbSchema } from "../../lib/seo";

const breadcrumb = breadcrumbSchema([
  { name: "Inicio", url: "/" },
  { name: "El programa SLPH", url: "/programa" },
]);
---

<MainLayout
  title="Programa de concienciación marina para colegios e instituciones"
  description="Danza, arte y ciencia se dan la aleta: talleres, exposiciones y materiales para cuidar el mar, supervisados por investigadoras de ECOAQUA (ULPGC)."
  image="/assets/og-programa.jpg"
  imageAlt="Una niña, concentrada, en un Taller SLPH del Programa Si los peces hablaran…"
  imageWidth={1200}
  imageHeight={630}
  jsonLd={[breadcrumb]}
>
  <Hero />
  <Video />
  <Principios />
  <Explora />
  <WaterLine separador clave="-acciones" />
  <Talleres />
  <Destacan />
  <Ods />
  <WaterLine separador clave="-formatos" />
  <Formatos />
  <FormatosGrid />
  <Diferencia />
  <Profesorado />
  <WaterLine separador clave="-centro" />
  <ParaTuCentro />
</MainLayout>

<script>
  const reduceMotion = window.matchMedia(
    "(prefers-reduced-motion: reduce)",
  ).matches;
  const targets = document.querySelectorAll<HTMLElement>(".reveal");

  if (reduceMotion) {
    targets.forEach((el) => el.classList.add("is-visible"));
  } else {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("is-visible");
            observer.unobserve(entry.target);
          }
        });
      },
      { rootMargin: "0px 0px -10% 0px", threshold: 0.05 },
    );
    targets.forEach((el) => observer.observe(el));
  }
</script>
