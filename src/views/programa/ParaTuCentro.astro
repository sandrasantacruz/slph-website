---
/**
 * «Para tu centro»: el bloque del profesorado (análisis de contenido, 27 nov 2026).
 * Va justo después de «Lo que dice el profesorado», cuando el docente ya está
 * convencido: qué podemos llevar al centro, qué aporta al currículo y cómo se pide.
 * Datos del Dossier Bibliotecas 2026-2027 y del Dossier Talleres SLPH 2026.
 * Sin precios en la web: van en la propuesta a medida.
 */
import { Icon } from 'astro-icon/components';
import Ola from '../../components/Ola.astro';
import { SETTINGS, mailHref } from '../../lib/settings';

const correo = SETTINGS.email
  ? `${mailHref(SETTINGS.email)}?subject=${encodeURIComponent('Actividad de Si los peces hablaran… para mi centro')}`
  : '';

const propuestas = [
  {
    icono: 'game-icons:sewing-needle',
    titulo: 'Talleres SLPH',
    texto: 'Aproximadamente una hora de la mano de la autora del cuento, que puede ir acompañada de una actriz según la propuesta. Con ambientación marina, los personajes del cuento y todo el material incluido, el alumnado crea reutilizando.',
  },
  {
    icono: 'game-icons:theater',
    titulo: 'Musical y espectáculos SLPH',
    texto: 'En el propio colegio, si el espacio lo permite, o reuniendo a varios centros en un recinto mayor: en 2022 llevamos el musical a más de 500 escolares de 12 colegios.',
  },
];

const claves = ['Infantil y Primaria', 'ODS 14 y LOMLOE', 'Aval científico de la ULPGC', 'Se adapta a tu espacio y a tu alumnado'];

const pasos = [
  'Escríbenos o llámanos.',
  'Te enviamos una propuesta y un presupuesto a medida.',
  'Fijamos la fecha y llevamos el mar a tu centro.',
];
const flecha = 'M5 12h14M13 6l6 6-6 6';
---

<section id="para-tu-centro" aria-labelledby="para-tu-centro-titulo" class="relative isolate scroll-mt-24 py-16 sm:py-20">
  <div class="mx-auto max-w-6xl px-6">
    <div class="reveal mx-auto max-w-3xl text-center">
      <p class="font-hand text-2xl text-celeste sm:text-3xl">para el profesorado</p>
      <h2 id="para-tu-centro-titulo" class="mt-2 font-display text-[clamp(2rem,5.5vw,3.75rem)] leading-[1.05] text-caparol">
        Lleva el mar <Ola class="whitespace-nowrap text-arena">a tu aula</Ola>
      </h2>
      <p class="mt-5 text-base leading-relaxed text-caparol/85 sm:text-lg">
        Creamos experiencias artísticas, no actividades de ocio. Cada propuesta une arte, educación y ciencia,
        con el aval de investigadoras marinas de la ULPGC, y puede diseñarse contigo, a la medida de tu centro
        y de tu presupuesto.
      </p>
    </div>

    <ul class="reveal reveal-delay-1 mx-auto mt-10 grid max-w-4xl gap-5 sm:gap-6 md:grid-cols-2">
      {
        propuestas.map((p) => (
          <li class="flex flex-col rounded-3xl border border-arena/25 bg-azul/30 p-7">
            <span class="flex h-14 w-14 items-center justify-center rounded-2xl bg-arena/10 text-arena">
              <Icon name={p.icono} class="h-8 w-8" aria-hidden="true" />
            </span>
            <h3 class="mt-4 font-display text-2xl leading-tight text-caparol">{p.titulo}</h3>
            <p class="mt-3 text-base leading-relaxed text-caparol/85">{p.texto}</p>
          </li>
        ))
      }
    </ul>

    <ul class="reveal reveal-delay-2 mt-8 flex flex-wrap justify-center gap-3" aria-label="Lo que aporta a tu centro">
      {claves.map((c) => <li class="rounded-full bg-celeste/15 px-4 py-1.5 font-display text-base text-celeste">{c}</li>)}
    </ul>

    <div class="reveal reveal-delay-2 mx-auto mt-12 max-w-3xl rounded-3xl bg-azul/40 p-7 ring-1 ring-caparol/15 sm:p-9">
      <p class="text-center font-display text-2xl text-arena">¿Cómo lo pides?</p>
      <ol class="mt-5 grid gap-4 sm:grid-cols-3">
        {
          pasos.map((p, i) => (
            <li class="flex gap-3 sm:flex-col sm:items-center sm:text-center">
              <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-arena font-display text-xl text-azul">{i + 1}</span>
              <span class="text-base leading-snug text-caparol/90">{p}</span>
            </li>
          ))
        }
      </ol>
      <div class="mt-8 flex flex-col items-center gap-4 sm:flex-row sm:justify-center">
        {correo && (
          <a href={correo} class="group inline-flex items-center gap-3 rounded-full bg-arena px-7 py-3 font-display text-xl text-azul shadow-lg transition hover:brightness-95 sm:text-2xl">
            Pide tu propuesta
            <svg viewBox="0 0 24 24" class="h-5 w-5 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d={flecha} /></svg>
          </a>
        )}
        <a href="/contacto" class="font-display text-lg text-celeste underline decoration-celeste/40 underline-offset-4 transition hover:text-arena hover:decoration-arena">
          Otras formas de contacto
        </a>
      </div>
    </div>
  </div>
</section>
