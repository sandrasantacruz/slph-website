---
// Die neun Formate aus Sandras Übersicht. Bilder liegen als fertige WebPs
// unter public/assets/programa/formatos/ — Austausch = nur Datei ersetzen.
const formatos = [
  {
    titulo: 'Espectáculos',
    nota: 'con diferentes formatos',
    img: '/assets/programa/formatos/espectaculos.webp',
    alt: 'Escena del musical con la tortuga y dos bailarinas ante un arrecife de coral iluminado',
  },
  {
    titulo: 'Eventos de concienciación',
    nota: 'en diversidad de espacios',
    img: '/assets/programa/formatos/eventos-concienciacion.webp',
    alt: 'El elenco del programa posando con figuras marinas en un evento al aire libre',
  },
  {
    titulo: 'Experiencias artísticas',
    nota: 'emotivas e inmersivas',
    img: '/assets/programa/formatos/experiencias.webp',
    alt: 'Bailarina sentada en una butaca frente al mar durante una performance',
  },
  {
    titulo: 'Talleres SLPH',
    nota: 'reciclamos materiales',
    img: '/assets/programa/formatos/talleres.webp',
    alt: 'Vista cenital de un taller: niñas y niños pintando un cartel contra la contaminación',
  },
  {
    titulo: 'Cuento',
    nota: 'en tapa dura y blanda',
    img: '/assets/programa/formatos/cuento.webp',
    alt: 'Cuatro niñas leyendo juntas el cuento sentadas en las rocas frente al mar',
  },
  {
    titulo: 'Cuadernillo',
    nota: 'de actividades',
    img: '/assets/programa/formatos/cuadernillo.webp',
    alt: 'El cuadernillo de actividades para colorear junto al cuento y el logo del programa',
  },
  {
    titulo: 'Conferencias',
    nota: 'con investigadoras marinas',
    img: '/assets/programa/formatos/conferencias.webp',
    alt: 'Sala de conferencias llena de público durante una ponencia del programa',
  },
  {
    titulo: 'Eventos a medida',
    nota: 'interdisciplinares',
    img: '/assets/programa/formatos/eventos-medida.webp',
    alt: 'El título Si los peces hablaran… escrito sobre la arena de la playa',
  },
  {
    titulo: 'Centros escolares',
    nota: 'infantil y primaria',
    img: '/assets/programa/formatos/centros-escolares.webp',
    alt: 'Alumnado de un centro escolar siguiendo una proyección del programa en el aula',
  },
];
---

<section class="relative isolate overflow-hidden pb-24 sm:pb-32">
  <div class="mx-auto max-w-6xl px-6">
    <ul class="grid grid-cols-1 gap-x-8 gap-y-12 sm:grid-cols-2 lg:grid-cols-3 lg:gap-x-10">
      {
        formatos.map((f, i) => (
          <li
            class="reveal group"
            style={`transition-delay:${Math.min(i * 60, 480)}ms`}
          >
            <div class="overflow-hidden rounded-sm shadow-[0_20px_40px_-16px_rgba(6,15,44,0.65)] ring-1 ring-caparol/10">
              <img
                src={f.img}
                alt={f.alt}
                class="aspect-[4/3] w-full object-cover transition-transform duration-700 group-hover:scale-[1.04]"
                loading="lazy"
                decoding="async"
              />
            </div>

            <h3 class="mt-5 font-display text-lg tracking-[0.18em] text-caparol uppercase sm:text-xl">
              {f.titulo}
            </h3>
            <p class="mt-1 font-hand text-xl leading-tight text-celeste sm:text-2xl">
              {f.nota}
            </p>
          </li>
        ))
      }
    </ul>
  </div>
</section>
