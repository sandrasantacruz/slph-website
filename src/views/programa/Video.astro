---

---

<section id="video" class="relative isolate overflow-hidden py-24 sm:py-32">
  <!-- Drifting bubbles -->
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 -z-10 overflow-hidden"
  >
    <span
      class="anim-float-soft absolute top-[18%] left-[6%] block h-3 w-3 rounded-full bg-celeste/40"
    ></span>
    <span
      class="anim-float absolute bottom-[16%] left-[9%] block h-2 w-2 rounded-full bg-arena/50"
    ></span>
    <span
      class="anim-float-soft absolute top-[28%] right-[7%] block h-2.5 w-2.5 rounded-full bg-caparol/30"
    ></span>
    <span
      class="anim-float absolute right-[11%] bottom-[22%] block h-4 w-4 rounded-full bg-celeste/30"
    ></span>
  </div>

  <div class="mx-auto max-w-5xl px-6">
    <h2
      class="reveal mx-auto max-w-3xl text-center font-display text-[clamp(2.5rem,6vw,4.5rem)] leading-[0.95] text-caparol"
    >
      Sube el telón
      <span class="block">
        <span class="hand-underline text-arena">del programa</span>
      </span>
    </h2>

    <p
      class="reveal reveal-delay-1 mx-auto mt-6 max-w-xl text-center text-base text-caparol/80 sm:text-lg"
    >
      Una mirada en movimiento al Programa SLPH y las personas que dan voz al
      mundo marino.
    </p>
  </div>

  <!-- Stage area — sits OUTSIDE the px-6 container so we can go
       edge-to-edge on mobile without negative-margin tricks.
       Film strips + polaroid framing return at md+. -->
  <div class="reveal reveal-delay-2 relative mt-16">
    <div
      aria-hidden="true"
      class="film-strip absolute top-1/2 -left-2 hidden h-[26rem] w-9 -translate-y-1/2 -rotate-6 rounded-[3px] shadow-xl ring-1 ring-caparol/10 lg:block xl:-left-14"
    >
    </div>
    <div
      aria-hidden="true"
      class="film-strip absolute top-1/2 -right-2 hidden h-[26rem] w-9 -translate-y-1/2 rotate-6 rounded-[3px] shadow-xl ring-1 ring-caparol/10 lg:block xl:-right-14"
    >
    </div>

    <figure class="video-frame relative">
      <div class="player-wrap relative overflow-hidden bg-azul-deep">
        <media-player
          data-player
          title="El programa SLPH"
          src="/videos/programa.mp4"
          poster="/videos/programa-poster.webp"
          aspect-ratio="16/9"
          crossorigin
          playsinline
          preload="metadata"
        >
          <media-provider></media-provider>
          <media-video-layout></media-video-layout>
        </media-player>

        <span
          aria-hidden="true"
          class="play-hint pointer-events-none absolute right-5 bottom-12 z-10 -rotate-3 font-hand text-2xl text-arena/95 transition-opacity duration-300 select-none sm:right-8 sm:bottom-16 sm:text-3xl"
        >
          dale al play…
        </span>
      </div>

      <figcaption
        class="video-caption absolute right-0 bottom-2 left-0 px-6 text-center font-hand text-2xl text-azul sm:text-3xl"
      >
        una pequeña inmersión submarina.
      </figcaption>
    </figure>
  </div>

  <div class="mx-auto mt-12 max-w-5xl px-6">
    <div
      class="reveal reveal-delay-3 flex flex-wrap items-center justify-center gap-x-6 gap-y-3 text-caparol/70"
    >
      <span
        class="inline-flex items-center gap-2 font-display text-sm tracking-[0.35em] uppercase"
      >
        <span aria-hidden="true" class="h-px w-8 bg-arena"></span>
        aprieta play
      </span>
      <span class="font-hand text-xl text-caparol/80 sm:text-2xl">
        el mar también tiene escena.
      </span>
      <span
        class="inline-flex items-center gap-2 font-display text-sm tracking-[0.35em] uppercase"
      >
        64 segundos
        <span aria-hidden="true" class="h-px w-8 bg-arena"></span>
      </span>
    </div>
  </div>
</section>

<style is:global>
  /* Vidstack brand overrides, scoped to our wrapper. */
  .player-wrap media-player {
    --video-brand: var(--color-arena);
    --media-brand: var(--color-arena);
    --media-focus-ring-color: var(--color-arena-deep);
    --media-controls-color: var(--color-caparol);
    --video-controls-color: var(--color-caparol);
    --media-tooltip-bg: rgb(11 32 86 / 0.95);
    --media-menu-bg: rgb(11 32 86 / 0.95);
    border-radius: 0;
    background: var(--color-azul-deep);
  }

  /* Hide the hand-script hint once Vidstack flags the first play */
  .player-wrap:has(media-player[data-started]) .play-hint {
    opacity: 0;
  }
</style>

<style>
  /* ──────────────────────────────────────────────────────────
   * Video frame
   * Mobile (<768px): edge-to-edge, no polaroid, no caption.
   * md+: polaroid card, centered, with hand-script caption.
   * ────────────────────────────────────────────────────────── */
  .video-frame {
    width: 100%;
  }
  .video-frame .player-wrap {
    border-radius: 0;
  }
  .video-caption {
    display: none;
  }

  @media (min-width: 768px) {
    .video-frame {
      position: relative;
      background: var(--color-caparol);
      padding: 0.875rem 0.875rem 3.75rem;
      box-shadow:
        0 18px 35px -10px rgba(6, 15, 44, 0.55),
        0 6px 12px -4px rgba(6, 15, 44, 0.35);
      border-radius: 6px;
      max-width: 56rem; /* matches max-w-4xl */
      margin-left: auto;
      margin-right: auto;
    }
    .video-frame .player-wrap {
      border-radius: 2px;
    }
    .video-caption {
      display: block;
    }
  }

  .film-strip {
    background:
      radial-gradient(
          circle at 50% 14px,
          var(--color-azul) 5px,
          transparent 5.5px
        )
        0 0 / 100% 28px repeat-y,
      var(--color-azul-deep);
  }
</style>

<script>
  // Vidstack: registers <media-player>, <media-provider>,
  // <media-video-layout> and ships the default theme + video layout CSS.
  import "vidstack/player";
  import "vidstack/player/ui";
  import "vidstack/player/layouts/default";
  import "vidstack/player/styles/default/theme.css";
  import "vidstack/player/styles/default/layouts/video.css";
</script>
