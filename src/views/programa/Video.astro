---
import Ola from '../../components/Ola.astro';

---

<section id="video" class="relative isolate scroll-mt-28 overflow-hidden py-24 sm:py-32">
  <div class="mx-auto max-w-5xl px-6">
    <h2
      class="reveal mx-auto max-w-3xl text-center font-display text-[clamp(2.5rem,6vw,4.5rem)] leading-[0.95] text-caparol"
    >
      Sube el telón
      <span class="block">
        <Ola class="text-arena">del programa</Ola>
      </span>
    </h2>

    <p
      class="reveal reveal-delay-1 mx-auto mt-6 max-w-xl text-center text-base text-caparol/80 sm:text-lg"
    >
      Una mirada en movimiento al Programa SLPH y las personas que dan voz al
      mundo marino.
    </p>
  </div>

  <!-- Stage area — sits OUTSIDE the px-6 container so we can go
       edge-to-edge on mobile without negative-margin tricks.
       Polaroid framing returns at md+. -->
  <div class="reveal reveal-delay-2 relative mt-16">
    <figure class="video-frame relative">
      <div class="player-wrap relative overflow-hidden">
        <media-player
          data-player
          title="El programa SLPH"
          src="/videos/programa.mp4"
          poster="/videos/programa-poster.webp"
          aspect-ratio="16/9"
          crossorigin
          playsinline
          preload="metadata"
        >
          <media-provider></media-provider>
          <media-poster class="vds-poster"></media-poster>
          <media-video-layout></media-video-layout>
        </media-player>

        <span
          aria-hidden="true"
          class="play-hint pointer-events-none absolute right-4 bottom-2 z-10 -rotate-3 font-hand text-xl text-arena/95 transition-opacity duration-300 select-none sm:right-8 sm:bottom-5 sm:text-3xl"
        >
          dale al play…
        </span>
      </div>

      <figcaption
        class="video-caption absolute right-0 bottom-2 left-0 px-6 text-center font-hand text-2xl text-azul sm:text-3xl"
      >
        ¡El océano te necesita!
      </figcaption>
    </figure>
  </div>

  <div class="mx-auto mt-12 max-w-5xl px-6">
    <div
      class="reveal reveal-delay-3 flex flex-wrap items-center justify-center gap-x-6 gap-y-3 text-caparol/70"
    >
      <span aria-hidden="true" class="h-px w-8 bg-arena sm:w-12"></span>
      <!-- Toda la frase es el enlace al Club, con flecha para que se vea que se puede pulsar -->
      <a href="/club" class="group text-center font-display text-2xl leading-tight text-caparol transition hover:text-arena sm:text-3xl md:text-4xl">
        <!-- corazón como en los índices de la web («lo más emocionante»), Sandra 28 nov 2026 -->
        <svg viewBox="0 0 24 24" class="mr-1 inline h-[0.7em] w-[0.7em] align-[0.02em] text-arena" fill="currentColor" aria-hidden="true"><path d="M12 21s-7.5-4.6-9.6-9.2C.9 8.4 2.9 4.5 6.6 4.5c2.1 0 3.6 1.2 4.4 2.5.8-1.3 2.3-2.5 4.4-2.5 3.7 0 5.7 3.9 4.2 7.3C19.5 16.4 12 21 12 21z"/></svg>
        ¡Únete al <Ola class="text-arena">Club SLPH</Ola> y forma parte del cambio!
        <svg viewBox="0 0 24 24" class="ml-1 inline h-[0.8em] w-[0.8em] align-[-0.05em] text-arena transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
      </a>
      <span aria-hidden="true" class="h-px w-8 bg-arena sm:w-12"></span>
    </div>
  </div>
</section>

<style is:global>
  /* Vidstack brand overrides, scoped to our wrapper. */
  .player-wrap media-player {
    --video-brand: var(--color-arena);
    --media-brand: var(--color-arena);
    --media-focus-ring-color: var(--color-arena-deep);
    --media-controls-color: var(--color-caparol);
    --video-controls-color: var(--color-caparol);
    --media-tooltip-bg: rgb(11 32 86 / 0.95);
    --media-menu-bg: rgb(11 32 86 / 0.95);
    border-radius: 0;
    background: transparent;
    /* block y sin borde: si no, salía un filito oscuro arriba y abajo del vídeo */
    display: block;
    border: 0 !important;
  }

  /* Hide the hand-script hint once Vidstack flags the first play */
  .player-wrap:has(media-player[data-started]) .play-hint {
    opacity: 0;
  }
</style>

<style>
  /* ──────────────────────────────────────────────────────────
   * Video frame
   * Mobile (<768px): edge-to-edge, no polaroid, no caption.
   * md+: polaroid card, centered, with hand-script caption.
   * ────────────────────────────────────────────────────────── */
  .video-frame {
    width: 100%;
  }
  .video-frame .player-wrap {
    border-radius: 0;
  }
  .video-caption {
    display: none;
  }

  @media (min-width: 768px) {
    .video-frame {
      position: relative;
      background: var(--color-caparol);
      padding: 0.875rem 0.875rem 3.75rem;
      box-shadow:
        0 18px 35px -10px rgba(6, 15, 44, 0.55),
        0 6px 12px -4px rgba(6, 15, 44, 0.35);
      border-radius: 6px;
      max-width: 56rem; /* matches max-w-4xl */
      margin-left: auto;
      margin-right: auto;
    }
    .video-frame .player-wrap {
      border-radius: 2px;
    }
    .video-caption {
      display: block;
    }
  }
</style>

<script>
  // Vidstack: registers <media-player>, <media-provider>,
  // <media-video-layout> and ships the default theme + video layout CSS.
  import "vidstack/player";
  import "vidstack/player/ui";
  import "vidstack/player/layouts/default";
  import "vidstack/player/styles/default/theme.css";
  import "vidstack/player/styles/default/poster.css";
  import "vidstack/player/styles/default/layouts/video.css";
</script>
