---
const principios = [
  {
    eyebrow: 'nuestra',
    titulo: 'Misión',
    texto:
      'Concienciar sobre el riesgo de los vertidos marinos haciendo frente a actitudes irresponsables, e implicar a la sociedad en la reacción.',
  },
  {
    eyebrow: 'nuestra',
    titulo: 'Visión',
    texto:
      'Sensibilizar y despertar el amor por la fauna marina a través de la creatividad, evitando que se utilice el mar como un vertedero.',
  },
  {
    eyebrow: 'aval',
    titulo: 'Científico',
    texto:
      'Nuestros contenidos están supervisados por investigadoras marinas, que garantizan el rigor científico de cada propuesta.',
  },
];

// Die vier Buchstaben von SLPH als zweite Lesart des Namens.
const siglas = [
  { letra: 'S', palabra: 'Sostenibilidad' },
  { letra: 'L', palabra: 'Legado' },
  { letra: 'P', palabra: 'Planeta' },
  { letra: 'H', palabra: 'Herencia' },
];
---

<section class="relative py-20 sm:py-28">
  <div class="mx-auto max-w-6xl px-6">
    <!-- Section header — bold marker bar -->
    <div class="reveal flex items-center gap-5">
      <span aria-hidden="true" class="h-[2px] w-16 bg-arena sm:w-24"></span>
      <span class="font-display text-sm tracking-[0.4em] text-arena uppercase">
        Quiénes somos
      </span>
    </div>

    <!-- Misión / Visión — two large editorial blocks -->
    <div class="mt-12 grid gap-x-8 gap-y-14 md:grid-cols-3 md:gap-y-0 lg:gap-x-10">
      {
        principios.map((p, i) => (
          <article
            class={`reveal reveal-delay-${i + 1} relative`}
          >
            <div class="absolute -top-6 left-0 font-hand text-3xl leading-none text-celeste sm:text-4xl">
              {p.eyebrow}
            </div>
            <h2 class="font-display text-[clamp(2.75rem,5vw,4.25rem)] leading-[0.92] text-caparol">
              {p.titulo}
            </h2>
            <div class="mt-5 flex gap-4">
              <span aria-hidden="true" class="mt-2 inline-block h-[3px] w-10 shrink-0 bg-arena"></span>
              <p class="text-base text-caparol/90 sm:text-lg">{p.texto}</p>
            </div>
          </article>
        ))
      }
    </div>

    <!-- Lema — handwritten call to action -->
    <div class="reveal reveal-delay-3 mt-20 sm:mt-28">
      <div class="flex items-center gap-5">
        <span aria-hidden="true" class="h-[2px] w-10 bg-celeste"></span>
        <span class="font-display text-sm tracking-[0.4em] text-celeste uppercase">
          Nuestra llamada a la acción
        </span>
        <span aria-hidden="true" class="h-[2px] flex-1 bg-celeste/30"></span>
      </div>

      <blockquote class="relative mt-8 text-center sm:mt-12">
        <!-- Aletas cruzadas -->
        <img
          src="/assets/programa/aletas.webp"
          alt=""
          aria-hidden="true"
          class="anim-float-soft mx-auto h-32 w-auto sm:h-44"
          loading="lazy"
          decoding="async"
        />

        <p class="mt-4 font-hand text-[clamp(2.5rem,8vw,6.5rem)] leading-[0.95] text-arena sm:mt-6">
          ¡No te quedes
          <span class="block text-caparol">de Aletas Cruzadas!</span>
        </p>
      </blockquote>

      <p class="mt-6 text-center font-display text-sm tracking-[0.4em] text-caparol/60 uppercase">
        — SLPH
      </p>

      <!-- Las siglas, leídas de otra manera -->
      <div class="reveal mt-16 sm:mt-20">
        <p class="mx-auto max-w-2xl text-center text-base text-caparol/90 sm:text-lg">
          Nuestras siglas significan <strong class="font-normal text-arena">mucho más</strong> que <em class="not-italic font-hand text-2xl text-celeste sm:text-3xl">si los peces hablaran:</em>
        </p>

        <dl class="mx-auto mt-10 grid max-w-4xl grid-cols-2 gap-x-6 gap-y-10 sm:grid-cols-4 sm:gap-x-4">
          {
            siglas.map((s, i) => (
              <div class={`reveal reveal-delay-${i + 1} text-center`}>
                <dt class="font-display text-[clamp(3rem,9vw,5rem)] leading-[0.9] text-arena">
                  {s.letra}
                </dt>
                <span aria-hidden="true" class="mx-auto mt-3 block h-[2px] w-8 bg-celeste/50" />
                <dd class="mt-3 text-base text-caparol sm:text-lg">{s.palabra}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>
  </div>
</section>
