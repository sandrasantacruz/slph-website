---
import { Icon } from 'astro-icon/components';
import Ola from '../../components/Ola.astro';
import IndicePagina from '../../components/IndicePagina.astro';
---

<section class="relative isolate overflow-hidden pt-14 pb-16 sm:pt-20 sm:pb-24">
  <!-- Subtle radial glow, top-left, like contacto -->
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 -z-10 bg-[radial-gradient(60%_50%_at_15%_25%,rgba(250,222,170,0.08),transparent_70%)]"
  ></div>

  <div class="mx-auto max-w-6xl px-6">
    <!-- Eyebrow -->
    <div class="reveal flex items-center gap-3 sm:gap-4">
      <span aria-hidden="true" class="h-px w-10 bg-arena sm:w-16"></span>
      <span class="font-display text-xs tracking-[0.4em] text-arena uppercase sm:text-sm">
        Colabora con SLPH
      </span>
    </div>

    <!-- Headline: “aleta” con la ola, como la palabra destacada de los demás títulos -->
    <h1 class="reveal reveal-delay-1 mt-6 max-w-4xl font-display text-[clamp(2.5rem,7.5vw,5rem)] leading-[0.95] tracking-tight text-caparol">
      ¿Nos echas
      <span class="whitespace-nowrap">
        una
        <Ola class="text-arena italic">aleta</Ola></span>?
    </h1>

    <!-- Lead — the "deber moral / supervivencia" punch -->
    <p class="reveal reveal-delay-2 mt-8 max-w-3xl font-display text-xl leading-tight text-celeste sm:text-2xl md:text-3xl">
      Preservar nuestros mares y sus ecosistemas
      <span class="text-caparol">no es solo un deber moral</span>:
      <Ola class="text-arena">¡nuestra supervivencia depende de ello!</Ola>
    </p>

    <!-- Texto breve: las formas de sumarse van justo debajo (Colaborar.astro) -->
    <p class="reveal reveal-delay-3 mt-10 max-w-3xl text-base leading-relaxed text-caparol/90 sm:text-lg">
      Desde 2016, <em class="not-italic font-display text-arena">Si los peces hablaran…</em>
      contagia el amor por el mar en <span class="text-celeste">todas las edades</span>, de la mano de
      colegios, bibliotecas, museos, instituciones y personas como tú. Hay muchas formas de
      sumarse: elige la tuya.
    </p>

    <p class="reveal reveal-delay-3 mt-8 max-w-3xl font-hand text-3xl leading-tight text-arena sm:text-4xl">
      ¡Tú puedes ser protagonista del cambio!
    </p>

    <!-- Índice de la página, como en Programa y Repercusión -->
    <IndicePagina
      class="reveal reveal-delay-4 mt-8 max-w-3xl border-t border-caparol/10 pt-5"
      enlaces={[
        { href: '#colaborar', texto: 'Cómo colaborar' },
        { href: '#entidades', texto: 'Para entidades' },
        { href: '#puntos-azules', texto: 'Puntos Azules' },
        { href: '#aliados', texto: 'Red de aliados' },
        { href: '#equipo', texto: 'Nuestro equipo', corazon: true },
      ]}
    />

    <!-- El Sr. Tentáculus con el tridente clavado en el neumático: limpiando el mar,
         que es lo que pide esta página. Alegría (el delfín) ya está en el botón
         “Comprar” de la barra en todas las páginas, por eso aquí no.
         Móvil y tableta: en el flujo, centrado y algo separado del índice para no taparlo. Desde lg, fuera del flujo,
         grande, a la derecha del texto y por detrás. -->
    <img
      src="/assets/animals/tentaculus-tridente.webp"
      alt=""
      aria-hidden="true"
      class="anim-pulpo pointer-events-none mx-auto mt-16 mb-0 block w-48 drop-shadow-[0_18px_28px_rgba(6,15,44,0.5)] sm:mt-8 sm:-mb-16 sm:w-60 md:w-72 lg:absolute lg:top-20 lg:right-4 lg:-z-10 lg:m-0 lg:w-80 xl:right-16 xl:w-[23rem]"
      width="500"
      height="876"
      loading="lazy"
    />
  </div>
</section>

<style>
  .anim-pulpo { transform-origin: 50% 20%; animation: colabora-pulpo 6s ease-in-out infinite; }
  @keyframes colabora-pulpo {
    0%, 100% { transform: translateY(0) rotate(-3deg); }
    50% { transform: translateY(-12px) rotate(3deg); }
  }
  @media (prefers-reduced-motion: reduce) { .anim-pulpo { animation: none; } }
</style>
