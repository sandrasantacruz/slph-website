---
import EnlaceFlecha from '../../components/EnlaceFlecha.astro';
// Lo que dicen: una fila de citas cortas, antes de las listas.
const citas = [
  {
    texto: 'Esta experiencia trasladada al museo es maravillosa… no solo conciencia a los niños que han participado, sino también a todos los visitantes.',
    nombre: 'José Alejandro Díaz Hernández',
    cargo: 'Director de la Casa-Museo León y Castillo',
  },
  {
    texto: 'Conecta fácilmente tanto con niños como con adultos. Sin duda, es un programa innovador en defensa de los ecosistemas marinos que involucra en la protección del planeta.',
    nombre: 'Manuel Benítez',
    cargo: 'Gerente de la Fundación Orquesta Filarmónica de Gran Canaria',
  },
  {
    texto: 'Esta maravillosa interpretación ha conseguido que nuestro alumnado tome conciencia sobre la gravedad de la contaminación y, además, adquiera estrategias encaminadas a la protección de nuestros océanos.',
    nombre: 'Equipo docente',
    cargo: 'CEIP Pepe Dámaso',
  },
  {
    texto: 'Es un regalo a la naturaleza y a las nuevas generaciones… desde el arte, una forma tan sensible de llegar.',
    nombre: 'Público',
    cargo: 'Biblioteca Municipal Dolores Campos-Herrero',
  },
];

const aliados = [
  'Consejería de Cultura del Cabildo de Gran Canaria',
  'Consejería de Educación del Cabildo de Gran Canaria',
  'Concejalía de Cultura de Maspalomas',
  'Concejalía de Cultura de Mogán',
  'Concejalía de Medioambiente de Arucas',
  'Ayuntamiento de Puntallana, La Palma',
  'Ayuntamiento de La Oliva, Fuerteventura',
  'Facultad de Ciencias del Mar de la ULPGC',
  'Orquesta Filarmónica de Gran Canaria',
  'Hospital Materno Infantil, área de oncología',
  'Candidatura de Las Palmas de Gran Canaria como Capital Europea de la Cultura 2031',
  'Ayuntamiento de Arona · Suma Festival de Tenerife',
  'Ayuntamiento de Tijarafe · La Palma',
  'Ayuntamiento de Las Palmas de Gran Canaria · Fiestas Fundacionales 2026',
  'Instituto del Patrimonio Mundial de la Reserva de la Biosfera de Gran Canaria: Risco Caído y Reserva de la Biosfera',
  'Proyecto Barrios del CAAM',
  'Fundación Belén María',
  'Turiscan',
];

const museos = [
  'Casa-Museo de Colón',
  'Casa-Museo Pérez Galdós',
  'Museo y Parque Arqueológico Cueva Pintada',
  'Casa-Museo Tomás Morales',
  'Casa-Museo León y Castillo',
  'Museo Elder de la Ciencia y la Tecnología',
];

const bibliotecas = [
  'Biblioteca Insular',
  'Biblioteca Pública del Estado en Las Palmas',
  'Biblioteca Municipal de Teror',
  'Biblioteca Pública Municipal de Arucas',
  'Biblioteca Pública Municipal de Mogán',
  'Biblioteca Municipal Dolores Campos-Herrero',
];

const centros = [
  'CEIP Príncipe de Asturias',
  'Colegio Dominicas Las Palmas',
  'CEO Tejeda',
  'Colegio Claret de Tamaraceite',
  'Colegio Bilingüe Brains Las Palmas',
  'Colegio Bilingüe La Higuerita',
  'CEIP César Manrique',
  'CEIP Cataluña',
  'CEIP Buena Vista I',
  'CEIP Siete Palmas',
  'CEIP Las Torres',
  'CEIP La Garita',
  'CEIP Pepe Dámaso',
  'CEIP Santa Bárbara',
  'CEIP Las Rehoyas',
  'CEIP San Rafael',
  'CEIP Gran Canaria',
  'CEIP Federico García Lorca',
  'CEIP Isabel La Católica',
  'CEIP Timplista José Antonio Ramos',
  'CEIP Poeta Francisco Tarajano',
  'CEIP Alfredo Kraus',
  'CEIP Monseñor Socorro Lantigua',
  'CEIP Santa Catalina',
  'CEIP Huertas del Palmar',
  'Colegio Marpe Altavista',
  'Colegio Marpe Las Palmas',
  'CEIP Artemi Semidán',
  'CEO Tijarafe, La Palma',
  'Colegio Público Puntallana, La Palma',
  'CEIP César Manrique Cabrera, Lanzarote',
  'CEIP Capitán General Julio Coloma Gallegos, Sevilla',
];
---

<section class="relative isolate overflow-hidden py-20 sm:py-28">
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 -z-10 bg-[radial-gradient(60%_50%_at_20%_30%,rgba(100,170,210,0.07),transparent_70%)]"
  ></div>

  <div class="mx-auto max-w-6xl px-6">
    <!-- Sprungziel sitzt am Überschriftenblock, nicht an der Section: sonst
         landet man oberhalb deren py-28 und es bleibt viel Luft übrig.
         Die Navbar ist `relative` und scrollt mit weg, daher nur ein kleiner
         Atem-Abstand. -->
    <div id="aliados" class="reveal max-w-3xl scroll-mt-8">
      <p class="font-hand text-3xl leading-none text-celeste sm:text-4xl">
        red de aliados
      </p>
      <h2 class="mt-3 font-display text-[clamp(2rem,5vw,3.5rem)] leading-[0.95] text-caparol">
        Organismos y entidades que ven en SLPH
        <span class="block text-arena italic">un aliado para proteger el mar</span>
      </h2>
    </div>

    <!-- Lo que dicen: en móvil una debajo de otra; desde md, rejilla de 2 -->
    <ul class="reveal reveal-delay-1 mt-12 grid gap-4 md:grid-cols-2 md:gap-6">
      {citas.map((c) => (
        <li>
          <figure class="flex h-full flex-col rounded-2xl border border-caparol/15 bg-azul/40 p-6 sm:p-7">
            <span aria-hidden="true" class="font-display text-5xl leading-none text-arena/60">«</span>
            <blockquote class="-mt-3 flex-1 font-hand text-2xl leading-snug text-caparol sm:text-[1.65rem]">
              {c.texto}
            </blockquote>
            <figcaption class="mt-5 border-t border-caparol/10 pt-4 text-sm leading-snug">
              <span class="block font-display text-base tracking-wide text-arena">{c.nombre}</span>
              <span class="text-caparol/70">{c.cargo}</span>
            </figcaption>
          </figure>
        </li>
      ))}
    </ul>

    <!-- Abre aquí mismo el vídeo de las opiniones de los niños (Casa-Museo Pérez Galdós) -->
    <div class="reveal mt-10 flex justify-center">
      <button
        type="button"
        data-abrir-opiniones
        class="group inline-flex items-center gap-2 rounded-full border border-arena/60 px-5 py-2.5 font-display text-base tracking-[0.18em] text-arena uppercase transition hover:border-arena hover:bg-arena hover:text-azul"
      >
        <svg viewBox="0 0 24 24" class="h-4 w-4" fill="currentColor" aria-hidden="true"><path d="M8 5.5v13l11-6.5z"/></svg>
        Lo que opinan los niños
      </button>
    </div>

    <dialog
      data-dialogo-opiniones
      aria-label="Opiniones de los niños en la Casa-Museo Pérez Galdós"
      class="m-auto w-[min(92vw,60rem)] overflow-visible bg-transparent p-0 backdrop:bg-azul-deep/85 backdrop:backdrop-blur-sm"
    >
      <div class="relative">
        <button
          type="button"
          data-cerrar-opiniones
          aria-label="Cerrar vídeo"
          class="absolute -top-12 right-0 rounded-full p-2 text-caparol transition hover:text-arena"
        >
          <svg viewBox="0 0 24 24" class="h-7 w-7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
        </button>
        <video
          src="/videos/menores-opiniones.mp4"
          poster="/videos/menores-opiniones-poster.webp"
          controls
          playsinline
          preload="none"
          class="block w-full rounded-2xl shadow-2xl"
        ></video>
        <p class="mt-3 text-center font-hand text-2xl text-arena">lo que opinan los niños · Casa-Museo Pérez Galdós</p>
      </div>
    </dialog>

    <div class="reveal reveal-delay-1 mt-16 grid gap-10 lg:grid-cols-3 lg:gap-12">
      <div class="lg:col-span-1">
        <h3 class="font-display text-xl tracking-wide text-arena uppercase">
          Administraciones, cultura y patrimonio
        </h3>
        <ul class="mt-5 space-y-2.5 text-base leading-relaxed text-caparol/85">
          {aliados.map((a) => <li class="flex gap-2"><span aria-hidden="true" class="mt-2 inline-block h-1.5 w-1.5 shrink-0 rounded-full bg-arena/70"></span>{a}</li>)}
        </ul>
      </div>

      <div class="lg:col-span-1">
        <h3 class="font-display text-xl tracking-wide text-celeste uppercase">
          Museos
        </h3>
        <ul class="mt-5 space-y-2.5 text-base leading-relaxed text-caparol/85">
          {museos.map((m) => <li class="flex gap-2"><span aria-hidden="true" class="mt-2 inline-block h-1.5 w-1.5 shrink-0 rounded-full bg-celeste/70"></span>{m}</li>)}
        </ul>

        <h3 class="mt-10 font-display text-xl tracking-wide text-celeste uppercase">
          Bibliotecas
        </h3>
        <p class="mt-3 text-sm leading-relaxed text-caparol/70">
          Bibliotecas que nos han abierto sus puertas.
        </p>
        <ul class="mt-5 space-y-2.5 text-base leading-relaxed text-caparol/85">
          {bibliotecas.map((b) => <li class="flex gap-2"><span aria-hidden="true" class="mt-2 inline-block h-1.5 w-1.5 shrink-0 rounded-full bg-celeste/70"></span>{b}</li>)}
        </ul>

        <h3 id="red-de-puntos-azules" class="mt-10 scroll-mt-28 font-display text-xl tracking-wide text-celeste uppercase">
          Red de Puntos Azules
        </h3>
        <p class="mt-3 text-sm leading-relaxed text-caparol/70">
          Bibliotecas que son un lugar de referencia en su comunidad desde el que contagiar el amor por el mar a través de SLPH.
        </p>
        <p class="mt-4 font-hand text-2xl leading-none text-celeste sm:text-3xl">
          «¿Buceamos juntos?»
        </p>
      </div>

      <div class="lg:col-span-1">
        <h3 class="font-display text-xl tracking-wide text-arena uppercase">
          Centros escolares
        </h3>
        <p class="mt-3 text-sm leading-relaxed text-caparol/70">
          Aulas en las que hemos navegado para sensibilizar a su alumnado sobre el mundo marino.
        </p>
        <ul class="mt-5 grid grid-cols-1 gap-x-6 gap-y-2.5 text-sm leading-relaxed text-caparol/85 sm:grid-cols-2 lg:grid-cols-1">
          {centros.map((c) => <li class="flex gap-2"><span aria-hidden="true" class="mt-1.5 inline-block h-1.5 w-1.5 shrink-0 rounded-full bg-arena/70"></span>{c}</li>)}
        </ul>
        <EnlaceFlecha href="/galeria#centros-escolares" class="mt-6">Nuestras visitas a los colegios</EnlaceFlecha>
      </div>
    </div>
  </div>
</section>

<script>
  // «Lo que opinan los niños»: el vídeo se abre y empieza aquí, sin salir de Colabora.
  const dlg = document.querySelector<HTMLDialogElement>('[data-dialogo-opiniones]');
  const vid = dlg?.querySelector('video');
  document.querySelector('[data-abrir-opiniones]')?.addEventListener('click', () => {
    dlg?.showModal();
    vid?.play().catch(() => {});
  });
  dlg?.querySelector('[data-cerrar-opiniones]')?.addEventListener('click', () => dlg.close());
  // clic fuera del vídeo = cerrar
  dlg?.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });
  dlg?.addEventListener('close', () => vid?.pause());
</script>
