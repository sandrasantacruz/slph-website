---
import { Icon } from 'astro-icon/components';
import Ola from '../../components/Ola.astro';
---

<section class="relative isolate overflow-hidden pb-24 sm:pb-32">
  <div class="mx-auto max-w-6xl px-6">
    <div class="reveal relative grid items-center gap-10 overflow-hidden rounded-3xl border border-caparol/15 bg-azul/30 p-8 sm:p-12 md:grid-cols-12">
      <div class="md:col-span-7">
        <p class="font-hand text-2xl leading-none text-celeste sm:text-3xl">
          ¿buscas algo más?
        </p>
        <h2 class="mt-3 font-display text-[clamp(1.75rem,4vw,2.75rem)] leading-[0.95] text-caparol">
          ¿Pedido al por mayor
          <span class="block"><Ola class="text-arena">o cualquier duda</Ola>?</span>
        </h2>
        <p class="mt-5 max-w-xl text-base text-caparol/85 sm:text-lg">
          Si quieres comprar ejemplares en lote para tu colegio, biblioteca u organización
          —o tienes cualquier otra consulta— escríbenos y te respondemos enseguida.
        </p>

        <ul class="mt-8 grid gap-3 sm:grid-cols-2">
        <li>
          <a
            href="/contacto"
            class="group flex h-full flex-col items-start gap-3 rounded-2xl border-2 border-caparol/15 bg-azul/40 p-5 transition hover:border-arena focus:outline-none focus-visible:border-arena"
          >
            <span class="flex h-11 w-11 items-center justify-center rounded-full bg-arena/10 text-arena transition group-hover:bg-arena group-hover:text-azul">
              <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z" />
              </svg>
            </span>
            <div class="flex flex-col gap-0.5">
              <span class="font-display text-lg text-caparol">Contáctanos</span>
              <span class="text-sm text-caparol/70">WhatsApp, correo o teléfono</span>
            </div>
          </a>
        </li>
        <li>
          <a
            href="/colabora"
            class="group flex h-full flex-col items-start gap-3 rounded-2xl border-2 border-caparol/15 bg-azul/40 p-5 transition hover:border-celeste focus:outline-none focus-visible:border-celeste"
          >
            <span class="flex h-11 w-11 items-center justify-center rounded-full bg-celeste/15 text-celeste transition group-hover:bg-celeste group-hover:text-azul">
              <Icon name="game-icons:fishing-net" class="h-5 w-5" aria-hidden="true" />
            </span>
            <div class="flex flex-col gap-0.5">
              <span class="font-display text-lg text-caparol">Colabora</span>
              <span class="text-sm text-caparol/70">Échanos una aleta</span>
            </div>
          </a>
        </li>
      </ul>
      </div>

      <!-- Entrega del cuento en Poema del Mar; das Foto ist 3:2 quer -->
      <img
        src="/assets/comprar/cuento-poema-del-mar.webp"
        alt="Dos bailarines del musical sostienen el cuento Si los peces hablaran frente al gran acuario de Poema del Mar"
        class="w-full rounded-2xl border border-caparol/15 shadow-[0_18px_35px_-10px_rgba(6,15,44,0.55)] md:col-span-5"
        width="1500"
        height="994"
        loading="lazy"
        decoding="async"
      />
    </div>
  </div>
</section>
