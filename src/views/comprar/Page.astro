---
import MainLayout from '../../layouts/MainLayout.astro';
import Hero from './Hero.astro';
import Videos from './Videos.astro';
import Librerias from './Librerias.astro';
import CTA from './CTA.astro';
import { bookSchema, breadcrumbSchema } from '../../lib/seo';

const breadcrumb = breadcrumbSchema([
  { name: 'Inicio', url: '/' },
  { name: 'Dónde comprar', url: '/comprar' },
]);
---

<MainLayout
  title="Dónde comprar"
  description="Encuentra ejemplares del cuento Si los peces hablaran online en Entintadas Editorial (con envío a domicilio) y en una decena de librerías y tiendas de Canarias: Gran Canaria y Tenerife."
  type="book"
  jsonLd={[bookSchema(), breadcrumb]}
>
  <Hero />
  <Librerias />
  <Videos />
  <CTA />
</MainLayout>

<script>
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const targets = document.querySelectorAll<HTMLElement>('.reveal');

  if (reduceMotion) {
    targets.forEach((el) => el.classList.add('is-visible'));
  } else {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          }
        });
      },
      { rootMargin: '0px 0px -10% 0px', threshold: 0.05 },
    );
    targets.forEach((el) => observer.observe(el));
  }
</script>
