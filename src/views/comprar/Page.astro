---
import MainLayout from '../../layouts/MainLayout.astro';
import Hero from './Hero.astro';
import Videos from './Videos.astro';
import Escuela from './Escuela.astro';
import Librerias from './Librerias.astro';
import CTA from './CTA.astro';
import WaterLine from '../../components/WaterLine.astro';
import { bookSchema, cuadernilloSchema, breadcrumbSchema } from '../../lib/seo';

const breadcrumb = breadcrumbSchema([
  { name: 'Inicio', url: '/' },
  { name: 'Dónde comprar', url: '/comprar' },
]);
---

<MainLayout
  title="Dónde comprar el cuento infantil Si los peces hablaran…"
  description="¿Lo quieres dedicado? Su autora te lo firma en el Centro de Danza Sandra Santa Cruz, donde también encontrarás el cuadernillo de actividades."
  image="/assets/og-comprar.jpg"
  imageAlt="Una niña muestra el cuento Si los peces hablaran… y su cuadernillo de actividades"
  imageWidth={1200}
  imageHeight={630}
  type="book"
  jsonLd={[bookSchema({ precio: true }), cuadernilloSchema(), breadcrumb]}
>
  <Hero />
  <Escuela />
  <Librerias />
  <Videos />
  <!-- la segunda vía: pedidos al por mayor y dudas -->
  <WaterLine separador />
  <CTA />
</MainLayout>

<script>
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const targets = document.querySelectorAll<HTMLElement>('.reveal');

  if (reduceMotion) {
    targets.forEach((el) => el.classList.add('is-visible'));
  } else {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          }
        });
      },
      { rootMargin: '0px 0px -10% 0px', threshold: 0.05 },
    );
    targets.forEach((el) => observer.observe(el));
  }
</script>
