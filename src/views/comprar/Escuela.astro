---
/**
 * Venta en la escuela: el Centro de Danza Sandra Santa Cruz es donde nació el
 * proyecto, y ahí la autora dedica el cuento en persona. Bloque propio con el
 * vídeo de la 3.ª edición, la invitación, el botón de reserva por WhatsApp y
 * «Lo que dicen del cuento» (antes suelto bajo la ficha del libro).
 */
import { Icon } from 'astro-icon/components';
import Ola from '../../components/Ola.astro';
import EnlaceFlecha from '../../components/EnlaceFlecha.astro';
import { SETTINGS, whatsappHref } from '../../lib/settings';

const mensaje = 'Hola, me gustaría reservar una cita en el Centro de Danza para la dedicatoria de Si los peces hablaran…';
const reservaHref = `${whatsappHref(SETTINGS.whatsapp)}?text=${encodeURIComponent(mensaje)}`;
const direccion = 'Av. de Escaleritas, 56, 35011 Las Palmas de Gran Canaria';
const mapsHref = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(
  `Centro de Danza Sandra Santa Cruz, ${direccion}`,
)}`;
---

<section id="escuela" aria-labelledby="escuela-titulo" class="relative isolate overflow-hidden pt-4 pb-20 sm:pb-28">
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 -z-10 bg-[radial-gradient(55%_50%_at_20%_40%,rgba(250,222,170,0.08),transparent_70%)]"
  ></div>

  <div class="mx-auto max-w-6xl px-6">
    <div class="reveal relative rounded-3xl border border-arena/25 bg-azul/30 p-6 sm:p-10">
      <div class="flex justify-center">
          <p class="inline-flex items-center gap-2.5 rounded-full bg-arena/15 px-5 py-2 font-display text-sm tracking-[0.18em] text-arena uppercase ring-1 ring-arena/50 sm:text-base">
            <svg viewBox="0 0 24 24" class="h-4 w-4 sm:h-5 sm:w-5" fill="currentColor" aria-hidden="true"><path d="M12 2.5l2.9 6.1 6.6.8-4.9 4.6 1.3 6.6L12 17.3l-5.9 3.3 1.3-6.6L2.5 9.4l6.6-.8z"/></svg>
            Nuestro punto de venta más especial
            <svg viewBox="0 0 24 24" class="h-4 w-4 sm:h-5 sm:w-5" fill="currentColor" aria-hidden="true"><path d="M12 2.5l2.9 6.1 6.6.8-4.9 4.6 1.3 6.6L12 17.3l-5.9 3.3 1.3-6.6L2.5 9.4l6.6-.8z"/></svg>
          </p>
      </div>
      <p class="mt-3 flex items-start justify-center gap-2 text-center text-sm text-caparol/85 sm:text-base">
          <svg viewBox="0 0 24 24" class="mt-0.5 h-5 w-5 shrink-0 text-arena" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 21s-7-7.5-7-12a7 7 0 0 1 14 0c0 4.5-7 12-7 12z" />
            <circle cx="12" cy="9" r="2.5" />
          </svg>
          <span>
            {direccion}
            <a
              href={mapsHref}
              target="_blank"
              rel="noopener noreferrer"
              class="ml-1 whitespace-nowrap text-celeste underline decoration-celeste/40 underline-offset-4 transition hover:text-caparol"
            >Cómo llegar</a>
          </span>
        </p>

      <!-- Vídeo -->
      <figure class="clip-frame mx-auto mt-6 max-w-3xl">
        <div class="player-wrap relative overflow-hidden bg-azul-deep">
          <media-player
            class="comprar-player comprar-player--destacado"
            title="Si los peces hablaran… 3.ª edición"
            src="/videos/tercera-edicion.mp4"
            poster="/videos/tercera-edicion-poster.webp"
            aspect-ratio="16/9"
            crossorigin
            playsinline
          >
            <media-provider>
              <media-poster class="vds-poster" />
            </media-provider>
            <media-video-layout />
            <media-play-button class="comprar-play-overlay" aria-label="Reproducir vídeo">
              <span class="comprar-play-circle">
                <Icon name="game-icons:play-button" aria-hidden="true" />
              </span>
            </media-play-button>
          </media-player>
        </div>
        <figcaption class="clip-caption font-hand text-2xl text-azul sm:text-[1.7rem]">
          ¡Ya está aquí la 3.ª edición!
        </figcaption>
      </figure>

      <!-- Debajo, en dos columnas: el Centro (izquierda) y la cita (derecha) -->
      <div class="mt-12 grid gap-10 md:grid-cols-2 md:items-center md:gap-12">
        <div>
        <p class="font-hand text-2xl leading-tight text-celeste">
          ¿Qué cuento te deja conocer dónde nació?
        </p>
        <h2
          id="escuela-titulo"
          class="mt-3 font-display text-[clamp(1.75rem,3.4vw,2.6rem)] leading-[1] text-caparol"
        >
          ¡El nuestro!
          <span class="block sm:whitespace-nowrap">Y te lo dedica <span class="whitespace-nowrap"><Ola class="text-arena">su autora</Ola></span></span>
        </h2>
        <p class="mt-5 text-base leading-relaxed text-caparol/85 sm:text-lg">
          Ven al Centro de Danza Sandra Santa Cruz, el lugar donde todo empezó, y llévate tu
          cuento firmado. Aquí también encontrarás el
          <a href="/cuadernillo" class="text-arena underline decoration-arena/40 underline-offset-4 hover:decoration-arena">cuadernillo de actividades</a>.
        </p>

        </div>
        <div class="md:border-l md:border-caparol/15 md:pl-12">
        <div class="flex flex-wrap items-center gap-3 md:mt-2">
          <a
            href={reservaHref}
            target="_blank"
            rel="noopener noreferrer"
            class="group inline-flex items-center gap-2 rounded-full bg-arena px-5 py-3 font-display text-base tracking-[0.12em] text-azul uppercase shadow-[0_10px_24px_-10px_rgba(250,222,170,0.6)] transition hover:bg-caparol focus:outline-none focus-visible:ring-2 focus-visible:ring-arena focus-visible:ring-offset-2 focus-visible:ring-offset-azul"
          >
            <Icon name="simple-icons:whatsapp" class="h-5 w-5" aria-hidden="true" />
            Reserva tu cita
          </a>
        </div>
        <p class="mt-3 text-sm leading-relaxed text-caparol/75 sm:text-base">
          Para comprarlo o, si ya lo tienes, para la dedicatoria. No te compromete ni
          tienes que pagar nada antes.
        </p>
        <div class="mt-5">
          <EnlaceFlecha href="/repercusion#menores">Lo que dicen los niños</EnlaceFlecha>
        </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* Polaroid como en «Antes de comprarlo, míralo en movimiento» */
  .clip-frame {
    position: relative;
    background: var(--color-caparol);
    padding: 0.875rem 0.875rem 3.25rem;
    border-radius: 6px;
    box-shadow:
      0 22px 45px -14px rgba(6, 15, 44, 0.6),
      0 8px 16px -6px rgba(6, 15, 44, 0.4);
  }
  .clip-frame .player-wrap {
    border-radius: 2px;
    overflow: hidden;
  }
  .clip-caption {
    position: absolute;
    right: 0;
    bottom: 0.75rem;
    left: 0;
    text-align: center;
  }
</style>
