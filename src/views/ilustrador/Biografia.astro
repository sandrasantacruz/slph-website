---
import Ola from '../../components/Ola.astro';
// 7 · Breve y verificable: respalda, no protagoniza (la historia va antes).
// Breve y verificable: respalda la historia, no la protagoniza.
const parrafos = [
  'Ilustrador y diseñador gráfico nacido en Buenos Aires en 1977, Pablo tiene una larga experiencia en ilustración infantil: ha trabajado para editoriales como Ediciones Infantil.com, Editorial Sin Fin, Nova Rhoman y Duendes del Sur.',
  'Su trabajo abarca la creación de personajes, la ilustración editorial y el desarrollo de imágenes para diferentes formatos y soportes.',
  'Desde 2018, ese oficio tiene un mar propio: el de Si los peces hablaran…',
];
---

<section id="biografia" class="relative isolate overflow-hidden py-20 sm:py-28">
  <!-- Subtle seabed glow -->
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-x-0 inset-y-10 -z-20 bg-[radial-gradient(65%_55%_at_70%_50%,rgba(100,170,210,0.08),transparent_70%)]"
  >
  </div>

  <div class="mx-auto max-w-6xl px-6">
    <!-- Section eyebrow -->
    <div class="reveal flex items-center gap-5">
      <span aria-hidden="true" class="h-[2px] w-16 bg-arena sm:w-24"></span>
      <span class="font-display text-sm tracking-[0.4em] text-arena uppercase">
        Su trayectoria
      </span>
    </div>

    <!-- Headline -->
    <h2
      class="reveal reveal-delay-1 mt-8 max-w-4xl font-display text-[clamp(2.5rem,7vw,5.25rem)] leading-[0.92] text-caparol"
    >
      Pablo Tribiño:
      <span class="block">experiencia en</span>
      <span class="block">
        <Ola class="text-arena">ilustración infantil</Ola>
      </span>
    </h2>

    <!-- Two-column editorial body -->
    <div class="mt-14 grid gap-x-12 gap-y-8 md:grid-cols-12 md:gap-y-0">
      <!-- Left side: pull quote -->
      <aside class="reveal reveal-delay-2 md:col-span-4">
        <div class="sticky top-28">
          <p class="font-hand text-2xl text-celeste sm:text-3xl">
            su especialidad
          </p>
          <p class="mt-2 font-display text-2xl leading-tight text-arena sm:text-3xl">
            Dar rostro a cada personaje
          </p>
          <a href="https://www.linkedin.com/in/pablo-tribi%C3%B1o-805396b/" target="_blank" rel="noopener noreferrer" class="group mt-6 inline-flex items-center gap-2 font-display text-xs tracking-[0.3em] text-arena uppercase transition hover:text-caparol">
            Su LinkedIn
            <svg viewBox="0 0 24 24" class="h-4 w-4 transition-transform group-hover:translate-x-0.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
          </a>
        </div>
      </aside>

      <!-- Right side: narrative -->
      <div
        class="reveal reveal-delay-3 space-y-6 text-lg leading-relaxed text-caparol/90 sm:text-xl md:col-span-8"
      >
        {parrafos.map((p) => <p>{p}</p>)}
      </div>
    </div>
  </div>
</section>
