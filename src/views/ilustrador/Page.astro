---
import MainLayout from '../../layouts/MainLayout.astro';
import Hero from './Hero.astro';
import Biografia from './Biografia.astro';
import Galeria from './Galeria.astro';
import Proceso from './Proceso.astro';
import DosMiradas from './DosMiradas.astro';
import ConLosNinos from './ConLosNinos.astro';
import Cierre from './Cierre.astro';
import Universo from './Universo.astro';
import InvitanACrear from './InvitanACrear.astro';
import Julieta from './Julieta.astro';
import Izzy from './Izzy.astro';
import WaterLine from '../../components/WaterLine.astro';
import Lightbox from '../galeria/Lightbox.astro';
import SubNavCuento from '../../components/SubNavCuento.astro';
import { breadcrumbSchema, SITE_URL } from '../../lib/seo';

const breadcrumb = breadcrumbSchema([
  { name: 'Inicio', url: '/' },
  { name: 'Sobre el cuento', url: '/sobre-el-cuento' },
  { name: 'El ilustrador', url: '/ilustrador' },
]);

// Google: quién es Pablo (prioridad SEO: ilustración infantil, después su nombre)
const pablo = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': `${SITE_URL}/ilustrador#person`,
  name: 'Pablo Tribiño',
  url: `${SITE_URL}/ilustrador`,
  image: `${SITE_URL}/assets/colaboradores/pablo-tribino/portrait.jpg`,
  jobTitle: 'Ilustrador de cuentos infantiles',
  description:
    'Ilustrador y diseñador gráfico especializado en ilustración infantil. Creó los personajes y el universo marino del cuento Si los peces hablaran…, de Sandra Santa Cruz.',
  birthPlace: { '@type': 'Place', name: 'Buenos Aires, Argentina' },
  knowsAbout: ['Ilustración infantil', 'Ilustración de cuentos', 'Diseño de personajes', 'Diseño gráfico'],
  sameAs: ['https://www.linkedin.com/in/pablo-tribi%C3%B1o-805396b/'],
  workExample: { '@id': `${SITE_URL}/#book` },
};
---

<MainLayout
  title="Ilustrador de cuentos infantiles · Pablo Tribiño"
  description="Conoce a Pablo Tribiño, ilustrador de cuentos infantiles. Descubre cómo creó los personajes y el universo visual de Si los peces hablaran…"
  image="/assets/og-ilustrador.jpg"
  imageAlt="Pablo Tribiño, ilustrador de cuentos infantiles, en su estudio"
  imageWidth={1200}
  imageHeight={630}
  type="profile"
  hideWaterLine
  jsonLd={[pablo, breadcrumb]}
>
  <SubNavCuento current="ilustrador" />
  <!-- La historia de dos creativos; la trayectoria de Pablo respalda, al final -->
  <Hero />
  <Galeria />
  <Proceso />
  <WaterLine separador clave="-c" />
  <DosMiradas />
  <ConLosNinos />
  <InvitanACrear />
  <Julieta />
  <WaterLine separador clave="-a" />
  <Izzy />
  <WaterLine separador clave="-b" />
  <Universo />
  <Biografia />
  <WaterLine separador clave="-d" />
  <Cierre />
  <Lightbox />
</MainLayout>

<script>
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const targets = document.querySelectorAll<HTMLElement>('.reveal');

  if (reduceMotion) {
    targets.forEach((el) => el.classList.add('is-visible'));
  } else {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          }
        });
      },
      { rootMargin: '0px 0px -10% 0px', threshold: 0.05 },
    );
    targets.forEach((el) => observer.observe(el));
  }
</script>
