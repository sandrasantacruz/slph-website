---
import Ola from '../../components/Ola.astro';
---

<section class="relative isolate flex min-h-[calc(100svh-6rem)] flex-col overflow-hidden">
  <!-- Soft radial glow, top-left -->
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 -z-10 bg-[radial-gradient(55%_45%_at_20%_25%,rgba(250,222,170,0.10),transparent_70%)]"
  ></div>

  <div class="mx-auto flex h-full w-full max-w-7xl flex-1 flex-col justify-center px-6 py-8 sm:py-10">
    <!-- Eyebrow -->
    <div class="reveal flex items-center gap-3 sm:gap-4">
      <span aria-hidden="true" class="h-px w-8 bg-arena sm:w-16"></span>
      <span class="font-display text-[0.7rem] tracking-[0.35em] text-arena uppercase sm:text-sm sm:tracking-[0.4em]">
        El ilustrador
      </span>
    </div>

    <!-- Hero grid: name + portrait -->
    <div class="mt-6 grid grid-cols-12 items-center gap-x-5 gap-y-6 sm:mt-8 sm:gap-x-10 lg:gap-x-14">
      <!-- Left column: name + tags + lead -->
      <div class="reveal reveal-delay-1 order-2 col-span-12 flex flex-col justify-center lg:order-1 lg:col-span-7">
        <p class="font-hand text-xl text-celeste sm:text-3xl lg:text-4xl">conoce a…</p>

        <!-- H1 para Google: el nombre y «ilustrador de cuentos infantiles» -->
        <h1 class="mt-0.5 font-display text-[clamp(2.5rem,9vw,7.5rem)] leading-[0.85] tracking-tight text-caparol sm:mt-1">
          Pablo
          <span class="mt-0.5 block sm:mt-1"><Ola class="text-arena italic">Tribiño</Ola></span>
          <span class="mt-4 block font-display text-[clamp(1.1rem,2.6vw,1.9rem)] leading-tight tracking-normal text-celeste sm:mt-6">ilustrador de cuentos infantiles</span>
        </h1>

        <p class="mt-5 max-w-xl text-sm leading-relaxed text-caparol/90 sm:mt-6 sm:text-lg sm:leading-relaxed lg:text-xl">
          En <em class="not-italic text-arena">Si los peces hablaran…</em> no se dibujaron
          personajes para contar una historia: se creó un universo visual para que el
          cuento llegara mucho más lejos y despertara en los más pequeños el deseo de
          proteger el mar.
        </p>

        <!-- Índice de la página (es larga): baja directo a cada parte, como en Colabora -->
        <nav aria-label="En esta página" class="mt-7 flex flex-wrap items-center gap-x-5 gap-y-3 border-t border-caparol/10 pt-5 sm:mt-8">
          {[
            { href: '#trabajo', texto: 'Los personajes' },
            { href: '#proceso', texto: 'El proceso' },
            { href: '#con-los-ninos', texto: 'Con los niños' },
            { href: '#universo', texto: 'Un universo que viaja' },
          ].map((l) => (
            <a href={l.href} class="group inline-flex items-center gap-1.5 font-display text-xs tracking-[0.18em] text-arena uppercase transition hover:text-caparol sm:text-sm">
              {l.texto}
              <svg viewBox="0 0 24 24" class="h-4 w-4 transition-transform group-hover:translate-y-0.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M6 13l6 6 6-6"/></svg>
            </a>
          ))}
        </nav>
      </div>

      <!-- Portrait, right side -->
      <div class="reveal reveal-delay-2 order-1 col-span-12 flex items-center justify-center lg:order-2 lg:col-span-5">
        <div class="relative w-full max-w-[min(100%,42vh)]">
          <!-- Decorative dashed frame behind portrait -->
          <div
            aria-hidden="true"
            class="anim-sway absolute -inset-2 -z-10 rounded-[1.25rem] border-2 border-dashed border-arena/40 sm:-inset-3 sm:rounded-[1.5rem]"
          ></div>

          <div class="polaroid tilt-r1 w-full transition duration-500 hover:rotate-0" style="padding-bottom:3.25rem">
            <img
              src="/assets/colaboradores/pablo-tribino/portrait.jpg"
              alt="Pablo Tribiño, ilustrador de cuentos infantiles"
              class="block w-full"
              style="aspect-ratio:4/5"
              loading="eager"
              decoding="async"
              fetchpriority="high"
            />
            <p class="absolute bottom-1.5 left-0 right-0 px-2 text-center font-hand text-lg leading-tight text-azul sm:bottom-2 sm:px-3 sm:text-2xl">
              Pablo Tribiño
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
