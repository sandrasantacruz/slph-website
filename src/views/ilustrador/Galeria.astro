---
import Ola from '../../components/Ola.astro';
// Drei Reihen à drei, helle und dunkle Motive gemischt, damit jede Reihe Licht hat.
const imagenes = [
  {
    src: '/assets/colaboradores/pablo-tribino/el-coronel-espada-afilada-si-los-peces-hablaran.jpg',
    nombre: 'El coronel Espada Afilada',
    pie: 'El coronel Espada Afilada, el pez espada más valeroso',
  },
  {
    src: '/assets/colaboradores/pablo-tribino/dina-la-voladora-si-los-peces-hablaran.jpg',
    nombre: 'Dina la Voladora',
    pie: 'Dina la Voladora, la gran amiga de Bella Azul',
  },
  {
    src: '/assets/colaboradores/pablo-tribino/el-sr-tentaculus-si-los-peces-hablaran.jpg',
    nombre: 'El Sr. Tentáculus',
    pie: 'El Sr. Tentáculus, el pulpo encargado de una gran misión…',
  },
  {
    src: '/assets/colaboradores/pablo-tribino/gusshy-si-los-peces-hablaran.jpg',
    nombre: 'Gusshy',
    pie: 'Gusshy, el primero que coge un tridente para…',
  },
  {
    src: '/assets/colaboradores/pablo-tribino/bubli-si-los-peces-hablaran.jpg',
    nombre: 'Bubli',
    pie: 'Bubli, un caballito de mar muy curioso',
  },
  {
    src: '/assets/colaboradores/pablo-tribino/don-canino-si-los-peces-hablaran.jpg',
    nombre: 'Don Canino',
    pie: 'Don Canino, el tiburón más fuerte del arrecife, capaz de sacar un neumático del mar',
  },
  {
    src: '/assets/colaboradores/pablo-tribino/nela-la-irritable-si-los-peces-hablaran.jpg',
    nombre: 'Nela la Irritable',
    pie: 'Nela la Irritable, que solo se irrita cuando las cosas no se hacen bien',
  },
  {
    src: '/assets/colaboradores/pablo-tribino/erizoquetepincho-si-los-peces-hablaran.jpg',
    nombre: 'Erizoquetepincho',
    pie: 'Erizoquetepincho, el gran cantante del arrecife, primo de Erikoquetepico',
  },
  {
    src: '/assets/colaboradores/pablo-tribino/david-si-los-peces-hablaran.jpg',
    nombre: 'David',
    pie: 'David, el más trasto de los amigos de Lorena',
  },
];
---

<section id="trabajo" class="relative isolate overflow-hidden py-16 sm:py-24">
  <div class="mx-auto max-w-6xl px-6">
    <!-- 1 · El resultado, nada más empezar -->
    <div class="reveal mx-auto mb-10 max-w-3xl text-center">
      <p class="font-hand text-2xl text-celeste sm:text-3xl">de la mano de Pablo…</p>
      <h2 class="mt-2 font-display text-[clamp(2.1rem,5vw,3.5rem)] leading-[0.95] text-caparol">
        Un universo marino
        <span class="block">creado <Ola class="text-arena">trazo a trazo</Ola></span>
      </h2>
      <p class="mx-auto mt-5 max-w-xl text-lg leading-relaxed text-caparol/85">
        Así los ves hoy, pero ninguno empezó de esta manera.
      </p>
    </div>
    <div class="mx-auto grid max-w-3xl grid-cols-3 gap-3 sm:gap-4">
      {imagenes.map((imagen) => (
        <a
          href={imagen.src}
          target="_blank"
          rel="noopener noreferrer"
          data-lightbox
          data-gallery="pablo-tribino"
          data-caption={imagen.pie}
          class="reveal gallery-item group relative block aspect-square overflow-hidden rounded-xl bg-azul/30 ring-1 ring-caparol/10 transition duration-300 hover:-translate-y-1 hover:ring-arena/70 hover:shadow-[0_18px_30px_-12px_rgba(6,15,44,0.7)] focus:outline-none focus-visible:ring-2 focus-visible:ring-arena"
        >
          <img
            src={imagen.src}
            alt={`Ilustración infantil de ${imagen.nombre}, personaje del cuento Si los peces hablaran…, por Pablo Tribiño`}
            loading="lazy"
            class="h-full w-full object-cover transition duration-500 group-hover:scale-[1.06]"
          />
          <span aria-hidden="true" class="pointer-events-none absolute inset-0 bg-gradient-to-t from-azul/40 via-transparent to-transparent opacity-0 transition group-hover:opacity-100"></span>
        </a>
      ))}
    </div>

  </div>
</section>
