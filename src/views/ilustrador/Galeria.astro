---
const nombre = 'Pablo Tribiño';
const imagenes = [
  '/assets/colaboradores/pablo-tribino/gallery-1.jpg',
  '/assets/colaboradores/pablo-tribino/gallery-2.jpg',
  '/assets/colaboradores/pablo-tribino/gallery-3.jpg',
  '/assets/colaboradores/pablo-tribino/gallery-4.jpg',
];
---

<section id="trabajo" class="relative isolate overflow-hidden pb-24 sm:pb-32">
  <div class="mx-auto max-w-6xl px-6">
    <!-- Section header -->
    <div class="reveal mb-8 flex items-center gap-3 sm:gap-4">
      <span class="font-display text-xs tracking-[0.4em] text-arena uppercase sm:text-sm">
        De su mano
      </span>
      <span class="dotted-rule flex-1 text-arena/40"></span>
    </div>

    <div class="grid grid-cols-2 gap-3 sm:grid-cols-4 sm:gap-4">
      {imagenes.map((src, i) => (
        <a
          href={src}
          target="_blank"
          rel="noopener noreferrer"
          data-lightbox
          data-gallery="pablo-tribino"
          data-caption={`${nombre} — imagen ${i + 1} de ${imagenes.length}`}
          class="reveal gallery-item group relative block aspect-square overflow-hidden rounded-xl bg-azul/30 ring-1 ring-caparol/10 transition duration-300 hover:-translate-y-1 hover:ring-arena/70 hover:shadow-[0_18px_30px_-12px_rgba(6,15,44,0.7)] focus:outline-none focus-visible:ring-2 focus-visible:ring-arena"
        >
          <img
            src={src}
            alt={`${nombre} — imagen ${i + 1}`}
            loading="lazy"
            class="h-full w-full object-cover transition duration-500 group-hover:scale-[1.06]"
          />
          <span aria-hidden="true" class="pointer-events-none absolute inset-0 bg-gradient-to-t from-azul/40 via-transparent to-transparent opacity-0 transition group-hover:opacity-100"></span>
        </a>
      ))}
    </div>

    <!-- Back link to the collaborators register -->
    <div class="reveal mt-14 flex justify-center">
      <a
        href="/colabora"
        class="group inline-flex items-center gap-2 font-display text-sm tracking-[0.3em] text-arena uppercase transition hover:text-caparol"
      >
        <svg viewBox="0 0 24 24" class="h-4 w-4 transition-transform group-hover:-translate-x-0.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M19 12H5M11 18l-6-6 6-6"/>
        </svg>
        Ver a todo el equipo
      </a>
    </div>
  </div>
</section>
