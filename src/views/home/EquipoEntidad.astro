---
import Ola from '../../components/Ola.astro';

---

<section class="relative">
  <div class="mx-auto max-w-6xl px-6 py-20 sm:py-28">
    <div class="reveal mx-auto mb-14 max-w-2xl text-center">
      <p class="font-hand text-3xl text-arena sm:text-4xl">en banco somos más fuertes</p>
      <h2 class="mt-1 font-display text-[clamp(2rem,5vw,3.5rem)] leading-tight">
        Suma tu
        <Ola class="text-arena">aleta</Ola>
      </h2>
    </div>

    <div class="grid gap-8 md:grid-cols-2">
      <!-- Dark/deep card -->
      <article class="reveal reveal-delay-1 group relative overflow-hidden rounded-[2rem] bg-gradient-to-br from-azul/85 to-azul-deep/95 p-8 ring-1 ring-arena/30 sm:p-10">
        <!-- Decorative coral lines -->
        <svg class="pointer-events-none absolute -bottom-6 -left-6 h-40 w-40 text-arena/15" viewBox="0 0 100 100" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
          <path d="M20 90 Q 25 60 20 30 M30 90 Q 38 50 33 20 M45 95 Q 50 70 45 40 M60 90 Q 68 60 60 25" stroke-linecap="round"/>
        </svg>

        <div class="relative flex flex-col items-center gap-5 text-center">
          <img
            src="/assets/animals/don-erizo.webp"
            alt="Don Erizo, personaje del cuento"
            class="anim-float-soft w-40 drop-shadow-2xl sm:w-52"
            loading="lazy"
          />
          <p class="font-hand text-2xl text-arena sm:text-3xl">para personas</p>
          <h3 class="font-display text-3xl leading-tight sm:text-5xl">
            ¡En equipo
            <span class="text-arena">somos más!</span>
          </h3>
          <p class="text-base leading-relaxed text-caparol/90 sm:text-lg">
            Trabajar en equipo, escuchar y dar lo mejor está en nuestra
            filosofía. Estamos encantados de contar con personas
            comprometidas y profesionales, ¿quieres conocerlas?
          </p>
          <a
            href="/colabora"
            class="group/btn mt-2 inline-flex items-center gap-2 rounded-full border-2 border-caparol px-6 py-3 font-display text-lg text-caparol transition hover:bg-caparol hover:text-azul sm:text-xl"
          >
            Quiénes participan
            <svg viewBox="0 0 24 24" class="h-5 w-5 transition-transform group-hover/btn:translate-x-1" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
          </a>
        </div>
      </article>

      <!-- Light/sand card -->
      <article class="reveal reveal-delay-2 paper relative overflow-hidden rounded-[2rem] p-8 text-azul ring-1 ring-arena/40 sm:p-10">
        <!-- Decorative wave pattern -->
        <svg class="pointer-events-none absolute -right-4 -top-4 h-40 w-40 text-azul/10" viewBox="0 0 100 100" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
          <path d="M0 30 Q 25 10 50 30 T 100 30 M0 50 Q 25 30 50 50 T 100 50 M0 70 Q 25 50 50 70 T 100 70" stroke-linecap="round"/>
        </svg>

        <div class="relative flex flex-col items-center gap-5 text-center">
          <img
            src="/assets/animals/bogavante.webp"
            alt="Bogavante, personaje del cuento"
            class="anim-float-soft w-40 drop-shadow-xl sm:w-52"
            loading="lazy"
          />
          <p class="font-hand text-2xl text-azul/60 sm:text-3xl">para entidades</p>
          <h3 class="font-display text-3xl leading-tight sm:text-5xl">
            ¿Quieres sumar
            <span class="text-arena-deep">a tu entidad?</span>
          </h3>
          <p class="text-base leading-relaxed text-azul/85 sm:text-lg">
            Pregúntanos cómo puedes unirte al Programa SLPH para mejorar
            el impacto de tu organización en el medioambiente, fomentar
            la cultura ecológica y tejer redes con otras entidades.
          </p>
          <a
            href="/contacto"
            class="group/btn mt-2 inline-flex items-center gap-2 rounded-full bg-azul px-6 py-3 font-display text-lg text-caparol shadow-md transition hover:brightness-110 sm:text-xl"
          >
            Quiero más información
            <svg viewBox="0 0 24 24" class="h-5 w-5 transition-transform group-hover/btn:translate-x-1" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
          </a>
        </div>
      </article>
    </div>
  </div>
</section>
