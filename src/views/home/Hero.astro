---
import { Icon } from 'astro-icon/components';
import fishes from './img/fishes.webp?url';
import dreizack from './img/dreizack.webp?url';
---

<section class="relative isolate flex h-[calc(100svh-6rem)] flex-col overflow-hidden">
  <!-- Floating character — drifts behind the headline -->
  <img
    src={fishes}
    alt=""
    aria-hidden="true"
    class="anim-float pointer-events-none absolute right-4 top-10 -z-10 w-[14rem] opacity-25 sm:w-[18rem] md:w-[22rem] md:opacity-30 lg:w-[28rem] lg:opacity-40"
    loading="eager"
  />

  <!-- Dreizack — zentral, gespiegelt -->
  <img
    src={dreizack}
    alt=""
    aria-hidden="true"
    class="anim-float pointer-events-none absolute left-1/2 top-10 -z-10 hidden w-[14rem] -translate-x-1/2 -scale-x-100 opacity-30 lg:block"
    style="animation-delay: -2.5s;"
    loading="eager"
  />

  <div class="mx-auto flex h-full w-full max-w-6xl flex-col justify-center gap-4 px-6 py-4 sm:gap-5 sm:py-6">
    <!-- Headline -->
    <h1 class="reveal reveal-delay-1 font-display text-[clamp(2.25rem,7vw,5rem)] leading-[0.92] tracking-tight">
      <span class="block">Si los peces</span>
      <span class="block">hablaran<span class="text-arena">…</span></span>
      <span class="mt-1 block text-arena">
        <span class="hand-underline">te dirían</span>
      </span>
    </h1>

    <!-- Subhead -->
    <p class="reveal reveal-delay-2 max-w-2xl font-display text-xl leading-tight text-celeste sm:text-2xl md:text-3xl">
      Que el mar te necesita para seguir latiendo.
    </p>

    <!-- Body -->
    <p class="reveal reveal-delay-3 max-w-2xl text-sm leading-snug text-caparol/90 sm:text-base">
      Hace años, un océano en peligro inspiró un musical. Hoy, ese
      grito es una llamada a la acción, porque salvar el mar
      <em class="not-italic text-arena">también nos salva a nosotros.</em>
    </p>

    <!-- CTAs — always visible -->
    <div class="reveal reveal-delay-4 mt-1 flex flex-col items-stretch gap-2 sm:flex-row sm:items-center sm:gap-4">
      <a
        href="/programa"
        class="group inline-flex items-center justify-center gap-2 rounded-full border-2 border-caparol px-5 py-2.5 font-display text-lg text-caparol transition hover:bg-caparol hover:text-azul sm:px-6 sm:py-3 sm:text-xl"
      >
        Descubre el proyecto
        <svg viewBox="0 0 24 24" class="h-5 w-5 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <path d="M5 12h14M13 6l6 6-6 6"/>
        </svg>
      </a>
      <a
        href="/comprar"
        class="group inline-flex items-center justify-center gap-2 rounded-full bg-arena px-5 py-2.5 font-display text-lg text-negro transition hover:brightness-95 sm:px-6 sm:py-3 sm:text-xl"
      >
        Compra el cuento
        <svg viewBox="0 0 24 24" class="h-5 w-5 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round">
          <path d="M3 7h2l2 11h11l2-8H6"/>
          <circle cx="9" cy="21" r="1.4" fill="currentColor"/>
          <circle cx="17" cy="21" r="1.4" fill="currentColor"/>
        </svg>
      </a>
    </div>
  </div>

  <!-- Scroll cue — absolutely positioned so it doesn't push CTAs -->
  <a
    href="#programa-slph"
    aria-label="Bajar a la siguiente sección"
    class="scroll-cue absolute bottom-2 left-1/2 flex -translate-x-1/2 flex-col items-center gap-0.5 text-caparol/70 transition hover:text-arena sm:bottom-3 sm:gap-1"
  >
    <Icon name="game-icons:scuba-mask" class="h-6 w-6 sm:h-7 sm:w-7" aria-hidden="true" />
    <span class="font-hand text-base leading-none sm:text-xl">bucea</span>
    <svg viewBox="0 0 24 24" class="h-4 w-4 sm:h-5 sm:w-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M6 9l6 6 6-6"/>
    </svg>
  </a>
</section>

<style>
  .hero-wave svg { animation: hw-drift 18s ease-in-out infinite alternate; }
  .hw-back  { animation: hw-bob 9s ease-in-out infinite; }
  .hw-mid   { animation: hw-bob 7s ease-in-out -1.2s infinite; }
  .hw-front { animation: hw-bob 6s ease-in-out -2.4s infinite; }
  .hw-crest { animation: hw-bob 6s ease-in-out -2.4s infinite; }

  .hw-sparks circle {
    fill: #fadeaa;
    transform-box: fill-box;
    transform-origin: center;
    animation: hw-spark 3.8s ease-in-out infinite;
  }
  .hw-sparks circle:nth-child(1) { animation-delay: 0s;    }
  .hw-sparks circle:nth-child(2) { animation-delay: 0.7s;  }
  .hw-sparks circle:nth-child(3) { animation-delay: 1.4s;  }
  .hw-sparks circle:nth-child(4) { animation-delay: 2.1s;  }
  .hw-sparks circle:nth-child(5) { animation-delay: 2.8s;  }

  @keyframes hw-drift {
    0%   { transform: translate3d(-0.8%, 0, 0); }
    100% { transform: translate3d(0.8%, 0, 0); }
  }
  @keyframes hw-bob {
    0%, 100% { transform: translateY(0); }
    50%      { transform: translateY(-1.8px); }
  }
  @keyframes hw-spark {
    0%, 100% { opacity: 0.2; transform: scale(0.55); }
    50%      { opacity: 1;   transform: scale(1.3);  }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-wave svg, .hw-back, .hw-mid, .hw-front, .hw-crest, .hw-sparks circle {
      animation: none !important;
    }
  }
</style>
