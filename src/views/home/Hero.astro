---
import { Icon } from 'astro-icon/components';
import Ola from '../../components/Ola.astro';
import FlechaAgua from '../../components/FlechaAgua.astro';
---

<section class="relative isolate flex h-[calc(100svh-6rem)] flex-col overflow-hidden bg-azul">
  <!-- Hintergrundvideo. Läuft einmal durch und bleibt auf dem letzten Bild
       stehen (kein loop). Die Quelle setzt das Skript weiter unten, weil
       Chrome das media-Attribut an <source> ignoriert und sonst jedes Handy
       die 1080p-Fassung zöge.
       Das Poster liegt als <picture> darunter statt im poster-Attribut:
       so wählt der Browser per media-Query selbst zwischen Hochkant- und
       Querformat (gleiche Grenze wie das Skript, 767px), auch ohne JS und
       bei reduzierter Bewegung. Ein <video> ohne poster ist bis zum ersten
       Frame durchsichtig, man sieht also nahtlos das Bild darunter. -->
  <picture>
    <source media="(max-width: 767px)" srcset="/videos/hero-bg-720-poster.webp" width="720" height="1280" />
    <img
      src="/videos/hero-bg-poster.webp"
      width="1920"
      height="1080"
      alt=""
      aria-hidden="true"
      fetchpriority="high"
      class="absolute inset-0 -z-20 h-full w-full object-cover"
    />
  </picture>
  <video
    id="hero-bg-video"
    class="absolute inset-0 -z-20 h-full w-full object-cover"
    data-src-sm="/videos/hero-bg-720.mp4"
    data-src-lg="/videos/hero-bg.mp4"
    autoplay
    muted
    playsinline
    preload="auto"
    aria-hidden="true"
    tabindex="-1"
  ></video>

  <!-- Lesbarkeits-Layer. Mobil liegt der Text über der ganzen Breite, da
       deckt eine gleichmässige Schicht ab; ab md zieht der Text nach links,
       da darf rechts das Bild durch. -->
  <div
    class="pointer-events-none absolute inset-0 -z-10 bg-gradient-to-b from-azul/85 via-azul/80 to-azul/80 md:bg-gradient-to-r md:from-azul/95 md:via-azul/80 md:to-azul/40"
    aria-hidden="true"
  >
  </div>
  <div
    class="pointer-events-none absolute inset-x-0 bottom-0 -z-10 h-40 bg-gradient-to-b from-transparent to-azul"
    aria-hidden="true"
  >
  </div>

  <div class="mx-auto flex h-full w-full max-w-6xl flex-col justify-center gap-4 px-6 py-4 sm:gap-5 sm:py-6">
    <!-- Headline -->
    <h1 class="reveal reveal-delay-1 font-display text-[clamp(1.75rem,9.6vw,5rem)] leading-[0.92] tracking-tight">
      <!-- “Si los peces hablaran…” (el título del cuento) siempre en una línea,
           también en el móvil: la letra baja lo justo para que quepa; “te dirían”
           debajo. Los puntos suspensivos son tres burbujas; para Google y los
           lectores de pantalla queda el “…” como texto oculto. -->
      <span class="block whitespace-nowrap">Si los peces hablaran<span class="sr-only">…</span><span class="puntos-burbuja" aria-hidden="true"><i></i><i></i><i></i></span></span>
      <span class="mt-[0.12em] block text-arena">
        <Ola>te dirían</Ola>
      </span>
    </h1>

    <!-- Subhead -->
    <p class="reveal reveal-delay-2 max-w-2xl font-display text-xl leading-tight text-celeste sm:text-2xl md:text-3xl">
      Que el mar te necesita para seguir latiendo
    </p>

    <!-- Body -->
    <p class="reveal reveal-delay-3 max-w-2xl text-sm leading-snug text-caparol/90 sm:text-base">
      En 2016, un océano en peligro inspiró un musical. Hoy, ese
      grito es una llamada a&nbsp;la&nbsp;acción, porque salvar el mar
      <em class="not-italic font-semibold text-caparol">también nos salva a nosotros.</em>
    </p>

    <!-- Etiqueta tras el texto (idea de Sandra): primero emociona, luego define y prepara “Descubre el programa”.
         En celeste (28 nov 2026): el arena queda solo para “te dirían” y el botón, así destaca. -->
    <div class="reveal reveal-delay-3 flex items-center gap-3 sm:gap-4">
      <span aria-hidden="true" class="h-px w-8 shrink-0 bg-celeste sm:w-16"></span>
      <span class="font-display text-[0.7rem] leading-snug tracking-[0.3em] text-celeste uppercase sm:text-sm sm:tracking-[0.38em]">
        Programa de concienciación marina · arte, ciencia y educación
      </span>
    </div>

    <!-- CTAs (28 nov 2026): un solo botón principal, conocer el proyecto; la compra sigue en el
         “Comprar” del menú. El segundo gesto es actuar: el Club SLPH, más abajo en esta página. -->
    <div class="reveal reveal-delay-4 mt-1 flex flex-col items-stretch gap-3 sm:flex-row sm:items-center sm:gap-6">
      <a
        href="/programa"
        class="group inline-flex items-center justify-center gap-2 rounded-full bg-arena px-6 py-3 font-display text-lg text-azul shadow-lg transition hover:brightness-95 sm:text-xl"
      >
        Descubre el programa
        <FlechaAgua />
      </a>
      <a
        href="#club-slph"
        class="text-center font-display text-lg text-caparol underline decoration-arena/50 underline-offset-4 transition hover:text-arena hover:decoration-arena sm:text-left sm:text-xl"
      >
        o únete al Club SLPH ↓
      </a>
    </div>
  </div>

  <!-- Scroll cue — absolutely positioned so it doesn't push CTAs -->
  <a
    href="#programa-slph"
    aria-label="Bajar a la siguiente sección"
    class="scroll-cue absolute bottom-2 left-1/2 flex -translate-x-1/2 flex-col items-center gap-0.5 text-caparol/70 transition hover:text-arena sm:bottom-3 sm:gap-1"
  >
    <Icon name="game-icons:scuba-mask" class="h-8 w-8 sm:h-10 sm:w-10" aria-hidden="true" />
    <Ola color="blanco" class="font-hand text-lg leading-none sm:text-xl">bucea</Ola>
    <svg viewBox="0 0 24 24" class="h-4 w-4 sm:h-5 sm:w-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M6 9l6 6 6-6"/>
    </svg>
  </a>
</section>

<script is:inline>
  (() => {
    const video = document.getElementById('hero-bg-video');
    if (!video) return;

    // Bei reduzierter Bewegung bleibt es beim Poster: keine Quelle, kein Play.
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    const small = window.matchMedia('(max-width: 767px)').matches;
    video.src = small ? video.dataset.srcSm : video.dataset.srcLg;

    // Safari startet nicht immer von allein, wenn src erst per Skript kommt.
    const play = () => video.play().catch(() => {});
    play();

    // Ausserhalb des Viewports pausieren, damit ein weggescrolltes Video
    // keine Rechenzeit verbrennt. Nach dem Ende bleibt es stehen.
    if ('IntersectionObserver' in window) {
      new IntersectionObserver(
        ([entry]) => {
          if (video.ended) return;
          if (entry.isIntersecting) play();
          else video.pause();
        },
        { threshold: 0 },
      ).observe(video);
    }
  })();
</script>

<style>
  .hero-wave svg { animation: hw-drift 18s ease-in-out infinite alternate; }
  .hw-back  { animation: hw-bob 9s ease-in-out infinite; }
  .hw-mid   { animation: hw-bob 7s ease-in-out -1.2s infinite; }
  .hw-front { animation: hw-bob 6s ease-in-out -2.4s infinite; }
  .hw-crest { animation: hw-bob 6s ease-in-out -2.4s infinite; }

  .hw-sparks circle {
    fill: #fadeaa;
    transform-box: fill-box;
    transform-origin: center;
    animation: hw-spark 3.8s ease-in-out infinite;
  }
  .hw-sparks circle:nth-child(1) { animation-delay: 0s;    }
  .hw-sparks circle:nth-child(2) { animation-delay: 0.7s;  }
  .hw-sparks circle:nth-child(3) { animation-delay: 1.4s;  }
  .hw-sparks circle:nth-child(4) { animation-delay: 2.1s;  }
  .hw-sparks circle:nth-child(5) { animation-delay: 2.8s;  }

  @keyframes hw-drift {
    0%   { transform: translate3d(-0.8%, 0, 0); }
    100% { transform: translate3d(0.8%, 0, 0); }
  }
  @keyframes hw-bob {
    0%, 100% { transform: translateY(0); }
    50%      { transform: translateY(-1.8px); }
  }
  @keyframes hw-spark {
    0%, 100% { opacity: 0.2; transform: scale(0.55); }
    50%      { opacity: 1;   transform: scale(1.3);  }
  }


  /* “…” als drei Blasen in Arena, jede etwas größer und höher als die vorige */
  .puntos-burbuja {
    display: inline-flex;
    align-items: flex-end;
    gap: 0.06em;
    margin-left: 0.06em;
    vertical-align: baseline;
  }
  .puntos-burbuja i {
    display: block;
    border-radius: 50%;
    background: radial-gradient(circle at 32% 30%, rgba(255,255,255,.95) 0 14%, rgba(255,240,210,.18) 32%, rgba(250,222,170,.16) 60%, rgba(250,222,170,.6) 100%);
    /* borde y halo algo más marcados: sobre la foto de fondo se perdían */
    box-shadow: inset 0 0 0 1.5px rgba(250,222,170,1), 0 0 0 0.5px rgba(250,222,170,.6), 0 0 9px rgba(250,222,170,.6);
    animation: pb-mece 3.2s ease-in-out infinite;
  }
  .puntos-burbuja i:nth-child(1) { width: .15em; height: .15em; margin-bottom: .02em; }
  .puntos-burbuja i:nth-child(2) { width: .19em; height: .19em; margin-bottom: .12em; animation-delay: .4s; }
  .puntos-burbuja i:nth-child(3) { width: .24em; height: .24em; margin-bottom: .26em; animation-delay: .8s; }
  /* móvil: el título es más pequeño y las burbujas apenas se distinguían */
  @media (max-width: 767px) {
    .puntos-burbuja { gap: 0.07em; margin-left: 0.07em; }
    .puntos-burbuja i:nth-child(1) { width: .19em; height: .19em; }
    .puntos-burbuja i:nth-child(2) { width: .24em; height: .24em; margin-bottom: .14em; }
    .puntos-burbuja i:nth-child(3) { width: .3em; height: .3em; margin-bottom: .3em; }
  }
  @keyframes pb-mece { 50% { transform: translateY(-.06em); } }

  @media (prefers-reduced-motion: reduce) {
    .hero-wave svg, .hw-back, .hw-mid, .hw-front, .hw-crest, .hw-sparks circle, .puntos-burbuja i {
      animation: none !important;
    }
  }

  /* iPhone en modo de ahorro de energía: no reproduce el vídeo de fondo y pinta
     su botón de play encima. Fuera: se queda el póster, sin botón. */
  #hero-bg-video::-webkit-media-controls,
  #hero-bg-video::-webkit-media-controls-start-playback-button,
  #hero-bg-video::-webkit-media-controls-overlay-play-button {
    display: none !important;
    -webkit-appearance: none;
  }
</style>
