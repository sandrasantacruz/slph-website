<section id="programa-slph" class="relative">
  <div class="mx-auto max-w-4xl px-6 py-20 sm:py-28">
    <p class="reveal font-hand text-4xl leading-none text-arena sm:text-5xl">
      nuestro programa
    </p>

    <h2 class="reveal reveal-delay-1 mt-4 font-display text-[clamp(2.5rem,7vw,5rem)] leading-[0.95]">
      ¿Qué es
      <span class="text-arena">Si los peces hablaran</span>
      <span class="text-arena">…?</span>
    </h2>

    <p class="reveal reveal-delay-2 mt-8 max-w-2xl text-lg leading-relaxed sm:text-xl">
