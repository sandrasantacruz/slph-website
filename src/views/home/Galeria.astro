---
import obertura from "./img/galeria-obertura.webp?url";
import danzaAcuario from "./img/galeria-danza-acuario.webp?url";
import Ola from '../../components/Ola.astro';

// «Diez años dando voz al océano» (análisis de Inicio, nov. 2026): antes repetía los
// formatos de «Un programa, muchas formas de cuidar el mar»; ahora cuenta la trayectoria.
// Hitos y títulos iguales que el hilo del tiempo de la Galería; cifras del dossier.
const cifras = [
  { n: '+10', t: 'años', d: 'desde 2016' },
  { n: '+3.000', t: 'escolares', d: 'en el musical' },
  { n: '+60', t: 'entidades', d: 'que han difundido el mensaje' },
  { n: '4', t: 'islas', d: '¡y hasta Colombia!' },
];

const imagenes = [
  {
    src: '/assets/galeria/musical/01-los-peces-del-arrecife-960.webp',
    alt: 'Bailarines con trajes de peces en el estreno del musical Si los peces hablaran… en el Teatro CICCA, en 2016',
    anio: '2016',
    label: 'Nace el musical',
    href: '/noticias/si-los-peces-hablaran-denuncia-la-contaminacion-del-medio-marino-la-provincia',
    mas: 'El estreno',
    tilt: 'tilt-l1',
  },
  {
    src: danzaAcuario,
    alt: 'Danza ante el gran acuario de Poema del Mar en la presentación del cuento, en 2018',
    anio: '2018',
    label: 'El cuento llega a Poema del Mar',
    href: '/noticias/poema-del-mar',
    mas: 'En el Deep Sea',
    tilt: 'tilt-r2',
  },
  {
    src: obertura,
    alt: 'La Orquesta Filarmónica de Gran Canaria interpreta el formato sinfónico de Si los peces hablaran…, en 2021',
    anio: '2021',
    label: 'El mar suena en sinfónico',
    href: '/noticias/si-los-peces-hablaran-concierto-sinfonico-ofgc',
    mas: 'Con la Filarmónica de Gran Canaria',
    tilt: 'tilt-l2',
  },
  {
    src: '/assets/galeria/espectaculos/05-puntallana-la-palma-960.webp',
    alt: 'Público escolar ante el escenario de Si los peces hablaran… en Puntallana, La Palma, en 2025',
    anio: '2025',
    label: 'Cruza a otras islas',
    href: '/galeria#espectaculos',
    mas: 'Tenerife, La Palma y Fuerteventura',
    tilt: 'tilt-r1',
  },
];
---

<section class="relative">
  <div class="mx-auto max-w-6xl px-6 py-20 sm:py-28">
    <div class="reveal flex flex-col items-center text-center">
      <p class="font-hand text-3xl text-arena sm:text-4xl">
        SLPH ¡a toda vela!
      </p>
      <h3 class="mt-2 font-display text-[clamp(2rem,6vw,4.5rem)] leading-tight">
        Desde 2016 dando voz
        <Ola class="whitespace-nowrap text-arena">al océano</Ola>
      </h3>
    </div>

    <ul class="reveal reveal-delay-1 mx-auto mt-10 grid max-w-4xl grid-cols-2 gap-6 text-center sm:mt-12 sm:grid-cols-4">
      {cifras.map(({ n, t, d }) => (
        <li>
          <p class="font-display text-5xl leading-none text-arena sm:text-6xl">{n}</p>
          <p class="mt-2 font-display text-sm tracking-[0.25em] text-caparol/85 uppercase sm:text-base">{t}</p>
          <!-- qué cuenta cada cifra (crítica recibida, 27 nov 2026): «+60» no son financiadores -->
          <p class="mt-1 text-xs leading-snug text-caparol/60 sm:text-sm">{d}</p>
        </li>
      ))}
    </ul>

    <div
      class="mt-14 grid grid-cols-1 gap-10 sm:gap-12 md:grid-cols-2 md:gap-10"
    >
      {
        imagenes.map(({ src, alt, anio, label, href, mas, tilt }, i) => (
          <figure
            class:list={[
              "reveal group relative mx-auto w-full max-w-md",
              `reveal-delay-${(i % 4) + 1}`,
            ]}
          >
            <a href={href} class="block rounded-md focus:outline-none focus-visible:ring-2 focus-visible:ring-arena focus-visible:ring-offset-4 focus-visible:ring-offset-azul">
            <div
              class:list={[
                "polaroid transition duration-500 hover:rotate-0 hover:!scale-[1.03] hover:shadow-2xl",
                tilt,
              ]}
            >
              <img
                src={src}
                alt={alt}
                class="aspect-[3/2] w-full object-cover"
                loading="lazy"
              />
              <figcaption class="mt-2 text-center font-hand text-2xl text-azul">
                <span class="font-display text-xl text-arena-deep">{anio}</span> · {label}
              </figcaption>
            </div>
            <!-- Enlace visible (crítica recibida, 27 nov 2026): cada hito dice adónde lleva, subrayado y con flecha -->
            <span class="mt-4 flex items-center justify-center gap-1.5 font-display text-xs tracking-[0.2em] text-arena uppercase underline decoration-arena/40 underline-offset-4 transition group-hover:text-caparol sm:text-sm">
              {mas}
              <svg viewBox="0 0 24 24" class="h-3.5 w-3.5 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
            </span>
            </a>
          </figure>
        ))
      }
    </div>

    <p class="reveal mx-auto mt-16 max-w-3xl text-center font-hand text-[clamp(1.5rem,7vw,1.875rem)] leading-tight text-arena sm:text-4xl">
      Solo cuando algo nos toca de verdad,<span class="block">¡empieza el cambio!</span>
    </p>

    <div class="reveal mt-8 flex flex-wrap items-center justify-center gap-3 text-center sm:gap-4">
      <a
        href="/galeria"
        class="group inline-flex items-center gap-3 rounded-full bg-arena px-7 py-3 font-display text-xl text-azul shadow-lg transition hover:brightness-95 sm:text-2xl"
      >
        Galería de eventos
        <svg
          viewBox="0 0 24 24"
          class="h-5 w-5 transition-transform group-hover:translate-x-1"
          fill="none"
          stroke="currentColor"
          stroke-width="2.4"
          stroke-linecap="round"
        >
          <path d="M5 12h14M13 6l6 6-6 6"></path>
        </svg>
      </a>
      <a
        href="/noticias"
        class="group inline-flex items-center gap-3 rounded-full border-2 border-arena/70 px-7 py-[0.625rem] font-display text-xl text-arena transition hover:border-arena hover:bg-arena hover:text-azul sm:text-2xl"
      >
        Últimas noticias
        <svg
          viewBox="0 0 24 24"
          class="h-5 w-5 transition-transform group-hover:translate-x-1"
          fill="none"
          stroke="currentColor"
          stroke-width="2.4"
          stroke-linecap="round"
        >
          <path d="M5 12h14M13 6l6 6-6 6"></path>
        </svg>
      </a>
    </div>
  </div>
</section>
