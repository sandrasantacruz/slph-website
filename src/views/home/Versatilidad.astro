---
import cuentoImg from './img/cover-1.webp?url';
import centrosImg from './img/cover-2.webp?url';
import escenarioImg from './img/cover-3.webp?url';

const columnas = [
  {
    titulo: 'Librupeces',
    imagen: cuentoImg,
    alt: 'El cuento Si los peces hablaran',
    texto:
      'Cuento ilustrado lleno de personajes entrañables y aventuras emocionantes + cuaderno de activades para conectar con todas las edades.',
    tilt: 'tilt-l1',
    ctaTexto: 'Descubre el cuento',
    ctaHref: '/sobre-el-cuento',
  },
  {
    titulo: 'Centros educativos',
    imagen: centrosImg,
    alt: 'Niñas y niños participando en un taller SLPH',
    texto:
      'Talleres y materiales didácticos diseñados con docentes para llevar la educación marina a todas las aulas.',
    tilt: 'tilt-r1',
    ctaTexto: 'Ver el programa',
    ctaHref: '/programa',
  },
  {
    titulo: 'En el escenario',
    imagen: escenarioImg,
    alt: 'Actuación del musical Si los peces hablaran',
    texto:
      'Musical, conciertos y performances que convierten la concienciación en una experiencia colectiva inolvidable.',
    tilt: 'tilt-l2',
    ctaTexto: 'Ver la galería',
    ctaHref: '/galeria',
  },
];
---

<section class="relative isolate overflow-x-clip">
  <!-- Bridge character — Doña Paciencia descends from QueEs into Versatilidad -->
  <img
    src="/assets/animals/dona-paciencia.webp"
    alt=""
    aria-hidden="true"
    class="bridge-creature pointer-events-none absolute -top-14 right-2 z-10 w-28 drop-shadow-[0_18px_28px_rgba(6,15,44,0.55)] sm:-top-24 sm:right-10 sm:w-48 lg:w-56"
    loading="lazy"
  />

  <!-- Soft light filtering down — slightly cooler than QueEs, we're deeper now -->
  <div
    class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-2/3 bg-[radial-gradient(ellipse_at_top,_rgba(100,170,210,0.12),_transparent_75%)]"
    aria-hidden="true"
  ></div>

  <!-- Subtle sand-warmth from below -->
  <div
    class="pointer-events-none absolute inset-x-0 bottom-0 -z-10 h-1/3 bg-[radial-gradient(ellipse_at_bottom,_rgba(250,222,170,0.06),_transparent_75%)]"
    aria-hidden="true"
  ></div>

  <div class="mx-auto max-w-6xl px-6 py-20 sm:py-28">
    <div class="reveal mx-auto max-w-3xl text-center">
      <p class="font-hand text-3xl text-arena sm:text-4xl">varias maneras de bucear con nosotros…</p>
      <h2 class="mt-3 font-display text-[clamp(2rem,5vw,3.75rem)] leading-tight">
        Un programa diseñado para potenciar
        <span class="hand-underline text-arena">la versatilidad</span>
      </h2>
      <p class="mx-auto mt-5 max-w-2xl text-base sm:text-lg text-balance">
        Investigadores, biólogos, zoólogos, fotógrafos marinos, profesores,
        psicopedagogos y artistas se han aliado con menores para diseñarlo
        y llamar a la acción a toda la población.
      </p>
    </div>

    <div class="mt-16 grid gap-12 sm:gap-8 md:grid-cols-3 md:gap-6">
      {
        columnas.map(({ titulo, imagen, alt, texto, tilt, ctaTexto, ctaHref }, i) => (
          <article
            class:list={[
              'reveal group polaroid flex flex-col gap-3 transition duration-500 hover:rotate-0 hover:shadow-2xl',
              tilt,
              `reveal-delay-${i + 1}`,
            ]}
          >
            <div class="overflow-hidden rounded-sm">
              <img
                src={imagen}
                alt={alt}
                class="aspect-video w-full object-cover"
                loading="lazy"
              />
            </div>

            <div class="flex flex-1 flex-col px-1 pb-1 pt-2 text-azul">
              <h3 class="font-display text-3xl leading-tight sm:text-4xl">
                {titulo}
              </h3>
              <p class="mt-2 text-sm leading-relaxed text-azul/80 sm:text-base">{texto}</p>
              <a
                href={ctaHref}
                class="mt-auto inline-flex items-center gap-2 pt-4 font-display text-sm tracking-[0.2em] uppercase text-azul transition hover:text-arena"
              >
                {ctaTexto}
                <svg
                  viewBox="0 0 24 24"
                  class="h-4 w-4 transition-transform group-hover:translate-x-1"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="M5 12h14M13 6l6 6-6 6" />
                </svg>
              </a>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  /* The float keyframe rotates the creature around its tilted resting pose
     so it bobs in place instead of un-rotating mid-cycle. */
  .bridge-creature {
    animation: bridge-bob 7s ease-in-out infinite;
    transform-origin: center;
  }
  @keyframes bridge-bob {
    0%, 100% { transform: translateY(0)    rotate(-12deg); }
    50%      { transform: translateY(-8px) rotate(-9deg);  }
  }
  @media (prefers-reduced-motion: reduce) {
    .bridge-creature { animation: none !important; }
  }
</style>
