---
import centrosImg from './img/cover-2.webp?url';
import escenarioImg from './img/cover-3.webp?url';
import culturaImg from './img/cover-cultura.webp?url';
import socialImg from './img/cover-social.webp?url';
import Ola from '../../components/Ola.astro';

// Las cuatro líneas del Programa SLPH (análisis de Inicio, nov. 2026): así se ve que
// el cuento, los talleres, los espectáculos y la acción social son un mismo programa.
const columnas = [
  {
    titulo: 'Artes escénicas',
    imagen: escenarioImg,
    alt: 'Actuación del musical Si los peces hablaran',
    texto:
      'El musical, el formato sinfónico y las performances que convierten la concienciación en una experiencia colectiva inolvidable.',
    tilt: 'tilt-l1',
    ctaTexto: 'Los espectáculos',
    ctaHref: '/galeria#espectaculos',
  },
  {
    titulo: 'Educación',
    imagen: centrosImg,
    alt: 'Alumnado del CEIP Alfredo Kraus levanta la mano para participar en una actividad de Si los peces hablaran… en el aula',
    texto:
      'El cuento, su cuadernillo de actividades y material didáctico para docentes: una herramienta educativa que colegios como el CEIP Alfredo Kraus usan en el aula desde 2019.',
    tilt: 'tilt-r1',
    ctaTexto: 'Centros escolares',
    ctaHref: '/galeria#centros-escolares',
  },
  {
    titulo: 'Cultura y divulgación',
    imagen: culturaImg,
    alt: 'Gercende Courtois, Sandra Santa Cruz y May Gómez hablan ante el gran acuario de Poema del Mar',
    texto:
      'Talleres, exposiciones, conferencias con investigadoras marinas y eventos en museos, bibliotecas y ferias de toda Canarias.',
    tilt: 'tilt-l2',
    ctaTexto: 'Los talleres',
    ctaHref: '/programa#talleres',
  },
  {
    titulo: 'Acción social',
    imagen: socialImg,
    alt: 'Bella Azul, sentada en una habitación de la planta de Oncología Infantil de un hospital',
    texto:
      'Proyectos con alma, como acompañar con el cuento y el cuadernillo “Actividades y personajes para colorear” a los niños de Oncología Infantil y a sus familias.',
    tilt: 'tilt-r2',
    ctaTexto: 'Oncología Infantil',
    ctaHref: '/cuadernillo#oncologia',
  },
];
---

<section class="relative isolate overflow-x-clip">
  <!-- Bridge character — el Sr. Tentáculus baja de QueEs a Versatilidad (antes,
       Dña. Paciencia con la bolsa: ya sale dibujada en “¿Nos echas una aleta?”).
       Casi cuadrado (1024x935): anchos menores que los de la tortuga.
       En el móvil va centrado, como el texto (26 nov 2026); desde sm, a la derecha. -->
  <img
    src="/assets/animals/tentaculus.webp"
    alt=""
    aria-hidden="true"
    width="1024"
    height="935"
    class="bridge-creature pointer-events-none absolute inset-x-0 -top-14 z-10 mx-auto w-36 sm:inset-x-auto sm:right-10 sm:mx-0 drop-shadow-[0_18px_28px_rgba(6,15,44,0.55)] sm:-top-24 sm:right-10 sm:w-56 lg:-top-44 lg:right-12 lg:w-[17rem] xl:right-24"
    loading="lazy"
  />

  <!-- Soft light filtering down — slightly cooler than QueEs, we're deeper now -->
  <div
    class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-2/3 bg-[radial-gradient(ellipse_at_top,_rgba(100,170,210,0.12),_transparent_75%)]"
    aria-hidden="true"
  ></div>

  <!-- Subtle sand-warmth from below -->
  <div
    class="pointer-events-none absolute inset-x-0 bottom-0 -z-10 h-1/3 bg-[radial-gradient(ellipse_at_bottom,_rgba(250,222,170,0.06),_transparent_75%)]"
    aria-hidden="true"
  ></div>

  <div class="mx-auto max-w-6xl px-6 py-20 sm:py-28">
    <div class="reveal mx-auto max-w-3xl text-center">
      <p class="font-hand text-3xl text-arena sm:text-4xl">varias maneras de bucear con nosotros…</p>
      <h2 class="mt-3 font-display text-[clamp(2rem,5vw,3.75rem)] leading-tight">
        Un programa, muchas formas
        <Ola class="whitespace-nowrap text-arena">de cuidar el mar</Ola>
      </h2>
      <p class="mx-auto mt-5 max-w-2xl text-base sm:text-lg text-balance">
        Nace de la mano de Sandra Santa Cruz y suma el conocimiento de investigadoras
        marinas, psicopedagogos, docentes, fotógrafos y artistas. Sus protagonistas: los
        más pequeños, que llaman a la acción a toda la sociedad.
      </p>
    </div>

    <div class="mt-16 grid gap-12 sm:grid-cols-2 sm:gap-8 lg:grid-cols-4 lg:gap-6">
      {
        columnas.map(({ titulo, imagen, alt, texto, tilt, ctaTexto, ctaHref, cta2Texto, cta2Href }, i) => (
          <article
            class:list={[
              'reveal group polaroid flex flex-col gap-3 transition duration-500 hover:rotate-0 hover:shadow-2xl',
              tilt,
              `reveal-delay-${i + 1}`,
            ]}
          >
            <div class="overflow-hidden rounded-sm">
              <img
                src={imagen}
                alt={alt}
                class="aspect-video w-full object-cover"
                loading="lazy"
              />
            </div>

            <div class="flex flex-1 flex-col px-1 pb-1 pt-2 text-azul">
              <h3 class="font-display text-3xl leading-tight sm:text-4xl">
                {titulo}
              </h3>
              <p class="mt-2 text-sm leading-relaxed text-azul/80 sm:text-base">{texto}</p>
              <div class="mt-auto flex flex-wrap gap-x-6 gap-y-2 pt-4">
                <a
                  href={ctaHref}
                  class="inline-flex items-center gap-2 font-display text-sm tracking-[0.2em] uppercase text-azul transition hover:text-arena"
                >
                  {ctaTexto}
                  <svg
                    viewBox="0 0 24 24"
                    class="h-4 w-4 transition-transform group-hover:translate-x-1"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <path d="M5 12h14M13 6l6 6-6 6" />
                  </svg>
                </a>
                {cta2Href && (
                  <a
                    href={cta2Href}
                    class="inline-flex items-center gap-2 font-display text-sm tracking-[0.2em] uppercase text-azul transition hover:text-arena"
                  >
                    {cta2Texto}
                    <svg
                      viewBox="0 0 24 24"
                      class="h-4 w-4 transition-transform group-hover:translate-x-1"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                    >
                      <path d="M5 12h14M13 6l6 6-6 6" />
                    </svg>
                  </a>
                )}
              </div>
            </div>
          </article>
        ))
      }
    </div>

    <div class="reveal mt-12 flex justify-center sm:mt-14">
      <a
        href="/programa#formatos"
        class="group inline-flex items-center justify-center gap-2 rounded-full border-2 border-caparol px-6 py-3 font-display text-lg text-caparol transition hover:bg-caparol hover:text-azul sm:text-xl"
      >
        Descubre todos los formatos
        <svg viewBox="0 0 24 24" class="h-5 w-5 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
      </a>
    </div>
  </div>
</section>

<style>
  /* The float keyframe rotates the creature around its tilted resting pose
     so it bobs in place instead of un-rotating mid-cycle. */
  .bridge-creature {
    animation: bridge-bob 7s ease-in-out infinite;
    transform-origin: 50% 30%;
  }
  /* el Sr. Tentáculus: como un pulpo de verdad, se encoge un momento (toma
     impulso), se estira al subir y baja planeando despacio */
  @keyframes bridge-bob {
    0%, 100% { transform: translateY(0) rotate(-6deg) scale(1, 1); }
    18%      { transform: translateY(3px) rotate(-7deg) scale(1.05, 0.93); }
    40%      { transform: translateY(-12px) rotate(-4deg) scale(0.96, 1.05); }
    70%      { transform: translateY(-7px) rotate(-5deg) scale(1, 1); }
  }
  @media (prefers-reduced-motion: reduce) {
    .bridge-creature { animation: none !important; }
  }
</style>
