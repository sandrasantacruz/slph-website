---
import ClubSLPH from '../../components/ClubSLPH.astro';
import MainLayout from '../../layouts/MainLayout.astro';
import Hero from './Hero.astro';
import Trailer from './Trailer.astro';
import QueEs from './QueEs.astro';
import Versatilidad from './Versatilidad.astro';
import PorQueUrgente from './PorQueUrgente.astro';
import SabiasQue from './SabiasQue.astro';
import Ciencia from './Ciencia.astro';
import CuentoFascina from './CuentoFascina.astro';
import QuienDetras from './QuienDetras.astro';
import Galeria from './Galeria.astro';
import Faq from './Faq.astro';
import EquipoEntidad from './EquipoEntidad.astro';
import Colaboran from './Colaboran.astro';
import WaterLine from '../../components/WaterLine.astro';
import {
  bookSchema,
  personSandraSchema,
  faqSchema,
} from '../../lib/seo';
import { HOME_FAQ } from './faq-data';
---

<MainLayout
  title="Si los peces hablaran… · Cuento infantil y programa para proteger el mar"
  description="¿Qué nos dirían si los peces hablaran? Un programa que protege el mar con arte, ciencia y educación, creado en Gran Canaria por Sandra Santa Cruz."
  image="/assets/og-inicio.jpg"
  imageAlt="Si los peces hablaran… te dirían que el mar te necesita para seguir latiendo: portada de la 3.ª edición del cuento"
  imageWidth={1200}
  imageHeight={630}
  jsonLd={[bookSchema(), personSandraSchema(), faqSchema(HOME_FAQ)]}
>
  <Hero />
  <Trailer />
  <QueEs />
  <Versatilidad />
  <PorQueUrgente />
  <Ciencia />
  <!-- la acción personal: después del problema y de la ciencia, lo que puede hacer cada uno -->
  <WaterLine separador clave="-club" />
  <ClubSLPH />
  <WaterLine separador clave="-cuento" />
  <SabiasQue />
  <CuentoFascina />
  <WaterLine separador clave="-quien" />
  <QuienDetras />
  <Galeria />
  <Faq />
  <!-- de contar el proyecto a pedir colaboración. “¿Nos echas una aleta?” (la llamada a particulares)
       la sustituye el Club SLPH, más arriba (27 nov 2026) -->
  <WaterLine separador />
  <EquipoEntidad />
  <Colaboran modo="compacto" />
</MainLayout>

<script>
  // Scroll-triggered reveal — toggles `.is-visible` on `.reveal` elements
  // once they enter the viewport. CSS handles the transition.
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const targets = document.querySelectorAll<HTMLElement>('.reveal');

  if (reduceMotion) {
    targets.forEach((el) => el.classList.add('is-visible'));
  } else {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          }
        });
      },
      { rootMargin: '0px 0px -10% 0px', threshold: 0.05 },
    );
    targets.forEach((el) => observer.observe(el));
  }
</script>
