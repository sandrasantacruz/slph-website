---
import ayuntamiento from './img/col/ayuntamiento.webp?url';
import bmFundacion from './img/col/bm-fundacion.webp?url';
import cabildoEducacion from './img/col/cabildo-educacion.webp?url';
import cabildo from './img/col/cabildo.webp?url';
import cabildoOfgc from './img/col/cabldo-ofgc.webp?url';
import candidata from './img/col/candidata.webp?url';
import conciertosEnFamilia from './img/col/conciertos-en-familia.webp?url';
import disa from './img/col/disa.webp?url';
import ecoaqua from './img/col/ecoaqua.webp?url';
import entretiteres from './img/col/entretiteres.webp?url';
import eomar from './img/col/eomar.webp?url';
import iusa from './img/col/iusa.webp?url';
import escolares from './img/col/escolares.webp?url';
import fcm from './img/col/fcm.webp?url';
import grancaeduca from './img/col/grancaeduca.webp?url';
import lpgc from './img/col/lpgc.webp?url';
import mares from './img/col/mares.webp?url';
import maspalomas from './img/col/maspalomas.webp?url';
import perezGaldos from './img/col/perez-galdos.webp?url';
import teror2 from './img/col/teror-2.webp?url';
import teror from './img/col/teror.webp?url';
import tijarafe from './img/col/tijarafe.webp?url';
import casaDeColon from './img/col/casa-de-colon.webp?url';
import leonYCastillo from './img/col/leon-y-castillo.webp?url';
import cuevaPintada from './img/col/cueva-pintada.webp?url';
import bibliotecaEstado from './img/col/biblioteca-publica-estado.webp?url';
import laOliva from './img/col/la-oliva.webp?url';
import puntallana from './img/col/puntallana.webp?url';
import altres from './img/col/altres.webp?url';

// Agrupados por el tipo de relación con SLPH (análisis de Inicio, nov. 2026): así no
// parece que todas las entidades tengan el mismo papel. Las dos marcas del Ayuntamiento
// de Las Palmas de G. C. se quedan porque fueron departamentos distintos.
const grupos = [
  {
    titulo: 'Instituciones públicas',
    logos: [
      { src: cabildo, alt: 'Cabildo de Gran Canaria' },
      { src: cabildoEducacion, alt: 'Consejería de Educación · Cabildo de Gran Canaria' },
      { src: grancaeduca, alt: 'GranCaEduca · Cabildo de Gran Canaria' },
      { src: ayuntamiento, alt: 'Ayuntamiento de Las Palmas de Gran Canaria' },
      { src: lpgc, alt: 'LPGC, tu ciudad para vivir · Ayuntamiento de Las Palmas de Gran Canaria' },
      { src: candidata, alt: 'Candidatura de Las Palmas de Gran Canaria a Capital Europea de la Cultura 2031' },
      { src: teror2, alt: 'Ayuntamiento de Teror' },
      { src: teror, alt: 'Auditorio de Teror' },
      { src: maspalomas, alt: 'Maspalomas Costa Canaria' },
      { src: tijarafe, alt: 'Ayuntamiento de Tijarafe' },
      { src: laOliva, alt: 'Cultura · Ayuntamiento de La Oliva' },
      { src: puntallana, alt: 'Ayuntamiento de Puntallana' },
      { src: mares, alt: 'MARES · Instituto Canario de Desarrollo Cultural' },
    ],
  },
  {
    titulo: 'Ciencia',
    logos: [
      { src: fcm, alt: 'Facultad de Ciencias del Mar · ULPGC' },
      { src: ecoaqua, alt: 'Instituto ECOAQUA · ULPGC' },
      { src: eomar, alt: 'EOMAR · Ecofisiología de Organismos Marinos · ULPGC' },
      { src: iusa, alt: 'Instituto Universitario de Sanidad Animal y Seguridad Alimentaria (IUSA) · ULPGC', ancho: true },
    ],
  },
  {
    titulo: 'Cultura',
    logos: [
      { src: cabildoOfgc, alt: 'Orquesta Filarmónica de Gran Canaria' },
      { src: escolares, alt: 'Conciertos Escolares de la Orquesta Filarmónica de Gran Canaria' },
      { src: conciertosEnFamilia, alt: 'Conciertos en Familia de la Orquesta Filarmónica de Gran Canaria' },
      { src: perezGaldos, alt: 'Casa-Museo Pérez Galdós', ancho: true },
      { src: casaDeColon, alt: 'Casa de Colón' },
      { src: leonYCastillo, alt: 'Casa-Museo León y Castillo' },
      { src: cuevaPintada, alt: 'Museo y Parque Arqueológico Cueva Pintada' },
      { src: bibliotecaEstado, alt: 'Biblioteca Pública del Estado en Las Palmas' },
      { src: entretiteres, alt: 'Entretíteres, compañía de teatro' },
    ],
  },
  {
    titulo: 'Fundaciones y asociaciones',
    logos: [
      { src: bmFundacion, alt: 'Fundación Belén María' },
      { src: disa, alt: 'Fundación DISA' },
      { src: altres, alt: 'Asociación ALTRES' },
    ],
  },
];
---

<section class="relative">
  <div class="mx-auto max-w-5xl px-6 pb-24 pt-32 sm:pb-32 sm:pt-40">
    <div class="reveal relative">
      <!-- Anchor descending on a rope into the card -->
      <div class="pointer-events-none absolute left-1/2 top-0 z-10 -translate-x-1/2 -translate-y-[58%]">
        <svg
          class="anim-sway h-28 w-14 text-arena drop-shadow-[0_4px_12px_rgba(6,15,44,0.45)] sm:h-32 sm:w-16"
          viewBox="0 0 40 110"
          fill="none"
          aria-hidden="true"
          style="transform-origin: 50% 5%;"
        >
          <!-- Twisted rope -->
          <path
            d="M20 0 Q 23 10 18 20 Q 23 30 18 40 Q 23 50 20 60"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            opacity="0.75"
          />
          <!-- Anchor ring -->
          <circle cx="20" cy="66" r="3.5" stroke="currentColor" stroke-width="2" fill="none"/>
          <!-- Shaft -->
          <path d="M20 70 v24" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/>
          <!-- Crossbar -->
          <path d="M13 76 h14" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/>
          <!-- Flukes -->
          <path
            d="M8 92 a12 12 0 0 0 24 0"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            fill="none"
          />
          <path d="M6 92 l4 -4 M34 92 l-4 -4" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/>
        </svg>
      </div>

      <!-- Dark "slate" card — switched from the light paper variant so the
           white entity logos read clearly. -->
      <div
        class="relative overflow-hidden rounded-[2.5rem] bg-azul/60 p-10 text-caparol ring-1 ring-arena/40 shadow-[0_30px_60px_-20px_rgba(6,15,44,0.65)] backdrop-blur-sm sm:p-14"
      >

        <p class="relative mt-8 text-center font-hand text-3xl text-arena sm:mt-10 sm:text-4xl">anclamos con…</p>
        <h3 class="relative mt-2 text-center font-display text-3xl leading-tight text-caparol sm:text-4xl">
          Organismos oficiales y entidades
        </h3>

        <!-- La misma línea dorada de la superficie del agua, bajo la cabecera -->
        <svg class="relative mx-auto mt-6 block h-5 w-56 sm:mt-8 sm:w-72" viewBox="0 0 480 30" preserveAspectRatio="none" aria-hidden="true">
          <defs>
            <linearGradient id="col-cresta" x1="0" y1="0" x2="1" y2="0">
              <stop offset="0%" stop-color="#fadeaa" stop-opacity="0" />
              <stop offset="18%" stop-color="#fadeaa" stop-opacity="0.95" />
              <stop offset="82%" stop-color="#fadeaa" stop-opacity="0.95" />
              <stop offset="100%" stop-color="#fadeaa" stop-opacity="0" />
            </linearGradient>
            <filter id="col-brillo" x="-10%" y="-80%" width="120%" height="260%"><feGaussianBlur stdDeviation="1.6" /></filter>
          </defs>
          <path d="M0,16 C 60,6 100,26 160,16 C 220,6 260,24 320,16 C 380,8 420,24 480,16" fill="none" stroke="#fadeaa" stroke-opacity="0.45" stroke-width="4" stroke-linecap="round" filter="url(#col-brillo)" />
          <path d="M0,16 C 60,6 100,26 160,16 C 220,6 260,24 320,16 C 380,8 420,24 480,16" fill="none" stroke="url(#col-cresta)" stroke-width="1.6" stroke-linecap="round" />
          <g fill="#fadeaa"><circle cx="120" cy="14" r="1.6" /><circle cx="250" cy="17" r="1.3" /><circle cx="370" cy="13" r="1.6" /></g>
        </svg>

        <div class="relative mt-12 space-y-12 sm:mt-14 sm:space-y-14">
          {
            grupos.map(({ titulo, logos }) => (
              <div>
                <h4 class="flex items-center justify-center gap-3 font-display text-sm tracking-[0.3em] text-arena uppercase sm:text-base">
                  <span aria-hidden="true" class="h-px w-8 bg-arena/50 sm:w-12"></span>
                  {titulo}
                  <span aria-hidden="true" class="h-px w-8 bg-arena/50 sm:w-12"></span>
                </h4>
                <ul class="mt-6 flex flex-wrap items-center justify-center gap-x-8 gap-y-8 sm:mt-8 sm:gap-x-10">
                  {logos.map(({ src, alt, ancho }: { src: string; alt: string; ancho?: boolean }) => (
                    <!-- «ancho»: logos apaisados con mucho texto (IUSA), con más sitio para que se lean -->
                    <li class:list={['flex items-center justify-center', ancho ? 'w-[80%] sm:w-[34%] lg:w-[26%]' : 'w-[42%] sm:w-[22%] lg:w-[17%]']}>
                      <img
                        src={src}
                        alt={alt}
                        class="h-16 w-auto max-w-full object-contain opacity-90 brightness-0 invert transition duration-300 ease-out hover:-translate-y-0.5 hover:scale-105 hover:opacity-100 sm:h-20 lg:h-24"
                        loading="lazy"
                      />
                    </li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>

        <!-- CTA -->
        <div class="relative mt-14 flex flex-col items-center gap-3 sm:mt-16">
          <p class="font-hand text-2xl text-caparol/70 sm:text-3xl">¿quieres remar con nosotras?</p>
          <a
            href="/colabora"
            class="group/cta inline-flex items-center gap-2 rounded-full bg-arena px-7 py-3 font-display text-lg text-azul shadow-md transition hover:brightness-110 sm:text-xl"
          >
            Échanos una aleta
            <svg
              viewBox="0 0 24 24"
              class="h-5 w-5 transition-transform group-hover/cta:translate-x-1"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M5 12h14M13 6l6 6-6 6"/>
            </svg>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
