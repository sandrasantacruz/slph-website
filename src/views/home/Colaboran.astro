---
import ayuntamiento from './img/col/ayuntamiento.webp?url';
import bmFundacion from './img/col/bm-fundacion.webp?url';
import cabildoEducacion from './img/col/cabildo-educacion.webp?url';
import cabildo from './img/col/cabildo.webp?url';
import cabildoOfgc from './img/col/cabldo-ofgc.webp?url';
import candidata from './img/col/candidata.webp?url';
import conciertosEnFamilia from './img/col/conciertos-en-familia.webp?url';
import disa from './img/col/disa.webp?url';
import ecoaqua from './img/col/ecoaqua.webp?url';
import entretiteres from './img/col/entretiteres.webp?url';
import eomar from './img/col/eomar.webp?url';
import escolares from './img/col/escolares.webp?url';
import fcm from './img/col/fcm.webp?url';
import grancaeduca from './img/col/grancaeduca.webp?url';
import lpgc from './img/col/lpgc.webp?url';
import mares from './img/col/mares.webp?url';
import maspalomas from './img/col/maspalomas.webp?url';
import perezGaldos from './img/col/perez-galdos.webp?url';
import santaCruz from './img/col/santa-cruz.webp?url';
import teror2 from './img/col/teror-2.webp?url';
import teror from './img/col/teror.webp?url';
import tijarafe from './img/col/tijarafe.webp?url';

const logos = [
  { src: cabildo, alt: 'Cabildo de Gran Canaria' },
  { src: cabildoEducacion, alt: 'Consejería de Educación · Cabildo de Gran Canaria' },
  { src: cabildoOfgc, alt: 'Orquesta Filarmónica de Gran Canaria' },
  { src: candidata, alt: 'Candidatura Las Palmas de Gran Canaria · Capital Cultural Europea 2031' },
  { src: lpgc, alt: 'Las Palmas de Gran Canaria' },
  { src: maspalomas, alt: 'Maspalomas' },
  { src: teror, alt: 'Teror' },
  { src: teror2, alt: 'Teror' },
  { src: ayuntamiento, alt: 'Ayuntamiento' },
  { src: tijarafe, alt: 'Tijarafe' },
  { src: santaCruz, alt: 'Santa Cruz' },
  { src: fcm, alt: 'Facultad de Ciencias del Mar · ULPGC' },
  { src: ecoaqua, alt: 'EcoAqua' },
  { src: eomar, alt: 'EOMAR' },
  { src: mares, alt: 'Mares' },
  { src: grancaeduca, alt: 'GranCaEduca' },
  { src: escolares, alt: 'Escolares' },
  { src: conciertosEnFamilia, alt: 'Conciertos en familia' },
  { src: perezGaldos, alt: 'Casa-Museo Pérez Galdós' },
  { src: entretiteres, alt: 'Entretíteres' },
  { src: bmFundacion, alt: 'Fundación Belén María' },
  { src: disa, alt: 'DISA' },
];
---

<section class="relative">
  <div class="mx-auto max-w-5xl px-6 pb-24 pt-32 sm:pb-32 sm:pt-40">
    <div class="reveal relative">
      <!-- Anchor descending on a rope into the card -->
      <div class="pointer-events-none absolute left-1/2 top-0 z-10 -translate-x-1/2 -translate-y-[58%]">
        <svg
          class="anim-sway h-28 w-14 text-arena drop-shadow-[0_4px_12px_rgba(6,15,44,0.45)] sm:h-32 sm:w-16"
          viewBox="0 0 40 110"
          fill="none"
          aria-hidden="true"
          style="transform-origin: 50% 5%;"
        >
          <!-- Twisted rope -->
          <path
            d="M20 0 Q 23 10 18 20 Q 23 30 18 40 Q 23 50 20 60"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            opacity="0.75"
          />
          <!-- Anchor ring -->
          <circle cx="20" cy="66" r="3.5" stroke="currentColor" stroke-width="2" fill="none"/>
          <!-- Shaft -->
          <path d="M20 70 v24" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/>
          <!-- Crossbar -->
          <path d="M13 76 h14" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/>
          <!-- Flukes -->
          <path
            d="M8 92 a12 12 0 0 0 24 0"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            fill="none"
          />
          <path d="M6 92 l4 -4 M34 92 l-4 -4" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/>
        </svg>
      </div>

      <!-- Dark "slate" card — switched from the light paper variant so the
           white entity logos read clearly. -->
      <div
        class="relative overflow-hidden rounded-[2.5rem] bg-azul/60 p-10 text-caparol ring-1 ring-arena/40 shadow-[0_30px_60px_-20px_rgba(6,15,44,0.65)] backdrop-blur-sm sm:p-14"
      >
        <!-- Wave pattern, bottom-left -->
        <svg
          class="pointer-events-none absolute -bottom-6 -left-6 h-36 w-36 text-caparol/[0.06] sm:h-44 sm:w-44"
          viewBox="0 0 100 100"
          fill="none"
          stroke="currentColor"
          stroke-width="1.4"
          aria-hidden="true"
        >
          <path d="M0 30 Q 25 10 50 30 T 100 30 M0 50 Q 25 30 50 50 T 100 50 M0 70 Q 25 50 50 70 T 100 70" stroke-linecap="round"/>
        </svg>
        <!-- Wave pattern, top-right (mirrored) -->
        <svg
          class="pointer-events-none absolute -right-6 -top-6 h-36 w-36 -scale-x-100 text-caparol/[0.06] sm:h-44 sm:w-44"
          viewBox="0 0 100 100"
          fill="none"
          stroke="currentColor"
          stroke-width="1.4"
          aria-hidden="true"
        >
          <path d="M0 30 Q 25 10 50 30 T 100 30 M0 50 Q 25 30 50 50 T 100 50 M0 70 Q 25 50 50 70 T 100 70" stroke-linecap="round"/>
        </svg>

        <p class="relative text-center font-hand text-3xl text-arena sm:text-4xl">anclamos con…</p>
        <h3 class="relative mt-2 text-center font-display text-3xl leading-tight text-caparol sm:text-4xl">
          <span class="relative inline-block">
            <span
              class="pointer-events-none absolute inset-x-0 bottom-1 h-3 rounded-full bg-arena/40"
              aria-hidden="true"
            ></span>
            <span class="relative">Organismos oficiales y entidades</span>
          </span>
        </h3>

        <!-- Dotted rule separator -->
        <div class="dotted-rule relative mx-auto mt-10 w-32 text-caparol/30 sm:mt-12"></div>

        <ul class="relative mt-12 grid grid-cols-2 items-center gap-x-6 gap-y-10 sm:mt-14 sm:grid-cols-4 sm:gap-x-10 lg:grid-cols-5">
          {
            logos.map(({ src, alt }) => (
              <li class="flex items-center justify-center">
                <img
                  src={src}
                  alt={alt}
                  class="h-16 w-auto max-w-full object-contain opacity-90 brightness-0 invert transition duration-300 ease-out hover:-translate-y-0.5 hover:scale-105 hover:opacity-100 sm:h-20 lg:h-24"
                  loading="lazy"
                />
              </li>
            ))
          }
        </ul>

        <!-- CTA -->
        <div class="relative mt-14 flex flex-col items-center gap-3 sm:mt-16">
          <p class="font-hand text-2xl text-caparol/70 sm:text-3xl">¿quieres remar con nosotras?</p>
          <a
            href="/colabora"
            class="group/cta inline-flex items-center gap-2 rounded-full bg-arena px-7 py-3 font-display text-lg text-azul shadow-md transition hover:brightness-110 sm:text-xl"
          >
            Echa una aleta
            <svg
              viewBox="0 0 24 24"
              class="h-5 w-5 transition-transform group-hover/cta:translate-x-1"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M5 12h14M13 6l6 6-6 6"/>
            </svg>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
