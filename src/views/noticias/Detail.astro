---
import MainLayout from '../../layouts/MainLayout.astro';
import type { RecordModel } from 'pocketbase';
import { PB_URL } from '../../lib/pb';
import { renderBlocks } from '../../lib/blocknote-render';

interface Props {
  item: RecordModel;
}

const { item } = Astro.props;

const dateFmt = new Intl.DateTimeFormat('es-ES', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});

const cover = Array.isArray(item.cover) ? item.cover[0] : item.cover;
const coverUrl = cover
  ? `${PB_URL}/api/files/${item.collectionId}/${item.id}/${cover}?thumb=1600x900`
  : null;

const date = item.published_at ? dateFmt.format(new Date(item.published_at)) : '';

const html = renderBlocks(item.content);
---

<MainLayout title={item.title || 'Noticia'} description={item.excerpt}>
  <article class="pb-24">
    <header class="mx-auto max-w-3xl px-4 pt-12 sm:pt-20">
      <a href="/noticias" class="inline-block text-sm text-arena hover:underline">
        ← Volver a noticias
      </a>
      {date && (
        <p class="mt-6 text-xs uppercase tracking-wider text-arena">{date}</p>
      )}
      <h1 class="mt-3 font-display text-4xl leading-[1.05] text-caparol sm:text-6xl">
        {item.title}
      </h1>
      {item.excerpt && (
        <p class="mt-6 text-lg text-caparol/85">{item.excerpt}</p>
      )}
    </header>

    {coverUrl && (
      <div class="mx-auto mt-12 max-w-5xl px-4">
        <img
          src={coverUrl}
          alt={item.title}
          class="aspect-[16/9] w-full rounded-2xl object-cover"
        />
      </div>
    )}

    <div class="prose-slph mx-auto mt-12 max-w-3xl px-4" set:html={html} />
  </article>
</MainLayout>

<style is:global>
  .prose-slph {
    color: var(--color-caparol);
    font-size: 1.05rem;
    line-height: 1.7;
  }
  .prose-slph p {
    margin: 0 0 1.25em;
  }
  .prose-slph h1,
  .prose-slph h2,
  .prose-slph h3 {
    font-family: var(--font-display);
    color: var(--color-arena);
    margin: 2em 0 0.6em;
    line-height: 1.15;
  }
  .prose-slph h1 { font-size: 2.4rem; }
  .prose-slph h2 { font-size: 1.9rem; }
  .prose-slph h3 { font-size: 1.5rem; }
  .prose-slph a {
    color: var(--color-arena);
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .prose-slph ul,
  .prose-slph ol {
    margin: 0 0 1.25em 1.25em;
    padding: 0;
  }
  .prose-slph li {
    margin: 0.4em 0;
  }
  .prose-slph ul { list-style: disc; }
  .prose-slph ol { list-style: decimal; }
  .prose-slph figure {
    margin: 2em 0;
  }
  .prose-slph figure img,
  .prose-slph figure video {
    border-radius: 1rem;
    max-width: 100%;
    height: auto;
  }
  .prose-slph figcaption {
    margin-top: 0.5em;
    font-size: 0.875rem;
    color: rgb(from var(--color-caparol) r g b / 0.65);
    text-align: center;
  }
  .prose-slph code {
    background: rgb(255 255 255 / 0.08);
    padding: 0.15em 0.4em;
    border-radius: 0.25rem;
    font-size: 0.95em;
  }
  .prose-slph pre {
    background: rgb(0 0 0 / 0.3);
    padding: 1em;
    border-radius: 0.75rem;
    overflow-x: auto;
    margin: 1.5em 0;
  }
  .prose-slph pre code {
    background: transparent;
    padding: 0;
  }
  .prose-slph blockquote {
    border-left: 3px solid var(--color-arena);
    padding-left: 1em;
    margin: 1.5em 0;
    color: rgb(from var(--color-caparol) r g b / 0.8);
    font-style: italic;
  }
</style>
