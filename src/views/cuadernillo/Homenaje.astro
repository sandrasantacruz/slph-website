---
import ConElApoyo from '../../components/ConElApoyo.astro';
import Ola from '../../components/Ola.astro';
import { Icon } from 'astro-icon/components';
import { SETTINGS, whatsappHref } from '../../lib/settings';

// Dónde comprar el cuadernillo (mismos datos que /comprar, etiqueta “también el cuadernillo”)
const mapa = (q: string) => `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(q)}`;
const reserva = `${whatsappHref(SETTINGS.whatsapp)}?text=${encodeURIComponent('Hola, quiero reservar el cuadernillo de actividades de Si los peces hablaran…')}`;
const puntos = [
  { name: 'Centro de Danza Sandra Santa Cruz', city: 'Las Palmas de Gran Canaria', address: 'Av. de Escaleritas, 56, 35011', reserva: true },
  { name: 'Librería Trébol', city: 'Teror', address: 'C. Real de la Pl., 7, 35330' },
  { name: 'Librería Greda Canarias', city: 'Teror', address: 'Plaza del Pino, 1, 35330' },
];
---

<section id="oncologia" class="relative isolate scroll-mt-28 overflow-hidden pb-24 sm:pb-32">
  <div class="mx-auto max-w-6xl px-6">
    <!-- Emotive highlight panel: the Oncología Infantil edition -->
    <div class="reveal relative overflow-hidden rounded-3xl border border-arena/25 bg-azul/50 p-8 ring-1 ring-caparol/10 sm:p-12">
      <!-- Corner glow -->
      <div
        aria-hidden="true"
        class="pointer-events-none absolute inset-0 -z-10 bg-[radial-gradient(50%_60%_at_85%_15%,rgba(250,222,170,0.10),transparent_70%)]"
      ></div>

      <p class="font-hand text-2xl text-celeste sm:text-3xl">un proyecto con alma</p>

      <h2 class="mt-3 max-w-3xl font-display text-[clamp(2rem,5.5vw,3.75rem)] leading-[0.95] text-caparol">
        Para oxigenar
        <Ola class="text-arena">hospitales infantiles</Ola>
      </h2>

      <div class="mt-6 max-w-3xl space-y-5 text-lg leading-relaxed text-caparol/90 sm:text-xl">
        <p>
          Hay una edición del cuadernillo pensada para Oncología Infantil. Lorena, Bubli,
          el Sr. Tentáculus, Dormilona, el delfín Alegría y sus amigos llegan a las plantas
          del hospital para regalar un rato de juego y de calma a los niños ingresados, y también a
          sus familias, que los llenan de amor en todo momento.
        </p>
        <p class="font-display text-2xl text-arena sm:text-3xl">
          Cada página es una forma de decirles que no están solos.
        </p>
      </div>

      <!-- Las dos fotos del hospital (antes, sección “Llevando el arte donde más se necesita”) -->
      <ul class="mt-10 grid max-w-4xl grid-cols-1 justify-items-center gap-y-10 sm:grid-cols-2 sm:items-start sm:gap-x-10">
        {[
          { src: '/assets/cuento/oncologia-infantil-slph.webp', alt: 'Los personajes de Si los peces hablaran visitando la planta de Oncología Infantil de un hospital', caption: 'visitando Oncología Infantil', tilt: 'tilt-l1' },
          { src: '/assets/cuento/oncologia-infantil-slph-2.webp', alt: 'Niñas de la compañía leyendo el cuento con una pequeña paciente en la sala de juegos del hospital', caption: 'esperanza y alegría', tilt: 'tilt-r1' },
        ].map((foto) => (
          <li class="w-full max-w-[20rem] sm:max-w-none">
            <div class={`polaroid ${foto.tilt} w-full transition duration-500 hover:rotate-0`}>
              <img src={foto.src} alt={foto.alt} class="block w-full object-cover" style="aspect-ratio:3/4" width="750" height="1000" loading="lazy" decoding="async" />
              <p class="absolute right-0 bottom-2 left-0 px-3 text-center font-hand text-xl leading-tight text-azul sm:text-2xl">{foto.caption}</p>
            </div>
          </li>
        ))}
      </ul>


      <!-- Weiterführende Links zum Oncología-Projekt -->
      <div class="mt-10 max-w-3xl">
        <p class="font-display text-sm uppercase tracking-[0.25em] text-celeste">
          Para saber más
        </p>

        <ul class="mt-4 divide-y divide-caparol/10 border-y border-caparol/10">
          {
            [
              {
                kicker: 'Artículo',
                title: 'Por qué queremos llegar a Oncología Infantil',
                href: 'https://www.muchomasquedanza.com/hospitales-de-oncologia-infantil/',
              },
              {
                kicker: 'Entrevista',
                title: 'Hablamos del proyecto en Radio Las Palmas',
                href: 'https://www.instagram.com/reel/DJr03ePMxx3/',
              },
            ].map((link) => (
              <li>
                <a
                  href={link.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="group flex items-center justify-between gap-6 py-4 transition hover:text-arena"
                >
                  <span>
                    <span class="block font-hand text-lg text-celeste sm:text-xl">
                      {link.kicker}
                    </span>
                    <span class="block text-lg leading-snug text-caparol group-hover:text-arena sm:text-xl">
                      {link.title}
                    </span>
                  </span>
                  <svg
                    viewBox="0 0 24 24"
                    class="h-5 w-5 shrink-0 text-arena transition-transform group-hover:translate-x-1"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <path d="M7 17 17 7M8 7h9v9" />
                  </svg>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <!-- Consigue tu cuadernillo: el recorrido de compra (familias y, al final, colegios) -->
    <div id="consiguelo" class="reveal mt-16 scroll-mt-28 rounded-3xl border border-arena/30 bg-azul/40 p-7 ring-1 ring-caparol/10 sm:mt-20 sm:p-10">
      <div class="flex flex-wrap items-end justify-between gap-x-8 gap-y-3">
        <div>
          <p class="font-hand text-2xl text-celeste sm:text-3xl">¿navegas con nosotros?</p>
          <h2 class="mt-1 font-display text-[clamp(1.9rem,4.5vw,3rem)] leading-[0.95] text-caparol">
            Consigue tu <Ola class="text-arena">cuadernillo</Ola>
          </h2>
        </div>
        <p class="font-display text-3xl text-arena sm:text-4xl">5 €</p>
      </div>
      <p class="mt-4 max-w-2xl text-lg leading-relaxed text-caparol/85">
        Juegos, actividades y personajes para seguir descubriendo el mundo marino. Se vende
        por separado o con el
        <a href="/sobre-el-cuento" class="text-arena underline decoration-arena/40 underline-offset-4 hover:decoration-arena">cuento</a>.
      </p>
      <ul class="mt-6 divide-y divide-caparol/10 border-y border-caparol/10">
        {puntos.map((p) => (
          <li class="flex flex-wrap items-center justify-between gap-x-6 gap-y-2 py-4">
            <p class="flex items-start gap-2">
              <Icon name="game-icons:position-marker" class="mt-0.5 h-5 w-5 shrink-0 text-arena" aria-hidden="true" />
              <span>
                <span class="font-display text-lg text-caparol">{p.name}</span>
                <span class="text-caparol/70"> · {p.city}</span>
              </span>
            </p>
            <span class="flex flex-wrap items-center gap-x-5 gap-y-2 pl-7 sm:pl-0">
              <a href={mapa(`${p.name}, ${p.address} ${p.city}`)} target="_blank" rel="noopener noreferrer" class="font-display text-xs tracking-[0.16em] text-arena uppercase transition hover:text-caparol">Cómo llegar</a>
              {p.reserva && (
                <a href={reserva} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 font-display text-xs tracking-[0.16em] text-arena uppercase transition hover:text-caparol">
                  <Icon name="simple-icons:whatsapp" class="h-4 w-4" aria-hidden="true" />
                  Resérvalo
                </a>
              )}
            </span>
          </li>
        ))}
      </ul>
      <a href="/contacto" class="group mt-6 inline-flex items-center gap-2 text-base text-caparol/85 transition hover:text-arena sm:text-lg">
        Para colegios y proyectos, <span class="text-arena underline decoration-arena/40 underline-offset-4 group-hover:decoration-arena">consulta las posibilidades de colaboración</span>
        <svg viewBox="0 0 24 24" class="h-4 w-4 text-arena transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
      </a>
      <p class="mt-2 text-base text-caparol/85 sm:text-lg">
        Y si quieres vivir el mar en directo, conoce nuestros
        <a href="/programa#talleres" class="text-arena underline decoration-arena/40 underline-offset-4 hover:decoration-arena">Talleres SLPH</a>.
      </p>
    </div>

    <!-- Quienes hicieron posible el cuadernillo -->
    <ConElApoyo class="reveal mx-auto mt-16 max-w-3xl border-t border-caparol/10 pt-8" />
  </div>
</section>
