---
import MainLayout from '../../layouts/MainLayout.astro';
import Hero from './Hero.astro';
import Contenido from './Contenido.astro';
import Homenaje from './Homenaje.astro';
import { breadcrumbSchema } from '../../lib/seo';

const breadcrumb = breadcrumbSchema([
  { name: 'Inicio', url: '/' },
  { name: 'Sobre el cuento', url: '/sobre-el-cuento' },
  { name: 'El cuadernillo', url: '/cuadernillo' },
]);
---

<MainLayout
  title="El cuadernillo · Cuaderno de actividades"
  description="El cuaderno de actividades de Si los peces hablaran: juegos y actividades para prolongar la aventura del cuento y conectar con el mar, para todas las edades. Con una edición pensada para Oncología Infantil."
  type="book"
  hideWaterLine
  jsonLd={[breadcrumb]}
>
  <Hero />
  <Contenido />
  <Homenaje />
</MainLayout>

<script>
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const targets = document.querySelectorAll<HTMLElement>('.reveal');

  if (reduceMotion) {
    targets.forEach((el) => el.classList.add('is-visible'));
  } else {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          }
        });
      },
      { rootMargin: '0px 0px -10% 0px', threshold: 0.05 },
    );
    targets.forEach((el) => observer.observe(el));
  }
</script>
