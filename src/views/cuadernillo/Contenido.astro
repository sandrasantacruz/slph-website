---
import Ola from '../../components/Ola.astro';
const features = [
  {
    title: 'Juegos y pasatiempos',
    body: 'Laberintos, personajes para colorear, diferencias, sombras por descubrir y dibujos que aparecen al unir los números. La historia sigue más allá de sus páginas.',
    accent: 'arena',
  },
  {
    title: 'En casa o en el aula',
    body: 'Pensado para los más pequeños, para jugar en familia o con todo el grupo en clase.',
    accent: 'celeste',
  },
  {
    title: 'Con códigos QR',
    body: 'En la contraportada, siete códigos QR te llevan al origen del proyecto, a las investigadoras marinas, a los talleres, a la pequeña Betta… Del musical al programa, en tu móvil.',
    accent: 'arena',
  },
];
const paginas = [
  { f: 'pagina-4', w: 800, h: 800, t: 'agudiza la vista…', alt: 'Página 4 del cuadernillo: «Encuentra las cinco diferencias…», con el Sr. Tentáculus' },
  { f: 'pagina-5', w: 800, h: 800, t: '¿las encontraste?', alt: 'Página 5 del cuadernillo: «…del Sr. Tentáculus», el mismo dibujo con cinco diferencias' },
  { f: 'pagina-12', w: 800, h: 800, t: 'Lorena también lleva pañuelo', alt: 'Página 12 del cuadernillo, para colorear: Doña Teresa de la mano de Julieta y de Lorena, que lleva pañuelo' },
  { f: 'pagina-9', w: 800, h: 800, t: '¿quién dirige la coral? D…', alt: 'Página 9 del cuadernillo: une los números para descubrir un personaje del cuento' },
  { f: 'pagina-10', w: 800, h: 800, t: '¡uy, el laberinto de la basura!', alt: 'Página 10 del cuadernillo: laberinto para descubrir qué se degrada más lento, una botella de plástico, una caja de cartón o una lata' },
  { f: 'pagina-16', w: 800, h: 800, t: '¡escanéame!', alt: 'Contraportada del cuadernillo: siete códigos QR con el origen del proyecto, las investigadoras marinas, los talleres SLPH, la pequeña Betta, colaboraciones y testimonios' },
];
---
<section id="contenido" class="relative isolate overflow-hidden py-20 sm:py-28">
  <!-- Subtle seabed glow -->
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-x-0 inset-y-10 -z-20 bg-[radial-gradient(65%_55%_at_30%_50%,rgba(100,170,210,0.08),transparent_70%)]"
  >
  </div>

  <div class="mx-auto max-w-6xl px-6">
    <!-- Section eyebrow -->
    <div class="reveal flex items-center gap-5">
      <span aria-hidden="true" class="h-[2px] w-16 bg-arena sm:w-24"></span>
      <span class="font-display text-sm tracking-[0.4em] text-arena uppercase">
        Qué encontrarás
      </span>
    </div>

    <!-- Headline -->
    <h2
      class="reveal reveal-delay-1 mt-8 max-w-4xl font-display text-[clamp(2.5rem,7vw,5.25rem)] leading-[0.92] text-caparol"
    >
      La aventura
      <span class="block">
        <Ola class="text-arena">continúa</Ola>
      </span>
    </h2>

    <p class="reveal reveal-delay-2 mt-6 max-w-2xl text-lg leading-relaxed text-caparol/90 sm:text-xl">
      El cuadernillo de actividades acompaña al cuento y convierte la lectura en
      una experiencia para hacer, jugar y compartir.
    </p>

    <!-- Feature cards -->
    <ul class="mt-12 grid gap-6 sm:mt-16 sm:grid-cols-3 sm:gap-7">
      {features.map((f, i) => (
        <li class={`reveal reveal-delay-${Math.min(i + 1, 4)} flex h-full flex-col gap-3 rounded-2xl border border-caparol/15 bg-azul/40 p-7 ring-1 ring-caparol/10 sm:p-8`}>
          <span aria-hidden="true" class={`h-[3px] w-12 ${f.accent === 'arena' ? 'bg-arena' : 'bg-celeste'}`}></span>
          <h3 class="mt-2 font-display text-2xl leading-tight text-caparol sm:text-3xl">
            {f.title}
          </h3>
          <p class="text-base leading-relaxed text-caparol/85">
            {f.body}
          </p>
        </li>
      ))}
    </ul>

    <!-- Alumnas del Centro de Danza con el cuadernillo (MVI_0385): 14–22 s a velocidad normal, 23–90 s a ×3 y 131,5–141,3 s normal (cierran el cuadernillo); sin sonido -->
    <figure class="reveal mx-auto mt-16 max-w-4xl sm:mt-20">
      <div class="overflow-hidden rounded-2xl shadow-[0_24px_48px_-18px_rgba(3,10,35,0.85)] ring-1 ring-caparol/15">
        <video src="/assets/cuadernillo/alumnas-cuadernillo.mp4" poster="/assets/cuadernillo/alumnas-cuadernillo-poster.jpg" width="960" height="540" autoplay muted loop playsinline aria-label="Tres alumnas del Centro de Danza Sandra Santa Cruz, sentadas en el suelo, hacen juntas las actividades del cuadernillo" class="block aspect-video w-full object-cover"></video>
      </div>
      <figcaption class="mt-3 text-center font-hand text-xl text-celeste sm:text-2xl">así lo viven nuestras alumnas del Centro de Danza</figcaption>
    </figure>

    <!-- Un vistazo por dentro: páginas definitivas del cuadernillo (PDF de la 3.ª edición) -->
    <div class="mt-16 sm:mt-20">
      <p class="reveal text-center font-hand text-2xl text-celeste sm:text-3xl">un vistazo por dentro</p>
      <ul class="carrusel -mx-6 mt-6 flex snap-x snap-mandatory items-end gap-4 overflow-x-auto px-6 pb-2 sm:mx-0 sm:grid sm:grid-cols-3 sm:gap-5 lg:grid-cols-6 sm:overflow-visible sm:px-0 sm:pb-0">
        {paginas.map((p, i) => (
          <li class={`reveal reveal-delay-${Math.min(i + 1, 4)} w-[62%] shrink-0 snap-center sm:w-auto`}>
            <a href={`/assets/cuadernillo/${p.f}.jpg`} data-lightbox data-gallery="cuadernillo-paginas" data-caption={p.t} class="block cursor-zoom-in">
              <img src={`/assets/cuadernillo/${p.f}.jpg`} alt={p.alt} width={p.w} height={p.h} loading="lazy" decoding="async" class="aspect-square w-full rounded-2xl object-cover shadow-[0_24px_48px_-18px_rgba(3,10,35,0.85)] ring-1 ring-caparol/15" />
            </a>
            <p class="mt-2 text-center font-hand text-xl text-celeste">{p.t}</p>
          </li>
        ))}
      </ul>
      <p class="mt-3 text-center font-hand text-xl text-celeste/80 sm:hidden" aria-hidden="true">desliza para ver más →</p>

      <!-- Uno de los siete QR de la contraportada («Origen del proyecto»), idéntico al del papel.
           En el móvil no se puede escanear la propia pantalla: ahí funciona como enlace. -->
      <figure class="reveal mt-12 flex flex-col items-center">
        <a
          href="https://youtu.be/YM4q_VqACh4"
          target="_blank"
          rel="noopener"
          class="block w-44 rotate-[2deg] rounded-2xl bg-white p-3 shadow-[0_20px_40px_-16px_rgba(3,10,35,0.8)] transition duration-500 hover:rotate-0 sm:w-52"
          aria-label="Vídeo: el origen del proyecto Si los peces hablaran… (YouTube)"
        >
          <img src="/assets/cuadernillo/qr-origen-del-proyecto.png" alt="Código QR «Origen del proyecto» de la contraportada del cuadernillo" width="400" height="400" class="block h-auto w-full [image-rendering:pixelated]" loading="lazy" decoding="async" />
        </a>
        <figcaption class="mt-4 max-w-64 text-center font-hand text-xl leading-snug text-celeste sm:text-2xl">
          <span class="qr-escritorio">escanéame y verás el origen del proyecto</span>
          <span class="qr-movil">púlsame y verás el origen del proyecto</span>
        </figcaption>
      </figure>
    </div>

    <!-- Todo el trabajo que no se ve: Pablo en su tableta (2019) y el vídeo de las capas de una página -->
    <div class="mt-16 grid items-center gap-8 sm:mt-20 lg:grid-cols-12 lg:gap-12">
      <div class="reveal grid grid-cols-2 gap-4 lg:order-2 lg:col-span-6">
        <div class="overflow-hidden rounded-2xl shadow-[0_24px_48px_-18px_rgba(3,10,35,0.85)] ring-1 ring-caparol/15">
          <video src="/assets/cuadernillo/capas-cuadernillo.mp4" poster="/assets/cuadernillo/capas-cuadernillo-poster.jpg" width="474" height="850" autoplay muted loop playsinline aria-label="Una página del cuadernillo en el programa de diseño, en modo esquema: cientos de trazados y capas superpuestos" class="block aspect-[4/5] w-full object-cover"></video>
        </div>
        <a href="/assets/cuadernillo/pablo-tableta.jpg" data-lightbox data-gallery="cuadernillo-trabajo" data-caption="Pablo Tribiño, ilustrando en su tableta (2019)" class="block cursor-zoom-in">
          <img src="/assets/cuadernillo/pablo-tableta.jpg" alt="Tableta gráfica de Pablo Tribiño con el Sr. Tentáculus a medio colorear en pantalla" width="1280" height="960" loading="lazy" decoding="async" class="aspect-[4/5] w-full rounded-2xl object-cover shadow-[0_24px_48px_-18px_rgba(3,10,35,0.85)] ring-1 ring-caparol/15" />
        </a>
      </div>
      <div class="reveal reveal-delay-1 lg:order-1 lg:col-span-6">
        <p class="font-hand text-2xl text-celeste sm:text-3xl">todo el trabajo que no se ve</p>
        <p class="mt-3 text-lg leading-relaxed text-caparol/90 sm:text-xl">
          Cientos de trazados, uno sobre otro: así se ve por dentro una página de este
          cuadernillo, ilustrada por
          <a href="/ilustrador" class="text-arena underline decoration-arena/40 underline-offset-4 hover:decoration-arena">Pablo Tribiño</a>.
          Todo, en el cuento y en el cuadernillo, se trabaja por capas para controlarlo
          al milímetro, y algunos archivos pesaban tanto que costaba abrirlos.
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  .qr-movil { display: none; }
  @media (pointer: coarse) and (max-width: 767px) {
    .qr-movil { display: inline; }
    .qr-escritorio { display: none; }
  }
</style>
