---
import fs from "node:fs";
import path from "node:path";

// Seiten zur Build-Zeit aus dem Ordner lesen, damit die Anzahl nicht
// auseinanderläuft, wenn das Fragment neu aus dem PDF generiert wird.
const BASE = path.resolve(process.cwd(), "public/assets/fragmento");
const pages = fs
  .readdirSync(BASE)
  // Solo las páginas (01.webp, 02.webp…): las versiones ligeras «-640/-960»
  // que usa Sobre el cuento no son páginas.
  .filter((f) => /^\d+\.webp$/i.test(f))
  .sort()
  .map((file, i) => ({ n: i + 1, src: `/assets/fragmento/${file}`, src960: `/assets/fragmento/${file.replace(".webp", "-960.webp")}` }));
// Rapidez (26 nov 2026): solo las 4 primeras páginas se descargan al abrir la página;
// las demás, unas páginas por delante de la que se está leyendo. En el móvil, 960 px.
const PRIMERAS = 4;
const totalPages = pages.length;
---

<section id="fragmento" class="relative isolate scroll-mt-24 overflow-hidden pt-8 pb-20 sm:pb-28">
  <!-- Subtle celeste glow behind the book -->
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-full bg-[radial-gradient(60%_60%_at_50%_20%,rgba(100,170,210,0.14),transparent_70%)]"
  >
  </div>

  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <!-- Section heading -->
    <div class="reveal mx-auto max-w-3xl text-center">
      <p class="font-hand text-3xl leading-none text-celeste sm:text-4xl">
        aquí empieza todo
      </p>
      <h2
        class="mt-3 font-display text-[clamp(1.75rem,4.5vw,3rem)] leading-[0.95] text-caparol"
      >
        Capítulo I, <span class="text-arena italic">a tu ritmo</span>
      </h2>
      <p class="mt-4 text-base text-caparol/80 sm:text-lg">
        Pasa las páginas como en un libro de verdad: arrastra una esquina con el
        dedo o el ratón, o usa las flechas del teclado.
      </p>
    </div>

    <!-- Flipbook frame -->
    <div
      class="reveal reveal-delay-1 relative mx-auto mt-10 max-w-5xl sm:mt-14"
    >
      <!-- Sand sticker corner -->
      <div
        aria-hidden="true"
        class="absolute -right-3 -top-3 z-20 flex h-20 w-20 rotate-12 items-center justify-center rounded-full bg-arena font-display text-azul shadow-xl sm:-right-5 sm:-top-5 sm:h-24 sm:w-24"
      >
        <span class="text-center text-sm leading-tight sm:text-base">
          PASA<br />Y LEE
        </span>
      </div>

      <!-- Decorative dashed frame -->
      <div
        aria-hidden="true"
        class="anim-sway absolute -inset-2 -z-10 rounded-3xl border-2 border-dashed border-arena/35 sm:-inset-3"
      >
      </div>

      <!-- Book container -->
      <div
        class="relative overflow-hidden rounded-2xl border border-caparol/20 bg-azul/60 shadow-2xl ring-1 ring-caparol/10"
      >
        <div
          id="flipbook"
          data-total={totalPages}
          class="book mx-auto"
          tabindex="0"
          aria-roledescription="libro"
          aria-label="Fragmento del cuento Si los peces hablaran"
        >
          {
            pages.map((p, idx) => (
              <div class="page" data-density="soft">
                <img
                  src={idx < PRIMERAS ? p.src : undefined}
                  srcset={idx < PRIMERAS ? `${p.src960} 960w, ${p.src} 1500w` : undefined}
                  data-src={idx < PRIMERAS ? undefined : p.src}
                  data-srcset={idx < PRIMERAS ? undefined : `${p.src960} 960w, ${p.src} 1500w`}
                  sizes="(min-width: 768px) 720px, 96vw"
                  alt={`Página ${p.n} del prólogo y el capítulo I de Si los peces hablaran…`}
                  loading="eager"
                  fetchpriority={idx < 2 ? "high" : "low"}
                  decoding="async"
                  draggable="false"
                  class="block h-full w-full object-contain"
                />
              </div>
            ))
          }
        </div>

        <!-- Footer controls -->
        <div
          class="flex items-center justify-between gap-3 border-t border-caparol/15 bg-azul/70 px-4 py-2.5 text-sm text-caparol sm:px-5 sm:py-3"
        >
          <button
            type="button"
            data-flip-prev
            class="inline-flex items-center gap-1.5 rounded-md px-2 py-1 font-display text-xs tracking-wide text-celeste uppercase transition hover:text-arena focus:outline-none focus-visible:text-arena sm:text-sm"
            aria-label="Página anterior"
          >
            <svg
              viewBox="0 0 24 24"
              class="h-4 w-4"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M15 18l-6-6 6-6"></path>
            </svg>
            <span class="hidden sm:inline">anterior</span>
          </button>

          <div class="flex flex-1 items-center justify-center gap-3">
            <span
              class="font-display text-xs tracking-wide text-caparol/75 uppercase sm:text-sm"
            >
              página <span data-flip-current>1</span> de <span
                >{totalPages}</span
              >
            </span>
            <div
              class="relative h-1 hidden flex-1 max-w-[12rem] overflow-hidden rounded-full bg-caparol/15 sm:block"
            >
              <div
                data-flip-progress
                class="absolute inset-y-0 left-0 w-0 rounded-full bg-arena transition-[width] duration-500"
              >
              </div>
            </div>
          </div>

          <button
            type="button"
            data-flip-next
            class="inline-flex items-center gap-1.5 rounded-md px-2 py-1 font-display text-xs tracking-wide text-celeste uppercase transition hover:text-arena focus:outline-none focus-visible:text-arena sm:text-sm"
            aria-label="Página siguiente"
          >
            <span class="hidden sm:inline">siguiente</span>
            <svg
              viewBox="0 0 24 24"
              class="h-4 w-4"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M9 6l6 6-6 6"></path>
            </svg>
          </button>
        </div>
      </div>

      <!-- Caption -->
      <p class="mt-4 text-center font-hand text-xl text-caparol/80">
        dieciocho páginas… las suficientes para enamorarte
      </p>
    </div>
  </div>
</section>

<style>
  .book {
    width: 100%;
  }
  .book .page {
    background: #0b2056;
  }
  .book:focus-visible {
    outline: 2px solid var(--color-arena, #fadeaa);
    outline-offset: 2px;
  }
</style>

<script>
  import { PageFlip } from "page-flip";

  const el = document.getElementById("flipbook");
  if (el) {
    const total = Number(el.dataset.total ?? 0);
    const currentEl = document.querySelector<HTMLElement>(
      "[data-flip-current]",
    );
    const progressEl = document.querySelector<HTMLElement>(
      "[data-flip-progress]",
    );
    const prevBtn =
      document.querySelector<HTMLButtonElement>("[data-flip-prev]");
    const nextBtn =
      document.querySelector<HTMLButtonElement>("[data-flip-next]");

    // Source page aspect ~1442:1500 ≈ 0.96
    const PAGE_W = 480;
    const PAGE_H = 500;

    const pageFlip = new PageFlip(el, {
      width: PAGE_W,
      height: PAGE_H,
      size: "stretch",
      minWidth: 280,
      maxWidth: 720,
      minHeight: 292,
      maxHeight: 750,
      maxShadowOpacity: 0.5,
      showCover: true,
      mobileScrollSupport: false,
      usePortrait: true,
      drawShadow: true,
      flippingTime: 700,
      autoSize: true,
    });

    pageFlip.loadFromHTML(el.querySelectorAll(".page"));

    const updateUi = (pageIndex: number) => {
      const human = Math.min(total, pageIndex + 1);
      if (currentEl) currentEl.textContent = String(human);
      if (progressEl) progressEl.style.width = `${(human / total) * 100}%`;
    };
    updateUi(0);

    // Carga progresiva: siempre 4 páginas por delante de la actual
    const imgs = Array.from(el.querySelectorAll<HTMLImageElement>("img[data-src]"));
    const cargarHasta = (pagina: number) => {
      for (const img of imgs) {
        const n = Number(img.alt.match(/Página (\d+)/)?.[1] ?? 0) - 1;
        if (n <= pagina + 4 && img.dataset.src) {
          if (img.dataset.srcset) img.srcset = img.dataset.srcset;
          img.src = img.dataset.src;
          delete img.dataset.src;
          delete img.dataset.srcset;
        }
      }
    };
    pageFlip.on("flip", (e) => {
      updateUi(Number(e.data));
      cargarHasta(Number(e.data));
    });
    // en cuanto alguien toca el libro, adelantamos unas cuantas más
    el.addEventListener("pointerdown", () => cargarHasta(4), { once: true });

    prevBtn?.addEventListener("click", () => pageFlip.flipPrev());
    nextBtn?.addEventListener("click", () => pageFlip.flipNext());

    el.addEventListener("keydown", (e) => {
      if (e.key === "ArrowLeft") {
        e.preventDefault();
        pageFlip.flipPrev();
      } else if (e.key === "ArrowRight") {
        e.preventDefault();
        pageFlip.flipNext();
      } else if (e.key === "Home") {
        e.preventDefault();
        pageFlip.turnToPage(0);
      } else if (e.key === "End") {
        e.preventDefault();
        pageFlip.turnToPage(total - 1);
      }
    });
  }
</script>
