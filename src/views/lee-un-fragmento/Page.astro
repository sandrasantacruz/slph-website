---
import MainLayout from '../../layouts/MainLayout.astro';
import Hero from './Hero.astro';
import Trailer from './Trailer.astro';
import Sumergete from './Sumergete.astro';
import Flipbook from './Flipbook.astro';
import CTA from './CTA.astro';
import SubNavCuento from '../../components/SubNavCuento.astro';
import { bookSchema, breadcrumbSchema } from '../../lib/seo';

const breadcrumb = breadcrumbSchema([
  { name: 'Inicio', url: '/' },
  { name: 'Sobre el cuento', url: '/sobre-el-cuento' },
  { name: 'Lee un fragmento', url: '/lee-un-fragmento' },
]);
---

<MainLayout
  title="Lee un fragmento"
  description="Lee un fragmento del cuento Si los peces hablaran de Sandra Santa Cruz: asómate al mundo submarino del libro antes de comprarlo."
  type="book"
  hideWaterLine
  jsonLd={[bookSchema(), breadcrumb]}
>
  <SubNavCuento current="fragmento" />
  <Hero />
  <Trailer />
  <Sumergete />
  <Flipbook />
  <CTA />
</MainLayout>

<script>
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const targets = document.querySelectorAll<HTMLElement>('.reveal');

  if (reduceMotion) {
    targets.forEach((el) => el.classList.add('is-visible'));
  } else {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          }
        });
      },
      { rootMargin: '0px 0px -10% 0px', threshold: 0.05 },
    );
    targets.forEach((el) => observer.observe(el));
  }
</script>
