---
import MainLayout from '../../layouts/MainLayout.astro';
import Hero from './Hero.astro';
import Trailer from './Trailer.astro';
import Sumergete from './Sumergete.astro';
import Flipbook from './Flipbook.astro';
import CTA from './CTA.astro';
import SoloNinos from './SoloNinos.astro';
import WaterLine from '../../components/WaterLine.astro';
import SubNavCuento from '../../components/SubNavCuento.astro';
import { bookSchema, breadcrumbSchema } from '../../lib/seo';

const breadcrumb = breadcrumbSchema([
  { name: 'Inicio', url: '/' },
  { name: 'Sobre el cuento', url: '/sobre-el-cuento' },
  { name: 'Lee el capítulo I', url: '/lee-un-fragmento' },
]);
---

<MainLayout
  title="Lee gratis el primer capítulo · cuento infantil Si los peces hablaran…"
  description="¡Ponte tus aletas y sumérgete en nuestra aventura! El prólogo y las primeras páginas de la historia de Lorena y el arrecife, escrita por Sandra Santa Cruz."
  image="/assets/og-fragmento.jpg"
  imageAlt="El cuento Si los peces hablaran… abierto por el capítulo 1"
  imageWidth={1200}
  imageHeight={630}
  type="book"
  hideWaterLine
  jsonLd={[bookSchema(), breadcrumb]}
>
  <SubNavCuento current="fragmento" />
  <!-- Un recorrido, no apartados sueltos: curiosidad (cabecera) → leer (capítulo I)
       → conocer a las heroínas → escuchar a Noa → querer el libro -->
  <Hero />
  <Flipbook />
  <Sumergete />
  <Trailer />
  <!-- «¿Crees que es solo un cuento para niños?»: Olga leyendo, antes de la compra,
       entre dos líneas de agua (como Izzy en El ilustrador) -->
  <WaterLine separador clave="-olga" />
  <SoloNinos />
  <!-- la línea de agua de la cabecera separa el recorrido del cierre (compra) -->
  <WaterLine separador />
  <CTA />
</MainLayout>

<script>
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const targets = document.querySelectorAll<HTMLElement>('.reveal');

  if (reduceMotion) {
    targets.forEach((el) => el.classList.add('is-visible'));
  } else {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          }
        });
      },
      { rootMargin: '0px 0px -10% 0px', threshold: 0.05 },
    );
    targets.forEach((el) => observer.observe(el));
  }
</script>
