---
type Char = {
  name: string;
  role: string;
  species: string;
  hint: string;
  img: string;
};

const characters: Char[] = [
  {
    name: 'Lorena',
    role: 'la protagonista',
    species: 'niña',
    hint: 'La nieta de Dña. Teresa. Escucha el cuento con los ojos bien abiertos.',
    img: '/assets/animals/lorena.webp',
  },
  {
    name: 'Nela',
    role: 'la Irritable',
    species: 'pez tropical',
    hint: 'Se enfada cuando algo no le cuadra en el arrecife.',
    img: '/assets/animals/nela.webp',
  },
  {
    name: 'Dina',
    role: 'la Voladora',
    species: 'pez volador',
    hint: 'Sale del agua con sus aletas-alas y aletea más alto que nadie.',
    img: '/assets/animals/dina.webp',
  },
  {
    name: 'Don Canino',
    role: 'el más fuerte',
    species: 'tiburón',
    hint: 'Utiliza su fuerza para proteger el mundo marino.',
    img: '/assets/animals/don-canino.webp',
  },
];
---

<section id="sumergete" class="relative isolate overflow-x-clip">
  <!-- Soft filtered light from above -->
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-2/3 bg-[radial-gradient(ellipse_at_top,_rgba(100,170,210,0.10),_transparent_70%)]"
  ></div>

  <!-- Drifting kelp on the right edge -->
  <svg
    class="anim-sway pointer-events-none absolute -right-4 bottom-0 -z-10 hidden h-2/3 w-24 -scale-x-100 text-celeste/12 lg:block"
    viewBox="0 0 80 200"
    fill="none"
    stroke="currentColor"
    stroke-width="1.2"
    stroke-linecap="round"
    aria-hidden="true"
  >
    <path d="M18 200 Q 28 150 20 100 Q 14 70 24 30 Q 28 10 20 0"/>
    <path d="M38 200 Q 48 160 40 110 Q 36 80 48 40 Q 52 18 44 0"/>
    <path d="M62 200 Q 70 160 62 120 Q 56 90 66 60 Q 70 30 64 0"/>
  </svg>

  <div class="mx-auto max-w-5xl px-6 py-16 sm:py-24">
    <div class="max-w-3xl">
      <p class="reveal font-hand text-3xl leading-none text-celeste sm:text-4xl">
        antes de pasar página
      </p>

      <h2 class="reveal reveal-delay-1 mt-3 font-display text-[clamp(2rem,5.5vw,3.75rem)] leading-[0.95]">
        Conoce a quienes
        <span class="block">
          <span class="hand-underline text-arena">habitan estas páginas</span>
        </span>
      </h2>

      <p class="reveal reveal-delay-2 mt-8 text-lg leading-relaxed sm:text-xl">
        Lorena, sentada junto a su abuela Dña. Teresa, escucha entusiasmada Si los peces hablaran. En el cuento que ha escrito su progenitora, los habitantes del mar descubren que su hogar corre un grave peligro y se embarcan en 
        <strong class="text-arena">una aventura para defenderlo</strong>.
      </p>

      <p class="reveal reveal-delay-3 mt-4 text-lg leading-relaxed sm:text-xl">
Te presentamos a algunas de nuestras intrépidas heroínas. Humanas y marinas, todas comparten un
mismo propósito: proteger el océano. Con ellas rendimos homenaje a mujeres valientes que, desde
la ciencia, la educación, el arte o el propio mar, nos inspiran cada día y nos recuerdan que cada
acción cuenta para salvar nuestro planeta.</p>
    </div>

    <!-- Characters strip -->
    <ul class="reveal reveal-delay-3 mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {characters.map((c) => (
        <li class="group relative flex flex-col rounded-2xl border border-caparol/15 bg-azul/30 p-5 transition hover:border-arena/60">
          <!-- Portrait -->
          <div class="relative mx-auto flex aspect-square w-28 items-center justify-center overflow-hidden rounded-full bg-celeste/10 ring-1 ring-caparol/10 sm:w-32">
            <img
              src={c.img}
              alt={`${c.name}, ${c.species}`}
              loading="lazy"
              decoding="async"
              draggable="false"
              class="block h-full w-full object-contain p-1.5 transition-transform duration-500 group-hover:scale-105"
            />
          </div>
          <p class="mt-4 text-center font-display text-2xl leading-tight text-arena sm:text-3xl">
            {c.name}
          </p>
          <p class="mt-1 text-center font-hand text-lg leading-none text-celeste sm:text-xl">
            {c.role}
          </p>
          <p class="mt-2 text-center font-display text-[0.7rem] tracking-[0.2em] text-arena/85 uppercase">
            {c.species}
          </p>
          <p class="mt-3 text-center text-sm leading-snug text-caparol/85">
            {c.hint}
          </p>
        </li>
      ))}
    </ul>
  </div>
</section>
