---
type Char = {
  name: string;
  role: string;
  hint: string;
};

const characters: Char[] = [
  {
    name: 'Lorena',
    role: 'la protagonista',
    hint: 'Nada con los ojos bien abiertos.',
  },
  {
    name: 'Nela',
    role: 'la irritable',
    hint: 'Se enfada cuando algo no le cuadra.',
  },
  {
    name: 'Dina',
    role: 'la voladora',
    hint: 'Aletea más alto que nadie.',
  },
  {
    name: 'Don Canino',
    role: 'el sabio del arrecife',
    hint: 'Lo ha visto todo. Y se acuerda.',
  },
];
---

<section id="sumergete" class="relative isolate overflow-x-clip">
  <!-- Soft filtered light from above -->
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-2/3 bg-[radial-gradient(ellipse_at_top,_rgba(100,170,210,0.10),_transparent_70%)]"
  ></div>

  <!-- Drifting kelp on the right edge -->
  <svg
    class="anim-sway pointer-events-none absolute -right-4 bottom-0 -z-10 hidden h-2/3 w-24 -scale-x-100 text-celeste/12 lg:block"
    viewBox="0 0 80 200"
    fill="none"
    stroke="currentColor"
    stroke-width="1.2"
    stroke-linecap="round"
    aria-hidden="true"
  >
    <path d="M18 200 Q 28 150 20 100 Q 14 70 24 30 Q 28 10 20 0"/>
    <path d="M38 200 Q 48 160 40 110 Q 36 80 48 40 Q 52 18 44 0"/>
    <path d="M62 200 Q 70 160 62 120 Q 56 90 66 60 Q 70 30 64 0"/>
  </svg>

  <div class="mx-auto max-w-5xl px-6 py-16 sm:py-24">
    <div class="max-w-3xl">
      <p class="reveal font-hand text-3xl leading-none text-arena sm:text-4xl">
        antes de pasar página
      </p>

      <h2 class="reveal reveal-delay-1 mt-3 font-display text-[clamp(2rem,5.5vw,3.75rem)] leading-[0.95]">
        Conoce a quienes
        <span class="block">
          <span class="hand-underline text-arena">habitan estas páginas</span>
        </span>
      </h2>

      <p class="reveal reveal-delay-2 mt-8 text-lg leading-relaxed sm:text-xl">
        La historia transcurre en el litoral canario, allí donde el azul se
        pone hondo. Cuatro criaturas que han crecido oyendo el mismo mar
        descubren que ya no suena igual. Lo que arranca como un día
        cualquiera bajo el agua se convierte, página a página, en
        <strong class="text-arena">una aventura para defender su hogar</strong>.
      </p>

      <p class="reveal reveal-delay-3 mt-4 text-lg leading-relaxed sm:text-xl">
        El fragmento de abajo es solo el comienzo. Pasa las hojas con el
        ratón, el dedo o las flechas del teclado.
      </p>
    </div>

    <!-- Characters strip -->
    <ul class="reveal reveal-delay-3 mt-12 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
      {characters.map((c) => (
        <li class="group relative rounded-2xl border border-caparol/15 bg-azul/30 p-5 transition hover:border-arena/60">
          <p class="font-hand text-xl leading-none text-celeste sm:text-2xl">
            {c.role}
          </p>
          <p class="mt-2 font-display text-2xl leading-tight text-arena sm:text-3xl">
            {c.name}
          </p>
          <p class="mt-3 text-sm leading-snug text-caparol/85">
            {c.hint}
          </p>
        </li>
      ))}
    </ul>
  </div>
</section>
