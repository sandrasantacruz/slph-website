---
import Ola from '../../components/Ola.astro';
// Cada tarjeta: quién es, qué papel tiene y una frase que invita a seguir leyendo
// (textos de Sandra, fieles al cuento).
type Char = {
  name: string;
  rol: string;
  gancho: string;
  img: string;
  alt: string;
};

const characters: Char[] = [
  {
    name: 'Dña. Teresa',
    rol: 'la abuela de Lorena',
    gancho: 'Su cuento y su querida nieta están a punto de cambiarlo todo.',
    img: '/assets/animals/abuela.webp',
    alt: 'Dña. Teresa, la abuela de Lorena',
  },
  {
    name: 'Dña. Paciencia',
    rol: 'la tortuga más sabia',
    gancho: 'Lidera una importante misión para comunicarse con los humanos.',
    img: '/assets/animals/dona.webp',
    alt: 'Dña. Paciencia, la tortuga',
  },
  {
    name: 'La Bella Azul',
    rol: 'la sirena más ingeniosa',
    gancho: 'Siempre encuentra la manera de ayudar a los demás.',
    img: '/assets/animals/bella.webp',
    alt: 'La Bella Azul, la sirena',
  },
  {
    name: 'Lorena',
    rol: 'una gran personalidad',
    gancho: 'Funda el Club SLPH para demostrar que los niños pueden cuidar el mar.',
    img: '/assets/animals/lorena.webp',
    alt: 'Lorena, la nieta de Dña. Teresa',
  },
];
---

<section id="sumergete" class="relative isolate overflow-x-clip">
  <!-- Soft filtered light from above -->
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-2/3 bg-[radial-gradient(ellipse_at_top,_rgba(100,170,210,0.10),_transparent_70%)]"
  ></div>

  <div class="mx-auto max-w-5xl px-6 py-16 sm:py-24">
    <div class="max-w-3xl">
      <p class="reveal font-hand text-3xl leading-none text-celeste sm:text-4xl">
        ya conoces a Lorena…
      </p>

      <h2 class="reveal reveal-delay-1 mt-3 font-display text-[clamp(2rem,5.5vw,3.75rem)] leading-[0.95]">
        Conoce a quienes
        <span class="block">
          <Ola class="text-arena">habitan estas páginas</Ola>
        </span>
      </h2>

      <!-- Sin volver a contar la historia: se acaba de leer en el capítulo I -->
      <p class="reveal reveal-delay-2 mt-8 text-lg leading-relaxed sm:text-xl">
        Estas son quienes la acompañan. Humanas y marinas, todas comparten un mismo
        propósito: <strong class="font-normal text-arena">proteger el océano</strong>. Con
        ellas rendimos homenaje a mujeres valientes que, desde la ciencia, la educación,
        el arte o el propio mar, nos inspiran cada día.
      </p>
    </div>

    <!-- Characters strip -->
    <ul class="reveal reveal-delay-3 mt-12 grid grid-cols-2 gap-3 sm:gap-4 lg:grid-cols-4">
      {characters.map((c) => (
        <li class="group relative flex flex-col overflow-hidden rounded-2xl border border-caparol/15 bg-azul/30 transition hover:border-arena/60">
          <img
            src={c.img}
            alt={c.alt}
            loading="lazy"
            decoding="async"
            draggable="false"
            class="block aspect-square w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
          />
          <div class="flex flex-1 flex-col p-3 text-center sm:p-5">
            <h3 class="font-display text-lg leading-tight text-arena sm:text-2xl">{c.name}</h3>
            <p class="font-hand text-base leading-tight text-celeste sm:text-xl">{c.rol}</p>
            <p class="mt-2 text-xs leading-snug text-caparol/85 sm:mt-3 sm:text-sm">{c.gancho}</p>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>
