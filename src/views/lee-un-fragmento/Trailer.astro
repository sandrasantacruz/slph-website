---
---

<section id="trailer" class="relative isolate">
  <div class="mx-auto max-w-4xl px-6 pb-12 sm:pb-16">
    <div class="reveal max-w-2xl">
      <p class="font-hand text-3xl leading-none text-arena sm:text-4xl">
        en vídeo
      </p>
      <h2 class="reveal reveal-delay-1 mt-3 font-display text-[clamp(2rem,5vw,3.25rem)] leading-[0.95]">
        Un vistazo
        <span class="block">
          <span class="hand-underline text-arena">al cuento en movimiento</span>
        </span>
      </h2>
    </div>

    <figure class="reveal reveal-delay-2 mt-10 overflow-hidden rounded-2xl border border-caparol/15 bg-azul/30">
      <video
        class="block aspect-video w-full"
        src="/assets/trailer.mp4"
        poster="/assets/trailer-poster.webp"
        controls
        preload="metadata"
        playsinline
      ></video>
    </figure>
  </div>
</section>
