---
import Ola from '../../components/Ola.astro';

---

<section id="trailer" class="relative isolate overflow-x-clip py-20 sm:py-28">
  <!-- Deep-water glow behind the window -->
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-x-0 top-1/4 -z-10 h-2/3 bg-[radial-gradient(70%_60%_at_50%_40%,rgba(100,170,210,0.16),transparent_72%)]"
  >
  </div>

  <!-- Rays of surface light falling into the section -->
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-x-0 top-0 -z-10 hidden h-1/2 opacity-40 md:block bg-[linear-gradient(100deg,transparent_18%,rgba(100,170,210,0.14)_24%,transparent_31%,transparent_62%,rgba(248,248,252,0.08)_68%,transparent_74%)]"
  >
  </div>

  <div class="mx-auto max-w-6xl px-6">
    <h2
      class="reveal mx-auto max-w-3xl text-center font-display text-[clamp(2rem,5vw,3.25rem)] leading-[0.95] text-caparol"
    >
      El mar tiene voz
      <span class="block">
        <Ola class="text-arena">para quien sabe escuchar</Ola>
      </span>
    </h2>
  </div>

  <!-- Window on the sea — full-bleed on mobile, framed from md up -->
  <div class="mt-12 sm:mt-16 md:mt-24">
    <div class="relative mx-auto max-w-6xl md:px-6">
      <!-- The window itself -->
      <div class="window reveal reveal-delay-1 relative mt-8 md:mt-0 md:pt-24">
        <div
          class="window-frame relative overflow-hidden bg-azul-deep md:rounded-[2.5rem]"
        >
          <!-- Caustic light falling in from the surface -->
          <div
            aria-hidden="true"
            class="caustics pointer-events-none absolute inset-0 z-10"
          >
          </div>

          <!-- Scrim so the quote stays legible over the poster; clears on play -->
          <div
            aria-hidden="true"
            class="scrim pointer-events-none absolute inset-0 z-10 hidden md:block"
          >
          </div>

          <media-player
            data-player
            title="Un vistazo al cuento Si los peces hablaran"
            src="/videos/vistazo-cuento.mp4"
            poster="/videos/vistazo-cuento-poster.webp"
            aspect-ratio="16/9"
            crossorigin
            playsinline
          >
            <media-provider></media-provider>
            <media-video-layout></media-video-layout>
          </media-player>

          <span
            aria-hidden="true"
            class="play-hint pointer-events-none absolute right-5 bottom-12 z-20 -rotate-3 font-hand text-2xl text-arena/95 transition-opacity duration-300 select-none sm:right-8 sm:bottom-14 sm:text-3xl"
          >
            dale al play…
          </span>
        </div>

        <!-- Caption under the window -->
        <p
          class="reveal reveal-delay-2 mt-6 px-6 text-center font-hand text-2xl text-caparol sm:text-3xl md:px-0"
        >
          ¡Noa es quien interpreta a la pequeña Betta!
        </p>
      </div>
    </div>
  </div>
</section>

<style is:global>
  .window-frame media-player {
    --video-brand: var(--color-arena);
    --media-brand: var(--color-arena);
    --media-focus-ring-color: var(--color-arena-deep);
    --media-controls-color: var(--color-caparol);
    --video-controls-color: var(--color-caparol);
    --media-tooltip-bg: rgb(11 32 86 / 0.95);
    --media-menu-bg: rgb(11 32 86 / 0.95);
    border-radius: 0;
    background: var(--color-azul-deep);
  }

  .window-frame:has(media-player[data-started]) .play-hint {
    opacity: 0;
  }

  /* Light and scrim clear once the video is running */
  .window-frame:has(media-player[data-started]) .caustics,
  .window-frame:has(media-player[data-started]) .scrim {
    opacity: 0;
  }
</style>

<style>
  .window-frame {
    box-shadow:
      0 40px 80px -30px rgba(6, 15, 44, 0.85),
      0 0 0 1px rgba(248, 248, 252, 0.08);
  }

  @media (min-width: 768px) {
    .window-frame {
      box-shadow:
        0 40px 90px -30px rgba(6, 15, 44, 0.9),
        0 0 90px -20px rgba(100, 170, 210, 0.35),
        0 0 0 1px rgba(248, 248, 252, 0.1);
    }
  }

  /* Darkens the upper-left of the poster so the quote keeps its contrast */
  .scrim {
    background:
      radial-gradient(
        70% 55% at 12% 0%,
        rgba(6, 15, 44, 0.92) 0%,
        rgba(6, 15, 44, 0.55) 45%,
        transparent 78%
      ),
      linear-gradient(
        to bottom,
        rgba(6, 15, 44, 0.55) 0%,
        rgba(6, 15, 44, 0.2) 28%,
        transparent 50%
      );
    transition: opacity 0.4s ease;
  }

  /* Shafts of surface light drifting across the glass */
  .caustics {
    background: linear-gradient(
      104deg,
      transparent 8%,
      rgba(100, 170, 210, 0.16) 14%,
      transparent 22%,
      transparent 46%,
      rgba(248, 248, 252, 0.1) 52%,
      transparent 60%,
      transparent 76%,
      rgba(100, 170, 210, 0.13) 82%,
      transparent 90%
    );
    mix-blend-mode: screen;
    opacity: 0.85;
    transition: opacity 0.4s ease;
    animation: caustic-drift 14s ease-in-out infinite;
  }

  @keyframes caustic-drift {
    0%,
    100% {
      transform: translateX(-3%) scaleY(1);
    }
    50% {
      transform: translateX(3%) scaleY(1.04);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .caustics {
      animation: none;
    }
  }
</style>

<script>
  import "vidstack/player";
  import "vidstack/player/ui";
  import "vidstack/player/layouts/default";
  import "vidstack/player/styles/default/theme.css";
  import "vidstack/player/styles/default/layouts/video.css";
</script>
