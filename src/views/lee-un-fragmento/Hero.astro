---
import Ola from '../../components/Ola.astro';

---

<section class="relative isolate overflow-hidden pt-14 pb-12 sm:pt-20 sm:pb-16">
  <!-- Soft radial glow, top-right -->
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 -z-10 bg-[radial-gradient(60%_50%_at_85%_25%,rgba(100,170,210,0.10),transparent_70%)]"
  >
  </div>

  <!-- Hint of arena from below -->
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-x-0 bottom-0 -z-10 h-1/2 bg-[radial-gradient(ellipse_at_bottom,_rgba(250,222,170,0.05),_transparent_75%)]"
  >
  </div>

  <div class="mx-auto max-w-6xl px-6">
    <!-- h1 para Google: lo que se busca («leer el primer capítulo de un cuento infantil online»).
         «Asómate a la aventura» sigue siendo el titular grande, con el mismo aspecto. -->
    <h1 class="reveal flex items-center gap-3 sm:gap-4">
      <span aria-hidden="true" class="h-px w-10 shrink-0 bg-arena sm:w-16"></span>
      <span
        class="font-display text-xs leading-snug tracking-[0.3em] text-arena uppercase sm:text-sm sm:tracking-[0.35em]"
      >
        Lee gratis el primer capítulo · cuento infantil online
      </span>
    </h1>

    <!-- Headline -->
    <p
      class="reveal reveal-delay-1 mt-6 max-w-4xl font-display text-[clamp(2.5rem,7.5vw,5rem)] leading-[0.95] tracking-tight text-caparol"
    >
      Asómate
      <span class="block">
        a la
        <Ola class="relative inline-block text-arena">
          aventura
        </Ola>
      </span>
    </p>

    <!-- Lead: «cuento infantil», que es lo que se busca en Google -->
    <p
      class="reveal reveal-delay-2 mt-8 max-w-3xl font-display text-xl leading-tight text-celeste sm:text-2xl md:text-3xl"
    >
      Lee el prólogo y el capítulo I completo de
      <em class="not-italic text-arena">Si los peces hablaran…</em>, un cuento infantil
      donde el océano tiene mucho que contar, y escúchalo en la voz de la pequeña Betta.
    </p>

    <!-- Un solo paso: abrir el libro (la compra llega al final del recorrido) -->
    <a
      href="#fragmento"
      class="reveal reveal-delay-3 group mt-10 inline-flex items-center gap-3 rounded-full bg-arena px-7 py-3 font-display text-xl text-azul shadow-lg transition hover:brightness-95"
    >
      Abre el libro
      <svg viewBox="0 0 24 24" class="h-5 w-5 transition-transform group-hover:translate-y-1" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v14M6 13l6 6 6-6"></path></svg>
    </a>
  </div>
</section>
