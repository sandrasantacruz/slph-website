---
import Ola from '../../components/Ola.astro';
// Las mismas fichas que en «La ciencia nos avala» de Inicio
const investigadoras = [
  { nombre: 'May Gómez', cargo: 'Catedrática de Zoología · Directora del grupo EOMAR', foto: '/assets/colaboradores/may-gomez/portrait.png' },
  { nombre: 'Dra. Gercende Courtois', cargo: 'Investigadora en Ciencias Marinas y Acuicultura', foto: '/assets/colaboradores/gercende-courtois/portrait-hd.webp' },
];

---

<section id="investigadoras" class="relative isolate scroll-mt-28 overflow-hidden pt-4 pb-24 sm:pt-6 sm:pb-32">
  <div class="mx-auto max-w-6xl px-6">
    <!-- Highlight panel: the cuento born from its musical's repercussion -->
    <div
      class="reveal relative overflow-hidden rounded-3xl border border-arena/25 bg-azul/50 p-8 ring-1 ring-caparol/10 sm:p-12"
    >
      <!-- Corner glow -->
      <div
        aria-hidden="true"
        class="pointer-events-none absolute inset-0 -z-10 bg-[radial-gradient(50%_60%_at_85%_15%,rgba(250,222,170,0.10),transparent_70%)]"
      >
      </div>

      <!-- Texto a la izquierda; a la derecha, las dos investigadoras (llenan el hueco y ponen
           cara al aval, como en Inicio) -->
      <div class="grid items-center gap-10 lg:grid-cols-12 lg:gap-12">
        <div class="lg:col-span-7">
          <p class="font-hand text-2xl text-celeste sm:text-3xl">
            nuestro aval
          </p>

          <h2
            class="mt-3 font-display text-[clamp(2rem,5.5vw,3.75rem)] leading-[0.95] text-caparol"
          >
            La ciencia
            <Ola class="text-arena">nos avala</Ola>
          </h2>

          <div
            class="mt-6 space-y-5 text-lg leading-relaxed text-caparol/90 sm:text-xl"
          >
            <p>
              Dos investigadoras del Instituto ECOAQUA de la ULPGC supervisan
              nuestro cuento y se han convertido en grandes aliadas de todos
              nuestros proyectos.
            </p>
            <p>
              Gracias a ellas, cada mensaje que llega a un aula, a un escenario o a
              las páginas del cuento está contrastado.
            </p>
          </div>
        </div>

        <ul class="grid gap-4 sm:grid-cols-2 lg:col-span-5 lg:grid-cols-1">
          {investigadoras.map(({ nombre, cargo, foto }) => (
            <li class="flex items-center gap-4 rounded-3xl bg-azul/65 p-4 ring-1 ring-caparol/15 sm:p-5">
              <img
                src={foto}
                alt={`Retrato de ${nombre}`}
                width="96"
                height="96"
                class="h-20 w-20 shrink-0 rounded-full object-cover ring-2 ring-arena/60 sm:h-24 sm:w-24"
                loading="lazy"
                decoding="async"
              />
              <div>
                <p class="font-display text-2xl leading-tight text-caparol">{nombre}</p>
                <p class="mt-1 text-sm leading-snug text-caparol/80 sm:text-base">{cargo}</p>
              </div>
            </li>
          ))}
        </ul>
      </div>

      <!-- Closing CTA -->
      <div
        class="reveal reveal-delay-1 mt-14 flex flex-col items-center gap-6 text-center sm:mt-16"
      >
        <p class="max-w-xl text-lg leading-relaxed text-caparol/90 sm:text-xl">
          Seguimos navegando. En nuestras noticias encontrarás los eventos,
          encuentros y notas de prensa más recientes.
        </p>
        <div class="flex flex-wrap items-center justify-center gap-4">
          <a
            href="/noticias"
            class="inline-flex items-center gap-2 rounded-full bg-arena px-6 py-3 font-display text-sm uppercase tracking-[0.2em] text-azul shadow-sm transition hover:brightness-105"
          >
            Ver noticias
            <svg
              viewBox="0 0 24 24"
              class="h-4 w-4"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M5 12h14M13 6l6 6-6 6"></path>
            </svg>
          </a>
          <a
            href="/programa"
            class="group inline-flex items-center gap-2 font-display text-sm tracking-[0.3em] text-arena uppercase transition hover:text-caparol"
          >
            <svg
              viewBox="0 0 24 24"
              class="h-4 w-4 transition-transform group-hover:-translate-x-0.5"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M19 12H5M11 18l-6-6 6-6"></path>
            </svg>
            Volver al programa
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
