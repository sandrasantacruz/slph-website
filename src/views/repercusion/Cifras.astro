---
// Cifras del dossier, las mismas que en Inicio («Diez años dando voz al océano").
// Aquí van justo debajo de la cabecera: quien llega desde Google ve la prueba primero.
const cifras = [
  { n: '+10', t: 'años', d: 'de trayectoria' },
  { n: '+3.000', t: 'escolares', d: 'en el musical' },
  { n: '+60', t: 'entidades', d: 'que han difundido el mensaje' },
  { n: '4', t: 'islas', d: '¡y hasta Colombia!' },
];
---

<section class="relative isolate pt-6 pb-0 sm:pt-4">
  <div class="mx-auto max-w-5xl px-6 text-center">
    <p class="reveal font-hand text-3xl leading-none text-celeste sm:text-4xl">dejando estela desde 2016</p>
    <ul class="reveal reveal-delay-1 mx-auto mt-10 grid max-w-4xl grid-cols-2 gap-6 sm:grid-cols-4">
      {cifras.map(({ n, t, d }) => (
        <li>
          <p class="font-display text-5xl leading-none text-arena sm:text-6xl">{n}</p>
          <p class="mt-2 font-display text-sm tracking-[0.25em] text-caparol/85 uppercase sm:text-base">{t}</p>
          <!-- qué cuenta cada cifra (crítica recibida, 27 nov 2026): «+60» no son financiadores -->
          <p class="mt-1 text-xs leading-snug text-caparol/60 sm:text-sm">{d}</p>
        </li>
      ))}
    </ul>
  </div>
</section>
