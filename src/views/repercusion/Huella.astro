---

---

<section class="relative isolate overflow-hidden py-16 sm:py-24">
  <!-- Soft glow behind the statement -->
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 -z-10 bg-[radial-gradient(45%_60%_at_50%_45%,rgba(100,170,210,0.10),transparent_70%)]"
  >
  </div>

  <div class="mx-auto max-w-4xl px-6 text-center">
    <!-- Bella swims in above the statement -->
    <img
      src="/assets/animals/bella2.webp"
      alt="Bella, la sirena del cuento"
      width="1000"
      height="516"
      class="anim-float-soft reveal mx-auto -mb-4 w-full max-w-[20rem] sm:-mb-6 sm:max-w-[28rem] lg:max-w-[34rem]"
      loading="lazy"
      decoding="async"
    />

    <h2
      class="reveal reveal-delay-1 mt-6 font-display text-[clamp(2.25rem,6.5vw,4.5rem)] leading-[0.95] tracking-tight text-caparol"
    >
      La huella de
      <span class="text-arena italic">SLPH</span>
    </h2>

    <p
      class="reveal reveal-delay-2 mt-5 font-hand text-2xl text-celeste sm:mt-6 sm:text-3xl"
    >
      No es un mérito solo nuestro
    </p>
  </div>
</section>
