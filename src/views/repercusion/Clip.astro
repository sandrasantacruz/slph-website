---
import { Icon } from "astro-icon/components";

interface Props {
  src: string;
  poster: string;
  title: string;
  caption: string;
  /** CSS aspect ratio of the source file, e.g. "16/9" or "9/16". */
  aspect?: string;
  class?: string;
}

const {
  src,
  poster,
  title,
  caption,
  aspect = "16/9",
  class: className = "",
} = Astro.props;
---

<figure class={`menores-clip ${className}`}>
  <div class="menores-wrap relative overflow-hidden bg-azul-deep">
    <media-player
      class="menores-player"
      title={title}
      src={src}
      poster={poster}
      aspect-ratio={aspect}
      style={`aspect-ratio:${aspect}`}
      crossorigin
      playsinline
    >
      <media-provider>
        <media-poster class="vds-poster" />
      </media-provider>
      <media-video-layout></media-video-layout>
      <media-play-button
        class="menores-play-overlay"
        aria-label="Reproducir vídeo"
      >
        <span class="menores-play-circle">
          <Icon name="game-icons:play-button" aria-hidden="true" />
        </span>
      </media-play-button>
    </media-player>
  </div>

  <figcaption
    class="menores-caption font-hand text-2xl text-azul sm:text-[1.7rem]"
  >
    {caption}
  </figcaption>
</figure>

<style is:global>
  .menores-wrap .menores-player {
    --video-brand: var(--color-arena);
    --media-brand: var(--color-arena);
    --media-focus-ring-color: var(--color-arena-deep);
    --media-controls-color: var(--color-caparol);
    --video-controls-color: var(--color-caparol);
    --media-tooltip-bg: rgb(11 32 86 / 0.95);
    --media-menu-bg: rgb(11 32 86 / 0.95);
    border-radius: 3px;
    background: var(--color-azul-deep);
  }

  /* Hide vidstack's own centered play/pause button — we bring our own overlay
     and rely on click-to-toggle for pausing. vidstack sets display via
     !important, so we must override it. */
  .menores-player .vds-play-button {
    display: none !important;
  }

  .menores-wrap .menores-play-overlay {
    position: absolute;
    inset: 0;
    z-index: 10;
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    background: transparent;
    border: 0;
    cursor: pointer;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease;
  }
  .menores-wrap media-player[data-paused] .menores-play-overlay {
    opacity: 1;
    pointer-events: auto;
  }
  .menores-wrap .menores-play-circle {
    display: grid;
    place-items: center;
    width: 4.5rem;
    height: 4.5rem;
    border-radius: 9999px;
    background: var(--color-arena);
    color: var(--color-azul);
    box-shadow: 0 10px 30px -8px rgba(6, 15, 44, 0.7);
    transition:
      transform 0.3s cubic-bezier(0.22, 1, 0.36, 1),
      background 0.3s ease;
  }
  .menores-wrap .menores-play-circle svg {
    width: 50%;
    height: 50%;
  }
  .menores-wrap .menores-play-overlay:hover .menores-play-circle,
  .menores-wrap .menores-play-overlay:focus-visible .menores-play-circle {
    transform: scale(1.08);
    background: var(--color-caparol);
  }
</style>

<style>
  /* Polaroid-style clipping, same family as the press clippings above */
  .menores-clip {
    position: relative;
    background: var(--color-caparol);
    padding: 0.875rem 0.875rem 3.25rem;
    border-radius: 6px;
    box-shadow:
      0 22px 45px -14px rgba(6, 15, 44, 0.6),
      0 8px 16px -6px rgba(6, 15, 44, 0.4);
    transition:
      transform 0.5s cubic-bezier(0.22, 1, 0.36, 1),
      box-shadow 0.5s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .menores-clip:hover {
    transform: rotate(0deg) translateY(-4px);
    box-shadow:
      0 30px 55px -14px rgba(6, 15, 44, 0.65),
      0 10px 20px -6px rgba(6, 15, 44, 0.45);
  }

  .menores-clip .menores-wrap {
    border-radius: 2px;
    overflow: hidden;
  }

  .menores-caption {
    position: absolute;
    right: 0;
    bottom: 0.75rem;
    left: 0;
    text-align: center;
  }

  @media (prefers-reduced-motion: reduce) {
    .menores-clip,
    .menores-clip:hover {
      transition: none;
      transform: none;
    }
  }
</style>

<script>
  import "vidstack/player";
  import "vidstack/player/ui";
  import "vidstack/player/layouts/default";
  import "vidstack/player/styles/default/theme.css";
  import "vidstack/player/styles/default/poster.css";
  import "vidstack/player/styles/default/layouts/video.css";
</script>
