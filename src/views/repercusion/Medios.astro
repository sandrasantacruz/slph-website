---
import { Icon } from "astro-icon/components";
import Ola from '../../components/Ola.astro';

const videos = [
  {
    src: "/videos/tvc-escolares.mp4",
    poster: "/videos/tvc-escolares-poster.webp",
    title: "Si los peces hablaran en los centros escolares · Televisión Canaria",
    caption: "centros escolares",
    tilt: "-rotate-1",
  },
  {
    src: "/videos/tvc-investigadoras.mp4",
    poster: "/videos/tvc-investigadoras-poster.webp",
    title: "Las investigadoras marinas · Televisión Canaria",
    caption: "investigadoras marinas",
    tilt: "rotate-1",
  },
];
---

<section id="medios" class="relative isolate overflow-hidden py-20 sm:py-28">
  <!-- Drifting bubbles -->
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 -z-10 overflow-hidden"
  >
    <span
      class="anim-float-soft absolute top-[14%] left-[7%] block h-3 w-3 rounded-full bg-celeste/40"
    ></span>
    <span
      class="anim-float absolute bottom-[18%] left-[12%] block h-2 w-2 rounded-full bg-arena/50"
    ></span>
    <span
      class="anim-float-soft absolute top-[24%] right-[8%] block h-2.5 w-2.5 rounded-full bg-caparol/30"
    ></span>
    <span
      class="anim-float absolute right-[14%] bottom-[20%] block h-4 w-4 rounded-full bg-celeste/30"
    ></span>
  </div>
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 -z-10 bg-[radial-gradient(55%_45%_at_85%_15%,rgba(250,222,170,0.07),transparent_70%)]"
  >
  </div>

  <div class="mx-auto max-w-6xl px-6">
    <!-- Header -->
    <div class="reveal mx-auto max-w-3xl text-center">
      <div class="flex items-center justify-center gap-3 sm:gap-4">
        <span aria-hidden="true" class="h-px w-10 bg-arena sm:w-16"></span>
        <span
          class="font-display text-xs tracking-[0.4em] text-arena uppercase sm:text-sm"
        >
          En los medios
        </span>
        <span aria-hidden="true" class="h-px w-10 bg-arena sm:w-16"></span>
      </div>

      <h2
        class="mt-6 font-display text-[clamp(2rem,5.5vw,4rem)] leading-[0.95] text-caparol"
      >
        Emitido en
        <span class="whitespace-nowrap">
          <Ola class="text-arena">Televisión Canaria</Ola>
        </span>
      </h2>

      <p
        class="reveal reveal-delay-1 mx-auto mt-6 max-w-xl text-base text-caparol/80 sm:text-lg"
      >
        Si los peces hablaran saltó del escenario al cuento, de ahí a talleres y
        performances y volvió nuevamente a los escenarios para llegar a la
        pantalla. Estos fragmentos emitidos por la Televisión Canaria, de la
        entrevista del programa “Canarias es Cultura”, son parte de la huella
        que SLPH va dejando.
      </p>
    </div>

    <!-- Video pair -->
    <div class="mt-14 grid gap-12 sm:mt-20 sm:gap-10 lg:grid-cols-2 lg:gap-12">
      {
        videos.map((video, i) => (
          <figure
            class={`clip-frame reveal reveal-delay-${i + 1} ${video.tilt}`}
          >
            <div class="player-wrap relative overflow-hidden bg-azul-deep">
              <media-player
                class="medios-player"
                title={video.title}
                src={video.src}
                poster={video.poster}
                aspect-ratio="16/9"
                crossorigin
                playsinline
              >
                <media-provider>
                  <media-poster class="vds-poster" />
                </media-provider>
                <media-video-layout />
                <media-play-button
                  class="medios-play-overlay"
                  aria-label="Reproducir vídeo"
                >
                  <span class="medios-play-circle">
                    <Icon name="game-icons:play-button" aria-hidden="true" />
                  </span>
                </media-play-button>
              </media-player>
            </div>

            <figcaption class="clip-caption font-hand text-2xl text-azul sm:text-[1.7rem]">
              {video.caption}
            </figcaption>
          </figure>
        ))
      }
    </div>
  </div>
</section>

<style is:global>
  .player-wrap .medios-player {
    --video-brand: var(--color-arena);
    --media-brand: var(--color-arena);
    --media-focus-ring-color: var(--color-arena-deep);
    --media-controls-color: var(--color-caparol);
    --video-controls-color: var(--color-caparol);
    --media-tooltip-bg: rgb(11 32 86 / 0.95);
    --media-menu-bg: rgb(11 32 86 / 0.95);
    border-radius: 3px;
    background: var(--color-azul-deep);
  }

  /* Hide vidstack's own centered play/pause button (the dark dot) —
     we provide our own overlay and rely on click-to-toggle for pausing.
     vidstack sets display via !important, so we must override it. */
  .medios-player .vds-play-button {
    display: none !important;
  }

  /* Custom centered play overlay */
  .player-wrap .medios-play-overlay {
    position: absolute;
    inset: 0;
    z-index: 10;
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    background: transparent;
    border: 0;
    cursor: pointer;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease;
  }
  /* Show whenever paused (initial state and mid-video pause) */
  .player-wrap media-player[data-paused] .medios-play-overlay {
    opacity: 1;
    pointer-events: auto;
  }
  .player-wrap .medios-play-circle {
    display: grid;
    place-items: center;
    width: 4.5rem;
    height: 4.5rem;
    border-radius: 9999px;
    background: var(--color-arena);
    color: var(--color-azul);
    box-shadow: 0 10px 30px -8px rgba(6, 15, 44, 0.7);
    transition:
      transform 0.3s cubic-bezier(0.22, 1, 0.36, 1),
      background 0.3s ease;
  }
  .player-wrap .medios-play-circle svg {
    width: 50%;
    height: 50%;
  }
  .player-wrap .medios-play-overlay:hover .medios-play-circle,
  .player-wrap .medios-play-overlay:focus-visible .medios-play-circle {
    transform: scale(1.08);
    background: var(--color-caparol);
  }
</style>

<style>
  /* Polaroid-style press clipping */
  .clip-frame {
    position: relative;
    background: var(--color-caparol);
    padding: 0.875rem 0.875rem 3.25rem;
    border-radius: 6px;
    box-shadow:
      0 22px 45px -14px rgba(6, 15, 44, 0.6),
      0 8px 16px -6px rgba(6, 15, 44, 0.4);
    transition:
      transform 0.5s cubic-bezier(0.22, 1, 0.36, 1),
      box-shadow 0.5s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .clip-frame:hover {
    transform: rotate(0deg) translateY(-4px);
    box-shadow:
      0 30px 55px -14px rgba(6, 15, 44, 0.65),
      0 10px 20px -6px rgba(6, 15, 44, 0.45);
  }

  .clip-frame .player-wrap {
    border-radius: 2px;
    overflow: hidden;
  }

  .clip-caption {
    position: absolute;
    right: 0;
    bottom: 0.75rem;
    left: 0;
    text-align: center;
  }

  @media (prefers-reduced-motion: reduce) {
    .clip-frame,
    .clip-frame:hover {
      transition: none;
      transform: none;
    }
  }
</style>

<script>
  import "vidstack/player";
  import "vidstack/player/ui";
  import "vidstack/player/layouts/default";
  import "vidstack/player/styles/default/theme.css";
  import "vidstack/player/styles/default/poster.css";
  import "vidstack/player/styles/default/layouts/video.css";
</script>
