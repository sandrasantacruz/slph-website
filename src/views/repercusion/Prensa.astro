---
import Ola from '../../components/Ola.astro';
import Clip from './Clip.astro';
// Reciente arriba (25 nov 2026: Sandra no los tenía guardados; pantallazos en Drive,
// PRENSA/Recopilación de prensa en internet). Debajo, el estreno de 2016.
const recientes = [
  {
    medio: "Creativa Canaria",
    fecha: "2025",
    titular: "La Casa-Museo León y Castillo conciencia a la juventud sobre el cuidado de los océanos a través de la escritura",
    accion: "Leer el artículo",
    url: "https://www.creativacanaria.com/la-casa-museo-leon-y-castillo-conciencia-a-la-juventud-sobre-el-cuidado-de-los-oceanos-a-traves-de-la-escritura/",
  },
  {
    medio: "Radio Las Palmas",
    fecha: "2025",
    titular: "Pérez Galdós se convierte en aliado del mar",
    accion: "Leer el artículo",
    url: "https://www.radiolaspalmas.com/cultura/2025/04/21/perez-galdos-se-convierte-en-aliado-del-mar/n12667.html",
  },
  {
    medio: "Televisión Canaria",
    fecha: "2024",
    titular: "“Canarias es Cultura”, con la defensa del ecosistema marino",
    accion: "Leer el artículo",
    url: "https://rtvc.es/canarias-es-cultura-con-la-defensa-del-ecosistema-marino/",
  },
];
const estreno = [
  {
    medio: "La Provincia",
    fecha: "2016",
    titular: "“Si los peces hablaran” denuncia la contaminación del medio marino",
    accion: "Leer el artículo",
    url: "https://www.laprovincia.es/cultura/2016/07/14/peces-hablaran-denuncia-contaminacion-medio-9881951.html",
  },
  {
    medio: "elDiario.es",
    fecha: "2016",
    titular: "“Si los peces hablaran…”, un espectáculo multidisciplinar en defensa del mar",
    accion: "Leer el artículo",
    url: "https://www.eldiario.es/canariasahora/cultura/hablaran-espectaculo-multidisciplinar-defensa-mar_1_3921160.html",
  },
  {
    medio: "El Espejo Canario",
    fecha: "2016",
    titular: "“Si los peces hablaran…” en El Espejo Canario",
    accion: "Escuchar la entrevista",
    url: "https://www.ivoox.com/noticia-sabrosa-si-peces-hablaran-audios-mp3_rf_12196242_1.html",
  },
];
const grupos = [
  { etiqueta: "lo más reciente", articulos: recientes },
  { etiqueta: "el estreno del musical", articulos: estreno },
];
---

<section id="prensa" class="relative isolate overflow-hidden pb-20 sm:pb-28">
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 -z-10 bg-[radial-gradient(55%_45%_at_20%_20%,rgba(100,170,210,0.10),transparent_70%)]"
  >
  </div>

  <div class="mx-auto max-w-6xl px-6">
    <div class="reveal mx-auto max-w-3xl text-center">
      <div class="flex items-center justify-center gap-3 sm:gap-4">
        <span aria-hidden="true" class="h-px w-10 bg-arena sm:w-16"></span>
        <span
          class="font-display text-xs tracking-[0.4em] text-arena uppercase sm:text-sm"
        >
          En la prensa
        </span>
        <span aria-hidden="true" class="h-px w-10 bg-arena sm:w-16"></span>
      </div>

      <h2
        class="mt-6 font-display text-[clamp(2rem,5.5vw,3.75rem)] leading-[0.95] text-caparol"
      >
        La prensa sigue
        <Ola class="text-arena">nuestra estela</Ola>
      </h2>

      <p
        class="reveal reveal-delay-1 mx-auto mt-6 max-w-xl text-base text-caparol/80 sm:text-lg"
      >
        Desde el estreno del musical en 2016 hasta hoy, los medios han ido
        contando cada etapa de
        <em class="text-arena not-italic">Si los peces hablaran…</em>
      </p>
    </div>

    {
      grupos.map((g, gi) => (
        <div class={gi === 0 ? "mt-12 sm:mt-16" : "mt-12"}>
          <p class="reveal font-hand text-2xl leading-none text-celeste sm:text-3xl">{g.etiqueta}</p>
        <ul class="mt-6 grid gap-6 lg:grid-cols-3">
          {
            g.articulos.map((articulo, i) => (
              <li class={`reveal reveal-delay-${i + 1}`}>
                <a
                  href={articulo.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="group flex h-full flex-col rounded-2xl border border-arena/25 bg-azul/50 p-7 ring-1 ring-caparol/10 transition duration-300 hover:-translate-y-1 hover:border-arena/60 hover:bg-azul/70 sm:p-8"
                >
                  <span class="flex items-baseline justify-between gap-3 font-display text-sm tracking-[0.3em] text-celeste uppercase">
                    {articulo.medio}
                    <span class="tracking-[0.15em] text-arena/80">{articulo.fecha}</span>
                  </span>

                  <span class="mt-4 flex-1 text-lg leading-snug text-caparol sm:text-xl">
                    {articulo.titular}
                  </span>

                  <span class="mt-6 inline-flex items-center gap-2 font-display text-xs tracking-[0.2em] text-arena uppercase transition group-hover:text-caparol">
                    {articulo.accion}
                    <svg
                      viewBox="0 0 24 24"
                      class="h-4 w-4 transition-transform group-hover:translate-x-0.5"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                    >
                      <path d="M7 17L17 7M9 7h8v8" />
                    </svg>
                  </span>
                </a>
              </li>
            ))
          }
        </ul>
        </div>
      ))
    }

    <!-- También en la radio: Noa Martín (Betta) en Radio Las Palmas. Antes estaba en
         “En los más pequeños”; aquí suma como repercusión en los medios. -->
    <div id="noa" class="mt-16 grid scroll-mt-28 items-center gap-10 sm:mt-20 lg:grid-cols-12 lg:gap-14">
      <div class="reveal lg:col-span-5">
        <p class="font-hand text-2xl leading-none text-celeste sm:text-3xl">también en la radio</p>
        <p class="mt-4 font-display text-[clamp(1.6rem,3.6vw,2.6rem)] leading-tight text-caparol">
          Demostrado:
          <span class="text-arena">la edad no es inconveniente para cuidar el mar</span>
        </p>
        <p class="mt-4 text-base leading-relaxed text-caparol/85 sm:text-lg">
          En su programa de Radio Las Palmas, Asunción Benítez entrevistó a Noa Martín,
          nuestra pequeña Betta, que explicó de qué trata
          <em class="not-italic text-arena">Si los peces hablaran…</em> y por qué hay que cuidar el mar.
        </p>
      </div>
      <div class="lg:col-span-7">
        <Clip
          class="reveal reveal-delay-1 -rotate-1"
          src="/videos/menores-noa.mp4"
          poster="/videos/menores-noa-poster.webp"
          title="Entrevista de Asunción Benítez en Radio Las Palmas · Si los peces hablaran"
          caption="con Asunción Benítez, en Radio Las Palmas"
        />
      </div>
    </div>
  </div>
</section>
