---
import galeriaMusical from "../home/img/galeria-del-musical.webp?url";
---

<section
  class="relative isolate flex min-h-[calc(100svh-6rem)] flex-col overflow-hidden"
>
  <!-- Soft radial glow, top-left -->
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 -z-10 bg-[radial-gradient(55%_45%_at_20%_25%,rgba(250,222,170,0.10),transparent_70%)]"
  >
  </div>

  <!-- Drifting kelp on the right edge -->
  <svg
    class="anim-sway pointer-events-none absolute -right-4 bottom-0 -z-10 hidden h-2/3 w-24 text-celeste/12 lg:block"
    viewBox="0 0 80 200"
    fill="none"
    stroke="currentColor"
    stroke-width="1.2"
    stroke-linecap="round"
    aria-hidden="true"
  >
    <path d="M18 200 Q 28 150 20 100 Q 14 70 24 30 Q 28 10 20 0"></path>
    <path d="M38 200 Q 48 160 40 110 Q 36 80 48 40 Q 52 18 44 0"></path>
    <path d="M62 200 Q 70 160 62 120 Q 56 90 66 60 Q 70 30 64 0"></path>
  </svg>

  <div
    class="mx-auto flex h-full w-full max-w-7xl flex-1 flex-col justify-center px-6 py-8 sm:py-10"
  >
    <!-- Eyebrow -->
    <div class="reveal flex items-center gap-3 sm:gap-4">
      <span aria-hidden="true" class="h-px w-8 bg-arena sm:w-16"></span>
      <span
        class="font-display text-[0.7rem] tracking-[0.35em] text-arena uppercase sm:text-sm sm:tracking-[0.4em]"
      >
        DEMOSTRADO
      </span>
    </div>

    <!-- Hero grid: text + image -->
    <div
      class="mt-6 grid grid-cols-12 items-center gap-x-5 gap-y-6 sm:mt-8 sm:gap-x-10 lg:gap-x-14"
    >
      <!-- Left column: title + lead -->
      <div
        class="reveal reveal-delay-1 order-2 col-span-12 flex flex-col justify-center lg:order-1 lg:col-span-7"
      >
        <p class="font-hand text-xl text-celeste sm:text-3xl lg:text-4xl">
          más allá del papel…
        </p>

        <h1
          class="mt-0.5 font-display text-[clamp(2.75rem,10vw,8rem)] leading-[0.85] tracking-tight text-caparol sm:mt-1"
        >
          Reper<span class="text-arena italic">cusión</span>
        </h1>

        <!-- Tag chips -->
        <ul
          class="mt-4 flex flex-wrap items-center gap-x-2 gap-y-1 font-display text-[0.65rem] uppercase tracking-[0.18em] text-celeste sm:mt-6 sm:gap-x-3 sm:text-base lg:gap-x-4 lg:text-lg"
        >
          <li>Televisión Canaria</li>
          <li aria-hidden="true" class="text-arena/70">·</li>
          <li>en menores</li>
          <li aria-hidden="true" class="text-arena/70">·</li>
          <li>Prensa</li>
        </ul>

        <p
          class="mt-5 max-w-xl text-sm leading-relaxed text-caparol/90 sm:mt-6 sm:text-lg sm:leading-relaxed lg:text-xl"
        >
          <em class="not-italic text-arena">Si los peces hablaran…</em>
          saltó del papel al escenario y de ahí a los medios. Proyecto del Centro
          de Danza Sandra Santa Cruz convertido en programa de concienciación debido
          a su gran repercusión.
        </p>

        <div class="mt-7 flex flex-wrap items-center gap-3 sm:mt-8">
          <a
            href="#medios"
            class="inline-flex items-center gap-2 font-display text-xs tracking-[0.18em] text-arena uppercase transition hover:text-caparol"
          >
            UNA HUELLA PATENTE
            <svg
              viewBox="0 0 24 24"
              class="h-4 w-4"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M6 9l6 6 6-6"></path>
            </svg>
          </a>
        </div>
      </div>

      <!-- Image, right side -->
      <div
        class="reveal reveal-delay-2 order-1 col-span-12 flex items-center justify-center lg:order-2 lg:col-span-5"
      >
        <div class="relative w-full max-w-[min(100%,52vh)]">
          <!-- Decorative dashed frame behind image -->
          <div
            aria-hidden="true"
            class="anim-sway absolute -inset-2 -z-10 rounded-[1.25rem] border-2 border-dashed border-arena/40 sm:-inset-3 sm:rounded-[1.5rem]"
          >
          </div>

          <div
            class="polaroid tilt-r1 w-full transition duration-500 hover:rotate-0"
            style="padding-bottom:3.25rem"
          >
            <img
              src={galeriaMusical}
              alt="El musical Si los peces hablaran en el escenario"
              class="block w-full"
              style="aspect-ratio:4/3"
              loading="eager"
              decoding="async"
              fetchpriority="high"
            />
            <p
              class="absolute bottom-1.5 left-0 right-0 px-2 text-center font-hand text-lg leading-tight text-azul sm:bottom-2 sm:px-3 sm:text-2xl"
            >
              del cuento al escenario
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
