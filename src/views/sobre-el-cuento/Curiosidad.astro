---
import Ola from '../../components/Ola.astro';
const presentacion = "/assets/cuento/presentacion-oficial-poema-del-mar.webp";
---

<section class="relative isolate overflow-hidden py-20 sm:py-28">
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 -z-20 bg-[radial-gradient(55%_45%_at_80%_40%,rgba(100,170,210,0.10),transparent_70%)]"
  >
  </div>

  <div class="mx-auto max-w-6xl px-6">
    <div class="grid items-center gap-12 lg:grid-cols-12 lg:gap-16">
      <!-- Image column -->
      <div
        class="reveal reveal-delay-1 relative z-10 order-last lg:order-first lg:col-span-5"
      >
        <div class="relative mx-auto max-w-xs sm:max-w-sm lg:max-w-none">
          <div data-caracola class="polaroid tilt-l1 transition duration-500 hover:rotate-0">
            <img
              src={presentacion}
              alt="Sandra Santa Cruz firma ejemplares en la presentación oficial del cuento en el acuario Poema del Mar"
              width="900"
              height="600"
              class="block aspect-[4/5] w-full object-cover"
              loading="lazy"
              decoding="async"
            />
            <p
              class="absolute bottom-2 left-0 right-[30%] text-center font-hand text-2xl leading-none text-azul sm:text-3xl"
            >
              firma en el Deep Sea
            </p>

            <!-- Caracolas y algas — ancladas al borde inferior del marco -->
            <div
              aria-hidden="true"
              class="pointer-events-none absolute -right-[6%] -bottom-[5%] w-[44%] sm:-right-[18%]"
            >
              <div
                class="absolute -bottom-[2%] left-1/2 h-[18%] w-[120%] -translate-x-1/2 rounded-[100%] bg-celeste/25 blur-xl"
              >
              </div>
              <img
                src="/assets/cuento/caracola.webp"
                alt=""
                width="847"
                height="1000"
                class="relative block w-full drop-shadow-[0_12px_20px_rgba(6,15,44,0.45)]"
                loading="lazy"
                decoding="async"
              />
              <!-- Burbujas que salen de las algas y de la caracola al acercarse
                   (ratón sobre la foto) o, en táctil, al aparecer en pantalla -->
              <div class="burbujas-caracola">
                <img src="/assets/burbuja.webp" alt="" width="240" height="237" loading="lazy" decoding="async" style="--x:31%;--t:9px;--d:0.16s;--dur:4.2s;--dx:-14px" />
                <img src="/assets/burbuja.webp" alt="" width="240" height="237" loading="lazy" decoding="async" style="--x:31%;--t:7px;--d:0.96s;--dur:4.4s;--dx:-14px" />
                <img src="/assets/burbuja.webp" alt="" width="240" height="237" loading="lazy" decoding="async" style="--x:32%;--t:13px;--d:1.23s;--dur:4.3s;--dx:12px" />
                <img src="/assets/burbuja.webp" alt="" width="240" height="237" loading="lazy" decoding="async" style="--x:26%;--t:7px;--d:2.18s;--dur:4.8s;--dx:-14px" />
                <img src="/assets/burbuja.webp" alt="" width="240" height="237" loading="lazy" decoding="async" style="--x:35%;--t:13px;--d:2.42s;--dur:4.4s;--dx:-10px" />
                <img src="/assets/burbuja.webp" alt="" width="240" height="237" loading="lazy" decoding="async" style="--x:30%;--t:13px;--d:3.06s;--dur:4.3s;--dx:8px" />
                <img src="/assets/burbuja.webp" alt="" width="240" height="237" loading="lazy" decoding="async" style="--x:67%;--t:18px;--d:0.05s;--dur:4.7s;--dx:18px" />
                <img src="/assets/burbuja.webp" alt="" width="240" height="237" loading="lazy" decoding="async" style="--x:56%;--t:10px;--d:0.38s;--dur:4.9s;--dx:12px" />
                <img src="/assets/burbuja.webp" alt="" width="240" height="237" loading="lazy" decoding="async" style="--x:51%;--t:15px;--d:0.76s;--dur:4.9s;--dx:8px" />
                <img src="/assets/burbuja.webp" alt="" width="240" height="237" loading="lazy" decoding="async" style="--x:74%;--t:10px;--d:1.19s;--dur:5.3s;--dx:-8px" />
                <img src="/assets/burbuja.webp" alt="" width="240" height="237" loading="lazy" decoding="async" style="--x:59%;--t:8px;--d:1.64s;--dur:4.9s;--dx:-12px" />
                <img src="/assets/burbuja.webp" alt="" width="240" height="237" loading="lazy" decoding="async" style="--x:52%;--t:15px;--d:1.84s;--dur:4.6s;--dx:-8px" />
                <img src="/assets/burbuja.webp" alt="" width="240" height="237" loading="lazy" decoding="async" style="--x:73%;--t:12px;--d:2.19s;--dur:5.4s;--dx:-18px" />
                <img src="/assets/burbuja.webp" alt="" width="240" height="237" loading="lazy" decoding="async" style="--x:66%;--t:12px;--d:2.5s;--dur:4.3s;--dx:8px" />
                <img src="/assets/burbuja.webp" alt="" width="240" height="237" loading="lazy" decoding="async" style="--x:63%;--t:6px;--d:3.09s;--dur:3.9s;--dx:12px" />
                <img src="/assets/burbuja.webp" alt="" width="240" height="237" loading="lazy" decoding="async" style="--x:68%;--t:10px;--d:3.25s;--dur:4.4s;--dx:8px" />
                <img src="/assets/burbuja.webp" alt="" width="240" height="237" loading="lazy" decoding="async" style="--x:68%;--t:12px;--d:3.52s;--dur:3.9s;--dx:-8px" />
                <img src="/assets/burbuja.webp" alt="" width="240" height="237" loading="lazy" decoding="async" style="--x:65%;--t:18px;--d:4.05s;--dur:3.9s;--dx:18px" />
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Text column -->
      <div class="lg:col-span-7">
        <div class="reveal flex items-center gap-5">
          <span aria-hidden="true" class="h-[2px] w-16 bg-arena sm:w-24"></span>
          <span
            class="font-display text-sm tracking-[0.4em] text-arena uppercase"
          >
            Un gran ventanal al mar
          </span>
        </div>

        <h2
          class="reveal reveal-delay-1 mt-8 font-display text-[clamp(2rem,5vw,3.75rem)] leading-[0.98] text-caparol"
        >
          Un estreno entre
          <Ola class="text-celeste whitespace-nowrap">los peces</Ola>
        </h2>

        <div
          class="reveal reveal-delay-2 mt-8 space-y-5 text-lg leading-relaxed text-caparol/90 sm:text-xl"
        >
          <p>
            ¿Qué mejor lugar para presentar nuestro cuento que Poema del Mar?
            Allí, frente al Deep Sea, los más pequeños vieron nadar tiburones,
            rayas y bancos de peces y, tal como buscábamos, se enamoraron de las especies que el
            cuento nos invita a cuidar.
          </p>
        </div>

        <!-- El dato -->
        <div
          class="reveal reveal-delay-3 mt-10 flex items-center gap-6 rounded-2xl border border-arena/30 bg-azul-deep/40 p-6 ring-1 ring-caparol/10 backdrop-blur-sm sm:p-8"
        >
          <div class="shrink-0 text-center">
            <p
              class="font-display text-5xl leading-none text-arena sm:text-6xl"
            >
              36
            </p>
            <p class="mt-1 font-hand text-xl text-celeste">metros</p>
          </div>
          <p class="text-base leading-relaxed text-caparol/85 sm:text-lg">
            La ventana del Deep Sea mide 36 metros de largo y es la ventana
            curva más grande del mundo. Al otro lado, los peces parecían salir
            de las páginas del cuento.
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .burbujas-caracola {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .burbujas-caracola img {
    position: absolute;
    left: var(--x);
    bottom: 22%;
    width: var(--t);
    height: auto;
    opacity: 0;
  }
  /* mientras el ratón está sobre la foto siguen saliendo; en táctil, unas cuantas tandas */
  .polaroid:hover .burbujas-caracola img,
  .soltando .burbujas-caracola img {
    animation: sube-burbuja var(--dur) ease-in var(--d) infinite;
  }
  @keyframes sube-burbuja {
    0% { opacity: 0; transform: translate(0, 0) scale(0.6); }
    12% { opacity: 0.85; }
    50% { transform: translate(var(--dx), -220px) scale(1); }
    85% { opacity: 0.7; }
    100% { opacity: 0; transform: translate(calc(var(--dx) * -0.5), -460px) scale(1.15); }
  }
  @media (prefers-reduced-motion: reduce) {
    .burbujas-caracola { display: none; }
  }
</style>

<script>
  // En táctil no hay «pasar el ratón»: las burbujas salen solas un rato cuando
  // la foto aparece en pantalla.
  if (matchMedia('(hover: none)').matches) {
    document.querySelectorAll<HTMLElement>('[data-caracola]').forEach((el) => {
      const obs = new IntersectionObserver(
        (entries) => {
          if (!entries.some((e) => e.isIntersecting)) return;
          obs.disconnect();
          el.classList.add('soltando');
          setTimeout(() => el.classList.remove('soltando'), 9000);
        },
        { threshold: 0.5 },
      );
      obs.observe(el);
    });
  }
</script>
