---
const imagenes = [
  {
    src: "/assets/galeria/cuento/danza-de-las-aletas-poema-del-mar.webp",
    alt: "Danza de las Aletas de SLPH en Poema del Mar",
  },
  {
    src: "/assets/galeria/cuento/si-los-peces-hablaran-dona-paciencia-poema-del-mar.webp",
    alt: "Si los peces hablaran: Dña. Paciencia en Poema del Mar",
  },
  {
    src: "/assets/galeria/cuento/may-gomez-gercende-courtois-poema-del-mar.webp",
    alt: "May Gómez y Gercende Courtois en Poema del Mar",
  },
] as const;
---

<section class="relative isolate overflow-hidden pt-6 pb-16 sm:pt-8 sm:pb-20">
  <div class="mx-auto max-w-6xl px-6">
    <div class="reveal flex items-center gap-5">
      <span aria-hidden="true" class="h-0.5 w-16 bg-arena sm:w-24"></span>
      <span class="font-display text-sm tracking-[0.4em] text-arena uppercase">
        NOVEDOSA Y EXITOSA PRESENTACIÓN
      </span>
    </div>

    <div
      class="mt-8 grid items-start gap-6 mx-auto max-w-xl lg:max-w-none lg:grid-cols-3"
    >
      {
        imagenes.map((img, i) => (
          <a
            href={img.src}
            data-lightbox
            data-gallery="cuento-imagenes"
            data-caption={img.alt}
            aria-label="Ampliar imagen del cuento"
            class={`reveal reveal-delay-${i + 1} group block cursor-zoom-in overflow-hidden rounded-xl border border-caparol/15 bg-azul-deep/50 ring-1 ring-caparol/10 transition hover:border-arena/60 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-arena`}
          >
            <img
              src={img.src}
              alt={img.alt}
              class="block h-auto w-full object-contain transition duration-500 group-hover:brightness-110"
              loading="lazy"
              decoding="async"
            />
          </a>
        ))
      }
    </div>
  </div>
</section>
