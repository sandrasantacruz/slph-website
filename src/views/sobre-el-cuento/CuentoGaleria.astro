---
import { srcset } from '../../lib/srcset';
import EnlaceFlecha from '../../components/EnlaceFlecha.astro';
const imagenes = [
  {
    src: "/assets/cuento/danza-de-las-aletas-poema-del-mar.webp",
    alt: "Danza de las Aletas ante el gran ventanal del Deep Sea, en la presentación del cuento en Poema del Mar",
  },
  {
    src: "/assets/cuento/dona-paciencia-poema-del-mar.webp",
    alt: "Doña Paciencia, personaje del cuento, en la presentación en Poema del Mar",
  },
  {
    src: "/assets/galeria/cuento/03-guacimara-medina-poema-del-mar.webp",
    alt: "El público, con Guacimara Medina, consejera de Cultura del Cabildo de Gran Canaria, en la presentación del cuento en Poema del Mar",
  },
] as const;
---

<section class="relative isolate overflow-hidden pt-6 pb-16 sm:pt-8 sm:pb-20">
  <div class="mx-auto max-w-6xl px-6">
    <div class="reveal flex items-center gap-5">
      <span aria-hidden="true" class="h-0.5 w-16 bg-arena sm:w-24"></span>
      <span class="font-display text-sm tracking-[0.4em] text-arena uppercase">
        Así fue nuestra presentación
      </span>
    </div>

    <div
      class="carrusel -mx-6 mt-8 flex snap-x snap-mandatory items-start gap-4 overflow-x-auto px-6 pb-2 lg:mx-0 lg:grid lg:grid-cols-3 lg:gap-6 lg:overflow-visible lg:px-0 lg:pb-0"
    >
      {
        imagenes.map((img, i) => (
          <a
            href={img.src}
            data-lightbox
            data-gallery="cuento-imagenes"
            data-caption={img.alt}
            aria-label="Ampliar imagen del cuento"
            class={`reveal reveal-delay-${i + 1} group block w-[82%] shrink-0 snap-center sm:w-[60%] lg:w-auto cursor-zoom-in overflow-hidden rounded-xl border border-caparol/15 bg-azul-deep/50 ring-1 ring-caparol/10 transition hover:border-arena/60 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-arena`}
          >
            <img
              src={img.src}
              srcset={srcset(img.src, 1500)}
              sizes="(min-width: 1024px) 360px, (min-width: 640px) 60vw, 300px"
              alt={img.alt}
              width="1500"
              height="1000"
              class="block aspect-[3/2] w-full object-cover transition duration-500 group-hover:brightness-110"
              loading="lazy"
              decoding="async"
            />
          </a>
        ))
      }
    </div>
    <p class="mt-3 text-center font-hand text-xl text-celeste/80 lg:hidden" aria-hidden="true">desliza para ver más →</p>
    <div class="reveal mt-10 flex justify-center">
      <EnlaceFlecha href="/galeria#cuento">Revívela en la galería</EnlaceFlecha>
    </div>
  </div>
</section>
