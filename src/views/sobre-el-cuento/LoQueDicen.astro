---
/**
 * «Lo que dicen del cuento»: dos voces de aula sobre el libro, justo antes de
 * la ficha y el botón de compra. Mismo estilo de tarjetas que las citas de
 * «Red de aliados» en Colabora.
 */
type Cita = {
  texto: string;
  nombre: string;
  cargo: string;
  /** Vídeo de la persona: se abre en grande en esta misma página. */
  video?: { src: string; poster: string; etiqueta: string; pie: string };
};
/** Lectoras del cuento (vídeos «Con el cuento he aprendido», tarjeta 100D5100;
 *  autorización de las familias). */
const lectoras = [
  // La del oxígeno ya sale en el vídeo de la 3.ª edición (Comprar): aquí no se repite.
  { texto: 'Me sorprendió que una niña quisiera salvar el océano y que al final acabara siendo mucha gente.', nombre: 'Vera Paisier', edad: '11 años', video: 'opinion-vera' },
  { texto: 'Después del cuento fui a la playa, encontré un montón de latas y plásticos y los recogí.', nombre: 'Valentina Hernández', edad: '8 años', video: 'opinion-valentina' },
  { texto: 'Con el cuento he aprendido que no se puede tirar basura al mar.', nombre: 'Gara Corujo', edad: '7 años', video: '' } // su vídeo (MVI_1980) está en la tarjeta 100D5100,
];

/** Botón «Escúchala»: abre el trozo de su grabación en el diálogo de vídeo de abajo. */
const escuchar = (nombre: string, video: string) => ({
  src: `/videos/${video}.mp4`,
  poster: `/videos/${video}-poster.webp`,
  pie: nombre,
});

const citas: Cita[] = [
  {
    texto: 'A raíz de la lectura del libro, del encuentro con la autora, de todo lo que hemos vivido, los niños han empezado a desarrollar acciones para mejorar: de traer una botella de un solo uso para beber agua en el recreo, ahora traen una rellenable; y reciclan la basura.',
    nombre: 'Isabel Martín',
    cargo: 'Jefa de estudios del Colegio Alfredo Kraus',
    video: { src: '/videos/tvc-escolares.mp4', poster: '/videos/tvc-escolares-poster.webp', etiqueta: 'Entrevista en Televisión Canaria', pie: 'Si los peces hablaran en los centros escolares · Televisión Canaria' },
  },
  {
    texto: 'Nos parece fundamental educar desde edades tempranas para conservar nuestros ecosistemas. Nos ha encantado el libro.',
    nombre: 'Elisa',
    cargo: 'Profesora del CEIP Príncipe de Asturias',
  },
  {
    // Antes estaba en Colabora como «Público»; ahora solo aquí.
    texto: 'Este tipo de iniciativa es un regalo a la naturaleza y a todos, a las nuevas generaciones. Una oportunidad para ayudar, para concienciarnos. Desde el arte, además, que es tan importante: una forma tan sensible de llegar.',
    nombre: 'María del Mar Vicente',
    cargo: 'Madre, con su hija, en la Biblioteca Municipal Dolores Campos-Herrero',
    video: { src: '/videos/opinion-madre-dolores-campos.mp4', poster: '/videos/opinion-madre-dolores-campos-poster.webp', etiqueta: 'Escúchala', pie: 'Biblioteca Municipal Dolores Campos-Herrero' },
  },
];
---

<section class="relative isolate overflow-hidden pt-4 pb-16 sm:pb-20">
  <div class="mx-auto max-w-6xl px-6">
    <div class="reveal text-center">
      <p class="font-hand text-2xl text-celeste sm:text-3xl">de las aulas a casa</p>
      <h2 class="mt-2 font-display text-[clamp(1.9rem,4.5vw,3rem)] leading-[0.95] text-caparol">
        Lo que dicen <span class="text-arena italic">del cuento</span>
      </h2>
    </div>

    <!-- «Mamá, tenemos que cambiar el mundo» (CEIP Julio Coloma Gallegos, Sevilla) ya está
         en Repercusión y en Realidad aumentada: aquí no se repite. -->
    <p class="reveal mt-10 text-center font-hand text-2xl text-celeste sm:text-3xl">palabra de lectora</p>
    <ul class="reveal reveal-delay-1 mt-5 grid gap-4 md:grid-cols-3 md:gap-6">
      {lectoras.map((l) => (
        <li>
          <figure class="flex h-full flex-col rounded-2xl border border-arena/25 bg-azul-deep/40 p-6">
            <blockquote class="flex-1 font-hand text-2xl leading-snug text-caparol">«{l.texto}»</blockquote>
            <figcaption class="mt-4 text-sm leading-snug">
              <span class="font-display text-base tracking-wide text-arena">{l.nombre}</span>
              {l.edad && <span class="text-caparol/70">, {l.edad}</span>}
              {l.video && <button
                type="button"
                data-abrir-video={escuchar(l.nombre, l.video).src}
                data-poster={escuchar(l.nombre, l.video).poster}
                data-pie={l.nombre}
                class="mt-3 flex items-center gap-2 font-display text-xs tracking-[0.18em] text-arena uppercase transition hover:text-caparol"
              >
                <svg viewBox="0 0 24 24" class="h-3.5 w-3.5" fill="currentColor" aria-hidden="true"><path d="M8 5.5v13l11-6.5z"/></svg>
                Escúchala
              </button>}
            </figcaption>
          </figure>
        </li>
      ))}
    </ul>

    <p class="reveal mt-14 text-center font-hand text-2xl text-celeste sm:text-3xl">palabra de maestra y de familia</p>
    <ul class="reveal reveal-delay-2 mt-5 grid gap-4 md:grid-cols-3 md:gap-6">
      {citas.map((c) => (
        <li>
          <figure class="flex h-full flex-col rounded-2xl border border-caparol/15 bg-azul/40 p-6 sm:p-7">
            <span aria-hidden="true" class="font-display text-5xl leading-none text-arena/60">«</span>
            <blockquote class="-mt-3 flex-1 font-hand text-2xl leading-snug text-caparol sm:text-[1.65rem]">
              {c.texto}
            </blockquote>
            <figcaption class="mt-5 border-t border-caparol/10 pt-4 text-sm leading-snug">
              <span class="block font-display text-base tracking-wide text-arena">{c.nombre}</span>
              <span class="text-caparol/70">{c.cargo}</span>
              {c.video && (
                <button
                  type="button"
                  data-abrir-video={c.video.src}
                  data-poster={c.video.poster}
                  data-pie={c.video.pie}
                  class="mt-3 inline-flex items-center gap-2 font-display text-xs tracking-[0.18em] text-arena uppercase transition hover:text-caparol"
                >
                  {c.video.etiqueta}
                  <svg viewBox="0 0 24 24" class="h-3.5 w-3.5" fill="currentColor" aria-hidden="true"><path d="M8 5.5v13l11-6.5z"/></svg>
                </button>
              )}
            </figcaption>
          </figure>
        </li>
      ))}
    </ul>
  </div>

  <dialog
    data-dialogo-video
    aria-label="Vídeo"
    class="m-auto w-[min(94vw,60rem)] overflow-visible bg-transparent p-0 backdrop:bg-azul-deep/85 backdrop:backdrop-blur-sm"
  >
    <div class="relative">
      <button type="button" data-cerrar-video aria-label="Cerrar vídeo" class="absolute -top-12 right-0 rounded-full p-2 text-caparol transition hover:text-arena">
        <svg viewBox="0 0 24 24" class="h-7 w-7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
      </button>
      <video controls playsinline preload="none" class="block aspect-video w-full rounded-2xl bg-azul-deep object-contain shadow-2xl"></video>
      <p data-pie-video class="mt-3 text-center font-hand text-2xl text-arena"></p>
    </div>
  </dialog>
</section>

<script>
  const dlg = document.querySelector<HTMLDialogElement>('[data-dialogo-video]');
  const vid = dlg?.querySelector('video');
  const pie = dlg?.querySelector<HTMLElement>('[data-pie-video]');
  document.querySelectorAll<HTMLButtonElement>('[data-abrir-video]').forEach((b) =>
    b.addEventListener('click', () => {
      if (!dlg || !vid) return;
      vid.src = b.dataset.abrirVideo!;
      vid.poster = b.dataset.poster ?? '';
      if (pie) pie.textContent = b.dataset.pie ?? '';
      dlg.showModal();
      vid.play().catch(() => {});
    }),
  );
  dlg?.querySelector('[data-cerrar-video]')?.addEventListener('click', () => dlg.close());
  dlg?.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });
  dlg?.addEventListener('close', () => vid?.pause());
</script>
