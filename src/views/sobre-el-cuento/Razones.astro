---
/**
 * «Cuando un cuento toca, los niños actúan»: por qué funciona el cuento.
 * Las cuatro razones vienen del «Dossier Bibliotecas 2026-2027».
 */
import { Icon } from 'astro-icon/components';
import Ola from '../../components/Ola.astro';

const razones = [
  {
    icon: 'game-icons:heart-inside',
    titulo: 'Valores y empatía',
    texto: 'Cada personaje tiene su propia personalidad y aporta sus valores. Los niños se identifican enseguida con Lorena, nuestra pequeña heroína, y quieren ayudar como ella.',
  },
  {
    icon: 'game-icons:paint-brush',
    titulo: 'Ilustraciones cuidadas al detalle',
    texto: 'Todo el cuento se ha trabajado con mimo, sin simplificar: sus ilustraciones atrapan la mirada de los más pequeños, ¡incluso la de los bebés! Y la 3.ª edición trae aún más color.',
    // Vídeo de la bebé («SLPH Nieta de Elizete», public/videos/bebe-leyendo.mp4, sin subir):
    // pendiente de la autorización de su familia. Para activarlo, descomentar:
    // video: { src: '/videos/bebe-leyendo.mp4', poster: '/videos/bebe-leyendo-poster.webp', pie: 'Una lectora muy pequeña' },
  },
  {
    icon: 'game-icons:sunrise',
    titulo: 'Mensaje positivo',
    texto: 'No asusta: enseña que cada uno, con sus acciones, es capaz de cuidar el mar, porque para querer proteger algo, primero hay que conocerlo.',
  },
  {
    // El rigor científico tiene su propio apartado justo debajo (Aval científico).
    icon: 'game-icons:family-house',
    titulo: 'Para leer en familia',
    texto: 'Los niños lo leen solos y los mayores lo disfrutan con ellos: de padres a hijos, un mismo mar.',
  },
];
---

<section class="relative isolate overflow-hidden py-16 sm:py-24">
  <div class="mx-auto max-w-6xl px-6">
    <div class="reveal mx-auto max-w-3xl text-center">
      <p class="font-hand text-2xl text-celeste sm:text-3xl">el libro no da lecciones: hace sentir</p>
      <h2 class="mt-2 font-display text-[clamp(2rem,5vw,3.5rem)] leading-[0.95] text-caparol">
        Cuando un cuento toca,
        <span class="whitespace-nowrap">los niños <Ola class="text-arena">actúan</Ola></span>
      </h2>
    </div>

    <ul class="mt-12 grid gap-x-8 gap-y-10 sm:grid-cols-2 lg:grid-cols-4 lg:gap-x-10">
      {razones.map((r, i) => (
        <li class={`reveal reveal-delay-${i + 1} flex flex-col border-t-2 border-arena/50 pt-6`}>
          <Icon name={r.icon} class="h-10 w-10 text-arena" aria-hidden="true" />
          <h3 class="mt-4 font-display text-2xl leading-tight text-caparol">{r.titulo}</h3>
          <p class="mt-2 text-base leading-relaxed text-caparol/80">{r.texto}</p>
          {'video' in r && r.video && (
            <button
              type="button"
              data-abrir-video={r.video.src}
              data-poster={r.video.poster}
              data-pie={r.video.pie}
              class="mt-4 flex items-center gap-2 self-start font-display text-xs tracking-[0.18em] text-arena uppercase transition hover:text-caparol"
            >
              <svg viewBox="0 0 24 24" class="h-3.5 w-3.5" fill="currentColor" aria-hidden="true"><path d="M8 5.5v13l11-6.5z"/></svg>
              Míralo
            </button>
          )}
        </li>
      ))}
    </ul>
  </div>
</section>
