---
import Ola from '../../components/Ola.astro';

/**
 * «Una obra, muchos lenguajes»: cada tarjeta es una parte de la obra y lleva a
 * la página que la desarrolla. «Lee un fragmento» y «Dónde comprar» están en
 * los botones de la cabecera y del cierre.
 */
const cards = [
  {
    href: '/autor',
    eyebrow: 'literatura',
    title: 'Sandra Santa Cruz',
    body: 'Llevó al papel lo que nació bailando, para que el mensaje del mar llegue a todos los hogares.',
    image: '/assets/sandra-2.webp',
    alt: 'Retrato de Sandra Santa Cruz, autora del cuento',
    cta: 'Conoce a la autora',
    accent: 'arena',
  },
  {
    href: '/programa',
    eyebrow: 'música',
    title: 'Un cuento con banda sonora',
    body: 'La Orquesta Filarmónica de Gran Canaria puso música a nuestro «No, no, no a la contaminación».',
    // Foto propia (SLPH FOTOS/SLPH_OFGC_…_o.jpg): la de los bailarines ya está en la Galería
    image: '/assets/cuento/ofgc-concierto.webp',
    alt: 'En escena, la tijera corta una cuerda de mascarillas que sujeta el abuelo, con la Orquesta Filarmónica de Gran Canaria y su directora al fondo',
    cta: 'Escúchalo',
    // En vez de llevar a otra página, abre aquí el concierto con la OFGC
    youtube: 'P46l0TgWoKE',
    youtubeTitulo: 'Si los peces hablaran… en concierto con la Orquesta Filarmónica de Gran Canaria',
    accent: 'celeste',
  },
  {
    href: '/ilustrador#julieta',
    eyebrow: 'ilustración',
    title: 'Pablo Tribiño',
    body: 'Dio forma ilustrada a Lorena, a Don Canino y a todo el arrecife; eso sí, con la ayuda de una supervisora muy especial, de solo 3 años…',
    image: '/assets/colaboradores/pablo-tribino/portrait.jpg',
    alt: 'Retrato de Pablo Tribiño, ilustrador del cuento',
    cta: 'Conoce a Pablo',
    accent: 'arena',
  },
  {
    href: '/realidad-aumentada',
    eyebrow: 'tecnología',
    title: 'Realidad aumentada',
    body: '¿Conoces otro cuento que te lleve hasta su musical? Busca el símbolo AR y apunta con el móvil. App gratuita AR-SLPH.',
    image: '/assets/ar/app-ar-slph.webp',
    alt: 'La app AR-SLPH: Don Canino, el tiburón del cuento, saliendo de la pantalla de un teléfono',
    cta: 'Descubre la app',
    accent: 'celeste',
  },
  {
    href: '/cuadernillo',
    eyebrow: 'aprender jugando',
    title: 'Cuadernillo de actividades',
    body: 'Juegos, laberintos y personajes para colorear que alargan la aventura más allá de la última página, vayas donde vayas.',
    image: '/assets/cuento/cuadernillo.webp',
    alt: 'Portada del cuadernillo de actividades y personajes para colorear',
    cta: 'Ver el cuadernillo',
    stamp: 'Novedad · 3.ª edición',
    accent: 'arena',
  },
  {
    href: '/programa#talleres',
    eyebrow: 'educación ambiental',
    title: 'Talleres SLPH',
    body: 'Nacieron del cuento: transformamos bibliotecas, museos y colegios en un fondo marino donde los niños dan una segunda vida a materiales que iban a la basura.',
    image: '/assets/galeria/talleres/02-biblioteca-insular.webp',
    alt: 'Taller SLPH en la Biblioteca Insular de Gran Canaria, con el cartel del cuento',
    cta: 'Ver los talleres',
    accent: 'celeste',
  },
] as const;
---

<section class="relative isolate overflow-hidden pt-14 pb-12 sm:pt-20 sm:pb-16">
  <div class="mx-auto max-w-6xl px-6">
    <div class="reveal flex items-center gap-5">
      <span aria-hidden="true" class="h-[2px] w-16 bg-arena sm:w-24"></span>
      <span class="font-display text-sm tracking-[0.4em] text-arena uppercase">
        Una obra, muchos lenguajes
      </span>
    </div>

    <h2 class="reveal reveal-delay-1 mt-8 max-w-3xl font-display text-[clamp(2.25rem,6vw,4.5rem)] leading-[0.95] text-caparol">
      El cuento que no cabe
      <span class="whitespace-nowrap">en sus <Ola class="text-arena">páginas</Ola></span>
    </h2>

    <ul class="mt-12 grid gap-7 sm:grid-cols-2 md:gap-8 lg:grid-cols-3">
      {cards.map((card, i) => {
        const Tag = 'youtube' in card ? 'button' : 'a';
        const props = 'youtube' in card
          ? { type: 'button', 'data-abrir-youtube': card.youtube, 'data-titulo': card.youtubeTitulo }
          : { href: card.href };
        return (
        <li>
          <Tag
            {...props}
            class={`reveal w-full text-left cursor-pointer reveal-delay-${Math.min(i + 1, 4)} group relative flex h-full flex-col overflow-hidden rounded-2xl border border-caparol/15 bg-azul/45 ring-1 ring-caparol/10 transition hover:border-arena/60 hover:bg-azul/65`}
          >
            <div class="relative p-3 sm:p-4">
              <div class="@container relative aspect-square overflow-hidden rounded-xl">
                {'stamp' in card && (
                  <span class="stamp-cuadernillo pointer-events-none absolute z-10 rounded-full bg-arena font-display leading-none tracking-[0.12em] whitespace-nowrap text-azul uppercase shadow-[0_6px_16px_rgba(0,0,0,0.35)]">
                    {card.stamp}
                  </span>
                )}
                <img
                  src={card.image}
                  alt={card.alt}
                  width="600"
                  height="600"
                  class="h-full w-full object-cover transition duration-500 group-hover:scale-[1.04]"
                  loading={i === 0 ? 'eager' : 'lazy'}
                />
              </div>
            </div>

            <div class="flex flex-1 flex-col gap-3 p-7 sm:p-8">
              <p class={`font-hand text-2xl sm:text-3xl ${card.accent === 'arena' ? 'text-arena' : 'text-celeste'}`}>
                {card.eyebrow}
              </p>
              <h3 class="font-display text-3xl leading-tight text-caparol sm:text-4xl">
                {card.title}
              </h3>
              <p class="text-base leading-relaxed text-caparol/85">
                {card.body}
              </p>
              <span class="ola-underline ola-hover mt-auto inline-flex items-center gap-2 self-start pt-4 font-display text-base uppercase tracking-[0.22em] text-arena">
                {card.cta}
                {'youtube' in card
                  ? <svg viewBox="0 0 24 24" class="h-4 w-4" fill="currentColor" aria-hidden="true"><path d="M8 5.5v13l11-6.5z"/></svg>
                  : <svg viewBox="0 0 24 24" class="h-4 w-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>}
              </span>
            </div>

          </Tag>
        </li>
        );
      })}
    </ul>
  </div>
</section>

<style>
  /* Sello sobre la rueda del cuadernillo. Maße in cqw (Bildbreite), damit
     Lage und Größe auf jeder Kartenbreite gleich bleiben: unten links auf
     dem Reifen, frei vom blauen Fisch und von «Sandra Santa Cruz». */
  .stamp-cuadernillo {
    left: 3.5%;
    bottom: 7%;
    /* etiqueta limpia (no manuscrita): así no compite con «aprender jugando» */
    font-size: 4.2cqw;
    padding: 0.5em 0.8em 0.45em;
    transform: rotate(-8deg);
  }
</style>
