---
import coverCuento from '../home/img/cover-cuento.webp?url';
import galeriaCueva from '../home/img/galeria-cueva.webp?url';

const cards = [
  {
    href: '/lee-un-fragmento',
    eyebrow: 'el libro',
    title: 'Lee un fragmento',
    body: 'Un esbozo del mundo marino de SLPH antes de comprarlo. Hojea el cuento ilustrado y conoce a Lorena, Nela la Irritable y compañía.',
    image: coverCuento,
    alt: 'Portada del cuento Si los peces hablaran',
    cta: 'Abrir el fragmento',
    accent: 'arena',
  },
  {
    href: '/autor',
    eyebrow: 'la autora',
    title: 'Sandra Santa Cruz',
    body: 'Bailarina, coreógrafa y autora canaria. Más de tres décadas poniendo aportando muchodanzaquedanza, y la persona detrás del programa.',
    image: '/assets/sandra-2.webp',
    alt: 'Retrato de Sandra Santa Cruz',
    cta: 'Conoce a Sandra',
    accent: 'celeste',
  },
  {
    href: '/galeria',
    eyebrow: 'imágenes',
    title: 'Galería',
    body: 'El musical, el cuento, eventos, momentos entrañables y la contaminación que nos empuja. Lo que ya vivimos con el mar.',
    image: galeriaCueva,
    alt: 'Escena del musical Si los peces hablaran con pancarta «No a la basura, el mar no se contamina»',
    cta: 'Recorrer la galería',
    accent: 'arena',
  },
] as const;
---

<section class="relative isolate overflow-hidden pt-14 pb-12 sm:pt-20 sm:pb-16">
  <div class="mx-auto max-w-6xl px-6">
    <div class="reveal flex items-center gap-5">
      <span aria-hidden="true" class="h-[2px] w-16 bg-arena sm:w-24"></span>
      <span class="font-display text-sm tracking-[0.4em] text-arena uppercase">
        Nuestros Librupeces
      </span>
    </div>

    <h1 class="reveal reveal-delay-1 mt-8 max-w-3xl font-display text-[clamp(2.25rem,6vw,4.5rem)] leading-[0.95] text-caparol">
      Elige por dónde
      <span class="hand-underline text-arena">empezar</span>
    </h1>

    <ul class="mt-12 grid gap-7 md:grid-cols-3 md:gap-8">
      {cards.map((card, i) => (
        <li>
          <a
            href={card.href}
            class={`reveal reveal-delay-${i + 1} group relative flex h-full flex-col overflow-hidden rounded-2xl border border-caparol/15 bg-azul/45 ring-1 ring-caparol/10 transition hover:border-arena/60 hover:bg-azul/65`}
          >
            <div class="relative p-3 sm:p-4">
              <div class="aspect-square overflow-hidden rounded-xl">
                <img
                  src={card.image}
                  alt={card.alt}
                  class="h-full w-full object-cover transition duration-500 group-hover:scale-[1.04]"
                  loading={i === 0 ? 'eager' : 'lazy'}
                />
              </div>
            </div>

            <div class="flex flex-1 flex-col gap-3 p-7 sm:p-8">
              <p class={`font-hand text-2xl sm:text-3xl ${card.accent === 'arena' ? 'text-arena' : 'text-celeste'}`}>
                {card.eyebrow}
              </p>
              <h3 class="font-display text-3xl leading-tight text-caparol sm:text-4xl">
                {card.title}
              </h3>
              <p class="text-base leading-relaxed text-caparol/85">
                {card.body}
              </p>
              <span class="mt-auto inline-flex items-center gap-2 pt-4 font-display text-base uppercase tracking-[0.22em] text-arena">
                {card.cta}
                <svg viewBox="0 0 24 24" class="h-4 w-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
              </span>
            </div>

            <!-- Decorative corner wave on hover -->
            <svg
              aria-hidden="true"
              class="pointer-events-none absolute -bottom-2 -right-2 h-24 w-24 text-arena/0 transition group-hover:text-arena/15"
              viewBox="0 0 80 80"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
            >
              <path d="M0 56 Q 16 44 32 56 T 64 56 T 96 56" />
              <path d="M0 68 Q 16 56 32 68 T 64 68 T 96 68" />
            </svg>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>
