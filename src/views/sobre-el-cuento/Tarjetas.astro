---
import coverCuento from '../home/img/cover-cuento.webp?url';
import Ola from '../../components/Ola.astro';

const cards = [
  {
    href: '/lee-un-fragmento',
    eyebrow: 'el libro',
    title: 'Lee un fragmento',
    body: 'Un esbozo del mundo marino de SLPH antes de comprarlo. Hojea el cuento ilustrado y conoce a Lorena, Nela la Irritable y compañía.',
    image: coverCuento,
    alt: 'Portada del cuento Si los peces hablaran',
    cta: 'Bucea en el cuento',
    accent: 'arena',
  },
  {
    href: '/realidad-aumentada',
    eyebrow: '¡salen del libro!',
    title: 'Realidad aumentada',
    body: 'Los personajes salen del libro con escenas del musical original. En Google Play y en beta abierta para iPhone y iPad.',
    image: '/assets/ar/app-ar-slph.webp',
    alt: 'La app AR-SLPH: Don Canino, el tiburón del cuento, saliendo de la pantalla de un teléfono',
    cta: 'Descubre la app',
    accent: 'celeste',
  },
  {
    href: '/autor',
    eyebrow: 'la autora',
    title: 'Sandra Santa Cruz',
    body: 'Bailarina, coreógrafa y autora canaria, responsable del programa SLPH. Casi cuatro décadas aportando mucho más que danza.',
    image: '/assets/sandra-2.webp',
    alt: 'Retrato de Sandra Santa Cruz',
    cta: 'Conoce a Sandra',
    accent: 'arena',
  },
  {
    href: '/ilustrador',
    eyebrow: 'el ilustrador',
    title: 'Pablo Tribiño',
    body: 'Ilustrador y diseñador gráfico. Suyos son los personajes y las viñetas que dan vida al mundo marino de Si los peces hablaran.',
    image: '/assets/colaboradores/pablo-tribino/portrait.jpg',
    alt: 'Retrato de Pablo Tribiño',
    cta: 'Conoce a Pablo',
    accent: 'celeste',
  },
  {
    href: '/cuadernillo',
    eyebrow: 'el cuadernillo',
    title: 'De actividades',
    body: 'Juegos y actividades para prolongar la aventura del cuento y conectar con el mar, pensados para acompañar a diversas edades.',
    image: '/assets/cuento/cuadernillo.webp',
    alt: 'Portada del cuadernillo de actividades y personajes para colorear',
    cta: 'Ver el cuadernillo',
    stamp: '¡novedad de la 3.ª edición!',
    accent: 'arena',
  },
  {
    href: '/comprar',
    eyebrow: 'llévatelo a casa',
    title: 'Dónde comprar',
    body: 'Online, en el Centro de Danza Sandra Santa Cruz y en librerías repartidas por Gran Canaria.',
    image: '/assets/comprar/cuento-en-la-orilla.webp',
    alt: 'El cuento Si los peces hablaran abierto sobre una roca en la orilla',
    cta: 'Ver dónde comprar',
    accent: 'celeste',
  },
] as const;
---

<section class="relative isolate overflow-hidden pt-14 pb-12 sm:pt-20 sm:pb-16">
  <div class="mx-auto max-w-6xl px-6">
    <div class="reveal flex items-center gap-5">
      <span aria-hidden="true" class="h-[2px] w-16 bg-arena sm:w-24"></span>
      <span class="font-display text-sm tracking-[0.4em] text-arena uppercase">
        Nuestros Librupeces
      </span>
    </div>

    <h1 class="reveal reveal-delay-1 mt-8 max-w-3xl font-display text-[clamp(2.25rem,6vw,4.5rem)] leading-[0.95] text-caparol">
      Elige por dónde
      <Ola class="text-arena">empezar</Ola>
    </h1>

    <ul class="mt-12 grid gap-7 sm:grid-cols-2 md:gap-8 lg:grid-cols-3">
      {cards.map((card, i) => (
        <li>
          <a
            href={card.href}
            class={`reveal reveal-delay-${Math.min(i + 1, 4)} group relative flex h-full flex-col overflow-hidden rounded-2xl border border-caparol/15 bg-azul/45 ring-1 ring-caparol/10 transition hover:border-arena/60 hover:bg-azul/65`}
          >
            <div class="relative p-3 sm:p-4">
              <div class="@container relative aspect-square overflow-hidden rounded-xl">
                {'stamp' in card && (
                  <span class="stamp-cuadernillo pointer-events-none absolute z-10 rounded-full bg-arena font-hand leading-none whitespace-nowrap text-azul shadow-[0_6px_16px_rgba(0,0,0,0.35)]">
                    {card.stamp}
                  </span>
                )}
                <img
                  src={card.image}
                  alt={card.alt}
                  class="h-full w-full object-cover transition duration-500 group-hover:scale-[1.04]"
                  loading={i === 0 ? 'eager' : 'lazy'}
                />
              </div>
            </div>

            <div class="flex flex-1 flex-col gap-3 p-7 sm:p-8">
              <p class={`font-hand text-2xl sm:text-3xl ${card.accent === 'arena' ? 'text-arena' : 'text-celeste'}`}>
                {card.eyebrow}
              </p>
              <h3 class="font-display text-3xl leading-tight text-caparol sm:text-4xl">
                {card.title}
              </h3>
              <p class="text-base leading-relaxed text-caparol/85">
                {card.body}
              </p>
              <span class="ola-underline ola-hover mt-auto inline-flex items-center gap-2 self-start pt-4 font-display text-base uppercase tracking-[0.22em] text-arena">
                {card.cta}
                <svg viewBox="0 0 24 24" class="h-4 w-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
              </span>
            </div>

          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  /* Sello sobre la rueda del cuadernillo. Maße in cqw (Bildbreite), damit
     Lage und Größe auf jeder Kartenbreite gleich bleiben: unten links auf
     dem Reifen, frei vom blauen Fisch und von «Sandra Santa Cruz». */
  .stamp-cuadernillo {
    left: 3.5%;
    bottom: 7%;
    font-size: 5.4cqw;
    padding: 0.35em 0.6em 0.4em;
    transform: rotate(-13deg);
  }
</style>
