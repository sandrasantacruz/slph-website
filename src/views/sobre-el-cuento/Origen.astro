---
import { Icon } from "astro-icon/components";

const estrenoImg =
  "/assets/galeria/momentos/Momentos-Entrañables_DSC_0040.webp";
---

<section class="relative isolate overflow-hidden py-20 sm:py-28">
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 -z-20 bg-[radial-gradient(55%_45%_at_25%_25%,rgba(100,170,210,0.10),transparent_70%)]"
  >
  </div>

  <div class="mx-auto max-w-6xl px-6">
    <div class="grid items-start gap-12 lg:grid-cols-12 lg:gap-16">
      <!-- Text column -->
      <div class="lg:col-span-7 lg:col-start-1 lg:row-start-1">
        <div class="reveal flex items-center gap-5">
          <span aria-hidden="true" class="h-[2px] w-16 bg-arena sm:w-24"></span>
          <span
            class="font-display text-sm tracking-[0.4em] text-arena uppercase"
          >
            El origen del cuento
          </span>
        </div>

        <h2
          class="reveal reveal-delay-1 mt-8 font-display text-[clamp(2.25rem,6vw,4.5rem)] leading-[0.95] text-caparol"
        >
          Un cuento que nació de
          <span class="hand-underline text-arena">su propio musical</span>
        </h2>

        <div
          class="reveal reveal-delay-2 mt-8 space-y-5 text-lg leading-relaxed text-caparol/90 sm:text-xl"
        >
          <p>
            Que sepamos, es la <strong class="font-display text-2xl text-arena"
              >primera vez</strong
            > que un cuento se escribe por la repercusión de su propio musical.
          </p>
          <p>
            La reacción entre el alumnado del Centro de Danza de nuestra autora
            fue tal, que Sandra decidió escribir la historia para que sus
            mensajes perduren y pasen de una generación a otra.
          </p>
        </div>
      </div>

      <!-- Ficha del estreno, full width under both columns on desktop -->
      <div
        class="reveal reveal-delay-3 flex flex-wrap items-center gap-x-8 gap-y-3 rounded-2xl border border-celeste/25 bg-azul-deep/40 p-6 ring-1 ring-caparol/10 backdrop-blur-sm sm:p-7 lg:col-span-12 lg:col-start-1 lg:row-start-2"
      >
        <div class="flex items-center gap-3">
          <Icon name="game-icons:musical-notes" class="h-6 w-6 text-celeste" />
          <span class="text-base text-caparol/85">
            Música de <strong class="font-display text-lg text-caparol"
              >Juan Ramos</strong
            >
          </span>
        </div>
        <div class="flex items-center gap-3">
          <Icon name="game-icons:quill-ink" class="h-6 w-6 text-celeste" />
          <span class="text-base text-caparol/85">
            Letras de <strong class="font-display text-lg text-caparol"
              >Juan Luis Santa Cruz</strong
            >
          </span>
        </div>
        <p class="w-full text-base text-caparol/75">
          Un formato totalmente original, estrenado en julio de 2016, por el
          Centro de Danza Sandra Santa Cruz. Debido a la relevancia de este
          musical se sumaron a él artistas de la talla de Lili Quintana, Nauzet
          Valerón y Ohiane Viñaspre.
        </p>
      </div>

      <!-- Image column -->
      <div class="reveal reveal-delay-2 lg:col-span-5 lg:col-start-8 lg:row-start-1">
        <div class="relative mx-auto max-w-xs sm:max-w-sm lg:max-w-none">
          <div
            aria-hidden="true"
            class="anim-sway absolute -inset-3 -z-10 rounded-[1.5rem] border-2 border-dashed border-celeste/30"
          >
          </div>

          <div class="polaroid tilt-r1 transition duration-500 hover:rotate-0">
            <img
              src={estrenoImg}
              alt="Alumnas del Centro de Danza Sandra Santa Cruz sosteniendo botellas de plástico"
              class="block aspect-[4/3] w-full object-cover"
              loading="lazy"
              decoding="async"
            />
            <p
              class="absolute bottom-2 left-0 right-0 text-center font-hand text-3xl leading-none text-azul sm:text-4xl"
            >
              su alumnado de Predanza
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
