---
/**
 * «Diez años creciendo» en cifras (Dossier Bibliotecas 2026-2027). La línea de
 * tiempo completa está en La autora (#trayectoria): aquí no se repite.
 */
import EnlaceFlecha from '../../components/EnlaceFlecha.astro';
import Ola from '../../components/Ola.astro';

const cifras = [
  { valor: '+10', texto: 'años dando voz al mar' },
  { valor: '+70', texto: 'actividades' },
  { valor: '+3.000', texto: 'escolares en el musical' },
  { valor: '4', texto: 'islas… ¡y hasta Colombia!' },
];
---

<section id="diez-anos" class="relative isolate scroll-mt-24 overflow-hidden py-12 sm:py-16">
  <div class="mx-auto max-w-6xl px-6 text-center">
    <p class="reveal font-hand text-2xl text-celeste sm:text-3xl">en cifras</p>
    <h2 class="reveal reveal-delay-1 mt-2 font-display text-[clamp(2rem,5vw,3.5rem)] leading-[0.95] text-caparol">
      Creciendo
      <Ola class="text-arena">desde 2016</Ola>
    </h2>

    <ul class="mt-12 grid grid-cols-2 gap-x-6 gap-y-10 lg:grid-cols-4">
      {cifras.map((c, i) => (
        <li class={`reveal reveal-delay-${i + 1}`}>
          <p class="font-display text-[clamp(2.75rem,7vw,4.5rem)] leading-none text-arena">{c.valor}</p>
          <p class="mt-2 text-base text-caparol/85 sm:text-lg">{c.texto}</p>
        </li>
      ))}
    </ul>

    <div class="reveal mt-12 flex flex-wrap justify-center gap-4">
      <EnlaceFlecha href="/autor#trayectoria">Hitos del camino</EnlaceFlecha>
      <EnlaceFlecha href="/programa">Programa SLPH</EnlaceFlecha>
    </div>
  </div>
</section>
