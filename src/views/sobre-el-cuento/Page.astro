---
import Trailer from './Trailer.astro';
import MainLayout from '../../layouts/MainLayout.astro';
import Hero from './Hero.astro';
import Razones from './Razones.astro';
import AvalCientifico from './AvalCientifico.astro';
import Tarjetas from './Tarjetas.astro';
import Trayectoria from './Trayectoria.astro';
import Fragmento from './Fragmento.astro';
import SeparadorPulpo from './SeparadorPulpo.astro';
import Origen from './Origen.astro';
import Curiosidad from './Curiosidad.astro';
import Cierre from './Cierre.astro';
import WaterLine from '../../components/WaterLine.astro';
import LoQueDicen from './LoQueDicen.astro';
import Lightbox from '../galeria/Lightbox.astro';
import { bookSchema, breadcrumbSchema, cuadernilloSchema } from '../../lib/seo';

const breadcrumb = breadcrumbSchema([
  { name: 'Inicio', url: '/' },
  { name: 'Sobre el cuento', url: '/sobre-el-cuento' },
]);
---

<MainLayout
  title="Cuento infantil ilustrado sobre el mar · Si los peces hablaran…"
  description="¿Quieres unirte al Club SLPH? Lorena descubre que los peces quieren pedirnos ayuda. 3.ª edición, con realidad aumentada y cuadernillo de actividades."
  image="/assets/og-cuento.jpg"
  imageAlt="Una familia leyendo juntos la 3.ª edición del cuento infantil ilustrado Si los peces hablaran…"
  imageWidth={1200}
  imageHeight={630}
  type="book"
  jsonLd={[bookSchema({ precio: true }), cuadernilloSchema(), breadcrumb]}
>
  <Hero />
  <!-- Primera mitad: lo que quiere saber quien compra -->
  <Tarjetas />
  <Razones />
  <!-- La ciencia respalda lo que se acaba de contar: pruebas juntas (ciencia, después lectores) -->
  <AvalCientifico />
  <SeparadorPulpo />
  <LoQueDicen />
  <!-- después de las opiniones: “compruébalo tú” -->
  <Fragmento />
  <Trailer />
  <!-- Segunda mitad: la historia (en orden) y la garantía antes de comprar -->
  <WaterLine separador clave="-b" />
  <Origen />
  <Curiosidad />
  <!-- “Diez años creciendo”, entre dos líneas de agua, como Izzy en El ilustrador -->
  <WaterLine separador clave="-a" />
  <Trayectoria />
  <!-- la línea de agua de la cabecera separa la historia de la ficha y la compra -->
  <WaterLine separador />
  <Cierre />
  <Lightbox />
</MainLayout>

<script>
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const targets = document.querySelectorAll<HTMLElement>('.reveal');

  if (reduceMotion) {
    targets.forEach((el) => el.classList.add('is-visible'));
  } else {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          }
        });
      },
      { rootMargin: '0px 0px -10% 0px', threshold: 0.05 },
    );
    targets.forEach((el) => observer.observe(el));
  }
</script>
