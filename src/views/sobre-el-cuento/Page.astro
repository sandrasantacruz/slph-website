---
import MainLayout from '../../layouts/MainLayout.astro';
import Tarjetas from './Tarjetas.astro';
import Origen from './Origen.astro';
import MusicalGaleria from './MusicalGaleria.astro';
import Curiosidad from './Curiosidad.astro';
import CuentoGaleria from './CuentoGaleria.astro';
import Cierre from './Cierre.astro';
import Lightbox from '../galeria/Lightbox.astro';
import { bookSchema, breadcrumbSchema } from '../../lib/seo';

const breadcrumb = breadcrumbSchema([
  { name: 'Inicio', url: '/' },
  { name: 'Sobre el cuento', url: '/sobre-el-cuento' },
]);
---

<MainLayout
  title="Sobre el cuento"
  description="Tres puertas para asomarte a Si los peces hablaran: lee un fragmento del cuento de Sandra Santa Cruz, conoce a la autora y recorre la galería del proyecto."
  type="book"
  jsonLd={[bookSchema(), breadcrumb]}
>
  <Tarjetas />
  <Origen />
  <MusicalGaleria />
  <Curiosidad />
  <CuentoGaleria />
  <Cierre />
  <Lightbox />
</MainLayout>

<script>
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const targets = document.querySelectorAll<HTMLElement>('.reveal');

  if (reduceMotion) {
    targets.forEach((el) => el.classList.add('is-visible'));
  } else {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          }
        });
      },
      { rootMargin: '0px 0px -10% 0px', threshold: 0.05 },
    );
    targets.forEach((el) => observer.observe(el));
  }
</script>
