---
import MainLayout from '../../layouts/MainLayout.astro';
import Hero from './Hero.astro';
import Razones from './Razones.astro';
import AvalCientifico from './AvalCientifico.astro';
import Tarjetas from './Tarjetas.astro';
import Origen from './Origen.astro';
import MusicalGaleria from './MusicalGaleria.astro';
import Curiosidad from './Curiosidad.astro';
import CuentoGaleria from './CuentoGaleria.astro';
import Cierre from './Cierre.astro';
import LoQueDicen from './LoQueDicen.astro';
import Lightbox from '../galeria/Lightbox.astro';
import { bookSchema, breadcrumbSchema } from '../../lib/seo';

const breadcrumb = breadcrumbSchema([
  { name: 'Inicio', url: '/' },
  { name: 'Sobre el cuento', url: '/sobre-el-cuento' },
]);
---

<MainLayout
  title="Si los peces hablaran…: cuento infantil sobre el mar | Sandra Santa Cruz"
  description="Cuento infantil de Sandra Santa Cruz con realidad aumentada y supervisión científica de la ULPGC. Desde 6 años. Nace de su propio musical. 3.ª edición."
  image="/assets/og-cuento.jpg"
  imageAlt="Portada de la 3.ª edición del cuento Si los peces hablaran…, de Sandra Santa Cruz"
  imageWidth={1200}
  imageHeight={630}
  type="book"
  jsonLd={[bookSchema(), breadcrumb]}
>
  <Hero />
  <Razones />
  <LoQueDicen />
  <AvalCientifico />
  <Tarjetas />
  <Origen />
  <MusicalGaleria />
  <Curiosidad />
  <CuentoGaleria />
  <Cierre />
  <Lightbox />
</MainLayout>

<script>
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const targets = document.querySelectorAll<HTMLElement>('.reveal');

  if (reduceMotion) {
    targets.forEach((el) => el.classList.add('is-visible'));
  } else {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          }
        });
      },
      { rootMargin: '0px 0px -10% 0px', threshold: 0.05 },
    );
    targets.forEach((el) => observer.observe(el));
  }
</script>
