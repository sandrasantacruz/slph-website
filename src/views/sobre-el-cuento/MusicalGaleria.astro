---
const imagenes = [
  {
    src: "/assets/musical/danza-del-arrecife-de-coral.webp",
    alt: "Danza del arrecife de coral, musical Si los peces hablaran",
  },
  {
    src: "/assets/musical/danza-de-las-espadas.webp",
    alt: "Danza de las Espadas, musical Si los peces hablaran",
  },
  {
    src: "/assets/musical/don-canino-llega-al-arrecife.webp",
    alt: "Don Canino llega al arrecife, musical Si los peces hablaran",
  },
] as const;
---

<section class="relative isolate overflow-hidden pt-8 pb-4 sm:pt-12 sm:pb-6">
  <div class="mx-auto max-w-6xl px-6">
    <div class="reveal flex items-center gap-5">
      <span aria-hidden="true" class="h-[2px] w-16 bg-arena sm:w-24"></span>
      <span class="font-display text-sm tracking-[0.4em] text-arena uppercase">
        EL MUSICAL DEL CENTRO DE DANZA
      </span>
    </div>

    <div
      class="mt-8 grid items-start gap-6 mx-auto max-w-xl lg:max-w-none lg:grid-cols-3"
    >
      {
        imagenes.map((img, i) => (
          <a
            href={img.src}
            data-lightbox
            data-gallery="musical-escena"
            data-caption={img.alt}
            aria-label="Ampliar imagen del musical"
            class={`reveal reveal-delay-${i + 1} group block cursor-zoom-in overflow-hidden rounded-xl border border-caparol/15 bg-azul-deep/50 ring-1 ring-caparol/10 transition hover:border-arena/60 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-arena`}
          >
            <img
              src={img.src}
              alt={img.alt}
              class="block aspect-[5/3] w-full object-cover transition duration-500 group-hover:brightness-110"
              loading="lazy"
              decoding="async"
            />
          </a>
        ))
      }
    </div>
  </div>
</section>
