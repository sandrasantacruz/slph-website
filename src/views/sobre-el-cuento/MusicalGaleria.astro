---
import { srcset } from '../../lib/srcset';
import EnlaceFlecha from '../../components/EnlaceFlecha.astro';

const imagenes = [
  {
    src: "/assets/musical/danza-del-arrecife-de-coral.webp",
    alt: "Danza del arrecife de coral, en el musical Si los peces hablaran…",
  },
  {
    src: "/assets/musical/danza-de-las-espadas.webp",
    alt: "Danza de las Espadas, en el musical Si los peces hablaran…",
  },
  {
    src: "/assets/musical/don-canino-llega-al-arrecife.webp",
    alt: "Don Canino llega al arrecife, en el musical Si los peces hablaran…",
  },
] as const;
---

<!-- Parte del bloque anterior (no es una sección aparte): solo la etiqueta
     manuscrita, el carrusel y el enlace a la galería. -->
<div class="mt-16 sm:mt-20">
  <div>
    <p class="reveal font-hand text-2xl text-celeste sm:text-3xl">el musical que dio pie al programa</p>

    <div
      class="carrusel -mx-6 mt-5 flex snap-x snap-mandatory items-start gap-4 overflow-x-auto px-6 pb-2 lg:mx-0 lg:grid lg:grid-cols-3 lg:gap-6 lg:overflow-visible lg:px-0 lg:pb-0"
    >
      {
        imagenes.map((img, i) => (
          <a
            href={img.src}
            data-lightbox
            data-gallery="musical-escena"
            data-caption={img.alt}
            aria-label="Ampliar imagen del musical"
            class={`reveal reveal-delay-${i + 1} group block w-[82%] shrink-0 snap-center sm:w-[60%] lg:w-auto cursor-zoom-in overflow-hidden rounded-xl border border-caparol/15 bg-azul-deep/50 ring-1 ring-caparol/10 transition hover:border-arena/60 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-arena`}
          >
            <img
              src={img.src}
              srcset={srcset(img.src, 1500)}
              sizes="(min-width: 1024px) 360px, (min-width: 640px) 60vw, 300px"
              alt={img.alt}
              width="1500"
              height="900"
              class="block aspect-[5/3] w-full object-cover transition duration-500 group-hover:brightness-110"
              loading="lazy"
              decoding="async"
            />
          </a>
        ))
      }
    </div>
    <p class="mt-3 text-center font-hand text-xl text-celeste/80 lg:hidden" aria-hidden="true">desliza para ver más →</p>
    <div class="reveal mt-10 flex justify-center">
      <EnlaceFlecha href="/galeria#musical">Ver el musical original</EnlaceFlecha>
    </div>
  </div>
</div>
