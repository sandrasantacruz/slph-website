---
import { getCollection } from 'astro:content';

import MainLayout from '../../layouts/MainLayout.astro';
import NovedadCard from '../novedades/NovedadCard.astro';
import { byDateDesc } from '../../lib/posts';
import { normalize } from '../../lib/search';
import { breadcrumbSchema } from '../../lib/seo';

// Statische Seiten — Suchindex direkt im Code, da sie nicht in PB liegen.
// Reicht für eine kleine Site; wenn das wächst, in eine eigene Datei ziehen.
interface StaticEntry {
  title: string;
  url: string;
  description: string;
  keywords: string;
}

const STATIC_PAGES: StaticEntry[] = [
  {
    title: 'Inicio',
    url: '/',
    description:
      'Programa de concienciación medioambiental que protege los ecosistemas marinos a través de las artes, las ciencias y la educación.',
    keywords: 'inicio home slph programa medio ambiente mar océano arte ciencia educación',
  },
  {
    title: 'El programa SLPH',
    url: '/programa',
    description:
      'Talleres, principios y diferenciadores del programa educativo SLPH, supervisado por la Facultad de Ciencias del Mar.',
    keywords: 'programa talleres ciencia mar educación principios facultad universidad',
  },
  {
    title: 'Sobre el cuento',
    url: '/sobre-el-cuento',
    description:
      'Tres puertas para asomarte al cuento: fragmento, autora y galería del proyecto.',
    keywords: 'cuento libro fragmento autora galería ilustraciones',
  },
  {
    title: 'Lee un fragmento',
    url: '/lee-un-fragmento',
    description: 'Lee un fragmento del cuento Si los peces hablaran online.',
    keywords: 'fragmento extracto preview cuento libro leer online',
  },
  {
    title: 'El cuadernillo · Cuaderno de actividades',
    url: '/cuadernillo',
    description:
      'Cuaderno de actividades del cuento Si los peces hablaran: juegos y actividades para todas las edades, con una edición para Oncología Infantil.',
    keywords: 'cuadernillo cuaderno actividades juegos pasatiempos colorear todas las edades oncología infantil aula centro escolar',
  },
  {
    title: 'Sandra Santa Cruz · La autora',
    url: '/autor',
    description:
      'Bailarina, coreógrafa y autora canaria. Más de tres décadas al frente del Centro de Danza Sandra Santa Cruz.',
    keywords: 'sandra santa cruz autora bailarina coreógrafa danza centro biografía',
  },
  {
    title: 'Pablo Tribiño · El ilustrador',
    url: '/ilustrador',
    description:
      'Ilustrador y diseñador gráfico argentino. Autor de los personajes y las viñetas del cuento Si los peces hablaran.',
    keywords: 'pablo tribiño ilustrador dibujante diseñador gráfico ilustraciones personajes viñetas cuento',
  },
  {
    title: 'Repercusión · En los medios',
    url: '/repercusion',
    description:
      'La repercusión de Si los peces hablaran en los medios: del papel al escenario y a Televisión Canaria. El cuento que nace por la repercusión de su propio musical.',
    keywords: 'repercusión medios prensa televisión canaria musical impacto reconocimiento',
  },
  {
    title: 'Galería',
    url: '/galeria',
    description:
      'Imágenes del musical, el cuento, los eventos y los momentos del proyecto.',
    keywords: 'galería fotos imágenes musical eventos momentos contaminación',
  },
  {
    title: 'Dónde comprar',
    url: '/comprar',
    description:
      'Tienda online de Entintadas y librerías asociadas en Gran Canaria y Tenerife.',
    keywords: 'comprar tienda librería online entintadas gran canaria tenerife libro',
  },
  {
    title: 'Noticias',
    url: '/noticias',
    description:
      'Eventos, encuentros y notas de prensa del proyecto Si los peces hablaran.',
    keywords: 'noticias novedades eventos prensa actividades',
  },
  {
    title: 'Colabora',
    url: '/colabora',
    description:
      'Voluntariado, donaciones puntuales o mecenazgo institucional para el proyecto.',
    keywords: 'colaborar voluntariado donaciones mecenazgo donar ayuda',
  },
  {
    title: 'Contacto',
    url: '/contacto',
    description: 'WhatsApp, correo electrónico y teléfono. Sin formularios.',
    keywords: 'contacto whatsapp email correo teléfono',
  },
];

// Die Seite ist prerendered, `?q=` gibt es zur Build-Zeit also nicht. Deshalb
// wird alles Durchsuchbare einmal ausgeliefert und im Browser gefiltert: die
// Seiten oben, die Artikel als fertige Karten. Das spart eine zweite
// Kartenimplementierung in JavaScript und macht die Suche sofort reaktiv.
const posts = (await getCollection('posts')).sort(byDateDesc);

const haystack = (...parts: (string | undefined)[]) =>
  normalize(parts.filter(Boolean).join(' '));

const breadcrumb = breadcrumbSchema([
  { name: 'Inicio', url: '/' },
  { name: 'Buscar', url: '/buscar' },
]);

const pageTitle = 'Buscar';
const pageDescription =
  'Busca contenido en la web del proyecto Si los peces hablaran.';
---

<MainLayout title={pageTitle} description={pageDescription} noindex jsonLd={[breadcrumb]}>
  <section class="mx-auto max-w-4xl px-6 py-20 sm:py-28" data-search-root>
    <p class="font-hand text-3xl text-celeste sm:text-4xl">a la deriva</p>
    <h1 class="mt-4 font-display text-[clamp(2.5rem,7vw,5rem)] leading-[0.95] text-caparol">
      Buscar en la web
    </h1>

    <form
      action="/buscar"
      method="get"
      role="search"
      class="mt-10 flex flex-col gap-3 sm:flex-row"
    >
      <label class="sr-only" for="search-q">Términos de búsqueda</label>
      <input
        id="search-q"
        name="q"
        type="search"
        placeholder="¿Qué quieres encontrar?"
        autocomplete="off"
        autofocus
        class="flex-1 rounded-full border-2 border-caparol/30 bg-azul/40 px-5 py-3 font-display text-lg text-caparol placeholder:text-caparol/40 focus:border-arena focus:outline-none"
      />
      <button
        type="submit"
        class="rounded-full bg-arena px-6 py-3 font-display text-lg text-negro transition hover:brightness-95"
      >
        Buscar
      </button>
    </form>

    <p class="mt-6 text-sm text-caparol/70" data-search-count hidden></p>

    <section class="mt-12" data-search-section="paginas" hidden>
      <h2 class="font-display text-xs uppercase tracking-[0.3em] text-arena">
        Páginas
      </h2>
      <ul class="mt-6 divide-y divide-caparol/15 border-y border-caparol/15">
        {STATIC_PAGES.map((page) => (
          <li
            class="py-5"
            hidden
            data-search={haystack(page.title, page.description, page.keywords)}
          >
            <a href={page.url} class="group block">
              <h3 class="font-display text-2xl text-caparol transition group-hover:text-arena">
                {page.title}
              </h3>
              <p class="mt-1 text-sm text-caparol/75 sm:text-base">{page.description}</p>
              <p class="mt-1 font-mono text-xs text-celeste/80">
                silospeceshablaran.com{page.url}
              </p>
            </a>
          </li>
        ))}
      </ul>
    </section>

    <section class="mt-16" data-search-section="noticias" hidden>
      <h2 class="font-display text-xs uppercase tracking-[0.3em] text-arena">
        Noticias
      </h2>
      <ul class="mt-6 grid gap-5 sm:gap-6">
        {posts.map((item) => (
          <NovedadCard
            item={item}
            hidden
            search={haystack(item.data.title, item.data.teaser, item.data.location)}
          />
        ))}
      </ul>
    </section>

    <div class="mt-12 rounded-2xl border border-caparol/15 bg-azul/40 p-6" data-search-empty hidden>
      <p class="text-base text-caparol/85">
        No hemos encontrado nada con ese término. Prueba con palabras más
        generales o vuelve al <a href="/" class="text-arena hover:underline">inicio</a>.
      </p>
    </div>
  </section>
</MainLayout>

<script>
  import { normalize } from '../../lib/search';

  const root = document.querySelector<HTMLElement>('[data-search-root]');
  const input = document.getElementById('search-q') as HTMLInputElement | null;
  if (root && input) {
    const count = root.querySelector<HTMLElement>('[data-search-count]')!;
    const empty = root.querySelector<HTMLElement>('[data-search-empty]')!;
    const sections = [...root.querySelectorAll<HTMLElement>('[data-search-section]')];
    const items = sections.map((section) => ({
      section,
      entries: [...section.querySelectorAll<HTMLElement>('[data-search]')],
    }));

    function apply(raw: string) {
      const q = normalize(raw);
      let total = 0;

      for (const { section, entries } of items) {
        let visible = 0;
        for (const el of entries) {
          const hit = q !== '' && (el.dataset.search ?? '').includes(q);
          el.hidden = !hit;
          if (hit) visible += 1;
        }
        section.hidden = visible === 0;
        total += visible;
      }

      const term = raw.trim();
      count.hidden = term === '';
      count.textContent =
        total === 0
          ? `Sin resultados para «${term}».`
          : `${total} ${total === 1 ? 'resultado' : 'resultados'} para «${term}»`;
      empty.hidden = term === '' || total > 0;

      // Die URL mitführen, damit ein Treffer teilbar bleibt.
      const url = new URL(location.href);
      if (term) url.searchParams.set('q', term);
      else url.searchParams.delete('q');
      history.replaceState(null, '', url);
    }

    input.value = new URL(location.href).searchParams.get('q') ?? '';
    apply(input.value);

    input.addEventListener('input', () => apply(input.value));
    // Kein Neuladen: die Seite ist statisch, gefiltert wird ohnehin hier.
    root.querySelector('form')?.addEventListener('submit', (e) => {
      e.preventDefault();
      apply(input.value);
    });
  }
</script>
