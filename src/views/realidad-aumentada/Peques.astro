---
import Ola from '../../components/Ola.astro';

// Zwei kurze Schnitte aus MVI_2218_AR (s 41–49,5 und 150–158), stumm und in
// Schleife. Die beiden Bildunterschriften lesen sich als ein Satz.
const videos = [
  {
    src: '/assets/ar/peques-sorpresa.mp4',
    poster: '/assets/ar/peques-sorpresa.webp',
    label: 'Dos niñas se ríen y sonríen a cámara al ver la realidad aumentada del cuento',
    pie: 'cuando la escena sale del libro…',
  },
  {
    src: '/assets/ar/peques-movil.mp4',
    poster: '/assets/ar/peques-movil.webp',
    label: 'Un móvil apunta al cuento y en la pantalla se mueve la escena',
    pie: '¡nuestro arrecife cabe en sus manos!',
  },
];
---

<!-- Bei reduzierter Bewegung blendet sich der ganze Abschnitt aus: ohne Videos
     stünden nur Titel und Bildunterschriften da. -->
<section class="relative isolate overflow-hidden pb-16 motion-reduce:hidden sm:pb-20">
  <div class="mx-auto max-w-6xl px-6">
    <div class="reveal flex items-center gap-4">
      <span aria-hidden="true" class="h-px w-10 bg-arena sm:w-16"></span>
      <span class="font-display text-xs tracking-[0.4em] text-arena uppercase sm:text-sm">
        Miradas que lo dicen todo
      </span>
    </div>

    <h2 class="reveal reveal-delay-1 mt-6 font-display text-[clamp(2rem,5vw,3.4rem)] leading-[0.95] text-caparol">
      Abren el cuento…
      <span class="whitespace-nowrap">¡y el mar <Ola class="text-arena">cobra vida</Ola>!</span>
    </h2>

    <div class="mt-10 grid gap-6 md:grid-cols-2 md:gap-8">
      {videos.map((v, i) => (
        <figure class={`reveal reveal-delay-${i + 1}`}>
          <div class="overflow-hidden rounded-2xl shadow-[0_20px_40px_-16px_rgba(3,10,35,0.8)] ring-1 ring-caparol/15">
            <video
              src={v.src}
              poster={v.poster}
              width="720"
              height="406"
              autoplay
              muted
              loop
              playsinline
              aria-label={v.label}
              class="block aspect-video w-full object-cover"
            ></video>
          </div>
          <figcaption class="mt-3 text-center font-hand text-2xl text-celeste">{v.pie}</figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>
