---
import Ola from '../../components/Ola.astro';

// Zwei kurze Schnitte aus MVI_2218_AR (s 41–49,5 und 150–158), stumm und in
// Schleife. Der Block ist der emotionale Höhepunkt der Seite: echte Reaktionen,
// die jeder sieht, ohne die App zu laden. Deshalb breit und groß; die Quellen
// jetzt 1280×720 aus dem Original (Kamerakarte), vorher 720 px.
// Ohne Bildunterschriften: die Gesichter sprechen für sich («Miradas que lo
// dicen todo»), und die Zeile aus dem Buch darunter bekommt das Gewicht.
const principal = {
  src: '/assets/ar/peques-sorpresa.mp4',
  poster: '/assets/ar/peques-sorpresa.webp',
  label: 'Dos niñas se ríen y sonríen a cámara al ver la realidad aumentada del cuento',
};
const secundario = {
  src: '/assets/ar/peques-movil.mp4',
  poster: '/assets/ar/peques-movil.webp',
  label: 'Un móvil apunta al cuento y en la pantalla se mueve la escena',
};
const marco = 'overflow-hidden rounded-3xl shadow-[0_30px_60px_-20px_rgba(3,10,35,0.9)] ring-1 ring-caparol/15';
---

<!-- Bei reduzierter Bewegung bleiben die Videos stehen (Posterbild), statt dass
     der ganze Abschnitt verschwindet: so bleibt auch der Satz aus dem Buch. -->
<section id="miradas" class="relative isolate my-8 scroll-mt-24 overflow-hidden py-20 sm:my-12 sm:py-28">
  <!-- Franja propia: más profunda y con un halo de luz, para marcar el momento -->
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 -z-10 bg-[radial-gradient(60%_55%_at_50%_55%,rgba(100,170,210,0.22),transparent_70%),linear-gradient(180deg,transparent,rgba(5,16,48,0.75)_18%,rgba(5,16,48,0.75)_82%,transparent)]"
  ></div>

  <div class="mx-auto max-w-6xl px-6">
    <div class="reveal flex items-center justify-center gap-4">
      <span aria-hidden="true" class="h-px w-10 bg-arena sm:w-16"></span>
      <span class="font-display text-xs tracking-[0.4em] text-arena uppercase sm:text-sm">
        Miradas que lo dicen todo
      </span>
      <span aria-hidden="true" class="h-px w-10 bg-arena sm:w-16"></span>
    </div>

    <h2 class="reveal reveal-delay-1 mx-auto mt-6 max-w-4xl text-center font-display text-[clamp(2.4rem,6.5vw,5rem)] leading-[0.95] text-caparol">
      Abren el cuento…
      <span class="block">¡y el mar <Ola class="text-arena">cobra vida</Ola>!</span>
    </h2>

    <div class="mt-12 grid items-center gap-8 sm:mt-16 lg:grid-cols-3 lg:gap-8">
      <figure class="reveal reveal-delay-1 lg:col-span-2">
        <div class={marco}>
          <video
            src={principal.src}
            poster={principal.poster}
            width="1280"
            height="720"
            autoplay
            muted
            loop
            playsinline
            aria-label={principal.label}
            class="block aspect-video w-full object-cover"
          ></video>
        </div>
      </figure>

      <figure class="reveal reveal-delay-2">
        <div class:list={[marco, 'relative']}>
          <video
            src={secundario.src}
            poster={secundario.poster}
            width="1280"
            height="720"
            autoplay
            muted
            loop
            playsinline
            aria-label={secundario.label}
            class="block aspect-video w-full object-cover lg:aspect-[8/9] lg:object-[42%_50%]"
          ></video>
          <!-- La única leyenda: dentro del vídeo, sobre un degradado, para que las
               dos piezas queden a la misma altura -->
          <figcaption class="pointer-events-none absolute inset-x-0 bottom-0 bg-gradient-to-t from-azul-deep/90 via-azul-deep/50 to-transparent px-4 pt-14 pb-4 text-center font-hand text-2xl leading-tight text-caparol sm:text-3xl">nuestro arrecife<span class="block">¡en sus manos!</span></figcaption>
        </div>
      </figure>
    </div>

    <!-- Frase del cuento como remate: la dice Lorena, capítulo 10, pág. 124 de la 3.ª ed.
         (comprobado en el PDF el 23 nov 2026), literal hasta «niña-niña». -->
    <figure class="reveal mx-auto mt-14 max-w-3xl text-center sm:mt-20">
      <blockquote class="font-hand text-[clamp(1.9rem,4.5vw,3rem)] leading-tight text-arena">
        «Cada vez que escucho su historia me gustaría ser niña-pez en lugar de niña-niña…»
      </blockquote>
      <figcaption class="mt-3 font-display text-xs tracking-[0.3em] text-caparol/70 uppercase sm:text-sm">
        Lorena, en <em class="not-italic text-caparol">Si los peces hablaran…</em>
      </figcaption>
    </figure>
  </div>
</section>

<script>
  // «Reducir movimiento»: los vídeos se quedan quietos, con su imagen fija.
  if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
    document.querySelectorAll<HTMLVideoElement>('#miradas video').forEach((v) => {
      v.autoplay = false;
      v.pause();
      v.currentTime = 0;
    });
  }
</script>
