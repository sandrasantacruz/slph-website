---
import MainLayout from '../../layouts/MainLayout.astro';
import Hero from './Hero.astro';
import Prueba from './Prueba.astro';
import Anecdota from './Anecdota.astro';
import Capas from './Capas.astro';
import Peques from './Peques.astro';
import Cuadernillo from './Cuadernillo.astro';
import Compra from './Compra.astro';
import WaterLine from '../../components/WaterLine.astro';
import SubNavCuento from '../../components/SubNavCuento.astro';
import { breadcrumbSchema, absoluteUrl } from '../../lib/seo';
import { APP_LINKS } from '../../lib/app-links';

const breadcrumb = breadcrumbSchema([
  { name: 'Inicio', url: '/' },
  { name: 'Sobre el cuento', url: '/sobre-el-cuento' },
  { name: 'Realidad aumentada', url: '/realidad-aumentada' },
]);

// Ficha de la app para Google: gratuita, Android e iOS (iOS de momento en TestFlight).
const appSchema = {
  '@context': 'https://schema.org',
  '@type': 'MobileApplication',
  name: 'AR-SLPH',
  description: 'App de realidad aumentada del cuento Si los peces hablaran…: al apuntar a sus ilustraciones aparecen escenas, diálogos y canciones del musical.',
  operatingSystem: 'Android, iOS',
  applicationCategory: 'EducationalApplication',
  inLanguage: 'es',
  image: absoluteUrl('/assets/og-realidad-aumentada-tiburon.jpg'),
  downloadUrl: APP_LINKS.android,
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'EUR' },
  author: { '@type': 'Organization', name: 'Si los peces hablaran' },
};
---

<MainLayout
  title="Cuento infantil con realidad aumentada · Si los peces hablaran…"
  description="Un cuento infantil cuyas ilustraciones esconden escenas, diálogos y canciones de su musical. Pruébalo gratis con la app AR-SLPH, incluso sin el libro."
  hideWaterLine
  image="/assets/og-realidad-aumentada-tiburon.jpg"
  imageAlt="Don Canino, el tiburón del cuento, sale de la pantalla de un móvil con un neumático entre los dientes, junto al logo de la app de realidad aumentada AR-SLPH"
  imageWidth={1200}
  imageHeight={630}
  jsonLd={[appSchema, breadcrumb]}
>
  <SubNavCuento current="realidad-aumentada" />
  <Hero />
  <!-- primero por qué existe (la historia), después cómo funciona -->
  <Anecdota />
  <Capas />
  <Peques />
  <!-- la demo, y justo después el libro; los QR del cuadernillo al final,
       para que no se confundan con la realidad aumentada -->
  <Prueba />
  <Compra />
  <!-- la línea de agua de la cabecera separa los QR del resto -->
  <WaterLine separador />
  <Cuadernillo />
</MainLayout>

<script>
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const targets = document.querySelectorAll<HTMLElement>('.reveal');

  if (reduceMotion) {
    targets.forEach((el) => el.classList.add('is-visible'));
  } else {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          }
        });
      },
      { rootMargin: '0px 0px -10% 0px', threshold: 0.05 },
    );
    targets.forEach((el) => observer.observe(el));
  }
</script>
