---
/**
 * Cierre de Realidad aumentada: justo después de probar la demo, el paso
 * siguiente es el libro. Única llamada a la compra de la página.
 */
import Ola from '../../components/Ola.astro';
import cover from '../home/img/cover-cuento.webp?url';
---

<section class="relative isolate overflow-hidden border-t border-caparol/10 py-16 sm:py-24">
  <div class="mx-auto grid max-w-5xl items-center gap-10 px-6 md:grid-cols-12 md:gap-14">
    <a href="/comprar" class="reveal mx-auto block w-full max-w-[15rem] md:col-span-4 md:max-w-none" aria-label="Comprar Si los peces hablaran…">
      <img
        src={cover}
        alt="Portada de la 3.ª edición del cuento infantil con realidad aumentada Si los peces hablaran…"
        width="1250"
        height="1250"
        class="block w-full rounded-md shadow-[0_24px_48px_-16px_rgba(6,15,44,0.8)] transition duration-500 hover:-translate-y-1"
        loading="lazy"
        decoding="async"
      />
    </a>

    <div class="reveal reveal-delay-1 text-center md:col-span-8 md:text-left">
      <p class="font-hand text-2xl text-celeste sm:text-3xl">¿te ha gustado?</p>
      <h2 class="mt-2 font-display text-[clamp(2rem,5vw,3.4rem)] leading-[0.95] text-caparol">
        La pantalla es
        <span class="whitespace-nowrap">solo el <Ola class="text-arena">principio</Ola></span>
      </h2>
      <p class="mx-auto mt-5 max-w-xl text-base leading-relaxed text-caparol/85 sm:text-lg md:mx-0">
        Descubre en el libro la historia completa de Lorena y sus amigos del arrecife.
        Consíguelo online, en el Centro de Danza Sandra Santa Cruz (con dedicatoria de la
        autora) o en librerías de Gran Canaria.
      </p>
      <a
        href="/comprar"
        class="group mt-8 inline-flex items-center gap-3 rounded-full bg-arena px-8 py-3.5 font-display text-xl text-azul shadow-lg transition hover:brightness-95"
      >
        Quiero el mío
        <svg viewBox="0 0 24 24" class="h-5 w-5 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
      </a>
    </div>
  </div>
</section>
