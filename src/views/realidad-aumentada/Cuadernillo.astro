---
// Die QR-Codes sind mit der 3. Auflage ins Cuadernillo umgezogen.
// Echter QR aus dem Cuadernillo («QR_TALLERES SLPH», Drive «QR en PNG»):
// führt zum Video von Don Canino im Museo-Casa Colón.
const QR_VIDEO = 'https://www.youtube.com/watch?v=AphhZ4KFlas';
---

<section class="relative isolate overflow-hidden border-t border-caparol/10 py-16 sm:py-24">
  <div class="mx-auto max-w-6xl px-6">
    <div class="reveal flex items-center gap-4">
      <span aria-hidden="true" class="h-px w-10 bg-arena sm:w-16"></span>
      <span class="font-display text-xs tracking-[0.4em] text-arena uppercase sm:text-sm">
        Novedad de la 3.ª edición
      </span>
    </div>

    <h2 class="reveal reveal-delay-1 mt-6 flex max-w-3xl items-start gap-4 font-display text-[clamp(1.8rem,4.5vw,3rem)] leading-none text-caparol">
      <!-- Icono QR dibujado a mano (no hay en los sets instalados): distinto del símbolo AR -->
      <svg viewBox="0 0 21 21" class="mt-1 h-[1.1em] w-[1.1em] shrink-0 text-arena" fill="currentColor" aria-hidden="true">
        <path fill-rule="evenodd" d="M0 0h7v7H0zM2 2v3h3V2zM14 0h7v7h-7zm2 2v3h3V2zM0 14h7v7H0zm2 2v3h3v-3z" />
        <path d="M9 0h2v2H9zM9 4h3v2H9zM9 8h2v3H9zM0 9h3v2H0zM5 9h3v2H5zM13 9h2v2h-2zM17 9h4v2h-4zM12 12h3v2h-3zM17 13h2v3h-2zM9 14h2v4H9zM13 16h3v2h-3zM12 19h2v2h-2zM16 19h5v2h-5zM19 16h2v2h-2z" />
      </svg>
      <span>
        Códigos QR
        <span class="text-arena">que nadan en el cuadernillo</span>
      </span>
    </h2>

    <div class="mt-6 grid items-center gap-10 lg:grid-cols-12 lg:gap-14">
    <div class="lg:col-span-8">
    <p class="reveal reveal-delay-2 max-w-3xl text-base leading-relaxed text-caparol/90 sm:text-lg">
      Con la 3.ª edición nace un nuevo compañero de viaje para el cuento: el
      cuadernillo de actividades. Sus códigos QR no sacan escenas del cuento:
      te abren la puerta a los eventos SLPH, para que veas cómo acercamos el
      mensaje del cuento a colegios, museos y bibliotecas.
    </p>
    <p class="reveal reveal-delay-2 mt-4 max-w-3xl text-base leading-relaxed text-caparol/90 sm:text-lg">
      Es un cuaderno para <span class="text-arena">aprender jugando</span>, y
      nació pensando en Oncología Infantil para regalar sonrisas allí donde más
      se necesitan. Lorena, Bubli, el Sr. Tentáculus y sus amigos acompañan
      cada actividad para que nadie juegue solo.
    </p>

    <a
      href="/cuadernillo"
      class="reveal mt-8 inline-flex items-center gap-2 rounded-full bg-arena px-6 py-3 font-display text-azul transition hover:scale-[1.03]"
    >
      Conoce el cuadernillo <span aria-hidden="true">→</span>
    </a>
    </div>

    <!-- El QR real, idéntico al del papel. En el móvil no se puede escanear la
         propia pantalla: ahí funciona como enlace. -->
    <figure class="reveal reveal-delay-2 mx-auto lg:col-span-4">
      <a
        href={QR_VIDEO}
        target="_blank"
        rel="noopener"
        class="block w-52 rotate-[2deg] rounded-2xl bg-white p-4 shadow-[0_20px_40px_-16px_rgba(3,10,35,0.8)] transition duration-500 hover:rotate-0 sm:w-60"
        aria-label="Vídeo: Don Canino visita el Museo-Casa Colón por el Día Mundial del Libro (YouTube)"
      >
        <img src="/assets/ar/qr-talleres-slph.png" alt="Código QR del cuadernillo" width="400" height="400" class="block h-auto w-full [image-rendering:pixelated]" loading="lazy" decoding="async" />
      </a>
      <figcaption class="mt-4 max-w-60 text-center font-hand text-xl leading-snug text-celeste sm:text-2xl">
        <span class="qr-escritorio">escanéame y verás uno de nuestros eventos</span>
        <span class="qr-movil">púlsame y verás uno de nuestros eventos</span>
      </figcaption>
    </figure>
    </div>

    <p class="reveal mt-12 border-t border-caparol/10 pt-6 text-sm leading-relaxed text-caparol/70 sm:text-base">
      Los QR y la realidad aumentada son obra de
      <a href="/colabora#equipo" class="text-arena underline decoration-arena/40 underline-offset-4 transition hover:decoration-arena">Carlos García</a>,
      director técnico y autor de los audiovisuales de nuestros espectáculos.
    </p>
  </div>
</section>

<style>
  .qr-movil { display: none; }
  @media (pointer: coarse) and (max-width: 767px) {
    .qr-movil { display: inline; }
    .qr-escritorio { display: none; }
  }
</style>
