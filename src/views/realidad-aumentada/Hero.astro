---
import { Icon } from 'astro-icon/components';
import Ola from '../../components/Ola.astro';
import { APP_LINKS } from '../../lib/app-links';
---

<section class="relative isolate flex min-h-[calc(100svh-6rem)] flex-col overflow-hidden">
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 -z-10 bg-[radial-gradient(55%_45%_at_75%_40%,rgba(100,170,210,0.14),transparent_70%)]"
  ></div>

  <div class="mx-auto flex h-full w-full max-w-7xl flex-1 flex-col justify-center px-6 py-8 sm:py-10">
    <div class="reveal flex items-center gap-3 sm:gap-4">
      <span aria-hidden="true" class="h-px w-8 bg-arena sm:w-16"></span>
      <span class="font-display text-[0.7rem] tracking-[0.35em] text-arena uppercase sm:text-sm sm:tracking-[0.4em]">
        Realidad aumentada
      </span>
    </div>

    <div class="mt-6 grid grid-cols-12 items-center gap-x-5 gap-y-8 sm:mt-8 sm:gap-x-10 lg:gap-x-14">
      <div class="reveal reveal-delay-1 order-2 col-span-12 lg:order-1 lg:col-span-7">
        <p class="font-hand text-xl text-celeste sm:text-3xl lg:text-4xl">páginas que esconden magia…</p>

        <!-- Umbruch nur nach „se lee,“: der Rest bleibt zusammen -->
        <h1 class="mt-1 font-display text-[clamp(2.1rem,6vw,4.6rem)] leading-[0.95] tracking-tight text-caparol">
          Un cuento que se lee,
          <span class="whitespace-nowrap">se escucha y se <Ola class="text-arena">baila</Ola></span>
        </h1>

        <p class="mt-6 max-w-xl text-base leading-relaxed text-caparol/90 sm:text-lg lg:text-xl">
          Gracias a su realidad aumentada (AR), el cuento se transforma y los
          personajes salen del libro para mostrarte escenas del musical original
          e invitarte a descubrir el universo de
          <em class="not-italic text-arena">Si los peces hablaran…</em>
        </p>

        <!-- App-Karte. Android ist im Play Store, iOS vorerst öffentliche
             TestFlight-Beta. -->
        <div class="mt-8 max-w-xl rounded-2xl border border-celeste/30 bg-azul/40 p-5 ring-1 ring-caparol/10 backdrop-blur-sm sm:p-6">
          <p class="font-display text-2xl leading-tight text-arena sm:text-3xl">Tu viaje al musical empieza aquí</p>
          <p class="mt-1 text-sm text-caparol/80 sm:text-base">Descarga la app AR-SLPH para Android, iPhone y iPad.</p>

          <div class="mt-5 flex flex-col gap-3 sm:flex-row sm:items-center">
            <a
              href={APP_LINKS.android}
              target="_blank"
              rel="noopener"
              class="inline-flex items-center gap-3 rounded-xl bg-caparol px-5 py-3 text-azul shadow-md transition hover:-translate-y-0.5 hover:brightness-95"
            >
              <Icon name="simple-icons:googleplay" class="h-7 w-7" aria-hidden="true" />
              <span class="flex flex-col leading-tight">
                <span class="text-[0.7rem] tracking-wider text-azul/70 uppercase">disponible en</span>
                <span class="font-display text-lg">Google Play</span>
              </span>
            </a>
            <a
              href={APP_LINKS.iosBeta}
              target="_blank"
              rel="noopener"
              class="inline-flex items-center gap-3 rounded-xl bg-caparol px-5 py-3 text-azul shadow-md transition hover:-translate-y-0.5 hover:brightness-95"
            >
              <Icon name="simple-icons:apple" class="h-7 w-7" aria-hidden="true" />
              <span class="flex flex-col leading-tight">
                <span class="text-[0.7rem] tracking-wider text-azul/70 uppercase">prueba la beta en</span>
                <span class="font-display text-lg">iPhone y iPad</span>
              </span>
            </a>
          </div>

          <p class="mt-4 text-xs leading-relaxed text-caparol/60 sm:text-sm">
            En iPhone y iPad se instala con TestFlight, la app gratuita de Apple para versiones de prueba.
          </p>
        </div>
      </div>

      <div class="reveal reveal-delay-2 order-1 col-span-12 flex justify-center lg:order-2 lg:col-span-5">
        <!-- Standbild = erstes und letztes Bild des Loops (Higgsfield, nur die
             Bläschen bewegen sich). Bei reduzierter Bewegung nur das Bild. -->
        <video
          src="/assets/ar/app-ar-slph-burbujas.mp4"
          poster="/assets/ar/app-ar-slph.webp"
          width="720"
          height="720"
          autoplay
          muted
          loop
          playsinline
          aria-label="La app AR-SLPH: Don Canino, el tiburón del cuento, saliendo de la pantalla de un teléfono mientras suben burbujas"
          class="h-auto w-full max-w-[min(100%,52vh)] rounded-[14%] shadow-[0_30px_60px_-20px_rgba(3,10,35,0.85)] motion-reduce:hidden"
        ></video>
        <img
          src="/assets/ar/app-ar-slph.webp"
          alt="La app AR-SLPH: Don Canino, el tiburón del cuento, saliendo de la pantalla de un teléfono"
          width="1200"
          height="1200"
          class="hidden h-auto w-full max-w-[min(100%,52vh)] rounded-[14%] shadow-[0_30px_60px_-20px_rgba(3,10,35,0.85)] motion-reduce:block"
          loading="eager"
          decoding="async"
        />
      </div>
    </div>
  </div>
</section>
