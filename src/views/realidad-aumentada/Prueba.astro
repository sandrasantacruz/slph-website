---
import { Icon } from 'astro-icon/components';
import Ola from '../../components/Ola.astro';
import { APP_LINKS } from '../../lib/app-links';

// Zielbild für die AR-App (Seite 80 des Buchs). Wird ungeschnitten gezeigt,
// sonst erkennt die App das Motiv nicht.
const target = '/assets/ar/pagina-80-pez-espada.webp';
---

<section id="prueba" class="relative isolate overflow-hidden py-16 sm:py-24">
  <div class="mx-auto max-w-6xl px-6">
    <div class="reveal flex items-center gap-4">
      <span aria-hidden="true" class="h-px w-10 bg-arena sm:w-16"></span>
      <span class="font-display text-xs tracking-[0.4em] text-arena uppercase sm:text-sm">
        ¿Ya tienes la app?
      </span>
    </div>

    <h2 class="reveal reveal-delay-1 mt-6 max-w-3xl font-display text-[clamp(2rem,5.5vw,3.75rem)] leading-[0.95] text-caparol">
      Pruébala en
      <Ola class="whitespace-nowrap text-arena">esta ilustración</Ola>
    </h2>

    <!-- Zwei Fassungen: wer auf dem Handy liest, kann das Handy nicht auf den
         eigenen Bildschirm richten. Umschalten per (pointer: coarse) + Breite,
         nicht per JS, damit nichts springt. -->
    <p class="prueba-escritorio reveal reveal-delay-2 mt-6 max-w-2xl text-base leading-relaxed text-caparol/90 sm:text-lg">
      Abre la app y apunta con el móvil a la ilustración de aquí abajo,
      directamente en la pantalla. ¿Tienes el libro? Búscala en la página 80
      y verás cómo, de repente, la escena se escapa… ¡y salta del libro!
    </p>
    <p class="prueba-movil reveal reveal-delay-2 mt-6 max-w-2xl text-base leading-relaxed text-caparol/90 sm:text-lg">
      Abre esta página en un ordenador o una tableta y apunta con el móvil a la
      ilustración de aquí abajo. ¿Tienes el libro? Búscala en la página 80
      y verás cómo, de repente, la escena se escapa… ¡y salta del libro!
    </p>

    <!-- Für alle, die die App noch nicht haben -->
    <p class="reveal reveal-delay-2 mt-5 flex flex-wrap items-center gap-x-5 gap-y-2 text-sm text-caparol/75 sm:text-base">
      <span>¿Aún no la tienes?</span>
      <a
        href={APP_LINKS.android}
        target="_blank"
        rel="noopener"
        class="inline-flex items-center gap-2 text-celeste underline decoration-celeste/40 underline-offset-4 transition hover:text-arena"
      >
        <Icon name="simple-icons:googleplay" class="h-4 w-4" aria-hidden="true" />
        Google Play
      </a>
      <a
        href={APP_LINKS.iosBeta}
        target="_blank"
        rel="noopener"
        class="inline-flex items-center gap-2 text-celeste underline decoration-celeste/40 underline-offset-4 transition hover:text-arena"
      >
        <Icon name="simple-icons:apple" class="h-4 w-4" aria-hidden="true" />
        iPhone y iPad (TestFlight)
      </a>
    </p>

    <div class="reveal reveal-delay-2 mt-10">
      <a
        href={target}
        target="_blank"
        rel="noopener"
        class="block overflow-hidden rounded-2xl border border-caparol/15 shadow-[0_24px_48px_-16px_rgba(6,15,44,0.75)] ring-1 ring-caparol/10"
      >
        <img
          src={target}
          alt="Ilustración de la página 80 del cuento: un pez espada y otros peces nadan entre botellas, latas, un neumático y otros residuos en el fondo del mar"
          width="1500"
          height="944"
          class="block h-auto w-full"
          loading="lazy"
          decoding="async"
        />
      </a>
      <p class="mt-4 text-center font-hand text-2xl text-arena sm:text-3xl">
        ¡Apunta aquí para ver al Coronel Espada Afilada en acción!
      </p>
    </div>
  </div>
</section>

<style>
  /* Por defecto, ordenador/tableta. Teléfono = puntero táctil y pantalla estrecha. */
  .prueba-movil { display: none; }
  @media (pointer: coarse) and (max-width: 767px) {
    .prueba-movil { display: block; }
    .prueba-escritorio { display: none; }
  }
</style>
