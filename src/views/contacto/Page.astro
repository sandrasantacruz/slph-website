---
import MainLayout from '../../layouts/MainLayout.astro';
import Canales from './Canales.astro';
import Sigue from './Sigue.astro';
import Entidades from './Entidades.astro';
import { SETTINGS as settings } from '../../lib/settings';
import { breadcrumbSchema, SITE_URL } from '../../lib/seo';

const breadcrumb = breadcrumbSchema([
  { name: 'Inicio', url: '/' },
  { name: 'Contacto', url: '/contacto' },
]);

// Ein Kontaktpunkt reicht: WhatsApp und Telefon sind dieselbe Nummer.
// Kein «TollFree» — die Nummer ist eine normale Mobilnummer.
const telefono = (settings.phone || settings.whatsapp).trim();
const contactPoints =
  telefono || settings.email
    ? [
        {
          '@type': 'ContactPoint',
          contactType: 'customer service',
          ...(telefono ? { telephone: telefono.startsWith('+') ? telefono : `+34 ${telefono}` } : {}),
          ...(settings.email ? { email: settings.email } : {}),
          areaServed: 'Islas Canarias',
          availableLanguage: ['Spanish'],
        },
      ]
    : [];

const contactPage = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  url: `${SITE_URL}/contacto`,
  name: 'Contacto · Si los peces hablaran',
  description:
    'Contacto de Si los peces hablaran: WhatsApp, teléfono y correo para familias, centros educativos, instituciones, empresas y profesionales.',
  about: { '@id': `${SITE_URL}/#organization` },
  ...(contactPoints.length ? { mainEntity: { '@id': `${SITE_URL}/#organization`, contactPoint: contactPoints } } : {}),
};
---

<MainLayout
  title="Contacto"
  description="¿Nadamos juntos? Escríbenos por WhatsApp, teléfono o correo electrónico. Centros educativos, instituciones, empresas y profesionales: hablemos de lo que podemos hacer por el mar."
  image="/assets/og-contacto-aletas.jpg"
  imageAlt="Sandra Santa Cruz sentada en la playa de Patalavaca junto a «Si los peces hablaran» escrito en la arena"
  imageWidth={1200}
  imageHeight={630}
  jsonLd={[contactPage, breadcrumb]}
>
  <Canales settings={settings} />
  <Entidades />
  <Sigue />
</MainLayout>

<script>
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const targets = document.querySelectorAll<HTMLElement>('.reveal');

  if (reduceMotion) {
    targets.forEach((el) => el.classList.add('is-visible'));
  } else {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          }
        });
      },
      { rootMargin: '0px 0px -10% 0px', threshold: 0.05 },
    );
    targets.forEach((el) => observer.observe(el));
  }
</script>
