---
import { Icon } from 'astro-icon/components';
import { socials } from '../../lib/social';
---

<section class="relative isolate overflow-hidden pb-24 sm:pb-32">
  <div class="mx-auto max-w-6xl px-6">
    <div class="reveal grid items-center gap-10 rounded-3xl border border-caparol/15 bg-azul/30 p-8 sm:p-12 md:grid-cols-12">
      <div class="md:col-span-5">
        <p class="font-hand text-2xl leading-none text-celeste sm:text-3xl">
          y además
        </p>
        <h2 class="mt-3 font-display text-[clamp(1.75rem,4vw,2.75rem)] leading-[0.95] text-caparol">
          Si no quieres
          <span class="block"><span class="hand-underline text-arena">perderte nada</span></span>
        </h2>
      </div>

      <ul class="grid gap-3 sm:grid-cols-3 md:col-span-7">
        {socials.map(({ label, href, icon, handle }) => (
          <li>
            <a
              href={href}
              target="_blank"
              rel="noopener noreferrer"
              class="group flex h-full flex-col items-start gap-3 rounded-2xl border-2 border-caparol/15 bg-azul/40 p-5 transition hover:border-arena focus:outline-none focus-visible:border-arena"
            >
              <span class="flex h-11 w-11 items-center justify-center rounded-full bg-arena/10 text-arena transition group-hover:bg-arena group-hover:text-azul">
                <Icon name={icon} class="h-5 w-5" aria-hidden="true" />
              </span>
              <div class="flex flex-col gap-0.5">
                <span class="font-display text-lg text-caparol">{label}</span>
                <span class="text-sm text-caparol/70">{handle}</span>
              </div>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>
