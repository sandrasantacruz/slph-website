---
/**
 * Contacto profesional: centros educativos, instituciones, empresas y
 * profesionales. Va debajo de los canales generales, para que la familia
 * encuentre primero el WhatsApp y la entidad encuentre después su sitio.
 * El botón abre el correo con el asunto ya puesto.
 */
import Ola from '../../components/Ola.astro';
import EnlaceFlecha from '../../components/EnlaceFlecha.astro';
import { SETTINGS, mailHref } from '../../lib/settings';

const correo = SETTINGS.email
  ? `${mailHref(SETTINGS.email)}?subject=${encodeURIComponent('Propuesta de colaboración con Si los peces hablaran…')}`
  : '';
---

<section aria-labelledby="entidades-titulo" class="relative isolate pb-16 sm:pb-20">
  <div class="mx-auto max-w-6xl px-6">
    <div class="reveal rounded-3xl border border-arena/25 bg-azul/30 p-8 sm:p-12">
      <p class="font-hand text-2xl leading-none text-celeste sm:text-3xl">para centros, instituciones y empresas</p>
      <h2
        id="entidades-titulo"
        class="mt-3 max-w-3xl font-display text-[clamp(1.75rem,4vw,2.75rem)] leading-[1] text-caparol"
      >
        ¿Representas a una entidad o quieres
        <Ola class="text-arena">colaborar con SLPH</Ola>?
      </h2>
      <p class="mt-5 max-w-2xl text-base leading-relaxed text-caparol/85 sm:text-lg">
        Si eres un centro educativo, una institución, una empresa o un profesional y quieres
        conocer nuestras propuestas, hablemos de lo que podemos hacer juntos.
      </p>
      <div class="mt-8 flex flex-wrap items-center gap-4">
        {correo && (
          <a
            href={correo}
            class="group inline-flex items-center gap-3 rounded-full bg-arena px-7 py-3 font-display text-xl text-azul shadow-lg transition hover:brightness-95"
          >
            Cuéntanos tu idea
            <svg viewBox="0 0 24 24" class="h-5 w-5 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
          </a>
        )}
        <EnlaceFlecha href="/programa">El Programa SLPH</EnlaceFlecha>
      </div>
    </div>
  </div>
</section>
