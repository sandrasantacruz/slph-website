---
import { Icon } from 'astro-icon/components';
import type { Settings } from '../../lib/settings';
import { whatsappHref, telHref, mailHref } from '../../lib/settings';
import Ola from '../../components/Ola.astro';

interface Props {
  settings: Settings;
}

const { settings } = Astro.props;

type IconKind = 'whatsapp' | 'mail' | 'phone';

const channels = [
  settings.whatsapp && {
    key: 'whatsapp',
    label: 'WhatsApp',
    verb: 'Escríbenos por',
    value: settings.whatsapp,
    href: whatsappHref(settings.whatsapp),
    icon: 'whatsapp' as IconKind,
    accent: 'arena',
    hint: 'Respuesta más rápida',
    external: true,
  },
  settings.phone && {
    key: 'phone',
    label: 'Teléfono',
    verb: 'Llámanos al',
    value: settings.phone,
    href: telHref(settings.phone),
    icon: 'phone' as IconKind,
    accent: 'caparol',
    hint: 'Cuando lo necesites a voz',
    external: false,
  },
  settings.email && {
    key: 'email',
    label: 'Correo',
    verb: 'Mándanos un',
    value: settings.email,
    href: mailHref(settings.email),
    icon: 'mail' as IconKind,
    accent: 'celeste',
    hint: 'Para textos más largos',
    external: false,
  },
].filter(Boolean) as Array<{
  key: string;
  label: string;
  verb: string;
  value: string;
  href: string;
  icon: IconKind;
  accent: 'arena' | 'celeste' | 'caparol';
  hint: string;
  external: boolean;
}>;

// Tailwind muss die Klassen statisch sehen — daher die Map.
const accentClasses: Record<'arena' | 'celeste' | 'caparol', { ring: string; text: string; bg: string; chip: string }> = {
  arena: {
    ring: 'hover:border-arena focus-visible:border-arena',
    text: 'text-arena',
    bg: 'group-hover:bg-arena group-hover:text-azul',
    chip: 'bg-arena/10 text-arena',
  },
  celeste: {
    ring: 'hover:border-celeste focus-visible:border-celeste',
    text: 'text-celeste',
    bg: 'group-hover:bg-celeste group-hover:text-azul',
    chip: 'bg-celeste/15 text-celeste',
  },
  caparol: {
    ring: 'hover:border-caparol focus-visible:border-caparol',
    text: 'text-caparol',
    bg: 'group-hover:bg-caparol group-hover:text-azul',
    chip: 'bg-caparol/15 text-caparol',
  },
};
---

<section id="canales" class="relative isolate overflow-hidden pt-10 pb-16 sm:pt-14 sm:pb-20">
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 -z-10 bg-[radial-gradient(60%_50%_at_85%_30%,rgba(100,170,210,0.07),transparent_70%)]"
  ></div>

  <div class="mx-auto max-w-6xl px-6">
    <div class="reveal max-w-3xl">
      <h1 class="font-display text-[clamp(2rem,5.5vw,3.75rem)] leading-[0.95] tracking-tight text-caparol">
        ¡No te quedes
        <Ola class="text-arena">con la duda</Ola>!
      </h1>
      <p class="mt-4 max-w-2xl text-base text-caparol/90 sm:text-lg">
        Dinos qué necesitas o qué quieres saber y
        <span class="text-celeste">Dina la Voladora</span> te responderá enseguida.
      </p>
    </div>

    <!-- Dina la Voladora, die im Intro versprochene Antwortgeberin. Asset ist
         fast quadratisch (965x881) und schaut nach links, zum Text hin.
         Mobil steht sie im Fluss zwischen Intro und Karten, rechtsbündig bis
         an den Viewport-Rand (-mr-6 hebt das px-6 des Containers auf);
         ab lg fliegt sie absolut rechts neben dem Header und liegt per -z-10
         hinter den Karten, falls sie in deren Zeile hineinragt. -->
    <img
      src="/assets/animals/dina.webp"
      alt=""
      aria-hidden="true"
      class="anim-float-soft pointer-events-none -mt-2 -mr-6 -mb-6 ml-auto block w-36 drop-shadow-[0_18px_28px_rgba(6,15,44,0.45)] sm:w-44 lg:absolute lg:top-8 lg:right-4 lg:-z-10 lg:m-0 lg:w-52 xl:right-10 xl:w-60"
      width="965"
      height="881"
      loading="lazy"
      decoding="async"
    />

    {channels.length === 0 ? (
      <p class="reveal mt-10 max-w-2xl rounded-2xl border border-caparol/20 bg-caparol/5 p-6 text-caparol/80">
        Estamos preparando los canales de contacto. Vuelve en unos días.
      </p>
    ) : (
      <ul class="reveal reveal-delay-1 mt-10 grid gap-5 sm:gap-6 md:grid-cols-2 lg:mt-28 lg:grid-cols-3">
        {channels.map((ch) => {
          const cls = accentClasses[ch.accent];
          return (
            <li class:list={[ch.icon === 'mail' && 'md:col-span-2 lg:col-span-1']}>
              <a
                href={ch.href}
                target={ch.external ? '_blank' : undefined}
                rel={ch.external ? 'noopener noreferrer' : undefined}
                class:list={[
                  'group relative flex h-full flex-col gap-5 rounded-2xl border-2 border-caparol/15 bg-azul/40 p-6 transition focus:outline-none @container',
                  cls.ring,
                ]}
              >
                <div class="flex items-center justify-between">
                  <span class:list={['flex h-12 w-12 items-center justify-center rounded-full transition', cls.chip, cls.bg]}>
                    {ch.icon === 'whatsapp' && (
                      <Icon name="simple-icons:whatsapp" class="h-6 w-6" aria-hidden="true" />
                    )}
                    {ch.icon === 'mail' && (
                      <svg viewBox="0 0 24 24" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <rect x="3" y="5" width="18" height="14" rx="2"/>
                        <path d="M3 7l9 7 9-7"/>
                      </svg>
                    )}
                    {ch.icon === 'phone' && (
                      <svg viewBox="0 0 24 24" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6A19.79 19.79 0 0 1 2.12 4.18 2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.37 1.9.72 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.9.35 1.85.59 2.81.72A2 2 0 0 1 22 16.92z"/>
                      </svg>
                    )}
                  </span>
                  <span class={`font-display text-xs tracking-[0.3em] uppercase ${cls.text}`}>
                    {ch.label}
                  </span>
                </div>

                <div class="flex flex-col gap-1">
                  <span class="text-sm text-caparol/70">{ch.verb}</span>
                  <span class={`font-display leading-tight break-words ${ch.icon === 'mail' ? 'text-[clamp(1rem,6cqi,1.875rem)] lg:text-3xl' : 'text-2xl sm:text-3xl'} ${cls.text}`}>
                    {ch.icon === 'mail' && ch.value.includes('@') ? (
                      <Fragment>{ch.value.split('@')[0]}@<wbr />{ch.value.split('@').slice(1).join('@')}</Fragment>
                    ) : (
                      ch.value
                    )}
                  </span>
                </div>

                <div class="mt-auto flex items-center justify-between gap-3 pt-2 text-sm text-caparol/70">
                  <span>{ch.hint}</span>
                  <svg viewBox="0 0 24 24" class="h-5 w-5 shrink-0 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
                    <path d="M5 12h14M13 6l6 6-6 6"/>
                  </svg>
                </div>
              </a>
            </li>
          );
        })}
      </ul>
    )}

  </div>
</section>
