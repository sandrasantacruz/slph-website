---
import { Icon } from 'astro-icon/components';
---

<section class="relative isolate flex h-[calc(100svh-6rem)] flex-col overflow-hidden">
  <!-- Soft radial glow, top-right -->
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 -z-10 bg-[radial-gradient(55%_45%_at_80%_25%,rgba(100,170,210,0.10),transparent_70%)]"
  ></div>

  <!-- Drifting kelp on the left edge -->
  <svg
    class="anim-sway pointer-events-none absolute -left-4 bottom-0 -z-10 hidden h-2/3 w-24 text-celeste/12 lg:block"
    viewBox="0 0 80 200"
    fill="none"
    stroke="currentColor"
    stroke-width="1.2"
    stroke-linecap="round"
    aria-hidden="true"
  >
    <path d="M18 200 Q 28 150 20 100 Q 14 70 24 30 Q 28 10 20 0"/>
    <path d="M38 200 Q 48 160 40 110 Q 36 80 48 40 Q 52 18 44 0"/>
    <path d="M62 200 Q 70 160 62 120 Q 56 90 66 60 Q 70 30 64 0"/>
  </svg>

  <div class="mx-auto flex h-full w-full max-w-7xl flex-col justify-center px-6 py-4 sm:py-6">
    <!-- Eyebrow -->
    <div class="reveal flex items-center gap-3 sm:gap-4">
      <span aria-hidden="true" class="h-px w-8 bg-arena sm:w-16"></span>
      <span class="font-display text-[0.7rem] tracking-[0.35em] text-arena uppercase sm:text-sm sm:tracking-[0.4em]">
        La autora
      </span>
    </div>

    <!-- Hero grid: portrait + name (always side-by-side, even on mobile) -->
    <div class="mt-4 grid flex-1 grid-cols-12 items-center gap-x-5 gap-y-4 sm:mt-6 sm:gap-x-10 lg:gap-x-14">
      <!-- Portrait, left side. max-w scales with viewport height so the 2:3 photo
           never gets cropped vertically on shorter laptops. -->
      <div class="reveal reveal-delay-1 col-span-5 flex max-h-full items-center justify-center lg:col-span-5">
        <div class="relative w-full max-w-[min(100%,28vh)] sm:max-w-[min(100%,42vh)]">
          <!-- Decorative dashed frame behind portrait -->
          <div
            aria-hidden="true"
            class="anim-sway absolute -inset-2 -z-10 rounded-[1.25rem] border-2 border-dashed border-arena/40 sm:-inset-3 sm:rounded-[1.5rem]"
          ></div>

          <div class="polaroid tilt-l1 w-full transition duration-500 hover:rotate-0" style="padding-bottom:3.75rem">
            <img
              src="/assets/sandra.webp"
              alt="Retrato de Sandra Santa Cruz"
              class="block w-full"
              style="aspect-ratio:2/3"
              loading="eager"
              decoding="async"
              fetchpriority="high"
            />
            <p class="absolute bottom-1.5 left-0 right-0 px-2 text-center font-hand text-[0.85rem] leading-tight text-balance text-azul sm:bottom-2 sm:px-3 sm:text-xl">
              Enseñar es parte de mi vida, aprender, la base de mi desarrollo
            </p>
          </div>
        </div>
      </div>

      <!-- Right column: name + tags + lead -->
      <div class="reveal reveal-delay-2 col-span-7 flex flex-col justify-center lg:col-span-7">
        <p class="font-hand text-xl text-celeste sm:text-3xl lg:text-4xl">conoce a…</p>

        <h1 class="mt-0.5 font-display text-[clamp(1.75rem,8vw,8.5rem)] leading-[0.85] tracking-tight text-caparol sm:mt-1">
          Sandra
          <span class="mt-0.5 block text-arena italic sm:mt-1">Santa Cruz</span>
        </h1>

        <!-- Role chips -->
        <ul class="mt-3 flex flex-wrap items-center gap-x-2 gap-y-1 font-display text-[0.65rem] uppercase tracking-[0.18em] text-celeste sm:mt-6 sm:gap-x-3 sm:text-base lg:gap-x-4 lg:text-lg">
          <li>Bailarina</li>
          <li aria-hidden="true" class="text-arena/70">·</li>
          <li>Coreógrafa</li>
          <li aria-hidden="true" class="text-arena/70">·</li>
          <li>Autora</li>
          <li aria-hidden="true" class="text-arena/70">·</li>
          <li>Directora</li>
        </ul>

        <p class="mt-3 max-w-xl text-xs leading-snug text-caparol/90 sm:mt-6 sm:text-lg sm:leading-relaxed lg:text-xl">
          Polifacética canaria que lleva <strong class="text-arena">más de tres décadas</strong>
          compartiendo mucho más que danza y enseñando a otros a hacer lo mismo.
          Utiliza el cuerpo como lenguaje, comunicando sus palabras en escena.
        </p>
      </div>
    </div>

    <!-- Scroll cue at the bottom -->
    <a
      href="#biografia"
      aria-label="Bajar a la biografía"
      class="scroll-cue absolute bottom-2 left-1/2 flex -translate-x-1/2 flex-col items-center gap-0.5 text-caparol/70 transition hover:text-arena sm:bottom-3 sm:gap-1"
    >
      <span class="font-hand text-base leading-none sm:text-xl">sigue buceando</span>
      <svg viewBox="0 0 24 24" class="h-4 w-4 sm:h-5 sm:w-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M6 9l6 6 6-6"/>
      </svg>
    </a>
  </div>
</section>
