---
---

<section class="relative isolate overflow-hidden py-24 sm:py-32">
  <!-- Faint compass behind the manifesto -->
  <svg
    class="anim-drift pointer-events-none absolute left-1/2 top-1/2 -z-10 hidden h-[28rem] w-[28rem] -translate-x-1/2 -translate-y-1/2 text-arena/8 md:block"
    viewBox="0 0 120 120"
    fill="none"
    stroke="currentColor"
    stroke-width="1"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <circle cx="60" cy="60" r="50"></circle>
    <circle cx="60" cy="60" r="38"></circle>
    <path d="M60 14 L66 60 L60 106 L54 60 Z"></path>
    <path d="M14 60 L60 54 L106 60 L60 66 Z"></path>
  </svg>

  <div class="mx-auto max-w-5xl px-6 text-center">
    <div class="reveal mx-auto flex items-center justify-center gap-4">
      <span aria-hidden="true" class="h-px w-12 bg-celeste"></span>
      <span class="font-display text-sm tracking-[0.4em] text-celeste uppercase">
        Su lema
      </span>
      <span aria-hidden="true" class="h-px w-12 bg-celeste"></span>
    </div>

    <blockquote class="reveal reveal-delay-1 mt-10">
      <p
        class="font-display text-[clamp(2.25rem,8vw,5.5rem)] leading-[0.95] tracking-tight break-words text-arena"
      >
        <span class="text-celeste">#</span>Muchomasquedanza
      </p>
      <span
        aria-hidden="true"
        class="mx-auto mt-6 block h-px w-24 bg-gradient-to-r from-transparent via-arena/60 to-transparent"
      ></span>
    </blockquote>

    <p class="reveal reveal-delay-2 mx-auto mt-10 max-w-2xl text-base leading-relaxed text-caparol/80 sm:text-lg">
      <span class="text-arena">Un vocablo</span> que resume su manera de entender
      la danza: como aula, como mensaje y como puente entre el cuerpo y el mar.
    </p>
  </div>
</section>
