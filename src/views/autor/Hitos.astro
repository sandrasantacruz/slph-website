---
const fundacionCentro = 1989;
const aniosCentro = new Date().getFullYear() - fundacionCentro;

const hitos = [
  {
    year: String(aniosCentro),
    yearSuffix: 'años',
    title: 'Centro de Danza Sandra Santa Cruz',
    body: `Al frente del primer estudio que abrió sus puertas en Gran Canaria dirigido por una titulada en danza, desde ${fundacionCentro}. Diecisiete espectáculos propios, más coreografías por encargo de instituciones como el Teatro Pérez Galdós.`,
  },
  {
    year: '2016',
    title: 'Estreno del musical SLPH',
    body: 'Lleva a las tablas Si los peces hablaran…, escrito en colaboración con su padre Juan Luis. La función se convierte, sin pretenderlo, en el origen de todo lo demás.',
  },
  {
    year: '2021',
    title: 'Sinfónico en la Filarmónica',
    body: 'La obra cruza al concierto sinfónico, interpretada por la Filarmónica de Las Palmas. Una historia infantil que llega a la sala grande.',
  },
  {
    year: 'Hoy',
    title: 'Programa completo',
    body: 'Cuento ilustrado, programa educativo, app de realidad aumentada y una red creciente de centros, instituciones y voluntarios.',
    isToday: true,
  },
];
---

<section class="relative isolate overflow-hidden py-20 sm:py-28">
  <!-- Tinted band -->
  <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 inset-y-10 -z-20 bg-gradient-to-b from-azul-deep/0 via-azul-deep/40 to-azul-deep/0"></div>

  <div class="mx-auto max-w-6xl px-6">
    <div class="reveal flex items-center gap-5">
      <span aria-hidden="true" class="h-[2px] w-16 bg-arena sm:w-24"></span>
      <span class="font-display text-sm tracking-[0.4em] text-arena uppercase">
        Hitos
      </span>
    </div>

    <h2 class="reveal reveal-delay-1 mt-8 max-w-4xl font-display text-[clamp(2.25rem,6vw,4.5rem)] leading-[0.95] text-caparol">
      Lo que ha ido <span class="text-arena italic">sucediendo</span>.
    </h2>

    <p class="reveal reveal-delay-2 mt-6 max-w-2xl text-base leading-relaxed text-caparol/80 sm:text-lg">
      Una trayectoria que se cuenta mejor en momentos que en frases.
    </p>

    <!-- Timeline -->
    <ol class="mt-16 space-y-12 sm:space-y-16">
      {hitos.map((h, i) => (
        <li class={`reveal reveal-delay-${Math.min(i + 1, 3)} group relative grid gap-6 sm:grid-cols-[12rem_1fr] sm:gap-10 md:grid-cols-[14rem_1fr] md:gap-14`}>
          <!-- Left: massive year (or duration) -->
          <div class="flex items-baseline gap-2">
            <span
              class={`font-display leading-none ${h.isToday ? 'text-celeste' : h.yearSuffix ? 'text-arena' : 'text-caparol'}`}
              style="font-size:clamp(3rem,7.5vw,5rem)"
            >
              {h.year}
            </span>
            {h.yearSuffix && (
              <span class="font-display text-xl leading-none text-arena/80 sm:text-2xl">
                {h.yearSuffix}
              </span>
            )}
          </div>

          <!-- Right: title + body, with a sand divider line on the left edge -->
          <div class="relative border-l-2 border-arena/30 pl-6 sm:pl-8">
            <span
              aria-hidden="true"
              class="absolute -left-[6px] top-1 inline-block h-3 w-3 rounded-full bg-arena ring-4 ring-azul transition group-hover:scale-125"
            ></span>
            <h3 class="font-display text-2xl text-caparol sm:text-3xl">
              {h.title}
            </h3>
            <p class="mt-3 max-w-prose text-base leading-relaxed text-caparol/80 sm:text-lg">
              {h.body}
            </p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>
