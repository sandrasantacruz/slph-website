---
import EnlaceFlecha from '../../components/EnlaceFlecha.astro';
const fundacionCentro = 1989;
const aniosCentro = new Date().getFullYear() - fundacionCentro;

const hitos = [
  {
    year: String(aniosCentro),
    yearSuffix: 'años',
    title: 'Centro de Danza Sandra Santa Cruz',
    body: `Desde ${fundacionCentro}, diecisiete espectáculos propios, además de coreografías y proyectos por encargo de instituciones como la Orquesta Filarmónica de Gran Canaria y el Teatro Pérez Galdós.`,
  },
  {
    year: '2016',
    title: 'Estreno del musical SLPH',
    body: 'Su Centro de Danza lleva a escena el musical Si los peces hablaran… Sin pretenderlo, aquella función se convierte en el origen de todo lo demás.',
  },
  {
    year: '2018',
    title: 'Presentación del cuento',
    body: 'Con el respaldo de la Consejería de Cultura del Cabildo de Gran Canaria, presenta el cuento frente al Deep Sea de Poema del Mar, para mostrar a los más pequeños la belleza del mundo marino.',
  },
  {
    year: '2019',
    title: 'El cuento llega a las aulas',
    body: 'El interés que despierta el libro lleva al CEIP Alfredo Kraus y al CEIP Monseñor Socorro Lantigua a contactar directamente con la autora. Ambos adquieren el cuento y lo llevan a sus clases.',
  },
  {
    year: '2021',
    title: 'En formato sinfónico',
    body: 'A petición de la Orquesta Filarmónica de Gran Canaria, Si los peces hablaran… suena en Conciertos escolares y Conciertos en familia, para acercar a todas las edades un problema actual.',
  },
  {
    year: '2022',
    title: 'La obra como herramienta educativa',
    body: 'Primer proyecto escolar con un organismo oficial, de la mano de la Consejería de Educación del Cabildo de Gran Canaria. El programa llega a la red de centros escolares y empodera a los menores para generar cambios sociales.',
  },
  {
    year: '2022',
    title: 'El cuento como baluarte',
    body: 'En el Día Mundial de las Bibliotecas, la Concejalía de Cultura de Maspalomas pone en marcha el Programa SLPH, junto a Precious Plastic, que da una segunda vida al plástico.',
  },
  {
    year: '2025',
    title: "Mares (ICDC)",
    body: 'Su trabajo en Gran Canaria lleva el programa a otras islas a través de Mares, del Instituto Canario de Desarrollo Cultural (ICDC).'
  },
  {
    year: '2026',
    title: "Un proyecto con alma",
    body: "Un cuadernillo de actividades pensado para Oncología Infantil, que lleva los personajes del cuento a los niños que atraviesan el momento más difícil, y a las familias que lo atraviesan a su lado."
  },
  {
    year: 'Hoy',
    title: 'Programa SLPH',
    body: 'Un programa global para vivir en un mundo mejor, con una red creciente de centros, instituciones y voluntarios.',
    isToday: true,
  },
];
---

<section id="trayectoria" class="relative isolate scroll-mt-28 overflow-hidden py-20 sm:py-28">
  <!-- Tinted band -->
  <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 inset-y-10 -z-20 bg-gradient-to-b from-azul-deep/0 via-azul-deep/40 to-azul-deep/0"></div>

  <div class="mx-auto max-w-6xl px-6">
    <div class="reveal flex items-center gap-5">
      <span aria-hidden="true" class="h-[2px] w-16 bg-arena sm:w-24"></span>
      <span class="font-display text-sm tracking-[0.4em] text-arena uppercase">
        Hitos
      </span>
    </div>

    <h2 class="reveal reveal-delay-1 mt-8 max-w-4xl font-display text-[clamp(2.25rem,6vw,4.5rem)] leading-[0.95] text-caparol">
      Lo que ha ido <span class="text-arena italic">sucediendo</span>
    </h2>

    <p class="reveal reveal-delay-2 mt-6 max-w-2xl text-base leading-relaxed text-caparol/80 sm:text-lg">
      Una historia que se cuenta mejor en momentos que en frases.
    </p>

    <!-- Timeline -->
    <ol class="mt-16 space-y-12 sm:space-y-16">
      {hitos.map((h, i) => (
        <li class={`reveal reveal-delay-${Math.min(i + 1, 3)} group relative grid gap-6 sm:grid-cols-[12rem_1fr] sm:gap-10 md:grid-cols-[14rem_1fr] md:gap-14`}>
          <!-- Left: massive year (or duration) -->
          <div class="flex items-baseline gap-2">
            <span
              class={`font-display leading-none ${h.isToday ? 'text-celeste' : h.yearSuffix ? 'text-arena' : 'text-caparol'}`}
              style="font-size:clamp(3rem,7.5vw,5rem)"
            >
              {h.year}
            </span>
            {h.yearSuffix && (
              <span class="font-display text-xl leading-none text-arena/80 sm:text-2xl">
                {h.yearSuffix}
              </span>
            )}
          </div>

          <!-- Right: title + body, with a sand divider line on the left edge -->
          <div class="relative border-l-2 border-arena/30 pl-6 sm:pl-8">
            <span
              aria-hidden="true"
              class="absolute -left-[6px] top-1 inline-block h-3 w-3 rounded-full bg-arena ring-4 ring-azul transition group-hover:scale-125"
            ></span>
            <h3 class="font-display text-2xl text-caparol sm:text-3xl">
              {h.title}
            </h3>
            <p class="mt-3 max-w-prose text-base leading-relaxed text-caparol/80 sm:text-lg">
              {h.body}
            </p>
          </div>
        </li>
      ))}
    </ol>
    <div class="reveal mt-14 flex justify-center">
      <EnlaceFlecha href="/galeria#musical">Su trayectoria en imágenes</EnlaceFlecha>
    </div>
  </div>
</section>
