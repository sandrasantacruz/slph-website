---
import Ola from '../../components/Ola.astro';
import { Icon } from 'astro-icon/components';
import IndicePagina from '../../components/IndicePagina.astro';
---

<section class="relative isolate flex min-h-[calc(100svh-6rem)] flex-col overflow-hidden">
  <!-- Nela: Tablet hochkant (md) unter dem Text in der freien Fläche, etwas
       links der Mitte; ab lg rechts neben dem Text. Das Asset ist hochformatig (449x600),
       die Blasenspur nimmt das obere Drittel ein, der Fisch das untere.
       Der Flip liegt auf dem Wrapper, weil die Float-Keyframes das
       transform des animierten Elements überschreiben würden. -->
  <div
    aria-hidden="true"
    class="pointer-events-none absolute -z-10 hidden -scale-x-100 md:block md:bottom-[10%] md:left-1/3 lg:top-[18%] lg:right-16 lg:bottom-auto lg:left-auto xl:right-24"
  >
    <img
      src="/assets/animals/nela.webp"
      alt=""
      class="anim-nervio w-44 drop-shadow-[0_18px_28px_rgba(6,15,44,0.45)] lg:w-56"
      width="449"
      height="600"
      loading="lazy"
      decoding="async"
    />
  </div>

  <div class="mx-auto flex h-full w-full max-w-6xl flex-col justify-center gap-5 px-6 py-16 sm:gap-6 sm:py-20">
    <!-- Eyebrow -->
    <div class="reveal flex items-center gap-3 sm:gap-4">
      <span aria-hidden="true" class="h-px w-10 bg-arena sm:w-16"></span>
      <span class="font-display text-xs tracking-[0.4em] text-arena uppercase sm:text-sm">
        Programa SLPH · la galería
      </span>
    </div>

    <!-- Headline -->
    <h1 class="reveal reveal-delay-1 font-display text-[clamp(2.5rem,8vw,5.5rem)] leading-[0.9] tracking-tight text-caparol">
      Lo vivido con el mar
      <span class="block pb-2 sm:pb-3"><Ola class="text-arena italic">forma parte ya</Ola> de</span>
      <span class="block">nuestra historia</span>
    </h1>

    <!-- Body -->
    <p class="reveal reveal-delay-3 max-w-2xl text-sm leading-snug text-caparol/90 sm:text-base">
      Cada imagen, una historia: funciones, presentaciones, encuentros y la realidad
      que nos recuerda <span class="text-arena">por qué empezamos</span>.
    </p>

    <!-- Índice de la página (11 secciones agrupadas en 6), como en Programa y Repercusión -->
    <IndicePagina
      class="reveal reveal-delay-3 max-w-3xl border-t border-caparol/10 pt-5"
      enlaces={[
        { href: '#musical', texto: 'El origen' },
        { href: '#librupeces', texto: 'El cuento' },
        { href: '#espectaculos', texto: 'Espectáculos y eventos' },
        { href: '#talleres', texto: 'En las aulas' },
        { href: '#contaminacion', texto: 'La contaminación' },
        { href: '#momentos', texto: 'Momentos entrañables', corazon: true },
      ]}
    />
  </div>

  <!-- Scroll cue -->
  <a
    href="#hilo"
    aria-label="Bajar a la galería"
    class="scroll-cue absolute bottom-2 left-1/2 flex -translate-x-1/2 flex-col items-center gap-0.5 text-caparol/70 transition hover:text-arena sm:bottom-3 sm:gap-1"
  >
    <Icon name="game-icons:scuba-mask" class="h-8 w-8 sm:h-10 sm:w-10" aria-hidden="true" />
    <span class="font-hand text-lg leading-none sm:text-xl">sigue buceando</span>
    <svg viewBox="0 0 24 24" class="h-4 w-4 sm:h-5 sm:w-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M6 9l6 6 6-6"/>
    </svg>
  </a>
</section>
