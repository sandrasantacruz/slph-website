import Lightbox from "./Lightbox.astro";
import SubNavPrograma from "../../components/SubNavPrograma.astro";

type SectionDef = {
  id: string;
  title: string;
  eyebrow: string;
  intro: string;
  /**
   * Bildunterschriften, gekeyed auf den Dateinamen ohne `.webp`. Fehlt ein
   * Eintrag, wird die Unterschrift aus dem Dateinamen abgeleitet — ein neues
   * Bild erscheint also auch ohne Code-Edit, nur eben mit gröberem Text.
   */
  captions?: Record<string, string>;
  /**
   * Optionaler Langtext zu einzelnen Bildern, gekeyed wie `captions`. Er
   * erscheint nur in der Lightbox unter der Bildunterschrift, nicht auf der
   * Kachel: im 3:2-Raster waere dafuer kein Platz, und auf dem Handy gibt es
   * kein Hover, hinter dem man ihn verstecken koennte.
   */
