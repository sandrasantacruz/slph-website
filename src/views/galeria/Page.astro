---
import fs from "node:fs";
import path from "node:path";
import MainLayout from "../../layouts/MainLayout.astro";
import Hero from "./Hero.astro";
import Section from "./Section.astro";
import Lightbox from "./Lightbox.astro";
import SubNavCuento from "../../components/SubNavCuento.astro";

type SectionDef = {
  id: string;
  title: string;
  eyebrow: string;
  intro: string;
  /**
   * Bildunterschriften, gekeyed auf den Dateinamen ohne `.webp`. Fehlt ein
   * Eintrag, wird die Unterschrift aus dem Dateinamen abgeleitet — ein neues
   * Bild erscheint also auch ohne Code-Edit, nur eben mit gröberem Text.
   */
