// Read available webp files at build time, one folder per section.
const BASE = path.resolve(process.cwd(), "public/assets/galeria");

/**
 * Notlösung für Dateien ohne Eintrag in `captions`: "02-museo-perez-galdos"
 * wird zu "Museo perez galdos". Akzente fehlen, deshalb ist der Map-Eintrag
 * immer die bessere Wahl.
 */
function captionFromFilename(stem: string): string {
  const words = stem
    .replace(/^\d+[-_]?/, "")
    .replace(/[-_]+/g, " ")
    .trim();
  return words.charAt(0).toUpperCase() + words.slice(1);
}

const sections = sectionDefs.map((def) => {
  const dir = path.join(BASE, def.id);
  // Ordner darf (noch) fehlen oder leer sein: die Section rendert dann nur
  // den Kopf, Bilder erscheinen sobald WebPs im Ordner liegen. Die führende
  // Nummer im Dateinamen bestimmt die Reihenfolge.
  const files = fs.existsSync(dir)
    ? fs
        .readdirSync(dir)
        // Die leichten Varianten «-640/-960» (pnpm galeria:variantes) sind
        // keine eigenen Bilder, sondern Futter fuer das srcset der Kachel.
        .filter((f) => /\.webp$/i.test(f) && !/-(640|960)\.webp$/i.test(f))
        .sort()
    : [];
  const images = files.map((file) => {
    const stem = file.replace(/\.webp$/i, "");
    const caption = def.captions?.[stem] ?? captionFromFilename(stem);
    return {
      src: `/assets/galeria/${def.id}/${file}`,
      alt: ALTS[def.id]?.[stem] ?? `${def.title}: ${caption}`,
      caption,
      story: def.stories?.[stem],
      encuadre: def.encuadres?.[stem],
    };
  });
  return { ...def, images };
});
