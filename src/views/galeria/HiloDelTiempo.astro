---
/**
 * Hilo del tiempo 2016 → hoy, justo bajo la cabecera de la Galería: cuenta de
 * un vistazo cuánto ha crecido el proyecto gracias a quienes se han sumado.
 * Cada año salta a su sección de fotos. Móvil: línea vertical a la izquierda;
 * desde lg: una sola fila horizontal con los ocho hitos.
 * Fechas confirmadas por Sandra (presentación 2018, venta 2019, OFGC 2021).
 */
import Ola from '../../components/Ola.astro';

const hitos = [
  { anio: '2016', titulo: 'Nace el musical', texto: 'En el Centro de Danza Sandra Santa Cruz', href: '#musical' },
  { anio: '2017', titulo: 'Se suma la ciencia', texto: 'Con May Gómez y Gercende Courtois', href: '#transformacion' },
  { anio: '2018', titulo: 'Se presenta el cuento', texto: 'En el acuario Poema del Mar', href: '#cuento' },
  { anio: '2019', titulo: 'Llega a los lectores', texto: 'Con realidad aumentada', href: '#librupeces' },
  { anio: '2021', titulo: 'Le abren sus puertas', texto: 'La OFGC, museos y bibliotecas', href: '#espectaculos' },
  { anio: '2023', titulo: 'Se va de feria', texto: 'En Mogán: la del Libro y la del Atún', href: '#eventos' },
  { anio: '2025', titulo: 'Cruza a otras islas', texto: 'Tenerife y La Palma', href: '#espectaculos' },
  { anio: '2026', titulo: 'Alegrando el hospital', texto: '3.ª edición y cuadernillo para Oncología Infantil', href: '#librupeces' },
];
---

<section id="hilo" aria-labelledby="hilo-titulo" class="relative scroll-mt-24 py-16 sm:py-24">
  <div class="mx-auto w-full max-w-6xl px-6">
    <header class="reveal max-w-3xl">
      <div class="flex items-center gap-3 sm:gap-4">
        <span aria-hidden="true" class="h-px w-10 bg-arena sm:w-16"></span>
        <span class="font-display text-xs tracking-[0.4em] text-arena uppercase sm:text-sm">De 2016 a hoy</span>
      </div>
      <h2 id="hilo-titulo" class="mt-4 font-display text-[clamp(2rem,6vw,4rem)] leading-tight">
        Gota a gota, <Ola class="text-arena">un océano</Ola>
      </h2>
    </header>

    <ol class="relative mt-12 grid gap-8 border-l-2 border-arena/30 pl-6 lg:grid-cols-8 lg:gap-4 lg:border-t-2 lg:border-l-0 lg:pt-8 lg:pl-0">
      {
        hitos.map((h, i) => (
          <li class:list={['reveal relative', `reveal-delay-${(i % 3) + 1}`]}>
            <span
              aria-hidden="true"
              class="absolute top-2 -left-[1.95rem] h-3.5 w-3.5 rounded-full bg-arena ring-4 ring-azul lg:-top-[2.45rem] lg:left-0"
            ></span>
            <a href={h.href} class="group block">
              <span class="block font-display text-3xl leading-none text-arena transition group-hover:text-caparol">{h.anio}</span>
              <span class="mt-2 block font-display text-lg leading-tight text-caparol">{h.titulo}</span>
              <span class="mt-1 block text-sm leading-snug text-caparol/75">{h.texto}</span>
            </a>
          </li>
        ))
      }
    </ol>

    <p class="reveal mt-12 max-w-3xl font-hand text-2xl leading-snug text-celeste sm:text-3xl">
      Lo que empezó en un aula de danza hoy lo sostienen científicas, instituciones,
      colegios, músicos y familias.
    </p>
  </div>
</section>
