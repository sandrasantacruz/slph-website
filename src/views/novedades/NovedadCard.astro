---
import type { RecordModel } from 'pocketbase';
import { PB_PUBLIC_URL } from '../../lib/pb';

interface Props {
  item: RecordModel;
  hidden?: boolean;
}

const { item, hidden = false } = Astro.props;

const dayFmt = new Intl.DateTimeFormat('es-ES', { day: 'numeric' });
const monthFmt = new Intl.DateTimeFormat('es-ES', { month: 'short' });
const fullFmt = new Intl.DateTimeFormat('es-ES', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});

const cover = Array.isArray(item.cover) ? item.cover[0] : item.cover;
const coverUrl = cover
  ? `${PB_PUBLIC_URL}/api/files/${item.collectionId}/${item.id}/${cover}?thumb=0x600`
  : null;

function parseDate(raw: string | undefined): Date | null {
  if (!raw) return null;
  const d = new Date(raw);
  return Number.isNaN(d.getTime()) ? null : d;
}

const isEvent = item.typ === 'event';
const start = isEvent ? parseDate(item.event_date) : null;
const end = isEvent ? parseDate(item.event_end) : null;

const today = new Date();
today.setHours(0, 0, 0, 0);
const past = isEvent && ((end && end < today) || (!end && start && start < today));

const dateLabel = isEvent
  ? end && start
    ? `${fullFmt.format(start)} – ${fullFmt.format(end)}`
    : start
      ? fullFmt.format(start)
      : ''
  : (() => {
      const d = parseDate(item.published_at);
      return d ? fullFmt.format(d) : '';
    })();

const day = start ? dayFmt.format(start) : '';
const month = start ? monthFmt.format(start).replace('.', '') : '';

const href = `/noticias/${item.slug}`;
---

<li hidden={hidden} class:list={[
  'group relative flex h-full flex-col overflow-hidden rounded-2xl ring-1 transition',
  past
    ? 'bg-white/[0.03] ring-white/10 hover:ring-arena/30'
    : 'bg-white/5 ring-white/15 hover:ring-arena/50',
]}>
  <a href={href} class="flex h-full flex-col">
    <div class:list={[
      'relative aspect-[4/3] overflow-hidden bg-azul/40',
      past ? 'opacity-80 group-hover:opacity-100' : '',
    ]}>
      {coverUrl ? (
        <>
          <img
            src={coverUrl}
            alt=""
            aria-hidden="true"
            loading="lazy"
            class="absolute inset-0 h-full w-full scale-110 object-cover opacity-50 blur-xl"
          />
          <img
            src={coverUrl}
            alt=""
            loading="lazy"
            class="relative h-full w-full object-contain transition duration-500 group-hover:scale-105"
          />
        </>
      ) : (
        <div class="flex h-full items-center justify-center font-display text-3xl text-caparol/30">
          SLPH
        </div>
      )}

      {isEvent && start && (
        <div class="absolute left-3 top-3 flex flex-col items-center rounded-lg bg-arena px-3 py-2 text-negro shadow-lg">
          <span class="font-display text-3xl leading-none">{day}</span>
          <span class="text-xs font-medium uppercase tracking-wider">{month}</span>
        </div>
      )}
    </div>

    <div class="flex flex-1 flex-col gap-2 p-5">
      <div class="flex items-center gap-2 text-xs uppercase tracking-wider">
        <span class:list={[
          'rounded-full px-2 py-0.5 font-medium',
          isEvent
            ? 'bg-arena/20 text-arena'
            : 'bg-celeste/25 text-celeste',
        ]}>
          {isEvent ? 'Evento' : 'Noticia'}
        </span>
        {dateLabel && (
          <span class={past ? 'text-caparol/50' : 'text-caparol/70'}>
            {dateLabel}
          </span>
        )}
      </div>

      <h3 class:list={[
        'font-display text-2xl leading-tight text-caparol group-hover:text-arena',
        past && 'text-caparol/85',
      ]}>
        {item.title || 'Sin título'}
      </h3>

      {isEvent && item.location && (
        <p class="flex items-center gap-1.5 text-sm text-caparol/70">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0z"/>
            <circle cx="12" cy="10" r="3"/>
          </svg>
          {item.location}
        </p>
      )}

      {item.excerpt && (
        <p class="mt-1 line-clamp-2 text-sm text-caparol/75">{item.excerpt}</p>
      )}

      <span class="mt-auto pt-3 text-sm text-arena group-hover:underline">
        {isEvent ? 'Más info →' : 'Leer más →'}
      </span>
    </div>
  </a>
</li>
