---
import MainLayout from '../../layouts/MainLayout.astro';
import type { RecordModel } from 'pocketbase';
import { PB_PUBLIC_URL } from '../../lib/pb';
import { renderBlocks } from '../../lib/blocknote-render';
import {
  articleSchema,
  eventSchema,
  breadcrumbSchema,
} from '../../lib/seo';

interface Props {
  item: RecordModel;
}

const { item } = Astro.props;
const isEvent = item.typ === 'event';

const fullFmt = new Intl.DateTimeFormat('es-ES', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});

const cover = Array.isArray(item.cover) ? item.cover[0] : item.cover;
const coverUrl = cover
  ? `${PB_PUBLIC_URL}/api/files/${item.collectionId}/${item.id}/${cover}?thumb=0x900`
  : null;

function parseDate(iso: string | undefined): Date | null {
  if (!iso) return null;
  const d = new Date(iso);
  return Number.isNaN(d.getTime()) ? null : d;
}

const start = isEvent ? parseDate(item.event_date) : null;
const end = isEvent ? parseDate(item.event_end) : null;

const eventDateLabel = end && start
  ? `${fullFmt.format(start)} – ${fullFmt.format(end)}`
  : start
    ? fullFmt.format(start)
    : '';

const newsDate = !isEvent && item.published_at ? fullFmt.format(new Date(item.published_at)) : '';

const html = renderBlocks(item.content);

const fallbackTitle = isEvent ? 'Evento' : 'Noticia';
const typLabel = isEvent ? 'Evento' : 'Noticia';

const path = `/novedades/${item.slug}`;
const breadcrumb = breadcrumbSchema([
  { name: 'Inicio', url: '/' },
  { name: 'Novedades', url: '/novedades' },
  { name: item.title || fallbackTitle, url: path },
]);

const itemSchema = isEvent
  ? eventSchema({
      title: item.title || fallbackTitle,
      description: item.excerpt,
      url: path,
      image: coverUrl ?? undefined,
      startDate: item.event_date,
      endDate: item.event_end,
      location: item.location,
      locationUrl: item.address_url,
    })
  : articleSchema({
      title: item.title || fallbackTitle,
      description: item.excerpt,
      url: path,
      image: coverUrl ?? undefined,
      datePublished: item.published_at,
      dateModified: item.updated,
    });
---

<MainLayout
  title={item.title || fallbackTitle}
  description={item.excerpt}
  type="article"
  image={coverUrl ?? undefined}
  publishedTime={item.published_at}
  modifiedTime={item.updated}
  jsonLd={[itemSchema, breadcrumb]}
>
  <article class="pb-24">
    <div class="mx-auto max-w-3xl px-4 pt-12 sm:pt-16">
      <a href="/novedades" class="inline-block text-sm text-arena hover:underline">
        ← Volver a novedades
      </a>
    </div>

    {coverUrl && (
      <div class="mx-auto mt-6 max-w-3xl px-4">
        <div class="relative aspect-[16/9] overflow-hidden rounded-2xl bg-azul/40">
          <img
            src={coverUrl}
            alt=""
            aria-hidden="true"
            class="absolute inset-0 h-full w-full scale-110 object-cover opacity-50 blur-2xl"
          />
          <img
            src={coverUrl}
            alt={item.title}
            class="relative h-full w-full object-contain"
          />
        </div>
      </div>
    )}

    <header class="mx-auto max-w-3xl px-4 pt-12">
      <div class="flex items-center gap-2 text-xs uppercase tracking-wider">
        <span class:list={[
          'rounded-full px-2 py-0.5 font-medium',
          isEvent ? 'bg-arena/20 text-arena' : 'bg-celeste/25 text-celeste',
        ]}>
          {typLabel}
        </span>
        {isEvent && eventDateLabel && (
          <span class="text-arena">{eventDateLabel}</span>
        )}
        {!isEvent && newsDate && (
          <span class="text-arena">{newsDate}</span>
        )}
      </div>

      <h1 class="mt-3 font-display text-4xl leading-[1.05] text-caparol sm:text-6xl">
        {item.title}
      </h1>

      {isEvent && item.location && (
        <p class="mt-4 flex items-center gap-2 text-base text-caparol/85">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0z"/>
            <circle cx="12" cy="10" r="3"/>
          </svg>
          {item.address_url ? (
            <a
              href={item.address_url}
              class="hover:text-arena hover:underline"
              target="_blank"
              rel="noopener noreferrer"
            >
              {item.location}
            </a>
          ) : (
            <span>{item.location}</span>
          )}
        </p>
      )}
    </header>

    <div class="prose-slph mx-auto mt-10 max-w-3xl px-4" set:html={html} />
  </article>
</MainLayout>
