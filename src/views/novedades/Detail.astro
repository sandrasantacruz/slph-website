---
import { render } from 'astro:content';

import MainLayout from '../../layouts/MainLayout.astro';
import MapEmbed from '../../components/MapEmbed.astro';
import { postPath, type Post } from '../../lib/posts';
import {
  articleSchema,
  eventSchema,
  breadcrumbSchema,
} from '../../lib/seo';

interface Props {
  post: Post;
}

const { post } = Astro.props;
const {
  title,
  teaser,
  kind,
  cover,
  location,
  mapEmbed,
  startsAt,
  endsAt,
  publishedAt,
  updated,
} = post.data;

const isEvent = kind === 'event';

const fullFmt = new Intl.DateTimeFormat('es-ES', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});

const eventDateLabel = endsAt && startsAt
  ? `${fullFmt.format(startsAt)} a ${fullFmt.format(endsAt)}`
  : startsAt
    ? fullFmt.format(startsAt)
    : '';

const newsDate = !isEvent && publishedAt ? fullFmt.format(publishedAt) : '';

// `mapEmbed` ist im Ziel geprüft und immer eine reine Embed-URL. Für den Link
// im Kopf wollen wir aber eine vollwertige Maps-Ansicht, also eine Suche nach
// dem Ortsnamen.
const addressLink = location
  ? `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(location)}`
  : null;

// Der Körper kommt fertig und serverseitig gesäubert aus paula.
const { Content } = await render(post);

const fallbackTitle = isEvent ? 'Evento' : 'Noticia';
const typLabel = isEvent ? 'Evento' : 'Noticia';

const path = postPath(post);
const breadcrumb = breadcrumbSchema([
  { name: 'Inicio', url: '/' },
  { name: 'Noticias', url: '/noticias' },
  { name: title || fallbackTitle, url: path },
]);

const itemSchema = isEvent
  ? eventSchema({
      title: title || fallbackTitle,
      description: teaser,
      url: path,
      image: cover?.src,
      startDate: startsAt?.toISOString(),
      endDate: endsAt?.toISOString(),
      location,
      locationUrl: mapEmbed,
    })
  : articleSchema({
      title: title || fallbackTitle,
      description: teaser,
      url: path,
      image: cover?.src,
      datePublished: publishedAt?.toISOString(),
      dateModified: updated?.toISOString(),
    });
---

<MainLayout
  title={title || fallbackTitle}
  description={teaser}
  type="article"
  image={cover?.src}
  imageAlt={cover ? cover.alt ?? title : undefined}
  publishedTime={publishedAt?.toISOString()}
  modifiedTime={updated?.toISOString()}
  jsonLd={[itemSchema, breadcrumb]}
>
  <article class="pb-24">
    <div class="mx-auto max-w-3xl px-4 pt-12 sm:pt-16">
      <a href="/noticias" class="inline-block text-sm text-arena hover:underline">
        ← Volver a noticias
      </a>
    </div>

    {cover && (
      <div class="mx-auto mt-6 max-w-3xl px-4">
        <div class="aspect-[3/2] overflow-hidden rounded-2xl bg-azul/40">
          <img
            src={cover.src}
            alt={cover.alt ?? title}
            width={cover.width}
            height={cover.height}
            class="h-full w-full object-cover"
          />
        </div>
      </div>
    )}

    <header class="mx-auto max-w-3xl px-4 pt-12">
      <div class="flex items-center gap-2 text-xs uppercase tracking-wider">
        <span class:list={[
          'rounded-full px-2 py-0.5 font-medium',
          isEvent ? 'bg-arena/20 text-arena' : 'bg-celeste/25 text-celeste',
        ]}>
          {typLabel}
        </span>
        {isEvent && eventDateLabel && (
          <span class="text-arena">{eventDateLabel}</span>
        )}
        {!isEvent && newsDate && (
          <span class="text-arena">{newsDate}</span>
        )}
      </div>

      <h1 class="mt-3 font-display text-4xl leading-[1.05] text-caparol sm:text-6xl">
        {title}
      </h1>

      {isEvent && location && (
        <p class="mt-4 flex items-center gap-2 text-base text-caparol/85">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0z"/>
            <circle cx="12" cy="10" r="3"/>
          </svg>
          {addressLink ? (
            <a
              href={addressLink}
              class="hover:text-arena hover:underline"
              target="_blank"
              rel="noopener noreferrer"
            >
              {location}
            </a>
          ) : (
            <span>{location}</span>
          )}
        </p>
      )}
    </header>

    <div class="prose-slph mx-auto mt-10 max-w-3xl px-4">
      <Content />
    </div>

    {isEvent && location && (
      <section class="mx-auto mt-16 max-w-3xl px-4">
        <h2 class="mb-4 font-display text-2xl text-arena sm:text-3xl">
          Cómo llegar
        </h2>
        <MapEmbed location={location} addressUrl={mapEmbed} />
      </section>
    )}
  </article>
</MainLayout>
