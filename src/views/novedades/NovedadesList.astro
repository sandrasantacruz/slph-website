---
import NovedadCard from './NovedadCard.astro';
import { byDateDesc, type Post } from '../../lib/posts';

interface Props {
  items: Post[];
}

const { items } = Astro.props;
const BATCH = 12;

const sorted = [...items].sort(byDateDesc);
// Filtros (26 nov 2026): con más de 100 entradas, por tipo y por año
const years = [...new Set(sorted.map((it) => (it.data.startsAt ?? it.data.publishedAt)?.getFullYear()).filter(Boolean))].sort((a, b) => b! - a!);
---

<section class="mx-auto max-w-6xl px-4 pb-24">
  {sorted.length === 0 ? (
    <p class="text-caparol/60">Aún no hay nada publicado.</p>
  ) : (
    <>
      <div class="mb-8 flex flex-col gap-4 sm:mb-10" data-filtros>
        <div class="flex flex-wrap gap-2" role="group" aria-label="Filtrar por tipo">
          {[['all', 'Todo'], ['event', 'Eventos'], ['article', 'En los medios y novedades']].map(([v, l], i) => (
            <button type="button" data-tipo={v} aria-pressed={i === 0 ? 'true' : 'false'} class="filtro rounded-full border border-caparol/25 px-4 py-2 font-display text-sm text-caparol/85 transition hover:border-arena hover:text-arena sm:text-base">{l}</button>
          ))}
        </div>
        <div class="flex flex-wrap items-center gap-x-4 gap-y-2 text-sm" role="group" aria-label="Filtrar por año">
          <span class="font-hand text-xl text-celeste">año:</span>
          <button type="button" data-anio="all" aria-pressed="true" class="filtro-anio font-display tracking-[0.12em] text-caparol/70 uppercase transition hover:text-arena">Todos</button>
          {years.map((y) => (
            <button type="button" data-anio={String(y)} aria-pressed="false" class="filtro-anio font-display tracking-[0.12em] text-caparol/70 uppercase transition hover:text-arena">{y}</button>
          ))}
        </div>
        <p data-sin-resultados hidden class="text-caparol/70">No hay entradas con esos filtros.</p>
      </div>
      <ul id="novedades-list" class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {sorted.map((item, i) => <NovedadCard item={item} hidden={i >= BATCH} />)}
      </ul>
      {sorted.length > BATCH && (
        <div
          id="novedades-sentinel"
          data-batch={BATCH}
          class="mt-12 flex h-1 items-center justify-center"
          aria-hidden="true"
        ></div>
      )}
      <!-- Rückweg zur Galerie, gleicher Stil wie «Últimas noticias» am Ende der Galería -->
      <div class="mt-20 flex flex-col items-center gap-3 text-center">
        <p class="font-hand text-2xl text-celeste sm:text-3xl">¿Te quedas con ganas de más?</p>
        <a
          href="/galeria"
          class="group inline-flex items-center gap-3 rounded-full bg-arena px-7 py-3 font-display text-xl text-azul shadow-lg transition hover:brightness-95 sm:text-2xl"
        >
          Bucea en nuestra Galería
          <svg viewBox="0 0 24 24" class="h-5 w-5 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true">
            <path d="M5 12h14M13 6l6 6-6 6"></path>
          </svg>
        </a>
      </div>
    </>
  )}
</section>

<style>
  .filtro[aria-pressed='true'] { background: var(--color-arena); border-color: var(--color-arena); color: var(--color-azul); }
  .filtro-anio[aria-pressed='true'] { color: var(--color-arena); text-decoration: underline; text-underline-offset: 6px; }
</style>

<script>
  // Filtros por tipo y año: al filtrar se muestran todas las coincidencias (sin carga por tandas)
  const lista = document.getElementById('novedades-list');
  const estado = { tipo: 'all', anio: 'all' };
  const aplicar = () => {
    if (!lista) return;
    const todo = estado.tipo === 'all' && estado.anio === 'all';
    let n = 0;
    lista.querySelectorAll<HTMLLIElement>('li').forEach((li, i) => {
      const ok = (estado.tipo === 'all' || li.dataset.kind === estado.tipo) && (estado.anio === 'all' || li.dataset.year === estado.anio);
      li.hidden = todo ? i >= 12 : !ok;
      if (ok) n++;
    });
    document.getElementById('novedades-sentinel')?.toggleAttribute('hidden', !todo);
    document.querySelector<HTMLElement>('[data-sin-resultados]')!.hidden = n > 0;
  };
  document.querySelectorAll<HTMLButtonElement>('[data-tipo]').forEach((b) => b.addEventListener('click', () => {
    estado.tipo = b.dataset.tipo!;
    document.querySelectorAll('[data-tipo]').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
    aplicar();
  }));
  document.querySelectorAll<HTMLButtonElement>('[data-anio]').forEach((b) => b.addEventListener('click', () => {
    estado.anio = b.dataset.anio!;
    document.querySelectorAll('[data-anio]').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
    aplicar();
  }));
</script>

<script>
  const sentinel = document.getElementById('novedades-sentinel');
  const list = document.getElementById('novedades-list');
  if (sentinel && list) {
    const batch = Number(sentinel.dataset.batch) || 12;
    const observer = new IntersectionObserver(
      (entries) => {
        if (!entries.some((e) => e.isIntersecting)) return;
        const hidden = Array.from(list.querySelectorAll<HTMLLIElement>('li[hidden]'));
        if (hidden.length === 0) {
          sentinel.remove();
          observer.disconnect();
          return;
        }
        hidden.slice(0, batch).forEach((el) => el.removeAttribute('hidden'));
      },
      { rootMargin: '600px' },
    );
    observer.observe(sentinel);
  }
</script>
