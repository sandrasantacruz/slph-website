---
import MainLayout from '../../layouts/MainLayout.astro';
import Hero from './Hero.astro';
import NovedadesList from './NovedadesList.astro';
import type { RecordModel } from 'pocketbase';

const pb = Astro.locals.pb;

let items: RecordModel[] = [];
let loadError: string | null = null;
try {
  items = await pb.collection('posts').getFullList({
    filter: 'status = "published" && published_at <= @now',
  });
} catch (err) {
  loadError = err instanceof Error ? err.message : 'No se pudieron cargar las novedades.';
}

// Chronologisch sortieren: bei Events nach event_date (Datum der Veranstaltung),
// bei Noticias nach published_at. Beide DESC — neueste/nächste oben.
function sortKey(item: RecordModel): number {
  const raw = item.typ === 'event'
    ? (item.event_date || item.published_at)
    : item.published_at;
  if (!raw) return 0;
  const d = new Date(raw);
  return Number.isNaN(d.getTime()) ? 0 : d.getTime();
}

items.sort((a, b) => sortKey(b) - sortKey(a));
---

<MainLayout
  title="Novedades"
  description="Eventos, encuentros y notas de prensa del proyecto Si los peces hablaran."
>
  <Hero />
  {loadError ? (
    <section class="mx-auto max-w-6xl px-4 pb-24">
      <p class="text-arena">{loadError}</p>
    </section>
  ) : (
    <NovedadesList items={items} />
  )}
</MainLayout>
