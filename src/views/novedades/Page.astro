---
import { getCollection } from "astro:content";

import MainLayout from "../../layouts/MainLayout.astro";
import Hero from "./Hero.astro";
import NovedadesList from "./NovedadesList.astro";
import SiguientePaso from "../../components/SiguientePaso.astro";
import { byDateDesc, postPath } from "../../lib/posts";
import { breadcrumbSchema, SITE_URL, absoluteUrl } from "../../lib/seo";

// Zur Build-Zeit aus pulpo geladen (src/lib/pulpo-loader.ts). Fällt die Quelle
// aus, bricht der Build ab — besser als eine still leere Liste im Deploy.
const items = (await getCollection("posts")).sort(byDateDesc);

const breadcrumb = breadcrumbSchema([
  { name: "Inicio", url: "/" },
  { name: "Noticias", url: "/noticias" },
]);

const collectionPage = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "@id": `${SITE_URL}/noticias`,
  url: `${SITE_URL}/noticias`,
  name: "Noticias · Si los peces hablaran",
  description:
    "Eventos, encuentros y notas de prensa del proyecto Si los peces hablaran.",
  isPartOf: { "@id": `${SITE_URL}/#website` },
  about: { "@id": `${SITE_URL}/#organization` },
  hasPart: items.slice(0, 20).map((it) => ({
    "@type": it.data.kind === "event" ? "Event" : "NewsArticle",
    name: it.data.title,
    url: absoluteUrl(postPath(it)),
    ...(it.data.publishedAt
      ? { datePublished: it.data.publishedAt.toISOString() }
      : {}),
    ...(it.data.startsAt ? { startDate: it.data.startsAt.toISOString() } : {}),
    ...(it.data.endsAt ? { endDate: it.data.endsAt.toISOString() } : {}),
    ...(it.data.teaser ? { description: it.data.teaser } : {}),
  })),
};
---

<MainLayout
  title="Noticias · Si los peces hablaran…"
  description="Sigue nuestra estela: lo que hemos vivido y lo que está por llegar. Actividades, encuentros y notas de prensa de Si los peces hablaran…"
  jsonLd={[collectionPage, breadcrumb]}
>
  <Hero />
  <NovedadesList items={items} />
  <SiguientePaso
    antetitulo="¿la próxima noticia?"
    titulo="La próxima aventura"
    destacado="puede ser contigo"
    texto="¿Quieres llevar Si los peces hablaran… a tu colegio, biblioteca o municipio? Cuéntanos tu idea."
    principal={{ href: '/colabora', texto: 'Colabora con SLPH' }}
    secundario={{ href: '/contacto', texto: 'Escríbenos' }}
  />
</MainLayout>
