---
import MainLayout from '../../layouts/MainLayout.astro';
import Hero from './Hero.astro';
import NovedadesList from './NovedadesList.astro';
import type { RecordModel } from 'pocketbase';
import { breadcrumbSchema, SITE_URL, absoluteUrl } from '../../lib/seo';

const pb = Astro.locals.pb;

let items: RecordModel[] = [];
let loadError: string | null = null;
try {
  items = await pb.collection('posts').getFullList({
    filter: 'status = "published" && published_at <= @now',
  });
} catch (err) {
  loadError = err instanceof Error ? err.message : 'No se pudieron cargar las novedades.';
}

// Chronologisch sortieren: bei Events nach event_date (Datum der Veranstaltung),
// bei Noticias nach published_at. Beide DESC — neueste/nächste oben.
function sortKey(item: RecordModel): number {
  const raw = item.typ === 'event'
    ? (item.event_date || item.published_at)
    : item.published_at;
  if (!raw) return 0;
  const d = new Date(raw);
  return Number.isNaN(d.getTime()) ? 0 : d.getTime();
}

items.sort((a, b) => sortKey(b) - sortKey(a));

const breadcrumb = breadcrumbSchema([
  { name: 'Inicio', url: '/' },
  { name: 'Novedades', url: '/novedades' },
]);

const collectionPage = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  '@id': `${SITE_URL}/novedades`,
  url: `${SITE_URL}/novedades`,
  name: 'Novedades · Si los peces hablaran',
  description:
    'Eventos, encuentros y notas de prensa del proyecto Si los peces hablaran.',
  isPartOf: { '@id': `${SITE_URL}/#website` },
  about: { '@id': `${SITE_URL}/#organization` },
  hasPart: items.slice(0, 20).map((it) => ({
    '@type': it.typ === 'event' ? 'Event' : 'NewsArticle',
    name: it.title,
    url: absoluteUrl(`/novedades/${it.slug}`),
    ...(it.published_at ? { datePublished: it.published_at } : {}),
    ...(it.typ === 'event' && it.event_date ? { startDate: it.event_date } : {}),
    ...(it.typ === 'event' && it.event_end ? { endDate: it.event_end } : {}),
    ...(it.excerpt ? { description: it.excerpt } : {}),
  })),
};
---

<MainLayout
  title="Novedades"
  description="Eventos, encuentros y notas de prensa del proyecto Si los peces hablaran. Listado cronológico con las próximas actividades y las publicaciones recientes."
  jsonLd={[collectionPage, breadcrumb]}
>
  <Hero />
  {loadError ? (
    <section class="mx-auto max-w-6xl px-4 pb-24">
      <p class="text-arena">{loadError}</p>
    </section>
  ) : (
    <NovedadesList items={items} />
  )}
</MainLayout>
