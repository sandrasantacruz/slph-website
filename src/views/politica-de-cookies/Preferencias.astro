---
---

<section id="preferencias" class="relative isolate overflow-hidden border-t border-white/10 py-20 sm:py-28">
  <div class="mx-auto max-w-3xl px-6">
    <div class="reveal flex items-center gap-5">
      <span aria-hidden="true" class="h-[2px] w-16 bg-arena sm:w-24"></span>
      <span class="font-display text-sm tracking-[0.4em] text-arena uppercase">
        Tus preferencias
      </span>
    </div>

    <h2
      class="reveal reveal-delay-1 mt-6 font-display text-[clamp(2rem,5vw,3.5rem)] leading-[0.95] text-caparol"
    >
      Preferencias de
      <span class="block text-arena italic">privacidad.</span>
    </h2>

    <p class="reveal reveal-delay-2 mt-6 text-base leading-relaxed text-caparol/80 sm:text-lg">
      Algunos contenidos externos (como los mapas de Google Maps en las
      páginas de eventos) solo se cargan si los activas. Aquí puedes revisar
      tus decisiones y cambiarlas cuando quieras.
    </p>

    <div class="reveal reveal-delay-3 mt-12 space-y-6">
      <article
        data-consent-item
        data-consent-key="slph:consent:maps"
        class="rounded-2xl border border-white/15 bg-white/5 p-6 sm:p-8"
      >
        <div class="flex items-start justify-between gap-6">
          <div class="flex-1">
            <h3 class="font-display text-xl text-caparol sm:text-2xl">
              Mapas de Google Maps
            </h3>
            <p class="mt-2 text-sm leading-relaxed text-caparol/75 sm:text-base">
              Permitir la carga del mapa interactivo de Google en las páginas
              de eventos. Si lo activas, Google puede recibir datos sobre tu
              visita e instalar cookies en tu navegador.
            </p>
            <p class="mt-3 text-xs text-caparol/55" data-consent-status>
              Estado: <span data-consent-value>desactivado</span>.
            </p>
          </div>
          <button
            type="button"
            data-consent-toggle
            class="shrink-0 rounded-full bg-arena px-5 py-2 font-display text-sm tracking-wide text-negro shadow-lg transition hover:brightness-110"
          >
            Activar
          </button>
        </div>
      </article>

      <div class="flex flex-wrap items-center gap-3 pt-4">
        <button
          type="button"
          data-consent-reset
          class="rounded-full border border-white/20 px-4 py-2 text-sm text-caparol/85 transition hover:border-arena hover:text-arena"
        >
          Restablecer todas las preferencias
        </button>
        <p class="text-xs text-caparol/55">
          Borra cualquier consentimiento guardado en este navegador.
        </p>
      </div>
    </div>
  </div>
</section>

<script>
  const items = document.querySelectorAll<HTMLElement>('[data-consent-item]');

  function refresh(item: HTMLElement) {
    const key = item.dataset.consentKey;
    if (!key) return;
    const granted = localStorage.getItem(key) === 'granted';
    const valueEl = item.querySelector<HTMLElement>('[data-consent-value]');
    const btn = item.querySelector<HTMLButtonElement>('[data-consent-toggle]');
    if (valueEl) valueEl.textContent = granted ? 'activado' : 'desactivado';
    if (btn) btn.textContent = granted ? 'Desactivar' : 'Activar';
  }

  items.forEach((item) => {
    refresh(item);
    const btn = item.querySelector<HTMLButtonElement>('[data-consent-toggle]');
    const key = item.dataset.consentKey;
    btn?.addEventListener('click', () => {
      if (!key) return;
      const granted = localStorage.getItem(key) === 'granted';
      if (granted) {
        localStorage.removeItem(key);
      } else {
        localStorage.setItem(key, 'granted');
      }
      refresh(item);
      window.dispatchEvent(new CustomEvent('slph:consent-changed'));
    });
  });

  const resetBtn = document.querySelector<HTMLButtonElement>('[data-consent-reset]');
  resetBtn?.addEventListener('click', () => {
    items.forEach((item) => {
      const key = item.dataset.consentKey;
      if (key) localStorage.removeItem(key);
      refresh(item);
    });
    window.dispatchEvent(new CustomEvent('slph:consent-changed'));
  });
</script>
